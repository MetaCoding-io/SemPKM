# SemPKM Cloud Deployment — Environment Variables
#
# Copy this file to .env and fill in the required values before deploying:
#   cp .env.cloud.example .env
#
# Then start:
#   docker compose -f docker-compose.yml -f docker-compose.cloud.yml up -d

# ── Required ──────────────────────────────────────────────────────────────────

# Your domain name (must have DNS A record pointing to this server).
# Caddy uses this to automatically obtain a Let's Encrypt TLS certificate.
SEMPKM_DOMAIN=sempkm.example.com

# Base namespace for RDF data. Set automatically by the setup wizard when
# choosing "Custom domain" mode, or set manually here.
# Must end with a trailing slash.
BASE_NAMESPACE=https://sempkm.example.com/data/

# Public URL of the application (used for magic links, invitations, etc.)
APP_BASE_URL=https://sempkm.example.com

# Set to true for HTTPS deployments — ensures cookies have the Secure flag.
COOKIE_SECURE=true

# Secret key for session signing. If left empty, one is auto-generated on
# first startup (persisted in the data volume). Set explicitly if you need
# sessions to survive container rebuilds without a persistent data volume.
SECRET_KEY=

# ── Optional: SMTP (enables email-based magic links and invitations) ────────
# When not configured, magic link tokens are returned directly in the browser.

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=sempkm@example.com

# ── Optional: CORS (needed for browser extension on a different origin) ─────

# CORS_ORIGINS=https://sempkm.example.com

# ── Optional: Triplestore ───────────────────────────────────────────────────
# Defaults are correct for the bundled RDF4J in docker-compose.yml.
# Only change these if using an external triplestore.

# TRIPLESTORE_URL=http://triplestore:8080/rdf4j-server
# REPOSITORY_ID=sempkm

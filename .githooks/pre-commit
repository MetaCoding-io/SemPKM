#!/bin/bash
# Pre-commit hook: reject commits containing git conflict markers.
#
# Checks all staged files for unresolved <<<<<<< / ======= / >>>>>>> markers.
# This prevents the class of bug where squash merges commit conflict markers
# without resolving them (see: M002/S03 through M005/S01, 17 commits, 51 files).

# Only check staged files (not the whole repo)
CONFLICT_FILES=$(git diff --cached --name-only --diff-filter=ACMR | \
  xargs grep -l '^<<<<<<< \|^=======$\|^>>>>>>> ' 2>/dev/null)

if [ -n "$CONFLICT_FILES" ]; then
  echo ""
  echo "ERROR: Git conflict markers found in staged files:"
  echo ""
  for f in $CONFLICT_FILES; do
    count=$(grep -c '^<<<<<<< ' "$f" 2>/dev/null)
    echo "  $f ($count conflict blocks)"
  done
  echo ""
  echo "Resolve all conflicts before committing."
  echo "To bypass (emergencies only): git commit --no-verify"
  echo ""
  exit 1
fi

# ---------------------------------------------------------------------------
# repolens: architectural conventions.
#
# Runs only when source that could change the answer is staged, and only the
# stages needed for checks — a pre-commit hook that costs more than a second
# gets disabled, and a disabled hook checks nothing.
# Bypass with SKIP_REPOLENS=1 or git commit --no-verify.
# ---------------------------------------------------------------------------

if [ -z "$SKIP_REPOLENS" ] && [ -f .repolens.yml ]; then
  STAGED_SRC=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^(backend/|frontend/|e2e/)' || true)
  if [ -n "$STAGED_SRC" ]; then
    if ! python3 -m tools.repolens check --fail-on high >/tmp/repolens-hook.log 2>&1; then
      echo ""
      echo "ERROR: repolens found a high-severity architectural regression:"
      echo ""
      sed -n '/\[HIGH/,$p' /tmp/repolens-hook.log | head -20
      echo ""
      echo "To bypass: SKIP_REPOLENS=1 git commit ..."
      echo ""
      exit 1
    fi
  fi
fi

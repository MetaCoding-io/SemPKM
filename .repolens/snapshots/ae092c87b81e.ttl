<urn:repolens:sempkm:part/U>
    a rl:Part ;
    dcterms:title "Workspace UI" ;
    rl:shortName "WORKSPACE" ;
    rl:key "U" ;
    rl:partOf <urn:repolens:sempkm:repo> ;
    dcterms:description "The screen the person actually uses: an IDE-style workspace with an explorer, tabs, auto-generated forms, tables, cards and graph views. It holds almost no state of its own — it asks the server for HTML and swaps it in." ;
    skos:note "htmx drives nearly every DOM update; there is no SPA framework. 20,781 lines of JS across 33 modules and 21,066 lines of CSS across 17 sheets. Dockview manages the pane layout, Cytoscape draws graphs, CodeMirror edits Markdown and SPARQL." ;
    rl:memberGlob "frontend/static/js/**/*.js" ;
    rl:memberGlob "frontend/static/css/**/*.css" ;

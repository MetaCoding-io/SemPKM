<urn:repolens:sempkm:part/C>
    a rl:Part ;
    dcterms:title "Commands API" ;
    rl:shortName "COMMANDS" ;
    rl:key "C" ;
    rl:partOf <urn:repolens:sempkm:repo> ;
    dcterms:description "The public write endpoint. A request carries a batch of commands; each is dispatched to a handler that returns an Operation describing the triples to add and remove, and the batch commits atomically. It is documented as the only way to write — in practice most of the codebase calls the event store beneath it directly." ;
    skos:note "router.py validates a discriminated union of exactly six command types, dispatch() maps each to a handler in handlers/, and the resulting Operations commit together through one EventStore.commit(). A slot mechanism lets one command reference an IRI minted by an earlier one in the same batch. Webhook dispatch and validation enqueueing are attached here, at the router." ;
    rl:memberGlob "backend/app/commands/**/*.py" ;
    rl:inGroup <urn:repolens:sempkm:group/loop> ;
    rl:inLayer <urn:repolens:sempkm:layer/manager> ;
    rl:inTier <urn:repolens:sempkm:tier/t3> ;
    rl:hasFile <urn:repolens:sempkm:file/backend/app/commands/__init__.py> ;
    rl:hasFile <urn:repolens:sempkm:file/backend/app/commands/dispatcher.py> ;
    rl:hasFile <urn:repolens:sempkm:file/backend/app/commands/exceptions.py> ;
    rl:hasFile <urn:repolens:sempkm:file/backend/app/commands/handlers/__init__.py> ;
    rl:hasFile <urn:repolens:sempkm:file/backend/app/commands/handlers/body_diff.py> ;
    rl:hasFile <urn:repolens:sempkm:file/backend/app/commands/handlers/body_set.py> ;
    rl:hasFile <urn:repolens:sempkm:file/backend/app/commands/handlers/edge_create.py> ;
    rl:hasFile <urn:repolens:sempkm:file/backend/app/commands/handlers/edge_patch.py> ;
    rl:hasFile <urn:repolens:sempkm:file/backend/app/commands/handlers/object_create.py> ;
    rl:hasFile <urn:repolens:sempkm:file/backend/app/commands/handlers/object_patch.py> ;
    rl:hasFile <urn:repolens:sempkm:file/backend/app/commands/router.py> ;
    rl:hasFile <urn:repolens:sempkm:file/backend/app/commands/schemas.py> ;

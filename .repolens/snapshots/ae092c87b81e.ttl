<urn:repolens:sempkm:part/E>
    a rl:Part ;
    dcterms:title "Event store" ;
    rl:shortName "EVENTS" ;
    rl:key "E" ;
    rl:partOf <urn:repolens:sempkm:repo> ;
    dcterms:description "Turns operations into history. Each commit mints an event graph holding what happened, who did it and when, then materialises the same triples into the one graph the interface reads. Both writes ride in a single transaction, so state and history can never disagree. This — not the endpoint above it — is the invariant that actually holds everywhere." ;
    skos:note "EventStore.commit() opens an RDF4J transaction, writes metadata and data triples into urn:sempkm:event:{uuid}, applies inserts and deletes to urn:sempkm:current, then commits atomically. Failure rolls the whole thing back. commit_bulk() exists for imports that would otherwise mint one event per object." ;
    rl:memberGlob "backend/app/events/**/*.py" ;
    rl:inGroup <urn:repolens:sempkm:group/loop> ;
    rl:inLayer <urn:repolens:sempkm:layer/access> ;
    rl:inTier <urn:repolens:sempkm:tier/t5> ;
    rl:hasFile <urn:repolens:sempkm:file/backend/app/events/__init__.py> ;
    rl:hasFile <urn:repolens:sempkm:file/backend/app/events/models.py> ;
    rl:hasFile <urn:repolens:sempkm:file/backend/app/events/query.py> ;
    rl:hasFile <urn:repolens:sempkm:file/backend/app/events/store.py> ;
    rl:imports <urn:repolens:sempkm:part/T> .


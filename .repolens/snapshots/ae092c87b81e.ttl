<urn:repolens:sempkm:decision/D283>
    a rlg:Decision ;
    dcterms:identifier "D283" ;
    dcterms:title "Whether lint violations should be dismissable in the UI" ;
    rlg:rationale "Violations indicate real SHACL conformance failures (e.g., missing required properties, wrong datatypes). Allowing users to dismiss them would hide actionable errors. Warnings and infos are advisory data quality signals where user judgment determines relevance — appropriate for dismiss/suppress." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/UX> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M030/S03/T04> ;
    rlg:governs <urn:repolens:sempkm:part/LT> .

<urn:repolens:sempkm:decision/D263>
    a rlg:Decision ;
    dcterms:identifier "D263" ;
    dcterms:title "LLM proxy auth strategy for browser extension — new /api/llm/stream endpoint with dual-auth" ;
    rlg:rationale "Existing LLM proxy uses get_current_user (cookie-only). Modifying it risks breaking the htmx Settings page. Creating a parallel endpoint with get_current_user_or_api is ~20 lines copying the SSE pattern with the auth swap. Same approach used for POST /api/commands (D165)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M028%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/C> ;
    rlg:governs <urn:repolens:sempkm:part/B> ;
    rlg:governs <urn:repolens:sempkm:part/G> .

<urn:repolens:sempkm:decision/D264>
    a rlg:Decision ;
    dcterms:identifier "D264" ;
    dcterms:title "Progressive loading strategy for AI Insights in extension sidebar" ;
    rlg:rationale "SSE adds complexity (EventSource, reconnection, error handling) for marginal benefit. The extension makes 4 sequential API calls (detect-claims → match-claims → suggest-relationships → summarize) and renders each section as it completes. This achieves the same UX (claims first, then matches, then suggestions, then summary) with simpler implementation. Each call is independent — failure of one doesn't block others." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M028%20planning> .

<urn:repolens:sempkm:decision/D265>
    a rlg:Decision ;
    dcterms:identifier "D265" ;
    dcterms:title "M028 requirement IDs use EXT- prefix continuing from Phase 2" ;
    rlg:rationale "Browser extension requirements form a continuous sequence across Phase 1 (EXT-01–EXT-13), Phase 2 (EXT-14–EXT-21), and Phase 3 (EXT-22–EXT-33). Continuing the sequence maintains traceability across phases." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M028%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/B> .

<urn:repolens:sempkm:decision/D266>
    a rlg:Decision ;
    dcterms:identifier "D266" ;
    dcterms:title "Claim-to-graph matching uses FTS keyword search, not embeddings" ;
    rlg:rationale "CONTEXT.md explicitly scopes out embedding-based semantic search. LuceneSail FTS is already operational (v2.2) and the context-query endpoint already uses it. Ranking by FTS relevance score and capping at 5 matches per claim reduces false positives. Can upgrade to embeddings in a future milestone without API changes." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M028%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/K> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D267>
    a rlg:Decision ;
    dcterms:identifier "D267" ;
    dcterms:title "Build tool choice — esbuild over Vite" ;
    rlg:rationale "For a vanilla JS + htmx project with no ES module imports, esbuild's speed (~10ms builds) and simplicity outweigh Vite's HMR/plugin ecosystem. Vite targets React/Vue SPAs; SemPKM is server-rendered with htmx. esbuild handles concatenation, minification, and content-hashing natively. Install via npm in multi-stage Docker build." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M029%20planning> .

<urn:repolens:sempkm:decision/D268>
    a rlg:Decision ;
    dcterms:identifier "D268" ;
    dcterms:title "Vendoring strategy — npm + esbuild vendor bundle" ;
    rlg:rationale "npm is the standard JS package manager, version-pinning is built-in, and esbuild can bundle from node_modules. No custom download scripts or manual file management." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M029%20planning> .

<urn:repolens:sempkm:decision/D269>
    a rlg:Decision ;
    dcterms:identifier "D269" ;
    dcterms:title "Compression strategy — nginx gzip + pre-compressed .gz files, no brotli for v1" ;
    rlg:rationale "nginx:stable-alpine doesn't include the brotli module without a custom build. gzip provides ~70-80% compression. Adding brotli would require a custom nginx image increasing maintenance burden for marginal benefit (~5% smaller)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M029%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/N> .

<urn:repolens:sempkm:decision/D270>
    a rlg:Decision ;
    dcterms:identifier "D270" ;
    dcterms:title "Content-hashed filename resolution — JSON manifest + Jinja2 filter" ;
    rlg:rationale "Django's staticfiles manifest.json pattern is proven. Jinja2 filter is ~20 lines and integrates cleanly with existing template infrastructure. Dev mode fallback preserves volume-mount hot-reload workflow." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M029%20planning> .

<urn:repolens:sempkm:decision/D271>
    a rlg:Decision ;
    dcterms:identifier "D271" ;
    dcterms:title "CSS splitting strategy — template block inheritance, not build tool" ;
    rlg:rationale "CSS splitting by route doesn't require sophisticated build tooling — it's a matter of which <link> tags appear in which template. Jinja2 block inheritance already supports this pattern. Build tool handles minification; templates handle route assignment." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M029%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/J> .

<urn:repolens:sempkm:decision/D272>
    a rlg:Decision ;
    dcterms:identifier "D272" ;
    dcterms:title "Yasgui and Chart.js stay as separate lazy-loaded bundles, not in vendor bundle" ;
    rlg:rationale "Yasgui bundles CodeMirror + YASQE + YASR (~800KB). Chart.js is admin-only (~60KB). Including them in the vendor bundle would bloat every page load for features used on 1-2 pages. Lazy loading preserves current behavior." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M029%20planning> .

<urn:repolens:sempkm:decision/D273>
    a rlg:Decision ;
    dcterms:identifier "D273" ;
    dcterms:title "PERF requirement IDs for M029" ;
    rlg:rationale "PERF prefix established by PERF-01 in M002. Continuing the sequence maintains traceability." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M029%20planning> .

<urn:repolens:sempkm:decision/D274>
    a rlg:Decision ;
    dcterms:identifier "D274" ;
    dcterms:title "QUIC/HTTP/3 deferred — document decision only" ;
    rlg:rationale "Implementing HTTP/3 requires a custom nginx build or switching to Caddy. The cost exceeds the benefit for the self-hosted Docker deployment model. Caddy exists for the demo instance (D246) but switching the main stack is a separate decision." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M029%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/N> .

<urn:repolens:sempkm:decision/D275>
    a rlg:Decision ;
    dcterms:identifier "D275" ;
    dcterms:title "Dev vs production asset path divergence handled by Jinja2 filter mode" ;
    rlg:rationale "Single filter handles both modes. No environment variable needed — manifest file presence is the signal. Docker build produces the manifest; dev mode volume mounts don't include it." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M029%20planning> .

<urn:repolens:sempkm:decision/D276>
    a rlg:Decision ;
    dcterms:identifier "D276" ;
    dcterms:title "Manifest sharing between frontend and API containers in Docker" ;
    rlg:rationale "The frontend bind mount (./frontend/static:/usr/share/nginx/html:ro) is read-only, so a sub-volume at /assets/ fails. A separate named volume at /srv/built-assets/ avoids the conflict. The entrypoint script copies built assets from the image on every container start, ensuring rebuilds take effect without docker compose down -v. nginx serves /assets/ via alias directive to the shared volume." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M029/S01/T04> ;
    rlg:governs <urn:repolens:sempkm:part/U> ;
    rlg:governs <urn:repolens:sempkm:part/N> .

<urn:repolens:sempkm:decision/D215>
    a rlg:Decision ;
    dcterms:identifier "D215" ;
    dcterms:title "Todoist sync authentication — PAT-only for v1, no OAuth" ;
    rlg:rationale "Todoist PAT is simpler and matches the individual user focus stated in CONTEXT. GitHub sync (M017) uses the same PAT-only approach. OAuth adds client_id/secret management and callback complexity for the same functional outcome. The research doc notes OAuth as secondary — deferring it keeps M019 lean. Can add OAuth later if multi-user production deployments need it." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M019%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D216>
    a rlg:Decision ;
    dcterms:identifier "D216" ;
    dcterms:title "Todoist sync requirement ID prefix" ;
    rlg:rationale "Follows D209 convention — provider-specific prefix avoids collision with existing SYNC- (Linear), GH- (GitHub), GCAL- (Google Calendar) sequences." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M019%20planning> .

<urn:repolens:sempkm:decision/D217>
    a rlg:Decision ;
    dcterms:identifier "D217" ;
    dcterms:title "Outlook sync authentication — full OAuth 2.0 with /common/ tenant" ;
    rlg:rationale "Microsoft Graph API requires OAuth for user-data access (no API key path). `/common/` supports both personal Microsoft accounts and organizational accounts, maximizing compatibility. Follows M018 Google OAuth pattern." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M020%20planning> .

<urn:repolens:sempkm:decision/D218>
    a rlg:Decision ;
    dcterms:identifier "D218" ;
    dcterms:title "Polling-only sync for Outlook v1, no webhook subscriptions" ;
    rlg:rationale "Same constraint as D200/D211 — App Platform doesn't expose external webhook routes. Delta queries are highly efficient (return only changes since last token). Webhook subscriptions expire after ~3 days requiring auto-renewal — complexity deferred to v2." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M020%20planning> .

<urn:repolens:sempkm:decision/D219>
    a rlg:Decision ;
    dcterms:identifier "D219" ;
    dcterms:title "Hand-rolled recurrence pattern→RRULE converter as pure function" ;
    rlg:rationale "No library maps Outlook's structured pattern object to RFC 5545 RRULE. The conversion is a deterministic pure function with well-defined mapping tables. Unit test coverage (6 patterns × 3 ranges + edge cases) is the safety net." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M020%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/N> .

<urn:repolens:sempkm:decision/D220>
    a rlg:Decision ;
    dcterms:identifier "D220" ;
    dcterms:title "markdownify for HTML→Markdown body conversion" ;
    rlg:rationale "Outlook body content defaults to HTML (unlike Google's plain text). markdownify is lightweight with no heavy C dependencies. Fallback: strip HTML tags if markdownify fails to install." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M020%20planning> .

<urn:repolens:sempkm:decision/D221>
    a rlg:Decision ;
    dcterms:identifier "D221" ;
    dcterms:title "Outlook sync requirement IDs use OL- prefix" ;
    rlg:rationale "Follows D209/D214/D216 convention — provider-specific prefix avoids collision." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M020%20planning> .

<urn:repolens:sempkm:decision/D222>
    a rlg:Decision ;
    dcterms:identifier "D222" ;
    dcterms:title "RSVP-only push scope for Outlook v1" ;
    rlg:rationale "Consistent with Google Calendar push scope. Narrow push reduces complexity and risk. Full event editing push requires field-level conflict resolution exceeding v1 scope." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M020%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/E> .

<urn:repolens:sempkm:decision/D223>
    a rlg:Decision ;
    dcterms:identifier "D223" ;
    dcterms:title "CalDAV sync authentication — HTTP Basic primary, optional OAuth 2.0" ;
    rlg:rationale "CalDAV's primary audience is self-hosters (Fastmail, Nextcloud, Synology, Radicale) who all use HTTP Basic auth. No complex OAuth redirect dance needed for the primary use case. Simpler than M018/M020 OAuth-only approaches. OAuth can layer on later without breaking the Basic auth path." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M021%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/G> .

<urn:repolens:sempkm:decision/D224>
    a rlg:Decision ;
    dcterms:identifier "D224" ;
    dcterms:title "CalDAV protocol implementation — hand-crafted XML over httpx, no caldav library" ;
    rlg:rationale "The caldav Python library (PyPI) has inconsistent API, limited maintenance, and brings its own HTTP client conflicting with SDK's HttpClient. CalDAV XML requests are small, well-defined documents. stdlib ET handles namespace-aware XML cleanly. Full control over request/response cycle is critical for debugging server compatibility issues." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M021%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D225>
    a rlg:Decision ;
    dcterms:identifier "D225" ;
    dcterms:title "CalDAV network permission — wildcard for user-configured server URLs" ;
    rlg:rationale "CalDAV servers are user-configured (any domain). Unlike Google/Outlook which target fixed API domains, CalDAV must reach arbitrary hosts. SDK's HttpClient uses fnmatch for domain enforcement — verified that '*' matches any domain string. This is the first app to use wildcard network permissions." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M021%20planning> .

<urn:repolens:sempkm:decision/D226>
    a rlg:Decision ;
    dcterms:identifier "D226" ;
    dcterms:title "CalDAV sync requirement ID prefix" ;
    rlg:rationale "Follows D209/D214/D216/D221 convention — provider-specific prefix avoids collision with SYNC- (Linear), GH- (GitHub), GCAL- (Google), TD- (Todoist), OL- (Outlook) sequences." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M021%20planning> .

<urn:repolens:sempkm:decision/D227>
    a rlg:Decision ;
    dcterms:identifier "D227" ;
    dcterms:title "Asana sync authentication — OAuth 2.0 primary with PAT fallback" ;
    rlg:rationale "Matches the dual-auth pattern from M016 (D199). OAuth is the standard Asana auth path; PAT simplifies local dev without callback routing. Asana OAuth has no explicit scopes — all permissions are implicit." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M022%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/G> .

<urn:repolens:sempkm:decision/D228>
    a rlg:Decision ;
    dcterms:identifier "D228" ;
    dcterms:title "Configurable field mapping as explicit setup step before sync" ;
    rlg:rationale "Asana has no native status or priority fields — status comes from custom enum fields or section membership, priority from custom enum fields. This is fundamentally different from Linear/GitHub/Todoist where mappings are fixed. The \"configure before sync\" pattern is new to the platform and will be reused by Monday.com and other custom-field-heavy providers (M024+)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M022%20planning> .

<urn:repolens:sempkm:decision/D229>
    a rlg:Decision ;
    dcterms:identifier "D229" ;
    dcterms:title "Subtask recursion bounded at 5 levels with per-level API calls" ;
    rlg:rationale "Subtask API returns direct children only — no deep query. 5 levels covers all practical use. Bounding prevents cost-based rate limit exhaustion (each level is N API calls where N is parent count)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M022%20planning> .

<urn:repolens:sempkm:decision/D230>
    a rlg:Decision ;
    dcterms:identifier "D230" ;
    dcterms:title "Asana sync requirement IDs use ASANA- prefix" ;
    rlg:rationale "Follows D209/D214/D216/D221/D226 convention — provider-specific prefix avoids collision with existing sync app requirement sequences." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M022%20planning> .

<urn:repolens:sempkm:decision/D231>
    a rlg:Decision ;
    dcterms:identifier "D231" ;
    dcterms:title "Section-based status push via addTask API, not field PATCH" ;
    rlg:rationale "Asana sections are organizational containers, not field values. Moving a task between sections requires a dedicated API call. This is a different push pattern than custom-field PATCH used by prior sync apps. Both paths coexist based on the user's status_source configuration." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M022%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/P> .

<urn:repolens:sempkm:decision/D232>
    a rlg:Decision ;
    dcterms:identifier "D232" ;
    dcterms:title "Asana REST client uses _raw_request/_request two-layer pattern for data envelope APIs" ;
    rlg:rationale "Asana's API wraps data in {\"data\": [...], \"next_page\": {\"offset\": \"...\"}} — pagination metadata is a sibling of data, not nested inside it. A single-layer _request that unwraps data loses the next_page cursor. The two-layer split keeps error handling (401, 429, 5xx) in one place while allowing pagination to read the full response structure. Applicable to any API with response wrappers containing metadata alongside the data array." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M022/S01> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D171>
    a rlg:Decision ;
    dcterms:identifier "D171" ;
    dcterms:title "AppManager restart count tracking strategy" ;
    rlg:rationale "Avoids extra DB round-trips in the crash recovery hot path. DB sync happens after each recovery attempt for persistence. Memory-first is safe because a single AppManager instance owns each app's lifecycle — no concurrent writers." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M009/S01/T03> .

<urn:repolens:sempkm:decision/D172>
    a rlg:Decision ;
    dcterms:identifier "D172" ;
    dcterms:title "How platform shutdown handles app DB status for auto-restart" ;
    rlg:rationale "Platform restarts (Docker restart, deploy) should not lose the user's intended app state. If an app was running before shutdown, it should auto-start on boot. This is the same pattern as systemd 'enabled' services — the desired state is declarative, not just current state." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M009/S01> .

<urn:repolens:sempkm:decision/D173>
    a rlg:Decision ;
    dcterms:identifier "D173" ;
    dcterms:title "SDK token validation mechanism (platform↔app authentication)" ;
    rlg:rationale "Simpler model where platform and app share the same token string. Apps don't need PyJWT to decode — just string equality. Platform still generates JWT (for structured claims on its own side, including grace period renewal), but the app only ever compares the opaque string. Avoids SDK needing secret key access or clock sync for JWT expiry checks." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M009/S02> ;
    rlg:governs <urn:repolens:sempkm:part/P> ;
    rlg:governs <urn:repolens:sempkm:part/Q> .

<urn:repolens:sempkm:decision/D174>
    a rlg:Decision ;
    dcterms:identifier "D174" ;
    dcterms:title "AppProxy response forwarding strategy" ;
    rlg:rationale "Simpler implementation. App fragment responses are small HTML chunks (KB range). Streaming adds complexity (async generator, chunked transfer encoding, error handling mid-stream) for no measurable benefit at current scale. Can upgrade to streaming later if large responses (file downloads, SSE) become a requirement." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M009/S02> .

<urn:repolens:sempkm:decision/D175>
    a rlg:Decision ;
    dcterms:identifier "D175" ;
    dcterms:title "Admin router inclusion order relative to app proxy router" ;
    rlg:rationale "app_proxy_router uses a greedy path parameter that matches any sub-path under /app/. If it were registered first, requests to /admin/apps/ would be intercepted by the proxy. FastAPI matches routes in registration order, so placing the admin router first ensures admin paths are resolved before the catch-all." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M009/S03> ;
    rlg:governs <urn:repolens:sempkm:part/A> ;
    rlg:governs <urn:repolens:sempkm:part/P> .

<urn:repolens:sempkm:decision/D176>
    a rlg:Decision ;
    dcterms:identifier "D176" ;
    dcterms:title "How to serve per-app static assets via nginx" ;
    rlg:rationale "App static files live in app source directories under the API container. nginx serves them via the shared sempkm_data volume. The alias directive (not root) handles path remapping correctly. Trailing slashes on both location and alias are critical for nginx alias to work without path traversal issues. Cache-Control: public, immutable headers set since app assets are versioned by install." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M009/S03> ;
    rlg:governs <urn:repolens:sempkm:part/U> ;
    rlg:governs <urn:repolens:sempkm:part/N> ;
    rlg:governs <urn:repolens:sempkm:part/L> .

<urn:repolens:sempkm:decision/D177>
    a rlg:Decision ;
    dcterms:identifier "D177" ;
    dcterms:title "SDK permission enforcement model — default-deny with manifest-driven allowlists" ;
    rlg:rationale "Without enforcement, apps can execute any command type, create IRIs outside their prefix, query any graph, and call any external URL. Default-deny is the safe baseline — apps must explicitly declare permissions. IRI prefix scoped to urn:sempkm:app:{appId}: to namespace all app-created data. fnmatch for domain matching supports both exact domains and *.example.com glob patterns. Permission checks are stateless and synchronous — raises PermissionError with self-documenting messages including the offending value and allowed list." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M009/S05> ;
    rlg:governs <urn:repolens:sempkm:part/P> .

<urn:repolens:sempkm:decision/D001>
    a rlg:Decision ;
    dcterms:identifier "D001" ;
    dcterms:title "Items from CONCERNS.md already fixed" ;
    rlg:rationale "Verified in codebase — fixed in v2.1 through v2.6" ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M002> .

<urn:repolens:sempkm:decision/D002>
    a rlg:Decision ;
    dcterms:identifier "D002" ;
    dcterms:title "MCP server for AI agent access" ;
    rlg:rationale "Feature work, not polish — doesn't belong in hardening milestone" ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M002> .

<urn:repolens:sempkm:decision/D003>
    a rlg:Decision ;
    dcterms:identifier "D003" ;
    dcterms:title "Admin model detail stats and charts" ;
    rlg:rationale "Cosmetic admin enhancements, low priority" ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M002> .

<urn:repolens:sempkm:decision/D004>
    a rlg:Decision ;
    dcterms:identifier "D004" ;
    dcterms:title "Browser router refactor approach" ;
    rlg:rationale "Preserves all URL paths and htmx wiring; E2E tests are the safety net" ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M002> ;
    rlg:governs <urn:repolens:sempkm:part/B> .

<urn:repolens:sempkm:decision/D005>
    a rlg:Decision ;
    dcterms:identifier "D005" ;
    dcterms:title "Federation testing approach" ;
    rlg:rationale "Single instance can't test federation; permanent dev setup not needed" ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M002> ;
    rlg:governs <urn:repolens:sempkm:part/F> .

<urn:repolens:sempkm:decision/D006>
    a rlg:Decision ;
    dcterms:identifier "D006" ;
    dcterms:title "Obsidian import testing approach" ;
    rlg:rationale "Automated testing of 905-note vault import is fragile; user judgment needed for mapping quality" ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M002> ;
    rlg:governs <urn:repolens:sempkm:part/X> .

<urn:repolens:sempkm:decision/D007>
    a rlg:Decision ;
    dcterms:identifier "D007" ;
    dcterms:title "Rate limiting library" ;
    rlg:rationale "Battle-tested (wraps flask-limiter), no Redis needed for single-instance, supports `get_remote_address` for real client IP behind nginx" ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M002/S01> ;
    rlg:governs <urn:repolens:sempkm:part/N> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D008>
    a rlg:Decision ;
    dcterms:identifier "D008" ;
    dcterms:title "SPARQL regex escaping placement" ;
    rlg:rationale "Must be importable without pulling in views service; S03 will unit-test it directly" ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M002/S01> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/V> .

<urn:repolens:sempkm:decision/D009>
    a rlg:Decision ;
    dcterms:identifier "D009" ;
    dcterms:title "SPARQL string-stripping helper placement" ;
    rlg:rationale "This is keyword-detection preprocessing specific to `scope_to_current_graph` and `check_member_query_safety`, not general SPARQL escaping. Keeping it module-private avoids polluting the shared utils API." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M002/S02> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D010>
    a rlg:Decision ;
    dcterms:identifier "D010" ;
    dcterms:title "View spec source_model query strategy" ;
    rlg:rationale "Matches existing codebase pattern (events/query.py), avoids scanning unrelated graphs, captures per-spec provenance. Reverse map from graph IRI to model ID uses the same `urn:sempkm:model:{id}:views` convention as models/registry.py." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M002/S02> ;
    rlg:governs <urn:repolens:sempkm:part/E> ;
    rlg:governs <urn:repolens:sempkm:part/M> ;
    rlg:governs <urn:repolens:sempkm:part/V> .

<urn:repolens:sempkm:decision/D011>
    a rlg:Decision ;
    dcterms:identifier "D011" ;
    dcterms:title "Backend test strategy" ;
    rlg:rationale "All S03 targets are sync pure functions or functions with injectable settings. No integration test infra needed. Tests run in <5s locally." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M002/S03> .

<urn:repolens:sempkm:decision/D012>
    a rlg:Decision ;
    dcterms:identifier "D012" ;
    dcterms:title "Token expiry testing approach" ;
    rlg:rationale "Avoids slow/flaky sleep-based tests. Tests the same verify API with immediate expiry." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M002/S03> .

<urn:repolens:sempkm:decision/D013>
    a rlg:Decision ;
    dcterms:identifier "D013" ;
    dcterms:title "`_serializer` singleton isolation" ;
    rlg:rationale "Prevents stale serializer from masking key-resolution bugs across tests." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M002/S03> .

<urn:repolens:sempkm:decision/D014>
    a rlg:Decision ;
    dcterms:identifier "D014" ;
    dcterms:title "Sub-router prefix strategy" ;
    rlg:rationale "Avoids prefix stacking bugs (`/browser/browser/settings`). Matches how existing codebase works." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M002/S04> ;
    rlg:governs <urn:repolens:sempkm:part/B> .

<urn:repolens:sempkm:decision/D015>
    a rlg:Decision ;
    dcterms:identifier "D015" ;
    dcterms:title "`_validate_iri` test import path" ;
    rlg:rationale "Cleaner — no re-export indirection. Single source of truth in `_helpers.py`." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M002/S04> .

<urn:repolens:sempkm:decision/D016>
    a rlg:Decision ;
    dcterms:identifier "D016" ;
    dcterms:title "Sub-router include order" ;
    rlg:rationale "Preserves FastAPI route matching order; prevents path-parameter shadowing regressions." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M002/S04> ;
    rlg:governs <urn:repolens:sempkm:part/A> .

<urn:repolens:sempkm:decision/D017>
    a rlg:Decision ;
    dcterms:identifier "D017" ;
    dcterms:title "Federation E2E invitation strategy" ;
    rlg:rationale "Full cross-instance signing requires TLS (WebFinger hardcodes HTTPS) and key management in tests. Hybrid still tests accept → sync with real API calls. Upgrade to real signing if federation becomes a daily workflow." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M002/S06> ;
    rlg:governs <urn:repolens:sempkm:part/F> .

<urn:repolens:sempkm:decision/D018>
    a rlg:Decision ;
    dcterms:identifier "D018" ;
    dcterms:title "Federation test ports" ;
    rlg:rationale "Avoids conflict with dev (3000/8001) and existing E2E test (3901/8901) stacks" ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M002/S06> ;
    rlg:governs <urn:repolens:sempkm:part/F> .

<urn:repolens:sempkm:decision/D019>
    a rlg:Decision ;
    dcterms:identifier "D019" ;
    dcterms:title "Federation test APP_BASE_URL" ;
    rlg:rationale "WebID URLs must be fetchable by the other instance. Docker service names resolve on the shared network. External localhost URLs wouldn't work for cross-container requests." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M002/S06> ;
    rlg:governs <urn:repolens:sempkm:part/F> ;
    rlg:governs <urn:repolens:sempkm:part/Y> .

<urn:repolens:sempkm:decision/D020>
    a rlg:Decision ;
    dcterms:identifier "D020" ;
    dcterms:title "Explorer mode switching mechanism" ;
    rlg:rationale "User confirmed: single section with mode dropdown, not multiple collapsible sections per mode" ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003> .

<urn:repolens:sempkm:decision/D021>
    a rlg:Decision ;
    dcterms:identifier "D021" ;
    dcterms:title "Favorites storage layer" ;
    rlg:rationale "Favorites are user preferences, not knowledge graph data. Same layer as auth/sessions." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003> ;
    rlg:governs <urn:repolens:sempkm:part/G> .

<urn:repolens:sempkm:decision/D022>
    a rlg:Decision ;
    dcterms:identifier "D022" ;
    dcterms:title "Comments storage layer" ;
    rlg:rationale "Comments are knowledge about objects — they belong in the knowledge graph. Event-sourced for auditability." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003> ;
    rlg:governs <urn:repolens:sempkm:part/E> .

<urn:repolens:sempkm:decision/D023>
    a rlg:Decision ;
    dcterms:identifier "D023" ;
    dcterms:title "Comment threading model" ;
    rlg:rationale "User chose threaded over flat. Modeled via sempkm:replyTo predicate in RDF." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003> .

<urn:repolens:sempkm:decision/D024>
    a rlg:Decision ;
    dcterms:identifier "D024" ;
    dcterms:title "Gist visibility in ontology viewer" ;
    rlg:rationale "User chose fully visible over grayed/hidden. Power users can explore the full hierarchy." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003> ;
    rlg:governs <urn:repolens:sempkm:part/O> .

<urn:repolens:sempkm:decision/D025>
    a rlg:Decision ;
    dcterms:identifier "D025" ;
    dcterms:title "Gist version" ;
    rlg:rationale "Avoids breaking changes from upstream. CC BY 4.0 license." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003> .

<urn:repolens:sempkm:decision/D026>
    a rlg:Decision ;
    dcterms:identifier "D026" ;
    dcterms:title "Gist named graph IRI" ;
    rlg:rationale "Namespaced under sempkm convention. Separate from model graphs." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003> .

<urn:repolens:sempkm:decision/D027>
    a rlg:Decision ;
    dcterms:identifier "D027" ;
    dcterms:title "User-created types graph" ;
    rlg:rationale "Separate from model graphs. Discoverable by ShapesService." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003> .

<urn:repolens:sempkm:decision/D028>
    a rlg:Decision ;
    dcterms:identifier "D028" ;
    dcterms:title "M003 class creation scope" ;
    rlg:rationale "Full shape editing deferred to later milestone (TYPE-03)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003> .

<urn:repolens:sempkm:decision/D029>
    a rlg:Decision ;
    dcterms:identifier "D029" ;
    dcterms:title "Hierarchy nesting depth" ;
    rlg:rationale "Most real usage will be 2-3 levels. Lazy expansion prevents performance issues." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003> .

<urn:repolens:sempkm:decision/D030>
    a rlg:Decision ;
    dcterms:identifier "D030" ;
    dcterms:title "VFS strategy reuse for explorer" ;
    rlg:rationale "Same queries, different output format. Avoids duplicating SPARQL logic." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D031>
    a rlg:Decision ;
    dcterms:identifier "D031" ;
    dcterms:title "Explorer mode endpoint pattern" ;
    rlg:rationale "htmx-native: select value auto-included in request. Simpler than dynamic URL building. Registry pattern allows downstream slices to register handlers." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S01> ;
    rlg:governs <urn:repolens:sempkm:part/M> .

<urn:repolens:sempkm:decision/D032>
    a rlg:Decision ;
    dcterms:identifier "D032" ;
    dcterms:title "Explorer mode persistence" ;
    rlg:rationale "Lightweight, per-browser, no server state needed for UI preference. Read on workspace init, trigger htmx load if non-default." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S01> ;
    rlg:governs <urn:repolens:sempkm:part/U> ;
    rlg:governs <urn:repolens:sempkm:part/B> .

<urn:repolens:sempkm:decision/D033>
    a rlg:Decision ;
    dcterms:identifier "D033" ;
    dcterms:title "Existing `/browser/nav-tree` endpoint kept for backwards compat" ;
    rlg:rationale "Prevents breakage during incremental rollout. Will be deprecated once all callers use mode-aware endpoint." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S01> ;
    rlg:governs <urn:repolens:sempkm:part/B> .

<urn:repolens:sempkm:decision/D034>
    a rlg:Decision ;
    dcterms:identifier "D034" ;
    dcterms:title "Selection clearing strategy on mode switch" ;
    rlg:rationale "Prevents stale selection state referencing IRIs not visible in the new tree. Proactive clear before htmx swap." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S01> .

<urn:repolens:sempkm:decision/D035>
    a rlg:Decision ;
    dcterms:identifier "D035" ;
    dcterms:title "Hierarchy node rendering: all nodes as expandable `.tree-node`" ;
    rlg:rationale "Any object could have children — rendering all as expandable avoids a sub-query to detect children upfront. If children endpoint returns empty, the expanded area shows \"No children\". Simpler than ASK queries per node." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S02> .

<urn:repolens:sempkm:decision/D036>
    a rlg:Decision ;
    dcterms:identifier "D036" ;
    dcterms:title "Children endpoint as separate route from `tree_children`" ;
    rlg:rationale "`tree_children` queries by `rdf:type`, hierarchy queries by `dcterms:isPartOf` — fundamentally different SPARQL. Separate endpoint avoids overloading the type-children route with mode-conditional logic." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S02> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D037>
    a rlg:Decision ;
    dcterms:identifier "D037" ;
    dcterms:title "Mount mode value encoding in explorer dropdown" ;
    rlg:rationale "Single `<select>` value carries both mode type and mount identity. Avoids hidden inputs or second query param. Parser strips `mount:` prefix to extract UUID." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S03> .

<urn:repolens:sempkm:decision/D038>
    a rlg:Decision ;
    dcterms:identifier "D038" ;
    dcterms:title "Mount handler as prefix match, not EXPLORER_MODES entry" ;
    rlg:rationale "Avoids polluting the static EXPLORER_MODES dict with per-mount entries. Single handler function handles all mounts via mount_id dispatch." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S03> ;
    rlg:governs <urn:repolens:sempkm:part/U> .

<urn:repolens:sempkm:decision/D039>
    a rlg:Decision ;
    dcterms:identifier "D039" ;
    dcterms:title "Dynamic mount dropdown injection timing" ;
    rlg:rationale "Avoids blocking initial page load. Built-in modes work immediately; mount options appear asynchronously. Re-check handles the case where stored mode is a mount that wasn't in the DOM during first restore." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S03> .

<urn:repolens:sempkm:decision/D040>
    a rlg:Decision ;
    dcterms:identifier "D040" ;
    dcterms:title "Separate mount-children endpoint from explorer/children" ;
    rlg:rationale "Mount folder expansion dispatches by VFS strategy (5 strategies × multiple depth levels), fundamentally different from hierarchy `dcterms:isPartOf` queries. Separate endpoint keeps dispatch clean." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S03> .

<urn:repolens:sempkm:decision/D041>
    a rlg:Decision ;
    dcterms:identifier "D041" ;
    dcterms:title "Tag property detection heuristic" ;
    rlg:rationale "Only `bpkm:tags` and `schema:keywords` exist as tag properties. Simple substring match is sufficient and consistent across templates, save path, and SPARQL queries." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S04> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/J> .

<urn:repolens:sempkm:decision/D042>
    a rlg:Decision ;
    dcterms:identifier "D042" ;
    dcterms:title "Multi-property by-tag SPARQL uses UNION, not VFS reuse" ;
    rlg:rationale "VFS functions take single `tag_property` and `scope_filter` params — explorer needs multi-property, unscoped queries. Adapting would be more complex than writing fresh queries following the same pattern." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S04> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D043>
    a rlg:Decision ;
    dcterms:identifier "D043" ;
    dcterms:title "Tag migration as admin endpoint, not startup hook" ;
    rlg:rationale "No existing SPARQL migration infrastructure. Explicit endpoint avoids running migration on every startup. Idempotent — safe to call multiple times." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S04> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D044>
    a rlg:Decision ;
    dcterms:identifier "D044" ;
    dcterms:title "Tag-children as separate endpoint from tree_children and explorer/children" ;
    rlg:rationale "Tag queries use UNION across two properties with string-match FILTER, fundamentally different from type-based tree_children or isPartOf-based explorer/children. Follows D036/D040 pattern of separate endpoints per query shape." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S04> .

<urn:repolens:sempkm:decision/D045>
    a rlg:Decision ;
    dcterms:identifier "D045" ;
    dcterms:title "Favorites router as separate browser sub-module" ;
    rlg:rationale "Follows D014 sub-router pattern. Favorites has its own endpoints (toggle, list) separate from workspace routes. Keeps workspace.py from growing further." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S05> ;
    rlg:governs <urn:repolens:sempkm:part/U> ;
    rlg:governs <urn:repolens:sempkm:part/B> .

<urn:repolens:sempkm:decision/D046>
    a rlg:Decision ;
    dcterms:identifier "D046" ;
    dcterms:title "FAVORITES section position in explorer pane" ;
    rlg:rationale "Favorites are high-traffic shortcuts — placing them above the main object list gives immediate visibility. Follows UX convention for quick-access sections." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S05> .

<urn:repolens:sempkm:decision/D047>
    a rlg:Decision ;
    dcterms:identifier "D047" ;
    dcterms:title "Star icon toggle strategy" ;
    rlg:rationale "Avoids Lucide `createIcons()` re-render timing issues. Simpler DOM manipulation — toggle a class to swap which icon is visible." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S05> .

<urn:repolens:sempkm:decision/D048>
    a rlg:Decision ;
    dcterms:identifier "D048" ;
    dcterms:title "FAVORITES refresh via htmx trigger event" ;
    rlg:rationale "htmx-native pattern for cross-component refresh. Toggle endpoint sets header; since star uses fetch (not htmx), JS dispatches `htmx.trigger(document.body, 'favoritesRefreshed')` after successful toggle." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S05> ;
    rlg:governs <urn:repolens:sempkm:part/E> .

<urn:repolens:sempkm:decision/D049>
    a rlg:Decision ;
    dcterms:identifier "D049" ;
    dcterms:title "Comment soft-delete strategy" ;
    rlg:rationale "Avoids orphaned reply chains. Thread structure stays intact for readers. Simpler than cascade delete or tombstone patterns." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S06> .

<urn:repolens:sempkm:decision/D050>
    a rlg:Decision ;
    dcterms:identifier "D050" ;
    dcterms:title "Comment thread query strategy" ;
    rlg:rationale "RDF4J property paths can't carry metadata (author, timestamp) along the path. Flat query is simple, fast, and lets Python build the tree with full control over ordering and depth capping." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S06> ;
    rlg:governs <urn:repolens:sempkm:part/T> .

<urn:repolens:sempkm:decision/D051>
    a rlg:Decision ;
    dcterms:identifier "D051" ;
    dcterms:title "Comments router as separate browser sub-module" ;
    rlg:rationale "Follows D014/D045 sub-router pattern. Comments have their own CRUD endpoints separate from workspace routes." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S06> ;
    rlg:governs <urn:repolens:sempkm:part/U> ;
    rlg:governs <urn:repolens:sempkm:part/B> .

<urn:repolens:sempkm:decision/D052>
    a rlg:Decision ;
    dcterms:identifier "D052" ;
    dcterms:title "Comments router include order" ;
    rlg:rationale "FastAPI's `:path` parameter in `objects_router` (`/object/{iri:path}`) is greedy and consumes `/comments` suffix, preventing comments endpoints from matching. Must register more-specific routes first." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S06> ;
    rlg:governs <urn:repolens:sempkm:part/A> .

<urn:repolens:sempkm:decision/D053>
    a rlg:Decision ;
    dcterms:identifier "D053" ;
    dcterms:title "Ontology service as separate module" ;
    rlg:rationale "Ontology loading + TBox/ABox/RBox queries are a distinct domain boundary with startup responsibilities. Separate module keeps workspace.py from growing further and follows the domain-module pattern (canvas/, lint/, vfs/)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S07> ;
    rlg:governs <urn:repolens:sempkm:part/U> ;
    rlg:governs <urn:repolens:sempkm:part/O> ;
    rlg:governs <urn:repolens:sempkm:part/LT> ;
    rlg:governs <urn:repolens:sempkm:part/CV> .

<urn:repolens:sempkm:decision/D054>
    a rlg:Decision ;
    dcterms:identifier "D054" ;
    dcterms:title "Gist loading via batched INSERT DATA, not RDF4J REST upload" ;
    rlg:rationale "Avoids adding a new RDF4J REST API method to TriplestoreClient. Batch size of 500 stays well under RDF4J's 2MB request body limit. Transaction-scoped for atomicity. Trade-off: slightly slower than direct Turtle upload but simpler and uses proven patterns." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S07> ;
    rlg:governs <urn:repolens:sempkm:part/T> .

<urn:repolens:sempkm:decision/D055>
    a rlg:Decision ;
    dcterms:identifier "D055" ;
    dcterms:title "Ontology viewer as three-tab htmx layout in special-panel" ;
    rlg:rationale "Simpler than dockview sub-panels. Consistent with how other workspace tabs work (canvas, VFS browser). htmx tab switching avoids JS complexity." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S07> ;
    rlg:governs <urn:repolens:sempkm:part/U> ;
    rlg:governs <urn:repolens:sempkm:part/B> ;
    rlg:governs <urn:repolens:sempkm:part/O> ;
    rlg:governs <urn:repolens:sempkm:part/CV> .

<urn:repolens:sempkm:decision/D056>
    a rlg:Decision ;
    dcterms:identifier "D056" ;
    dcterms:title "TBox label resolution inline via SPARQL COALESCE, not LabelService batch" ;
    rlg:rationale "Gist uses `skos:prefLabel`, model classes use `rdfs:label`. Resolving in-query avoids a second round-trip to LabelService. LabelService.resolve_batch() is still used for ABox instances." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S07> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/L> .

<urn:repolens:sempkm:decision/D057>
    a rlg:Decision ;
    dcterms:identifier "D057" ;
    dcterms:title "ABox shows only types with instances > 0" ;
    rlg:rationale "Gist has ~96 classes; most have zero instances in a typical SemPKM database. Showing all would overwhelm. D024 says gist is \"fully visible\" in TBox — ABox filtering by instance count is about data presence, not schema visibility." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S07> .

<urn:repolens:sempkm:decision/D058>
    a rlg:Decision ;
    dcterms:identifier "D058" ;
    dcterms:title "Ontology router included in browser router coordinator" ;
    rlg:rationale "Same reason as D052: objects_router's `:path` parameter is greedy. Ontology routes use `/ontology/` prefix which would be consumed." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S07> ;
    rlg:governs <urn:repolens:sempkm:part/B> ;
    rlg:governs <urn:repolens:sempkm:part/O> .

<urn:repolens:sempkm:decision/D059>
    a rlg:Decision ;
    dcterms:identifier "D059" ;
    dcterms:title "User class IRI minting with UUID suffix" ;
    rlg:rationale "Prevents IRI collision when multiple users create classes with the same name. Slug provides readability; UUID provides uniqueness. 8-hex-char prefix gives ~4 billion combinations — sufficient for user-created types." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S08> .

<urn:repolens:sempkm:decision/D060>
    a rlg:Decision ;
    dcterms:identifier "D060" ;
    dcterms:title "No EventStore for class/shape creation" ;
    rlg:rationale "Class creation is schema modification, not data modification. EventStore is for object-level operations. Consistent with how gist and ontology triples are loaded (D054)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S08> ;
    rlg:governs <urn:repolens:sempkm:part/O> .

<urn:repolens:sempkm:decision/D061>
    a rlg:Decision ;
    dcterms:identifier "D061" ;
    dcterms:title "IconService user-type icon resolution via triplestore triples" ;
    rlg:rationale "IconService is filesystem-only (manifest.yaml). User types have no filesystem manifest. Storing icon metadata as RDF triples is consistent with the RDF-first architecture and avoids introducing a separate JSON/YAML file for user types." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S08> ;
    rlg:governs <urn:repolens:sempkm:part/T> .

<urn:repolens:sempkm:decision/D062>
    a rlg:Decision ;
    dcterms:identifier "D062" ;
    dcterms:title "Class deletion as DELETE WHERE, create-only scope expanded to include delete" ;
    rlg:rationale "D028 scopes S08 as create-only, but without delete there's no recovery from broken classes. Delete is a single SPARQL operation, low effort, high value. Does not include edit (TYPE-03 scope)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S08> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D063>
    a rlg:Decision ;
    dcterms:identifier "D063" ;
    dcterms:title "htmx form data serialization: use config-request not before-request" ;
    rlg:rationale "htmx seals form parameters before `htmx:beforeRequest` fires. Hidden input values updated by JS during `beforeRequest` are not included in the request. `configRequest` fires during parameter collection phase, allowing explicit parameter injection." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S08> .

<urn:repolens:sempkm:decision/D064>
    a rlg:Decision ;
    dcterms:identifier "D064" ;
    dcterms:title "Shape delete uses two separate SPARQL UPDATE calls" ;
    rlg:rationale "RDF4J rejects `OPTIONAL` inside `DELETE WHERE` (returns 400). Semicolon-separated updates in a single call also fail. Two sequential calls are reliable and equivalent." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S08> ;
    rlg:governs <urn:repolens:sempkm:part/T> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D065>
    a rlg:Decision ;
    dcterms:identifier "D065" ;
    dcterms:title "Chart.js 4.x via CDN, per-page only" ;
    rlg:rationale "Research recommendation. Battle-tested, ~60KB gzipped, supports sparkline + bar chart. No global loading — only admin model detail page needs it." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S09> .

<urn:repolens:sempkm:decision/D066>
    a rlg:Decision ;
    dcterms:identifier "D066" ;
    dcterms:title "Lazy chart init on flip transitionend" ;
    rlg:rationale "Chart.js reads canvas dimensions on init. Canvas inside `display:none` (face-hidden) has 0×0 dimensions → empty charts. Lazy init after flip ensures canvas is visible." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S09> ;
    rlg:governs <urn:repolens:sempkm:part/CV> .

<urn:repolens:sempkm:decision/D067>
    a rlg:Decision ;
    dcterms:identifier "D067" ;
    dcterms:title "Link distribution buckets: 0, 1-2, 3-5, 6-10, 11+" ;
    rlg:rationale "Covers the typical power-law distribution of knowledge graph connectivity. Simple to compute in SPARQL with CASE/BIND. Readable in a small bar chart." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S09> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D068>
    a rlg:Decision ;
    dcterms:identifier "D068" ;
    dcterms:title "Growth trend window: 8 weeks" ;
    rlg:rationale "Balances sparkline readability (8 data points) with query performance (tight time bound avoids full event scan)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S09> ;
    rlg:governs <urn:repolens:sempkm:part/E> .

<urn:repolens:sempkm:decision/D069>
    a rlg:Decision ;
    dcterms:identifier "D069" ;
    dcterms:title "Rate-limit e2e tests run last via 99- directory prefix" ;
    rlg:rationale "Rate-limit tests exhaust the per-IP endpoint budget (slowapi in-memory), breaking auth fixtures in subsequent tests. Moving to 99- ensures Playwright's alphabetical ordering runs them after all auth-dependent tests." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M003/S10> ;
    rlg:governs <urn:repolens:sempkm:part/G> ;
    rlg:governs <urn:repolens:sempkm:part/ET> .

<urn:repolens:sempkm:decision/D070>
    a rlg:Decision ;
    dcterms:identifier "D070" ;
    dcterms:title "Two-step class delete confirmation via check endpoint" ;
    rlg:rationale "`hx-confirm` uses browser-native `window.confirm()` which cannot show dynamic content. Two-step pattern follows existing modal conventions (class creation, property creation, class edit)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M004/S02> ;
    rlg:governs <urn:repolens:sempkm:part/B> .

<urn:repolens:sempkm:decision/D071>
    a rlg:Decision ;
    dcterms:identifier "D071" ;
    dcterms:title "`_property_source` returns `'user'` for user-types IRIs" ;
    rlg:rationale "Fixes RBox badge showing \"sempkm\" instead of \"user\" for user-created properties. IRI prefix ordering matters since user-types IRIs also start with `urn:sempkm:`." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M004/S02> .

<urn:repolens:sempkm:decision/D072>
    a rlg:Decision ;
    dcterms:identifier "D072" ;
    dcterms:title "Property deletion: simple `hx-confirm`, no modal" ;
    rlg:rationale "Avoids over-engineering. Class deletion needs dynamic counts; property deletion doesn't." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M004/S02> .

<urn:repolens:sempkm:decision/D073>
    a rlg:Decision ;
    dcterms:identifier "D073" ;
    dcterms:title "Property type immutable on edit" ;
    rlg:rationale "Switching between ObjectProperty and DatatypeProperty changes IRI semantics and breaks SHACL shapes that reference the property. Safer to require delete + re-create." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M004/S03> ;
    rlg:governs <urn:repolens:sempkm:part/H> .

<urn:repolens:sempkm:decision/D074>
    a rlg:Decision ;
    dcterms:identifier "D074" ;
    dcterms:title "Custom section server-rendered in admin_models(), not htmx lazy-load" ;
    rlg:rationale "The `list_user_types()` query hits a single small graph (<100ms). Lazy-load adds unnecessary complexity." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M004/S03> .

<urn:repolens:sempkm:decision/D075>
    a rlg:Decision ;
    dcterms:identifier "D075" ;
    dcterms:title "SHACL shapes NOT updated on property edit" ;
    rlg:rationale "SHACL shapes reference properties by IRI via `sh:path`. Domain/range are OWL-level constraints, not SHACL-level. Acceptable because shapes still point to the correct IRI." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M004/S03> ;
    rlg:governs <urn:repolens:sempkm:part/H> .

<urn:repolens:sempkm:decision/D076>
    a rlg:Decision ;
    dcterms:identifier "D076" ;
    dcterms:title "Edit property form uses `epf-` ID prefix" ;
    rlg:rationale "Both forms can coexist in the DOM (ontology page has both modals). ID collision would break JS handlers." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M004/S03> ;
    rlg:governs <urn:repolens:sempkm:part/O> .

<urn:repolens:sempkm:decision/D077>
    a rlg:Decision ;
    dcterms:identifier "D077" ;
    dcterms:title "Pre-commit hook rejects conflict markers" ;
    rlg:rationale "17 consecutive squash merges (M002/S03–M005/S01) committed conflict markers to main undetected. Docker volume mounts hid the damage by serving clean branch code. Pre-commit hook is the last line of defense." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/process> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M005> .

<urn:repolens:sempkm:decision/D078>
    a rlg:Decision ;
    dcterms:identifier "D078" ;
    dcterms:title "Migrations volume-mounted in docker-compose.yml" ;
    rlg:rationale "Without this mount, migration file edits required a full `docker compose build api`. Consistent with how `./backend/app` is already mounted. Discovered when conflict-marker fix in `env.py` wasn't picked up by the running container." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/infra> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M005> .

<urn:repolens:sempkm:decision/D079>
    a rlg:Decision ;
    dcterms:identifier "D079" ;
    dcterms:title "Ops log calls in router layer, not service layer" ;
    rlg:rationale "Router layer already has user context from `require_role()`. Threading user IRIs through service methods would change signatures and create coupling. Consistent with how `EventStore.commit()` receives `performed_by` from routers." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M005/S02> ;
    rlg:governs <urn:repolens:sempkm:part/B> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D080>
    a rlg:Decision ;
    dcterms:identifier "D080" ;
    dcterms:title "Ops log uses direct SPARQL INSERT DATA, not EventStore" ;
    rlg:rationale "Ops log records metadata _about_ operations, not data belonging in `urn:sempkm:current`. Same pattern as `QueryService` writes to `urn:sempkm:queries`. EventStore would create per-event graphs and materialize into current — wrong semantics." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M005/S02> ;
    rlg:governs <urn:repolens:sempkm:part/E> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D081>
    a rlg:Decision ;
    dcterms:identifier "D081" ;
    dcterms:title "Single `urn:sempkm:ops-log` named graph for all entries" ;
    rlg:rationale "Matches `urn:sempkm:queries` pattern from S01. Log entries are simple metadata — no data isolation needed. Single graph simplifies querying. Low volume (10-50 entries/day max)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M005/S02> .

<urn:repolens:sempkm:decision/D082>
    a rlg:Decision ;
    dcterms:identifier "D082" ;
    dcterms:title "Ops log calls are fire-and-forget with try/except" ;
    rlg:rationale "Ops log is observability tooling. A triplestore write failure during model install must not prevent the install from succeeding. Same philosophy as webhook dispatch." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M005/S02> ;
    rlg:governs <urn:repolens:sempkm:part/T> .

<urn:repolens:sempkm:decision/D083>
    a rlg:Decision ;
    dcterms:identifier "D083" ;
    dcterms:title "htmx target-aware block rendering for ops log route" ;
    rlg:rationale "Single endpoint serves three use cases (full page, sidebar nav, filter/pagination). Without target detection, returning `content` block for filter swaps caused duplicate heading/controls inside `#ops-log-table`." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M005/S02> .

<urn:repolens:sempkm:decision/D084>
    a rlg:Decision ;
    dcterms:identifier "D084" ;
    dcterms:title "Hierarchical tag tree: fetch flat, nest in Python, lazy-load children" ;
    rlg:rationale "Reuses existing SPARQL (no new string functions for roots), uses `STRSTARTS` for children (well-supported), pure function is unit-testable without Docker. Follows proven htmx lazy-load pattern (D035, D036, D040, D044)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M005/S03> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D085>
    a rlg:Decision ;
    dcterms:identifier "D085" ;
    dcterms:title "`tag_children` endpoint extended with `prefix` parameter, not new endpoint" ;
    rlg:rationale "Existing endpoint already handles tag expansion. Prefix queries are the same domain — sub-folder expansion is conceptually \"children of a tag prefix\". `tag` param = exact match objects, `prefix` param = sub-folder tree. Avoids endpoint proliferation while staying clean." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M005/S03> .

<urn:repolens:sempkm:decision/D086>
    a rlg:Decision ;
    dcterms:identifier "D086" ;
    dcterms:title "`build_tag_tree()` as separate module, not inline in workspace.py" ;
    rlg:rationale "workspace.py is already 1063 lines. Pure function has no dependencies on FastAPI/triplestore — separate module keeps it testable and workspace.py from growing." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M005/S03> ;
    rlg:governs <urn:repolens:sempkm:part/U> ;
    rlg:governs <urn:repolens:sempkm:part/A> ;
    rlg:governs <urn:repolens:sempkm:part/T> .

<urn:repolens:sempkm:decision/D087>
    a rlg:Decision ;
    dcterms:identifier "D087" ;
    dcterms:title "Tag autocomplete q parameter via htmx:configRequest, not hx-vals" ;
    rlg:rationale "`hx-vals='js:{\"q\": this.value}'` did not reliably pass the `q` query parameter on htmx GET requests — requests were sent without `q`, returning all tags unfiltered. `htmx:configRequest` fires during parameter collection and allows explicit injection." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M005/S04> .

<urn:repolens:sempkm:decision/D088>
    a rlg:Decision ;
    dcterms:identifier "D088" ;
    dcterms:title "Refresh clears 4 artifact graphs inline, not via `clear_model_graphs()`" ;
    rlg:rationale "`clear_model_graphs()` clears all 5 graphs including seed. Refresh must NOT touch seed (user data). Adding an `exclude` parameter would change the function signature for one caller. Inline CLEAR is simpler and explicit." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M005/S05> .

<urn:repolens:sempkm:decision/D089>
    a rlg:Decision ;
    dcterms:identifier "D089" ;
    dcterms:title "Refresh uses hx-confirm, not two-step modal" ;
    rlg:rationale "Refresh is non-destructive (transactional — rollback on failure). Lower risk than delete. Two-step modal (D070) is for operations with permanent data loss potential." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M005/S05> .

<urn:repolens:sempkm:decision/D090>
    a rlg:Decision ;
    dcterms:identifier "D090" ;
    dcterms:title "PROV-O Starting Point terms only — no Qualified or Extended" ;
    rlg:rationale "Qualified terms add blank nodes and multi-triple patterns for marginal information gain. Starting Point covers 90%+ of SemPKM's provenance needs. Ops log already validates this approach." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M005/S06> .

<urn:repolens:sempkm:decision/D091>
    a rlg:Decision ;
    dcterms:identifier "D091" ;
    dcterms:title "Existing event graphs retain sempkm: predicates forever — no retroactive migration" ;
    rlg:rationale "Event-sourcing requires immutable events. Federation sync transmits events as serialized patches — changing predicates would desynchronize instances. Dual-write + COALESCE queries handle mixed-era data without rewriting history." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M005/S06> ;
    rlg:governs <urn:repolens:sempkm:part/E> ;
    rlg:governs <urn:repolens:sempkm:part/F> .

<urn:repolens:sempkm:decision/D092>
    a rlg:Decision ;
    dcterms:identifier "D092" ;
    dcterms:title "COALESCE pattern for dual-predicate SPARQL queries (over UNION or VALUES)" ;
    rlg:rationale "VALUES creates cross-products on dual-write events. UNION requires deduplication. COALESCE with OPTIONAL is clean, single-row-per-event, and performs well on most triplestores." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M005/S06> ;
    rlg:governs <urn:repolens:sempkm:part/E> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D093>
    a rlg:Decision ;
    dcterms:identifier "D093" ;
    dcterms:title "Generic views registered in-memory at startup, not as RDF" ;
    rlg:rationale "Avoids a \"system views\" named graph. Generic views are code-defined behavior, not data-defined. Simpler lifecycle — no migration needed for view definition changes." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M005/S07> ;
    rlg:governs <urn:repolens:sempkm:part/V> .

<urn:repolens:sempkm:decision/D094>
    a rlg:Decision ;
    dcterms:identifier "D094" ;
    dcterms:title "SHACL shapes via ShapesService as column discovery source" ;
    rlg:rationale "Already extracts sh:path, sh:name, sh:order — everything needed for dynamic columns. Fallback to default column set (label, type, created, modified) for types with ≤2 properties." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M005/S07> ;
    rlg:governs <urn:repolens:sempkm:part/L> ;
    rlg:governs <urn:repolens:sempkm:part/H> .

<urn:repolens:sempkm:decision/D095>
    a rlg:Decision ;
    dcterms:identifier "D095" ;
    dcterms:title "Type filter pills for cross-type generic views" ;
    rlg:rationale "Carousel assumes single target_class. Dropdown hides available types. Pills show all types at a glance with active state. Consistent with tag pill UX pattern." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M005/S07> ;
    rlg:governs <urn:repolens:sempkm:part/V> .

<urn:repolens:sempkm:decision/D096>
    a rlg:Decision ;
    dcterms:identifier "D096" ;
    dcterms:title "sempkm:scopeQuery for view-to-query scope binding" ;
    rlg:rationale "Extends existing promoted view pattern. scopeQuery injects VALUES clause or subquery to limit view results to query output IRIs. Clean separation of concerns." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M005/S07> .

<urn:repolens:sempkm:decision/D097>
    a rlg:Decision ;
    dcterms:identifier "D097" ;
    dcterms:title "3-phase views migration, additive-first" ;
    rlg:rationale "No big-bang. Phase 1 is strictly additive — zero risk to existing views. Phase 2 changes navigation only. Phase 3 is dead code removal." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/process> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M005/S07> ;
    rlg:governs <urn:repolens:sempkm:part/V> .

<urn:repolens:sempkm:decision/D098>
    a rlg:Decision ;
    dcterms:identifier "D098" ;
    dcterms:title "Direct SPARQL via SyncTriplestoreClient for VFS saved query resolution" ;
    rlg:rationale "WebDAV runs in sync WSGI context. `QueryService` is async (uses `httpx.AsyncClient`). Calling async from sync would require `asyncio.run()` or thread bridging — fragile in production. `SyncTriplestoreClient` already used by VFS provider code." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M005/S08> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/CX> ;
    rlg:governs <urn:repolens:sempkm:part/VF> .

<urn:repolens:sempkm:decision/D099>
    a rlg:Decision ;
    dcterms:identifier "D099" ;
    dcterms:title "VFS adopts `sempkm:scopeQuery` with full IRI (aligning with Views Rethink)" ;
    rlg:rationale "Matches Views Rethink D096 pattern. Full IRI enables SPARQL joins without string manipulation. One predicate used by both views and VFS for scope binding. Migration: one SPARQL UPDATE renames predicate + wraps values." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M005/S08> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/V> .

<urn:repolens:sempkm:decision/D100>
    a rlg:Decision ;
    dcterms:identifier "D100" ;
    dcterms:title "Chain model (Option A) for composable VFS strategies, max depth 3" ;
    rlg:rationale "Chain is simpler than tree or graph composition. 3 levels covers all practical use cases (e.g. by-tag → by-type → flat). Provider path dispatch needs extension from 4 to 6 segments." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M005/S08> .

<urn:repolens:sempkm:decision/D101>
    a rlg:Decision ;
    dcterms:identifier "D101" ;
    dcterms:title "type_filter AND saved_query compose via AND" ;
    rlg:rationale "AND semantics match user mental model: \"show me Notes (type) from this query (scope)\". OR would produce confusing results. Implementation: both clauses injected into the same WHERE block." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M005/S08> .

<urn:repolens:sempkm:decision/D102>
    a rlg:Decision ;
    dcterms:identifier "D102" ;
    dcterms:title "Defer auto-refresh for VFS, use existing 30s TTLCache" ;
    rlg:rationale "Auto-refresh adds complexity (filesystem watchers, WebSocket push) for marginal benefit. 30s TTL means changes appear within half a minute. Revisit when write-support lands." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M005/S08> .

<urn:repolens:sempkm:decision/D103>
    a rlg:Decision ;
    dcterms:identifier "D103" ;
    dcterms:title "Dashboard builder submits via fetch(), not htmx form" ;
    rlg:rationale "JSON API expects structured `{name, layout, blocks}` body. htmx form submission sends form-encoded data which doesn't map cleanly to nested JSON. `fetch()` also allows JS-side payload construction from dynamic block rows. Same pattern as VFS mount form." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M006/S04> ;
    rlg:governs <urn:repolens:sempkm:part/DS> .

<urn:repolens:sempkm:decision/D104>
    a rlg:Decision ;
    dcterms:identifier "D104" ;
    dcterms:title "Explorer refresh via JS-dispatched htmx trigger, not HX-Trigger header" ;
    rlg:rationale "JSON API endpoints return JSON, not HTML. `HX-Trigger` response header only works with htmx-initiated requests. Since builder uses `fetch()`, JS must dispatch the event manually. Follows D048 pattern (favorites)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M006/S04> ;
    rlg:governs <urn:repolens:sempkm:part/E> .

<urn:repolens:sempkm:decision/D105>
    a rlg:Decision ;
    dcterms:identifier "D105" ;
    dcterms:title "Single implicit IRI context variable per dashboard, not Retool-style named variables" ;
    rlg:rationale "Simplest viable approach. Single IRI covers primary use case (select project → filter notes). Multiple named variables can layer on later without breaking the single-IRI API." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M006/S05> ;
    rlg:governs <urn:repolens:sempkm:part/DS> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D106>
    a rlg:Decision ;
    dcterms:identifier "D106" ;
    dcterms:title "htmx:configRequest for context_iri URL injection, not hx-vals" ;
    rlg:rationale "`hx-vals` with `js:` prefix is unreliable for dynamic values in this codebase (see D087). `htmx:configRequest` fires during parameter collection and allows explicit injection. Proven pattern from tag autocomplete." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M006/S05> .

<urn:repolens:sempkm:decision/D107>
    a rlg:Decision ;
    dcterms:identifier "D107" ;
    dcterms:title "Context emission limited to table renderer for v1" ;
    rlg:rationale "Table is the primary use case. Card clicks trigger flip, not selection. Graph node clicks need Cytoscape event listeners — separate concern. Both can be added later without changing the event contract." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M006/S05> ;
    rlg:governs <urn:repolens:sempkm:part/E> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D108>
    a rlg:Decision ;
    dcterms:identifier "D108" ;
    dcterms:title "dashboard_mode query parameter for conditional row behavior" ;
    rlg:rationale "Clean separation: same template renders correctly in both dashboard-embedded and standalone contexts. No global state or CSS class sniffing. Passed from render_block through the view URL." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M006/S05> ;
    rlg:governs <urn:repolens:sempkm:part/DS> .

<urn:repolens:sempkm:decision/D109>
    a rlg:Decision ;
    dcterms:identifier "D109" ;
    dcterms:title "Dashboard context event uses camelCase, not colon-namespaced" ;
    rlg:rationale "htmx's hx-trigger parser uses colons as modifier separators (like `from:body`). Custom event names containing colons fail to register as trigger listeners. camelCase matches existing codebase pattern (dashboardsRefreshed, favoritesRefreshed)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M006/S05/T02> ;
    rlg:governs <urn:repolens:sempkm:part/E> ;
    rlg:governs <urn:repolens:sempkm:part/DS> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D110>
    a rlg:Decision ;
    dcterms:identifier "D110" ;
    dcterms:title "Context params forwarded server-side in render_block, not purely client-side" ;
    rlg:rationale "htmx:configRequest on nested elements (inner view div inside slot div) causes duplicate parameter injection. Server-side forwarding gives clean, single-injection chain: configRequest on slot → render_block → view URL." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M006/S05/T02> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D111>
    a rlg:Decision ;
    dcterms:identifier "D111" ;
    dcterms:title "Default SELECT query uses mandatory rdf:type binding" ;
    rlg:rationale "All-OPTIONAL patterns left `?s` unbound — SPARQL engines return zero rows because there's no triple pattern to ground the subject variable. Making type mandatory ensures subjects have at least one typed assertion." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M007/S01/T02> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D112>
    a rlg:Decision ;
    dcterms:identifier "D112" ;
    dcterms:title "Generic graph view uses separate data endpoint" ;
    rlg:rationale "Generic specs have empty `sparql_query` — queries are built dynamically per request. The existing data endpoint calls `execute_graph_query(spec)` which returns empty when `spec.sparql_query` is empty. Separate endpoint keeps both paths clean." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M007/S01/T02> .

<urn:repolens:sempkm:decision/D113>
    a rlg:Decision ;
    dcterms:identifier "D113" ;
    dcterms:title "pagination_base_url template variable for URL construction" ;
    rlg:rationale "default(old_pattern)`" ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/pattern> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M007/S01/T02> .

<urn:repolens:sempkm:decision/D114>
    a rlg:Decision ;
    dcterms:identifier "D114" ;
    dcterms:title "Generic view tabs use special-panel dockview component, not view-panel" ;
    rlg:rationale "Generic views don't have a spec IRI — `view-panel`'s URL construction assumes `/{renderer}/{encoded_iri}` which doesn't fit. `special-panel` pattern already proven by canvas, ontology, dashboard, and workflow tabs." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M007/S01/T04> ;
    rlg:governs <urn:repolens:sempkm:part/O> ;
    rlg:governs <urn:repolens:sempkm:part/V> ;
    rlg:governs <urn:repolens:sempkm:part/CV> ;
    rlg:governs <urn:repolens:sempkm:part/DS> .

<urn:repolens:sempkm:decision/D115>
    a rlg:Decision ;
    dcterms:identifier "D115" ;
    dcterms:title "Saved Views replaces MY VIEWS as htmx lazy-loaded folder inside VIEWS section" ;
    rlg:rationale "Removes a sidebar section. `/browser/my-views` endpoint stays unchanged. `#my-views-tree` → `#saved-views-tree` ID update in `my_views.html` and `sparql-console.js`." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M007/S01/T04> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/B> ;
    rlg:governs <urn:repolens:sempkm:part/V> .

<urn:repolens:sempkm:decision/D116>
    a rlg:Decision ;
    dcterms:identifier "D116" ;
    dcterms:title "type_filter VALUES uses ?iri a ?type binding" ;
    rlg:rationale "Connects the VALUES constraint to the object pattern via rdf:type triple. Empty list treated same as None (no-op)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M007/S02/T01> .

<urn:repolens:sempkm:decision/D117>
    a rlg:Decision ;
    dcterms:identifier "D117" ;
    dcterms:title "scope_query stores full IRI, not bare UUID" ;
    rlg:rationale "Enables SPARQL joins without string manipulation. Frontend constructs IRI by prefixing `urn:sempkm:query:` to UUID. Aligns with D099." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M007/S02/T02> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D118>
    a rlg:Decision ;
    dcterms:identifier "D118" ;
    dcterms:title "Two-query approach for list_mounts type_filter" ;
    rlg:rationale "More portable across SPARQL 1.1 stores than GROUP_CONCAT subquery. GROUP_CONCAT used for single-resource queries (get_by_id, get_by_prefix) where it's safe." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M007/S02/T04> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D119>
    a rlg:Decision ;
    dcterms:identifier "D119" ;
    dcterms:title "Preview returns HTTP 404 for unresolvable scope_query" ;
    rlg:rationale "Dead code previously produced empty scope_filter regardless of input. 404 makes the failure visible to API callers. WebDAV path silently omits scope (warning logged) since crashing a directory listing is worse." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M007/S02/T03> ;
    rlg:governs <urn:repolens:sempkm:part/VF> .

<urn:repolens:sempkm:decision/D120>
    a rlg:Decision ;
    dcterms:identifier "D120" ;
    dcterms:title "Chain strategies stored as pipe-delimited string literal" ;
    rlg:rationale "by-date\"` stored as single string via `sempkm:directoryStrategy`" ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M007/S03> .

<urn:repolens:sempkm:decision/D121>
    a rlg:Decision ;
    dcterms:identifier "D121" ;
    dcterms:title "Chain scope narrowing is cumulative across all parent levels" ;
    rlg:rationale "Objects at depth 2 must match both depth-0 and depth-1 groupings. Prevents leaked results from sibling branches. Narrowing filters composed as additional WHERE clause fragments via `build_chain_narrowing_filter()`." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M007/S03> .

<urn:repolens:sempkm:decision/D122>
    a rlg:Decision ;
    dcterms:identifier "D122" ;
    dcterms:title "Filename template expansion before slugification" ;
    rlg:rationale "Preserves filesystem safety. `{date}-{title}` → `\"2024-01-15-My Note\"` → `\"2024-01-15-my-note\"`. Dedup suffix applies after slugification as before." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M007/S03> .

<urn:repolens:sempkm:decision/D123>
    a rlg:Decision ;
    dcterms:identifier "D123" ;
    dcterms:title "Chain by-type narrowing uses SPARQL local name FILTER, not pre-resolved IRI" ;
    rlg:rationale "`build_chain_narrowing_filter()` is a pure function without triplestore access. Resolving type label→IRI requires a SPARQL query (done in StrategyFolderCollection._resolve_type_iri_from_label). The FILTER approach works at query time and avoids coupling the narrowing helper to the sync client." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M007/S03/T02> ;
    rlg:governs <urn:repolens:sempkm:part/T> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/L> .

<urn:repolens:sempkm:decision/D124>
    a rlg:Decision ;
    dcterms:identifier "D124" ;
    dcterms:title "Dual-layer rendering for embed nodes" ;
    rlg:rationale "`renderNodes()` rebuilds `state.layer.innerHTML` every drag frame. Iframes recreated via innerHTML lose their loaded page state. Dual-layer avoids this: embed nodes are created/moved via `style.left`/`style.top` updates, never innerHTML-rebuilt." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M008> .

<urn:repolens:sempkm:decision/D125>
    a rlg:Decision ;
    dcterms:identifier "D125" ;
    dcterms:title "Separate `base_embed.html` template for iframe content" ;
    rlg:rationale "`base.html` loads 15+ CDN scripts (Cytoscape, dockview, CodeMirror, etc.) and the sidebar. Embed pages need only htmx + theme CSS + content. Separate template avoids iframe payload bloat and fragility of hiding elements in a shared template." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M008> .

<urn:repolens:sempkm:decision/D126>
    a rlg:Decision ;
    dcterms:identifier "D126" ;
    dcterms:title "Property flip uses inline rendering, not iframes" ;
    rlg:rationale "SHACL-derived property data is lightweight (10-30 key/value pairs). Inline rendering is faster, lighter, and avoids iframe overhead for the most common flip action. Only views/dashboards/SPARQL/object-read use iframe embeds." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M008> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/V> .

<urn:repolens:sempkm:decision/D127>
    a rlg:Decision ;
    dcterms:identifier "D127" ;
    dcterms:title "CSS resize handles over native CSS `resize: both`" ;
    rlg:rationale "CSS `resize: both` only provides a bottom-right handle, doesn't emit events for state persistence, and can't enforce min/max constraints. Custom handles provide better UX and integrate with the existing pointer event system." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M008> ;
    rlg:governs <urn:repolens:sempkm:part/E> .

<urn:repolens:sempkm:decision/D128>
    a rlg:Decision ;
    dcterms:identifier "D128" ;
    dcterms:title "Max 8 simultaneous iframe embeds, hard limit" ;
    rlg:rationale "Each iframe is a full page load. 5+ embeds measurably impacts performance. Hard limit for v1 prevents browser tab crashes. Lazy loading deferred to follow-up." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M008> ;
    rlg:governs <urn:repolens:sempkm:part/B> .

<urn:repolens:sempkm:decision/D129>
    a rlg:Decision ;
    dcterms:identifier "D129" ;
    dcterms:title "Embed link routing via `window.parent`" ;
    rlg:rationale "Same-origin iframes can access parent window. This routes clicks to dockview tabs in the main workspace instead of navigating the iframe away from embedded content." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M008> ;
    rlg:governs <urn:repolens:sempkm:part/U> .

<urn:repolens:sempkm:decision/D130>
    a rlg:Decision ;
    dcterms:identifier "D130" ;
    dcterms:title "Resize updates inline style during drag, full renderNodes on pointerUp" ;
    rlg:rationale "`renderNodes()` rebuilds `state.layer.innerHTML` on every call. Calling it on every resize frame would be expensive and cause visual flicker (SVG edges rebuilt). Direct style manipulation during drag is smooth; final `renderNodes()` ensures edges re-calculate from final box dimensions." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M008/S01> .

<urn:repolens:sempkm:decision/D131>
    a rlg:Decision ;
    dcterms:identifier "D131" ;
    dcterms:title "Property cache is memory-only, not serialized" ;
    rlg:rationale "Serializing property data would bloat canvas session JSON and stale quickly. Re-fetching on load ensures fresh data. Follows the `fetchNodeBody` pattern where markdown is also re-fetched." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M008/S02> ;
    rlg:governs <urn:repolens:sempkm:part/L> ;
    rlg:governs <urn:repolens:sempkm:part/CV> .

<urn:repolens:sempkm:decision/D132>
    a rlg:Decision ;
    dcterms:identifier "D132" ;
    dcterms:title "`build_property_list()` extracted as pure function" ;
    rlg:rationale "Enables 26 unit tests with zero mocking — all inputs are plain dicts/lists. Endpoint handler orchestrates async calls then delegates to pure function. Pattern reusable for future canvas data transformations." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M008/S02> ;
    rlg:governs <urn:repolens:sempkm:part/CV> .

<urn:repolens:sempkm:decision/D133>
    a rlg:Decision ;
    dcterms:identifier "D133" ;
    dcterms:title "New `GET /browser/sparql-result/{query_id}` endpoint for server-rendered query results" ;
    rlg:rationale "Existing SPARQL console renders results client-side (CodeMirror + custom JS). No server-rendered endpoint exists for saved query output. Embeds need an HTML page, not a JS-rendered SPA. Reuses existing query execution helpers." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M008/S03> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/B> ;
    rlg:governs <urn:repolens:sempkm:part/ET> .

<urn:repolens:sempkm:decision/D134>
    a rlg:Decision ;
    dcterms:identifier "D134" ;
    dcterms:title "Embed layer uses `pointer-events: none` with `auto` on individual embeds" ;
    rlg:rationale "Lets clicks pass through empty areas of the embed layer to reach regular nodes on the layer below. Without this, the embed layer's higher DOM position would intercept all pointer events over the canvas." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M008/S03> ;
    rlg:governs <urn:repolens:sempkm:part/E> ;
    rlg:governs <urn:repolens:sempkm:part/CV> .

<urn:repolens:sempkm:decision/D135>
    a rlg:Decision ;
    dcterms:identifier "D135" ;
    dcterms:title "Fragment-to-string rendering for embed wrapping" ;
    rlg:rationale "Jinja2 `{% include inner_template %}` with a variable template name has scoping issues and requires the template name to be a string constant in some Jinja2 configurations. Rendering to string first is simpler, works with any fragment template, and the embed wrapper just needs `{{ content" ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M008/S03-T01> .

<urn:repolens:sempkm:decision/D136>
    a rlg:Decision ;
    dcterms:identifier "D136" ;
    dcterms:title "SPARQL result router registered as browser sub-module before objects_router" ;
    rlg:rationale "The objects_router has `{object_iri:path}` catch-all patterns that would consume `/sparql-result/*` URLs. Registration order in FastAPI determines route matching priority. Same pattern as ontology_router and comments_router." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M008/S03-T01> ;
    rlg:governs <urn:repolens:sempkm:part/A> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/B> .

<urn:repolens:sempkm:decision/D137>
    a rlg:Decision ;
    dcterms:identifier "D137" ;
    dcterms:title "Dual-layer rendering: regular nodes via innerHTML, embeds via persistent DOM" ;
    rlg:rationale "iframes lose their loaded state when recreated via innerHTML. Persistent DOM for embeds means the iframe never gets destroyed during regular node interactions. Orphan cleanup runs each render to remove stale embed elements. Embed layer applies same CSS transform as regular layer for pan/zoom sync." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M008/S03-T02> .

<urn:repolens:sempkm:decision/D138>
    a rlg:Decision ;
    dcterms:identifier "D138" ;
    dcterms:title "Apps as sandboxed subprocesses, not in-process or Docker containers" ;
    rlg:rationale "Subprocess gives dependency isolation and crash isolation without Docker-in-Docker complexity. HTTP/UDS is debuggable with standard tooling. In-process would allow apps to crash the platform; Docker containers add networking/orchestration overhead." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M009> ;
    rlg:governs <urn:repolens:sempkm:part/P> .

<urn:repolens:sempkm:decision/D139>
    a rlg:Decision ;
    dcterms:identifier "D139" ;
    dcterms:title "Mental models are always shared — apps never bundle their own model" ;
    rlg:rationale "Composability: multiple apps can share the same model. Independent versioning prevents tight coupling. Data survives app removal." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M009> ;
    rlg:governs <urn:repolens:sempkm:part/P> .

<urn:repolens:sempkm:decision/D140>
    a rlg:Decision ;
    dcterms:identifier "D140" ;
    dcterms:title "App data lives in urn:sempkm:current, not a separate graph" ;
    rlg:rationale "Separate graphs would fragment the knowledge graph. Shared graph means articles are as queryable as user-created notes. IRI prefix enables clean uninstall." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M009> .

<urn:repolens:sempkm:decision/D141>
    a rlg:Decision ;
    dcterms:identifier "D141" ;
    dcterms:title "Platform owns scheduling — apps declare tasks, platform runs them" ;
    rlg:rationale "Centralized control prevents rogue apps from overwhelming the system. Admin can pause all tasks. Consistent monitoring surface." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M009> ;
    rlg:governs <urn:repolens:sempkm:part/P> .

<urn:repolens:sempkm:decision/D142>
    a rlg:Decision ;
    dcterms:identifier "D142" ;
    dcterms:title "All app UI is fragments — platform controls the page shell" ;
    rlg:rationale "Consistent UX, theme compliance, no iframe overhead. Apps can't hijack navigation or break workspace layout." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M009> ;
    rlg:governs <urn:repolens:sempkm:part/U> ;
    rlg:governs <urn:repolens:sempkm:part/P> .

<urn:repolens:sempkm:decision/D143>
    a rlg:Decision ;
    dcterms:identifier "D143" ;
    dcterms:title "App SDK as in-repo package, not published to PyPI" ;
    rlg:rationale "Simpler development loop. SDK and platform evolve together. No package publishing infrastructure needed for v1." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M009> .

<urn:repolens:sempkm:decision/D144>
    a rlg:Decision ;
    dcterms:identifier "D144" ;
    dcterms:title "browserVisible field on Mental Model types (default true)" ;
    rlg:rationale "Apps create internal bookkeeping types (ReadActivity, sync cursors) that clutter the object browser. Hiding them improves UX without losing data access. Backward compatible (default true)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M009> ;
    rlg:governs <urn:repolens:sempkm:part/B> ;
    rlg:governs <urn:repolens:sempkm:part/P> .

<urn:repolens:sempkm:decision/D145>
    a rlg:Decision ;
    dcterms:identifier "D145" ;
    dcterms:title "Bulk EventStore with summary metadata, not per-operation" ;
    rlg:rationale "Feed polling creates 50-150 operations per update. Per-operation metadata overhead is unacceptable. Bulk undo semantics are fine for batch ingestion." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M009> .

<urn:repolens:sempkm:decision/D146>
    a rlg:Decision ;
    dcterms:identifier "D146" ;
    dcterms:title "First-party apps in apps/ directory alongside models/" ;
    rlg:rationale "Simple installation for bundled apps. No marketplace infrastructure needed for v1." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M009> ;
    rlg:governs <urn:repolens:sempkm:part/P> .

<urn:repolens:sempkm:decision/D147>
    a rlg:Decision ;
    dcterms:identifier "D147" ;
    dcterms:title "Right pane sections dynamic vs. hardcoded" ;
    rlg:rationale "App contributions need to appear alongside Relations/Lint/Comments. Dynamic endpoint allows runtime merging based on object type and running apps. AbortController cancellation prevents stale sections on rapid tab switching. Platform sections always present as baseline; app sections gracefully degraded on failure." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M009/S06> ;
    rlg:governs <urn:repolens:sempkm:part/P> ;
    rlg:governs <urn:repolens:sempkm:part/LT> .

<urn:repolens:sempkm:decision/D148>
    a rlg:Decision ;
    dcterms:identifier "D148" ;
    dcterms:title "Object renderer override dispatch pattern" ;
    rlg:rationale "Apps need to replace default SHACL form for specific types with custom read/edit renderers. Three-layer dispatch (registry → pref → template) gives clear precedence. AppRendererPref table resolves multi-app conflicts via admin UI. Silent fallback to default on any error ensures renderer bugs never break object viewing." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M009/S06> ;
    rlg:governs <urn:repolens:sempkm:part/P> ;
    rlg:governs <urn:repolens:sempkm:part/M> .

<urn:repolens:sempkm:decision/D149>
    a rlg:Decision ;
    dcterms:identifier "D149" ;
    dcterms:title "M011 is pure content — no platform code changes" ;
    rlg:rationale "Research confirmed every pattern needed (SPARQLConstraint, PropertyGroups, editHelpText, inverseOf, SavedQuery) is already exercised by basic-pkm and PPV. Adding platform features would increase risk for no benefit." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M011> .

<urn:repolens:sempkm:decision/D150>
    a rlg:Decision ;
    dcterms:identifier "D150" ;
    dcterms:title "Dashboard bundling deferred — document recommended configs" ;
    rlg:rationale "DashboardSpec-to-RDF migration is tracked tech debt. Adding manifest dashboard support is a platform change that violates M011's pure-content scope." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M011> ;
    rlg:governs <urn:repolens:sempkm:part/DS> .

<urn:repolens:sempkm:decision/D151>
    a rlg:Decision ;
    dcterms:identifier "D151" ;
    dcterms:title "S01-S04 parallelizable — no inter-model dependencies" ;
    rlg:rationale "Models must work standalone by design. Cross-model edges use shared gist hierarchy, not direct model-to-model references. Parallel execution cuts calendar time." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M011> .

<urn:repolens:sempkm:decision/D152>
    a rlg:Decision ;
    dcterms:identifier "D152" ;
    dcterms:title "basic-pkm v2 is additive-only, no Event type in v2.0" ;
    rlg:rationale "Event type has recurrence (RRULE), attendees, and timezone complexity. Without a calendar provider app to exercise it, it's dead schema. Ship what's usable now." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M011> ;
    rlg:governs <urn:repolens:sempkm:part/E> .

<urn:repolens:sempkm:decision/D153>
    a rlg:Decision ;
    dcterms:identifier "D153" ;
    dcterms:title "Validation rules use sh:sparql SPARQLConstraint on separate NodeShapes" ;
    rlg:rationale "pyshacl requires severity on parent NodeShape, not constraint node. Mixing inference and validation on one shape causes unpredictable behavior. Separate shapes is the proven pattern." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M011> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/H> ;
    rlg:governs <urn:repolens:sempkm:part/I> ;
    rlg:governs <urn:repolens:sempkm:part/Q> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D154>
    a rlg:Decision ;
    dcterms:identifier "D154" ;
    dcterms:title "Seed data pre-populates both sides of owl:inverseOf pairs" ;
    rlg:rationale "Matches basic-pkm and PPV pattern. Ensures data appears correctly even if inference hasn't run yet. Inference correctness tested by adding objects with only one side and checking materialization." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M011> ;
    rlg:governs <urn:repolens:sempkm:part/I> .

<urn:repolens:sempkm:decision/D155>
    a rlg:Decision ;
    dcterms:identifier "D155" ;
    dcterms:title "Layout-only personas for v1 — no settings overrides" ;
    rlg:rationale "Reduces scope and complexity. Settings overrides can layer on later without breaking the persona API. Core value is layout switching." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M012/S03> .

<urn:repolens:sempkm:decision/D156>
    a rlg:Decision ;
    dcterms:identifier "D156" ;
    dcterms:title "Dedicated `personas` table, not `user_settings` key-value" ;
    rlg:rationale "Personas have CRUD lifecycle + activation semantics that don't fit key-value storage. Dedicated table enables proper FK, indexing, and schema evolution." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M012/S03> .

<urn:repolens:sempkm:decision/D157>
    a rlg:Decision ;
    dcterms:identifier "D157" ;
    dcterms:title "Explicit save only — no auto-save to server on layout change" ;
    rlg:rationale "`onDidLayoutChange` fires on every panel resize/move — auto-saving would create excessive writes. localStorage auto-save continues independently for crash recovery." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M012/S03> .

<urn:repolens:sempkm:decision/D158>
    a rlg:Decision ;
    dcterms:identifier "D158" ;
    dcterms:title "How to handle auth rate limiting in E2E test environments" ;
    rlg:rationale "E2E auth fixtures create sessions rapidly (one per test), exhausting the 5/minute magic-link rate limit and causing cascading test failures. Disabling rate limiting in test stack is cleaner than increasing limits or adding delays. Production defaults remain unchanged (enabled=true)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/testing> ;
    rlg:governs <urn:repolens:sempkm:part/G> ;
    rlg:governs <urn:repolens:sempkm:part/ET> .

<urn:repolens:sempkm:decision/D159>
    a rlg:Decision ;
    dcterms:identifier "D159" ;
    dcterms:title "Dual-auth dependency approach for M013 API endpoints" ;
    rlg:rationale "External clients (browser extension) send Bearer tokens; htmx frontend sends cookies. Both must work on the same endpoints. Cookie-first ordering means the htmx frontend path is unchanged. AuthService.verify_api_token() already exists and is tested — no new auth logic needed, only wiring." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M013> ;
    rlg:governs <urn:repolens:sempkm:part/B> ;
    rlg:governs <urn:repolens:sempkm:part/G> .

<urn:repolens:sempkm:decision/D160>
    a rlg:Decision ;
    dcterms:identifier "D160" ;
    dcterms:title "SHACL shape JSON serialization strategy" ;
    rlg:rationale "Research confirmed PropertyShape/PropertyGroup/NodeShapeForm are plain Python dataclasses with simple types (str, int, float, list[str], None). dataclasses.asdict() serializes them cleanly — no custom serializers needed. Pydantic models on the response side provide OpenAPI docs and validation. Migrating ShapesService internals to Pydantic would be high-risk refactoring with no benefit to M013." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M013> ;
    rlg:governs <urn:repolens:sempkm:part/Q> .

<urn:repolens:sempkm:decision/D161>
    a rlg:Decision ;
    dcterms:identifier "D161" ;
    dcterms:title "CORS policy for API endpoints" ;
    rlg:rationale "SemPKM is self-hosted — the user controls their instance. Requiring extension origin registration adds complexity with no security benefit for local instances. Browser extensions have unpredictable origins (chrome-extension://random-id). Wildcard CORS is standard for local APIs. Can add configurable origin restrictions later for cloud-hosted instances." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M013> ;
    rlg:governs <urn:repolens:sempkm:part/B> .

<urn:repolens:sempkm:decision/D162>
    a rlg:Decision ;
    dcterms:identifier "D162" ;
    dcterms:title "Context-query scope — literal matches only for v1" ;
    rlg:rationale "URL matching (find objects containing a given URL as a property value) and FTS keyword matching (existing LuceneSail) cover the primary browser extension use case. Edge traversal (objects linked to matching objects) adds SPARQL complexity and potentially noisy results. Ship the simple version; add traversal later if needed." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M013> ;
    rlg:governs <urn:repolens:sempkm:part/N> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/B> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D163>
    a rlg:Decision ;
    dcterms:identifier "D163" ;
    dcterms:title "How to handle 401 responses for JSON API endpoints outside /api/ prefix" ;
    rlg:rationale "The exception handler converts 401s to 302 login redirects for HTML routes. Discovery endpoints at /.well-known/ are JSON APIs that must return structured error responses. Any future JSON API path prefix outside /api/ must also be added to the _is_html_route exclusion list." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M013/S01/T03> .

<urn:repolens:sempkm:decision/D164>
    a rlg:Decision ;
    dcterms:identifier "D164" ;
    dcterms:title "How /api/types endpoint accesses IconService" ;
    rlg:rationale "IconService is instantiated inline everywhere in the codebase (admin router, browser helpers, SPARQL router) — it's never registered on app.state. T01-T02 executor assumed app.state wiring, causing runtime 500. Fixed by following existing pattern: `IconService(models_dir=_MODELS_DIR)` with user_type_icons from app.state." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M013/S02> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/B> ;
    rlg:governs <urn:repolens:sempkm:part/ET> .

<urn:repolens:sempkm:decision/D165>
    a rlg:Decision ;
    dcterms:identifier "D165" ;
    dcterms:title "Backend auth approach for commands endpoint to support browser extension" ;
    rlg:rationale "Parallel factory avoids breaking existing htmx routes (which rely on cookie-only `require_role`). The `get_current_user_or_api` dependency already exists and is tested (M013). This is a ~20-line change with no risk to existing auth flows. Same pattern can be applied selectively to SPARQL endpoints if needed later." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M014> ;
    rlg:governs <urn:repolens:sempkm:part/C> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/B> ;
    rlg:governs <urn:repolens:sempkm:part/G> .

<urn:repolens:sempkm:decision/D166>
    a rlg:Decision ;
    dcterms:identifier "D166" ;
    dcterms:title "Extension form rendering approach — client-side vs server-rendered" ;
    rlg:rationale "Avoids a network round-trip for form HTML, enables form rendering from cached shapes (works offline-ish), keeps the extension self-contained with no dependency on server-rendered partials. The JS renderer handles the common SHACL property types used in standard Mental Models — not every edge case. Reference implementation is the 205-line Jinja2 `_field.html` macro." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M014> ;
    rlg:governs <urn:repolens:sempkm:part/N> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/H> .

<urn:repolens:sempkm:decision/D167>
    a rlg:Decision ;
    dcterms:identifier "D167" ;
    dcterms:title "Relationship picker search backend — context-query vs SPARQL endpoint" ;
    rlg:rationale "Context-query already supports Bearer auth (M013). Adding Bearer auth to 19 SPARQL router endpoints is high-effort with low Phase 1 benefit. Context-query returns objects with IRIs, labels, and types — sufficient for relationship search. Client-side type filtering is acceptable for v1 result sets. SPARQL auth can be added in Phase 2 (M015) if needed." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M014> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/L> ;
    rlg:governs <urn:repolens:sempkm:part/G> ;
    rlg:governs <urn:repolens:sempkm:part/K> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D168>
    a rlg:Decision ;
    dcterms:identifier "D168" ;
    dcterms:title "Extension distribution method for Phase 1" ;
    rlg:rationale "Web Store review adds latency, code review requirements, and privacy disclosures. `http://localhost:*/*` in host_permissions may be rejected. Sideloading is sufficient for self-hosted users and development iteration. Web Store submission planned for later when stable." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M014> ;
    rlg:governs <urn:repolens:sempkm:part/E> .

<urn:repolens:sempkm:decision/D169>
    a rlg:Decision ;
    dcterms:identifier "D169" ;
    dcterms:title "Extension tech stack and build approach" ;
    rlg:rationale "Chrome MV3 Content Security Policy forbids `eval()` and inline scripts. A build step adds complexity for a <2k LOC extension. Vanilla JS is consistent with the SemPKM frontend (htmx + vanilla JS). The SHACL renderer is imperative DOM manipulation which is natural in vanilla JS. No framework dependency to manage or update." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M014> ;
    rlg:governs <urn:repolens:sempkm:part/P> .

<urn:repolens:sempkm:decision/D170>
    a rlg:Decision ;
    dcterms:identifier "D170" ;
    dcterms:title "Object + edge creation sequencing in extension" ;
    rlg:rationale "Client-side IRI minting requires replicating `mint_object_iri` logic and is fragile if the minting scheme changes. Two-step sequential is simpler, guaranteed correct, and the latency of two API calls is negligible for a user-initiated save action. If the first succeeds but the second fails, the user has an object without the relationship — show a clear error and let them retry." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M014> ;
    rlg:governs <urn:repolens:sempkm:part/N> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D178>
    a rlg:Decision ;
    dcterms:identifier "D178" ;
    dcterms:title "App uninstall triplestore data cleanup strategy" ;
    rlg:rationale "Uninstall must never be blocked by a transient triplestore error. Orphaned triples are harmless (namespaced under urn:sempkm:app:{id}:). Admin can re-run cleanup manually if needed. The alternative — rolling back the DB deletion on SPARQL failure — would leave the system in an inconsistent state where the app row exists but the process is already stopped." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M009/S07> ;
    rlg:governs <urn:repolens:sempkm:part/T> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D179>
    a rlg:Decision ;
    dcterms:identifier "D179" ;
    dcterms:title "IRI prefix enforcement scope in SDK CommandClient" ;
    rlg:rationale "The original implementation rejected ALL IRIs not matching the app's own prefix, blocking apps from referencing model-defined types (the #1 platform risk for M010). Scoping enforcement to only app/data namespaces preserves sandboxing while allowing legitimate cross-namespace references." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M010/S01/T01> ;
    rlg:governs <urn:repolens:sempkm:part/P> .

<urn:repolens:sempkm:decision/D180>
    a rlg:Decision ;
    dcterms:identifier "D180" ;
    dcterms:title "RSS article IRI minting strategy" ;
    rlg:rationale "Using feed_iri (not feed_url) makes IRIs stable even if the feed URL redirects. The feed_iri is the canonical subscription object IRI, which is fixed. SHA-256 prevents collision while keeping IRIs deterministic for dedup." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M010/S01/T03> .

<urn:repolens:sempkm:decision/D181>
    a rlg:Decision ;
    dcterms:identifier "D181" ;
    dcterms:title "FeedSubscription browser visibility in rss-feeds model" ;
    rlg:rationale "FeedSubscriptions are managed by the RSS reader app, not manually created by users. Showing them in the object browser would clutter the user's workspace with implementation-detail objects. They remain SPARQL-queryable and editable by the app." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M010/S01/T02> ;
    rlg:governs <urn:repolens:sempkm:part/U> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/B> .

<urn:repolens:sempkm:decision/D182>
    a rlg:Decision ;
    dcterms:identifier "D182" ;
    dcterms:title "Subscription unsubscribe strategy for RSS feeds" ;
    rlg:rationale "Existing articles reference their feed subscription IRI via rss:fromFeed. Hard-deleting the subscription would orphan those references. Soft-delete preserves article provenance chain while preventing future polling. Admin can still query inactive subscriptions via SPARQL." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M010/S02/T03> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D183>
    a rlg:Decision ;
    dcterms:identifier "D183" ;
    dcterms:title "Navigate command enrichment for app pages in command palette" ;
    rlg:rationale "Exact path matching (no prefix/fuzzy) is simple and correct — app pages have unique paths. Adding appId/pageId to the JSON response lets the frontend make the right choice (dockview tab vs full navigation) without hardcoding app-specific logic in JS. This pattern works for all future apps with navigate commands." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M010/S04/T02> ;
    rlg:governs <urn:repolens:sempkm:part/C> ;
    rlg:governs <urn:repolens:sempkm:part/P> .

<urn:repolens:sempkm:decision/D184>
    a rlg:Decision ;
    dcterms:identifier "D184" ;
    dcterms:title "FeedSubscription browserVisible setting" ;
    rlg:rationale "FeedSubscriptions are managed by the RSS reader app, not by users directly. Showing them in the object browser would clutter the UI with infrastructure objects. They remain queryable via SPARQL and linkable via edges, just not browsable." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M010/S01/T02> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/B> .

<urn:repolens:sempkm:decision/D185>
    a rlg:Decision ;
    dcterms:identifier "D185" ;
    dcterms:title "Feed format dispatch strategy for RSS reader" ;
    rlg:rationale "feedparser doesn't support JSON Feed format. A content-type dispatcher keeps the parsing layer format-agnostic — callers don't need to know whether the feed was RSS, Atom, or JSON Feed. SimpleNamespace provides attribute access (.title, .link) matching feedparser's FeedParserDict, so entry_to_article() works identically for all formats." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M010/S02/T01> .

<urn:repolens:sempkm:decision/D186>
    a rlg:Decision ;
    dcterms:identifier "D186" ;
    dcterms:title "trafilatura optional dependency strategy for article content extraction" ;
    rlg:rationale "trafilatura has heavy C extension dependencies (lxml). Making it optional ensures the RSS reader app starts and functions even if trafilatura fails to install in the Docker container. The HAS_TRAFILATURA flag is inspectable at runtime for diagnostics. Feed-provided summaries are always available as fallback content." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M010/S02/T02> .

<urn:repolens:sempkm:decision/D187>
    a rlg:Decision ;
    dcterms:identifier "D187" ;
    dcterms:title "Conditional GET (ETag/Last-Modified) for feed polling bandwidth optimization" ;
    rlg:rationale "Polling feeds every 5 minutes generates redundant traffic when feed content hasn't changed. Conditional GET lets servers return 304 Not Modified (no body), saving bandwidth and parsing time. Per-subscription state stored as RDF predicates on FeedSubscription objects so conditional GET state persists across app restarts." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M010/S02/T02> .

<urn:repolens:sempkm:decision/D188>
    a rlg:Decision ;
    dcterms:identifier "D188" ;
    dcterms:title "RSS Reader user guide chapter number" ;
    rlg:rationale "The S06 plan assumed ch.29 was the last numbered chapter, but M012/S04 and M013/S03 had already created chapters 30 and 31 respectively. Maintaining sequential numbering required ch.32. Navigation chain adjusted: ch.31 → ch.32 → Appendix A." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/documentation> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M010/S06/T02> .

<urn:repolens:sempkm:decision/D189>
    a rlg:Decision ;
    dcterms:identifier "D189" ;
    dcterms:title "Title extraction strategy for dynamic SHACL forms in extension popup" ;
    rlg:rationale "Different Mental Model types use different title conventions — basic-pkm uses dcterms:title, CRM Contact has firstName/lastName but no title field, Task has dcterms:title. A cascade handles all cases without type-specific branching. Falls through gracefully — validation only requires a non-empty title, the cascade almost always finds something." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M014/S02> ;
    rlg:governs <urn:repolens:sempkm:part/Q> .

<urn:repolens:sempkm:decision/D190>
    a rlg:Decision ;
    dcterms:identifier "D190" ;
    dcterms:title "Content script injection strategy for browser extension page data extraction" ;
    rlg:rationale "Cleaner than {files:} approach which requires message-passing to get data back. The func parameter serializes/deserializes the function body, so the extractor must be fully self-contained (var declarations, no closures, no imports). This avoids a persistent content script that would run on every page load. The popup injects on-demand only when opened." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M014/S03> ;
    rlg:governs <urn:repolens:sempkm:part/B> .

<urn:repolens:sempkm:decision/D191>
    a rlg:Decision ;
    dcterms:identifier "D191" ;
    dcterms:title "Context menu to popup data bridge for \"Save to SemPKM\" right-click action" ;
    rlg:rationale "Service worker and popup are separate execution contexts — no shared memory. chrome.storage.session is ephemeral (cleared on browser restart), fast, and doesn't pollute sync storage. The consume-and-clear pattern prevents stale data from affecting subsequent popup opens. chrome.action.openPopup() is the standard MV3 approach; chrome.windows.create() fallback handles the case where openPopup() isn't available." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M014/S03> ;
    rlg:governs <urn:repolens:sempkm:part/B> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D192>
    a rlg:Decision ;
    dcterms:identifier "D192" ;
    dcterms:title "Schema.org to SHACL form property mapping priority" ;
    rlg:rationale "A schema.org Person has both schema:givenName and a CRM model might have crm:firstName. The cross-namespace map explicitly encodes domain-specific intent (givenName → crm:firstName), which should take priority over a generic direct-namespace match. First-write-wins means the cross-namespace mapping is checked first, and if it populates a path, the direct match skips it." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M014/S03> .

<urn:repolens:sempkm:decision/D193>
    a rlg:Decision ;
    dcterms:identifier "D193" ;
    dcterms:title "Edge creation error handling strategy in extension two-step save" ;
    rlg:rationale "Object creation is the primary user intent. Edges are supplementary relationship metadata. If the API is partially available or a single edge call fails due to a transient error, losing the entire object would be worse than losing a relationship. The user sees a clear warning toast with the failure count, so they know to re-add the relationship manually. Console logs identify exactly which edge failed for debugging." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M014/S04> ;
    rlg:governs <urn:repolens:sempkm:part/N> .

<urn:repolens:sempkm:decision/D194>
    a rlg:Decision ;
    dcterms:identifier "D194" ;
    dcterms:title "Sidebar implementation strategy — Chrome Side Panel API over content-script Shadow DOM injection" ;
    rlg:rationale "Side Panel API provides a dedicated browser surface that doesn't conflict with page CSS, persists across navigation, and has full access to Chrome extension APIs. Shadow DOM injection requires fighting with arbitrary page CSS, doesn't persist across navigation, and has limited API access. The cross-browser gap is manageable with the existing dual-manifest pattern from M014." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M015> ;
    rlg:governs <urn:repolens:sempkm:part/B> .

<urn:repolens:sempkm:decision/D195>
    a rlg:Decision ;
    dcterms:identifier "D195" ;
    dcterms:title "Popup and sidebar coexistence strategy — keep popup for capture, sidebar for context" ;
    rlg:rationale "Users need both flows: quick capture (popup via icon click / Alt+S) and context browsing (sidebar via Alt+K). Replacing one with the other reduces functionality. Separate entry points serve distinct user intents." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M015> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D196>
    a rlg:Decision ;
    dcterms:identifier "D196" ;
    dcterms:title "Context query signal splitting — separate URL, title, and keywords fields" ;
    rlg:rationale "The context-query endpoint already accepts `url`, `title`, and `keywords` as separate fields. Sending the same string as both title and keywords (current behavior) misses URL matching entirely and produces suboptimal keyword results. Separate signals enable URL exact match (highest confidence) alongside keyword search." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M015> ;
    rlg:governs <urn:repolens:sempkm:part/K> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D197>
    a rlg:Decision ;
    dcterms:identifier "D197" ;
    dcterms:title "Client-side result ranking strategy — URL match > title match > keyword match" ;
    rlg:rationale "The context-query endpoint returns flat results with match_type field but no ranking. Client-side ranking is simpler than modifying the backend endpoint and can be tuned per-UI without API changes. Top 10 prevents sidebar overflow from false positives." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M015> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D198>
    a rlg:Decision ;
    dcterms:identifier "D198" ;
    dcterms:title "Service worker context cache — in-memory Map with LRU eviction, no persistence" ;
    rlg:rationale "Cache is a performance optimization, not a correctness requirement. Re-querying on cache miss is cheap against a local instance. Persisting to chrome.storage would add read/write latency and storage management for ephemeral data. MV3 service workers restart cleanly." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M015> ;
    rlg:governs <urn:repolens:sempkm:part/L> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D199>
    a rlg:Decision ;
    dcterms:identifier "D199" ;
    dcterms:title "Linear sync app authentication strategy — OAuth vs API key" ;
    rlg:rationale "Linear mandates refresh tokens for OAuth2 apps created since Oct 2025, with 24h access token expiry. API key auth is simpler and avoids OAuth callback routing complexity for local dev. Supporting both maximizes usability: API key for quick personal setup, OAuth for production deployments where multiple users authenticate independently." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M016> ;
    rlg:governs <urn:repolens:sempkm:part/P> ;
    rlg:governs <urn:repolens:sempkm:part/G> .

<urn:repolens:sempkm:decision/D200>
    a rlg:Decision ;
    dcterms:identifier "D200" ;
    dcterms:title "Linear sync mechanism — polling vs webhooks" ;
    rlg:rationale "The App Platform doesn't expose app routes to external traffic — only platform-proxied internal routes. Linear webhooks can't reach localhost for local dev. Polling with updatedAt delta cursor covers the core sync UX. Webhooks can be added when the platform gains external webhook routing." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M016> ;
    rlg:governs <urn:repolens:sempkm:part/W> .

<urn:repolens:sempkm:decision/D201>
    a rlg:Decision ;
    dcterms:identifier "D201" ;
    dcterms:title "Linear GraphQL client approach — httpx direct vs gql library" ;
    rlg:rationale "Linear's GraphQL API is a single POST endpoint. The SDK's HttpClient already wraps httpx with domain enforcement. Adding the gql library brings dependency weight (graphql-core, etc.) for no benefit over raw POST with JSON query strings. Query construction is simpler as string templates with variable interpolation." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M016> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/J> .

<urn:repolens:sempkm:decision/D202>
    a rlg:Decision ;
    dcterms:identifier "D202" ;
    dcterms:title "Linear sync conflict resolution strategy" ;
    rlg:rationale "Linear's state.type enum is a cleaner status model than free-text — letting the provider win for status avoids lossy round-trips. For title/description, last-write-wins is pragmatic for a single-user self-hosted app where true conflicts are rare. lastSyncedAt timestamp comparison detects which side changed since last sync." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M016> .

<urn:repolens:sempkm:decision/D203>
    a rlg:Decision ;
    dcterms:identifier "D203" ;
    dcterms:title "Linear app unit test approach — importlib loading from apps/ directory" ;
    rlg:rationale "App code lives in apps/ (outside backend/), not importable via normal Python paths. The test-app has no unit tests, but the research doc recommends the importlib pattern used by M010 RSS Reader. Mocking SDK clients avoids platform runtime dependencies and makes tests fast and deterministic." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M016/S01> ;
    rlg:governs <urn:repolens:sempkm:part/P> .

<urn:repolens:sempkm:decision/D204>
    a rlg:Decision ;
    dcterms:identifier "D204" ;
    dcterms:title "Sync engine bulk creation strategy for platform-minted IRIs" ;
    rlg:rationale "The App SDK's CommandClient enforces an IRI prefix check (urn:sempkm:app:{appId}:) on object.patch, body.set, body.diff, and edge.create commands. Platform-minted Task IRIs use urn:sempkm:object: prefix, which the SDK rejects. Bypassing via ctx.commands._client (the underlying httpx.AsyncClient) avoids the prefix check while still using the platform's bulk command endpoint. The two-phase approach is needed because object.create returns no IRI — the platform assigns it — so body/edge commands for new objects must wait until the IRI is discoverable via SPARQL." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M016/S02> ;
    rlg:governs <urn:repolens:sempkm:part/N> ;
    rlg:governs <urn:repolens:sempkm:part/C> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D205>
    a rlg:Decision ;
    dcterms:identifier "D205" ;
    dcterms:title "Push sync loop prevention mechanism" ;
    rlg:rationale "When push_sync sends a change to Linear, the next poll sees that issue as updated. Without loop detection, pull_sync would re-import the pushed change. Comparing timestamps is simple and correct because both Linear updatedAt and bpkm:lastSyncedAt use ISO-8601 format where lexicographic ordering equals temporal ordering. lastSyncedAt is set after the mutation completes, so the next poll's updatedAt will be ≤ lastSyncedAt for push-originated changes." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M016/S03/T02> .

<urn:repolens:sempkm:decision/D206>
    a rlg:Decision ;
    dcterms:identifier "D206" ;
    dcterms:title "GitHub sync authentication — PAT-only for v1, no OAuth App" ;
    rlg:rationale "PAT is simpler, matches the M016 API key path, and avoids OAuth callback routing (same localhost limitation as D200). Users create a PAT with `repo` scope in GitHub Settings. OAuth App flow adds client_id/secret management, callback URL configuration, and token refresh complexity — all for the same functional outcome (API access). Can add OAuth later if multi-user production deployments need it." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M017> .

<urn:repolens:sempkm:decision/D207>
    a rlg:Decision ;
    dcterms:identifier "D207" ;
    dcterms:title "GitHub REST pagination — manual Link header parsing, no library" ;
    rlg:rationale "Link header format is trivial (~5 lines to parse). Adding a library for one regex is overhead. httpx exposes response.headers directly. Same approach used throughout SemPKM codebase — keep it simple." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M017> .

<urn:repolens:sempkm:decision/D208>
    a rlg:Decision ;
    dcterms:identifier "D208" ;
    dcterms:title "PR-to-issue linking via timeline API cross-referenced events" ;
    rlg:rationale "Text parsing of \"Closes #42\" in PR bodies is fragile (multiple variations, localization, false positives). The timeline API returns structured events that definitively identify cross-references. The `cross-referenced` event type includes the source PR reference, making link direction unambiguous." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M017> ;
    rlg:governs <urn:repolens:sempkm:part/E> .

<urn:repolens:sempkm:decision/D209>
    a rlg:Decision ;
    dcterms:identifier "D209" ;
    dcterms:title "GitHub sync requirement IDs use GH- prefix" ;
    rlg:rationale "SYNC-05 through SYNC-07 are already taken by M016 (Linear sync) with different meanings. GH- prefix avoids collision and makes requirements clearly identifiable by provider. Future sync apps should follow: TD- (Todoist), AS- (Asana), JR- (Jira), etc." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M017> ;
    rlg:governs <urn:repolens:sempkm:part/P> .

<urn:repolens:sempkm:decision/D210>
    a rlg:Decision ;
    dcterms:identifier "D210" ;
    dcterms:title "Google Calendar sync authentication — full OAuth 2.0, no API key alternative" ;
    rlg:rationale "Google Calendar API v3 has no API key path for user-data access — OAuth is mandatory. First real OAuth in a sync app (Linear used API key D199, GitHub used PAT D206). Callback URL routes through app proxy at /app/google-calendar/_fragments/oauth-callback." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M018> .

<urn:repolens:sempkm:decision/D211>
    a rlg:Decision ;
    dcterms:identifier "D211" ;
    dcterms:title "Polling-only sync for Google Calendar v1, no push notification channels" ;
    rlg:rationale "Same constraint as D200 — App Platform doesn't expose external webhook routes. Polling with syncToken is highly efficient (returns only changes). Push notification channels require publicly reachable URL + 7-day renewal. Polling matches M016/M017 pattern." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M018> .

<urn:repolens:sempkm:decision/D212>
    a rlg:Decision ;
    dcterms:identifier "D212" ;
    dcterms:title "bpkm:Event property set designed as cross-provider superset" ;
    rlg:rationale "The Event type must serve M018 (Google), M020 (Outlook), and M021 (CalDAV). Building the superset now avoids a breaking ontology change when Outlook sync lands. Unused enum values are harmless." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M018> ;
    rlg:governs <urn:repolens:sempkm:part/E> ;
    rlg:governs <urn:repolens:sempkm:part/O> .

<urn:repolens:sempkm:decision/D213>
    a rlg:Decision ;
    dcterms:identifier "D213" ;
    dcterms:title "RSVP-only push scope for v1 — no full event creation/edit push" ;
    rlg:rationale "Narrow push scope reduces complexity and risk. RSVP is the most common bidirectional action. Full event editing push requires field-by-field conflict resolution that exceeds v1 scope. Meeting notes explicitly listed as SemPKM-only in CONTEXT." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M018> ;
    rlg:governs <urn:repolens:sempkm:part/E> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D214>
    a rlg:Decision ;
    dcterms:identifier "D214" ;
    dcterms:title "Google Calendar requirement IDs use GCAL- prefix, Event type uses EVENT-" ;
    rlg:rationale "Follows D209 pattern — provider-specific prefix avoids collision. EVENT-01 is provider-neutral because the type serves Google, Outlook, and CalDAV." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M018> ;
    rlg:governs <urn:repolens:sempkm:part/E> .

<urn:repolens:sempkm:decision/D233>
    a rlg:Decision ;
    dcterms:identifier "D233" ;
    dcterms:title "Jira status normalization strategy" ;
    rlg:rationale "Status names are arbitrarily customizable per Jira project. statusCategory.key is the only reliable normalization point — maps every custom status to exactly one of three categories. This is Jira's designed abstraction for cross-project status comparison." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M023> .

<urn:repolens:sempkm:decision/D234>
    a rlg:Decision ;
    dcterms:identifier "D234" ;
    dcterms:title "Jira sync requirement ID prefix" ;
    rlg:rationale "Provider-specific prefix avoids collision and makes requirements identifiable by provider." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M023> .

<urn:repolens:sempkm:decision/D235>
    a rlg:Decision ;
    dcterms:identifier "D235" ;
    dcterms:title "Jira status normalization via statusCategory.key, not status name" ;
    rlg:rationale "Status names are arbitrarily customizable per Jira project (\"In Review\", \"QA Testing\", etc.). statusCategory.key is the only reliable normalization point — maps every custom status to exactly one of three categories. This is Jira's designed abstraction for cross-project status comparison." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M023/S01> .

<urn:repolens:sempkm:decision/D236>
    a rlg:Decision ;
    dcterms:identifier "D236" ;
    dcterms:title "Jira sync authentication — API token (email + token as Basic auth) for v1, no OAuth 2.0 3LO" ;
    rlg:rationale "Atlassian OAuth 2.0 (3LO) requires registering a Jira app with Atlassian developer console, managing client_id/secret, handling complex callback routing, and scope negotiation. API token is simpler and matches D206 (GitHub PAT) pattern. Sufficient for self-hosted single-user use. OAuth can be added in v2." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M023/S01> ;
    rlg:governs <urn:repolens:sempkm:part/G> .

<urn:repolens:sempkm:decision/D237>
    a rlg:Decision ;
    dcterms:identifier "D237" ;
    dcterms:title "Push sync limited to title/description/priority for v1 — no status transitions" ;
    rlg:rationale "Jira requires valid transition IDs for status changes (unlike Linear/GitHub where you set any status directly). Per-project transition discovery and validation is a separate concern from basic field sync. Title/description/priority PATCH is sufficient for v1 bidirectional capability." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M023/S01> ;
    rlg:governs <urn:repolens:sempkm:part/Q> .

<urn:repolens:sempkm:decision/D238>
    a rlg:Decision ;
    dcterms:identifier "D238" ;
    dcterms:title "Jira person resolution requires extra API call per unique accountId" ;
    rlg:rationale "Jira's GDPR-compliant API removed email from issue response data. The extra API call is unavoidable but the LRU cache (same pattern as all other sync apps) means each unique user is looked up only once per sync run." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M023/S01> ;
    rlg:governs <urn:repolens:sempkm:part/L> ;
    rlg:governs <urn:repolens:sempkm:part/P> .

<urn:repolens:sempkm:decision/D239>
    a rlg:Decision ;
    dcterms:identifier "D239" ;
    dcterms:title "ADF ↔ Markdown conversion — custom recursive converter, not library" ;
    rlg:rationale "No well-maintained Python ADF↔MD library exists. The node types are well-documented and finite. A focused converter covering common types is more reliable than depending on an unmaintained package. The reverse direction (MD→ADF) only needs to handle the Markdown subset SemPKM produces." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M023/S01> .

<urn:repolens:sempkm:decision/D240>
    a rlg:Decision ;
    dcterms:identifier "D240" ;
    dcterms:title "Jira issue link deduplication strategy for dependsOn edges" ;
    rlg:rationale "Each Jira blocking relationship appears in both issues' issuelinks arrays — as outwardIssue on the blocker and as inwardIssue on the blocked. Processing both directions would create duplicate bpkm:dependsOn edges. Filtering to inward-only (current issue \"is blocked by\" the inward issue) ensures one edge per blocking relationship while maintaining the correct dependency semantics." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M023/S03> ;
    rlg:governs <urn:repolens:sempkm:part/N> .

<urn:repolens:sempkm:decision/D241>
    a rlg:Decision ;
    dcterms:identifier "D241" ;
    dcterms:title "LoopGuard as lightweight TTL cache module for echo prevention" ;
    rlg:rationale "Monday.com has no webhook suppression. For v1 polling, push→poll echo occurs within same process lifetime. Simple in-memory TTL dict is sufficient and highly testable." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M024%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/L> .

<urn:repolens:sempkm:decision/D242>
    a rlg:Decision ;
    dcterms:identifier "D242" ;
    dcterms:title "Monday.com column mapping per-board storage keys" ;
    rlg:rationale "Monday.com boards are independently configurable — each board has unique columns, status labels, and priority labels. Per-board keys allow a single app installation to sync multiple boards with different mapping configurations. Follows the D228 \"configure before sync\" pattern established by Asana. Nested label mapping structure keeps status and priority mappings co-located per board for atomic read/write." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M024/S02> ;
    rlg:governs <urn:repolens:sempkm:part/L> .

<urn:repolens:sempkm:decision/D243>
    a rlg:Decision ;
    dcterms:identifier "D243" ;
    dcterms:title "Monday.com group→taskGroup sourced from item.group, not column_values" ;
    rlg:rationale "Monday.com groups are structural containers, not user-configurable columns. They appear in the items query under `group { id title }` but are absent from `column_values`. Using `item.group.title` directly (not via column mapping) is correct because the group assignment comes from item placement, not from a column value the user can remap. Similarly, subitems are separate items requiring a distinct API call, matching the structural relationship model." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M024/S02> .

<urn:repolens:sempkm:decision/D244>
    a rlg:Decision ;
    dcterms:identifier "D244" ;
    dcterms:title "DEMO_MODE env var for anonymous access — synthetic guest user bypass" ;
    rlg:rationale "Option B from research — cleaner than pre-seeded demo user with auto-login cookie. Synthetic user gets `role: \"guest\"` which already has restricted permissions. Combined with nginx write-blocking, this is defense-in-depth. ~15 lines in auth/dependencies.py, no new endpoints needed." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M025%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/N> ;
    rlg:governs <urn:repolens:sempkm:part/G> .

<urn:repolens:sempkm:decision/D245>
    a rlg:Decision ;
    dcterms:identifier "D245" ;
    dcterms:title "Read-only enforcement via nginx default-deny on non-GET methods" ;
    rlg:rationale "Default-deny is safer than endpoint-by-endpoint allowlisting — missing one POST route allows data corruption across visitors. Research identified 20+ mutation endpoints; blocking by HTTP method catches all current and future write routes with ~10 lines of nginx config." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M025%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/N> .

<urn:repolens:sempkm:decision/D246>
    a rlg:Decision ;
    dcterms:identifier "D246" ;
    dcterms:title "Caddy reverse proxy for SSL termination, not nginx SSL config" ;
    rlg:rationale "Avoids modifying nginx.conf for SSL — Caddy's automatic HTTPS is simpler than Let's Encrypt + certbot + nginx SSL blocks. Caddy also handles certificate renewal automatically. Keeps the demo nginx.conf identical to the local dev config." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M025%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/N> .

<urn:repolens:sempkm:decision/D247>
    a rlg:Decision ;
    dcterms:identifier "D247" ;
    dcterms:title "Demo requirement IDs use DEMO- prefix" ;
    rlg:rationale "Follows established provider-specific prefix convention (D209, D214, D216, D221, D226, D230, D234)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M025%20planning> .

<urn:repolens:sempkm:decision/D248>
    a rlg:Decision ;
    dcterms:identifier "D248" ;
    dcterms:title "M025 is deployment + content — no new platform features" ;
    rlg:rationale "Research confirmed every pattern needed (Driver.js tours, dashboard builder, seed data JSON-LD) is already exercised. Platform feature changes would increase risk for no benefit." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M025%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/DS> .

<urn:repolens:sempkm:decision/D249>
    a rlg:Decision ;
    dcterms:identifier "D249" ;
    dcterms:title "How to bypass FastAPI Depends() chain in get_current_user for DEMO_MODE" ;
    rlg:rationale "FastAPI evaluates Depends() arguments before the function body runs. The old get_session_token dependency raises 401 when no cookie is present, which would fire before any demo_mode check in the function body. Inlining the cookie extraction as an optional parameter lets the function body execute first, where the demo_mode guard returns the synthetic user immediately." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M025/S01/T01> ;
    rlg:governs <urn:repolens:sempkm:part/A> .

<urn:repolens:sempkm:decision/D250>
    a rlg:Decision ;
    dcterms:identifier "D250" ;
    dcterms:title "How to handle setup wizard redirect in DEMO_MODE" ;
    rlg:rationale "DEMO_MODE auth bypass (T01) prevents 401s but doesn't prevent the client-side JS setup wizard redirect. Fresh demo instances have setup_mode=true, causing auth.js to redirect to /setup.html before auth can take effect. The fix is at the status endpoint (not in JS or middleware) because it's the single source of truth the client checks, and it avoids modifying shared frontend code." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M025/S01/T03> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/G> .

<urn:repolens:sempkm:decision/D251>
    a rlg:Decision ;
    dcterms:identifier "D251" ;
    dcterms:title "nginx JSON response for write-blocking in demo mode" ;
    rlg:rationale "Bare `return 403` inside nginx `if` blocks always sends `text/plain` content-type — there's no way to set Content-Type: application/json with that pattern. The `limit_except` directive doesn't work at server level. The error_page + named location approach is the canonical nginx solution for returning JSON error responses from method guards." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M025/S01/T02> ;
    rlg:governs <urn:repolens:sempkm:part/N> .

<urn:repolens:sempkm:decision/D252>
    a rlg:Decision ;
    dcterms:identifier "D252" ;
    dcterms:title "How the demo seed script bypasses HTTP auth and nginx write-blocking" ;
    rlg:rationale "Three alternatives were considered: (1) HTTP API calls to port 8902 (bypasses nginx but requires owner auth — DEMO_MODE guest user lacks install/command permissions), (2) two-phase deployment (start without DEMO_MODE, seed, restart with DEMO_MODE — fragile, compose file hardcodes DEMO_MODE=true), (3) direct module imports inside container (works regardless of DEMO_MODE since model install and EventStore.commit don't check the flag). Option 3 is simplest and most reliable — follows the same pattern as ensure_starter_model() at app startup." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M025/S02%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/N> ;
    rlg:governs <urn:repolens:sempkm:part/G> .

<urn:repolens:sempkm:decision/D253>
    a rlg:Decision ;
    dcterms:identifier "D253" ;
    dcterms:title "Deterministic UUID for demo dashboard shared between tour JS and seed script" ;
    rlg:rationale "The demo tour's step 6 calls `openDashboardTab(dashboardId, name)` which needs to know the dashboard ID at JS runtime. Using a deterministic UUID rather than discovering it at runtime (which would need an API call) keeps the tour code simple and avoids async complexity. The seed script uses the same UUID when creating the dashboard, making it a shared constant. This is a pattern already used in the codebase (demo user UUID `00000000-...`)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M025/S03> ;
    rlg:governs <urn:repolens:sempkm:part/DS> .

<urn:repolens:sempkm:decision/D254>
    a rlg:Decision ;
    dcterms:identifier "D254" ;
    dcterms:title "No static site generator — vanilla HTML/CSS/JS for homepage rewrite" ;
    rlg:rationale "The existing docs/ directory is served directly by GitHub Pages with no build step. This is consistent with the project's \"no build step\" frontend philosophy (htmx + vanilla JS). At most 4 HTML files sharing one CSS file — an SSG adds tooling complexity for negligible benefit." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M026%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/U> .

<urn:repolens:sempkm:decision/D255>
    a rlg:Decision ;
    dcterms:identifier "D255" ;
    dcterms:title "Homepage messaging grounded in USER-CONVERSION-STRATEGY.md, not invented" ;
    rlg:rationale "The strategy doc contains researched competitive analysis, persona definitions, and messaging shifts. Using it as the content source ensures consistency and avoids subjective copywriting. Can iterate on copy post-launch based on user feedback." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M026%20planning> .

<urn:repolens:sempkm:decision/D256>
    a rlg:Decision ;
    dcterms:identifier "D256" ;
    dcterms:title "SITE requirement IDs for homepage-specific requirements" ;
    rlg:rationale "These are new scope not covered by existing requirements. SITE- prefix clearly identifies them as marketing site concerns separate from app functionality. SITE-04 through SITE-07 are quality attributes naturally embedded in the main work." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M026%20planning> .

<urn:repolens:sempkm:decision/D257>
    a rlg:Decision ;
    dcterms:identifier "D257" ;
    dcterms:title "Screenshots captured from M025 demo stack, not fresh Docker build" ;
    rlg:rationale "The demo stack has 74 pre-populated objects across 4 Mental Models, a demo dashboard, and represents the \"best foot forward\" state of the app. Screenshots from this stack match what the \"Try the Demo\" CTA links to." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M026%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/DS> .

<urn:repolens:sempkm:decision/D258>
    a rlg:Decision ;
    dcterms:identifier "D258" ;
    dcterms:title "Notion importer follows Obsidian pattern — parallel module, not shared imports/ extraction" ;
    rlg:rationale "Copy-and-adapt is lower risk than refactoring the working Obsidian importer. Both modules are small (~5 files each). Shared extraction can happen in a follow-up if a third importer is added." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M027%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/X> ;
    rlg:governs <urn:repolens:sempkm:part/Z> .

<urn:repolens:sempkm:decision/D259>
    a rlg:Decision ;
    dcterms:identifier "D259" ;
    dcterms:title "Classify step deferred — auto-classify databases as structured, standalone pages as content" ;
    rlg:rationale "Classification adds wizard complexity without proportional value for v1. Auto-classification covers 90%+ of real Notion exports. Users who need finer control can skip items. Dashboard/rollup classification deferred per CONTEXT.md scope." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M027%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/Z> ;
    rlg:governs <urn:repolens:sempkm:part/DS> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D260>
    a rlg:Decision ;
    dcterms:identifier "D260" ;
    dcterms:title "NOTION requirement IDs for Notion import" ;
    rlg:rationale "Follows provider-specific prefix convention. NOTION-01 already exists in REQUIREMENTS.md as deferred." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M027%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/Z> .

<urn:repolens:sempkm:decision/D261>
    a rlg:Decision ;
    dcterms:identifier "D261" ;
    dcterms:title "CSV parsing uses stdlib csv with utf-8-sig encoding, dates via python-dateutil" ;
    rlg:rationale "Notion exports CSVs in UTF-8 with BOM. dateutil handles locale-dependent date formats robustly. Both are proven tools already in the project." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M027%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/Z> .

<urn:repolens:sempkm:decision/D262>
    a rlg:Decision ;
    dcterms:identifier "D262" ;
    dcterms:title "Relation resolution is title-based with ambiguity warnings" ;
    rlg:rationale "This is a fundamental limitation of Notion's ZIP export format — no alternative exists for ZIP-only import. The 80% heuristic for detection is conservative. Warning users about ambiguous matches is the right UX — they can fix duplicates before re-importing." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M027%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/Z> .

<urn:repolens:sempkm:decision/D277>
    a rlg:Decision ;
    dcterms:identifier "D277" ;
    dcterms:title "QUIC/HTTP/3 for self-hosted Docker deployment" ;
    rlg:rationale "nginx:stable-alpine does NOT include HTTP/3 module (requires --with-http_v3_module + BoringSSL). nginx:mainline-alpine has experimental HTTP/3 but not stable. Self-hosted single-user tool over localhost gets minimal benefit from QUIC multiplexing and 0-RTT. HTTP/2 over h2c (cleartext) has limited browser support. Caddy supports HTTP/3 out of the box and is already used for the demo instance (D246), but switching the main Docker stack is a separate decision with its own trade-offs. Cost of implementing exceeds benefit for the current deployment model." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:governs <urn:repolens:sempkm:part/N> ;
    rlg:governs <urn:repolens:sempkm:part/B> .

<urn:repolens:sempkm:decision/D278>
    a rlg:Decision ;
    dcterms:identifier "D278" ;
    dcterms:title "Cross-model data quality rule placement — attach to basic-pkm with broad target patterns" ;
    rlg:rationale "basic-pkm is auto-installed as the starter model — always present. A platform rules graph (Option A from research) would require loader changes (new graph IRI pattern, separate loading logic). Attaching to basic-pkm is zero-infrastructure and follows the existing pattern where basic-pkm already has cross-cutting rules (overdue tasks). Migrate to platform rules graph later if a non-basic-pkm-only deployment becomes possible." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M030%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D279>
    a rlg:Decision ;
    dcterms:identifier "D279" ;
    dcterms:title "Lint filter storage in SQLite with server-side Python filtering" ;
    rlg:rationale "Suppressions/dismissals are user preferences, not knowledge graph data — SQLite is the natural home (alongside auth, favorites, personas). Server-side Python filtering is clean because the SPARQL queries for lint results are already complex; adding SQL-sourced filter lists to SPARQL would require cross-database joins (impossible). Python post-filtering is performant for typical result sets (~50-200 results)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M030%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/LT> ;
    rlg:governs <urn:repolens:sempkm:part/G> ;
    rlg:governs <urn:repolens:sempkm:part/DB> .

<urn:repolens:sempkm:decision/D280>
    a rlg:Decision ;
    dcterms:identifier "D280" ;
    dcterms:title "Lint filter preset schema — additive suppression model" ;
    rlg:rationale "Additive is simpler and matches the natural \"hide the noisy ones\" workflow. Users start seeing everything and progressively suppress rules they don't care about. The preset captures what to hide, not what to show." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M030%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/LT> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D281>
    a rlg:Decision ;
    dcterms:identifier "D281" ;
    dcterms:title "LINT requirement IDs for data quality linting" ;
    rlg:rationale "LINT prefix established by v2.4 lint dashboard requirements (LINT-01 through LINT-07). Continuing the sequence maintains traceability." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M030%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/LT> ;
    rlg:governs <urn:repolens:sempkm:part/DS> .

<urn:repolens:sempkm:decision/D282>
    a rlg:Decision ;
    dcterms:identifier "D282" ;
    dcterms:title "Orphan object rule as SHACL-AF with performance monitoring, not SavedQuery" ;
    rlg:rationale "Consistency: all 9 rules use the same mechanism. Users see orphan results alongside other lint results without running a separate query. The performance concern is speculative — measure first, optimize if needed." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M030%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/LT> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D284>
    a rlg:Decision ;
    dcterms:identifier "D284" ;
    dcterms:title "Model-declared view variant access after carousel removal" ;
    rlg:rationale "The carousel is the ONLY current surface for model-declared ViewSpecs (VIEW-05). Simply removing it loses access to type-specific views like \"Projects Table\". The view toolbar already exists and is the natural home for a variant selector alongside the scope dropdown. Adding entries to Saved Views provides a second discovery path. Both approaches use existing UI patterns with no new components." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M031%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/V> .

<urn:repolens:sempkm:decision/D285>
    a rlg:Decision ;
    dcterms:identifier "D285" ;
    dcterms:title "M031 requirement ID prefixes and numbering" ;
    rlg:rationale "VIEW- continues from VIEW-07 (M007). SPARQL- continues from SPARQL-08 (v2.6). ONTO- continues from ONTO-03 (M003). SQ- (Saved Queries) and DBUIX- (Dashboard/Builder UX) are new prefixes for new capability areas. 20 requirements total covering all 6 scope areas." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M031%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/DS> .

<urn:repolens:sempkm:decision/D286>
    a rlg:Decision ;
    dcterms:identifier "D286" ;
    dcterms:title "Kanban status field discovery strategy" ;
    rlg:rationale "bpkm:taskStatus is the only status-like field with sh:in constraints in the current Mental Models. SHACL shape inspection for arbitrary status fields is complex and adds scope. Hardcoding to the known field covers the primary use case (Task kanban). Can upgrade to SHACL-based field discovery in a follow-up if other models add status fields." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M031%20planning> .

<urn:repolens:sempkm:decision/D287>
    a rlg:Decision ;
    dcterms:identifier "D287" ;
    dcterms:title "Multiple view instance tab ID strategy" ;
    rlg:rationale "dockview deduplicates tabs by ID. The current `generic-view-table` ID prevents opening a second table view. Appending a UUID creates unique tabs while preserving the prefix for type identification. Scope and type filter stored as panel params so the view can re-fetch on restore. Matches the pattern used by object tabs (which use IRI-based unique IDs)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M031%20planning> .

<urn:repolens:sempkm:decision/D288>
    a rlg:Decision ;
    dcterms:identifier "D288" ;
    dcterms:title "Scope filter injection via SPARQL sub-select pattern" ;
    rlg:rationale "Follows VFS build_scope_filter() pattern but normalizes saved query primary SELECT variable to ?s for consistency with view query builders. Sub-select composes well with type filters and SHACL-derived columns. Graceful degradation (render unfiltered) when scope_query is invalid avoids user-facing errors." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M031/S01/T02> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D289>
    a rlg:Decision ;
    dcterms:identifier "D289" ;
    dcterms:title "Tab ID refinement — Date.now() for unscoped, composite key for scoped" ;
    rlg:rationale "Refines D287 (planning used UUID). Date.now() is simpler than UUID generation in browser JS and collision is impossible from user interaction. Scoped deduplication prevents redundant tabs for the same saved query. Numeric suffixes (\"Table View (2)\") differentiate unscoped instances visually." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M031/S02> ;
    rlg:governs <urn:repolens:sempkm:part/B> .

<urn:repolens:sempkm:decision/D290>
    a rlg:Decision ;
    dcterms:identifier "D290" ;
    dcterms:title "Generic saved views route through openGenericViewTab, query-based through openViewTab" ;
    rlg:rationale "Generic saved views need the new multi-instance tab system with scope binding. Query-based promoted views already work through the existing openViewTab() path. Separate delete methods because generic views may have no associated query_id — `demote_query()` requires one. Two-path pattern keeps backward compatibility while enabling the new feature." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M031/S02> ;
    rlg:governs <urn:repolens:sempkm:part/V> .

<urn:repolens:sempkm:decision/D291>
    a rlg:Decision ;
    dcterms:identifier "D291" ;
    dcterms:title "Kanban status field detection implementation — SHACL sh:in scan vs hardcoded field" ;
    rlg:rationale "The SHACL-based approach is only marginally more complex than hardcoding (~30 lines vs ~10 lines) but automatically supports any Mental Model type that declares sh:in enum constraints on a property. The preference for \"status\" in the path name provides sensible defaults while the fallback ensures broader compatibility. Unit tests cover all edge cases." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M031/S04> ;
    rlg:governs <urn:repolens:sempkm:part/N> .

<urn:repolens:sempkm:decision/D292>
    a rlg:Decision ;
    dcterms:identifier "D292" ;
    dcterms:title "SPARQL _VOCAB_PREFIXES strategy — broad urn:sempkm: exclusion vs specific sub-namespace allow-list" ;
    rlg:rationale "The broad \"urn:sempkm:\" entry caused ALL model ontology IRIs to be treated as internal/vocabulary, preventing pill rendering. An allow-list means new model ontology IRIs automatically get pill treatment. Only new internal machinery namespaces require list updates." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M031/S05/T01> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/O> .

<urn:repolens:sempkm:decision/D293>
    a rlg:Decision ;
    dcterms:identifier "D293" ;
    dcterms:title "Graph popover rendering — document.body with position:fixed vs z-index within container" ;
    rlg:rationale ".graph-container creates a stacking context via position:relative. Elevating z-index within that context cannot escape dockview chrome. Appending to document.body fully escapes all stacking contexts. Cleanup in registerCleanup prevents orphaned DOM nodes." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M031/S05/T04> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D294>
    a rlg:Decision ;
    dcterms:identifier "D294" ;
    dcterms:title "Full-height view layout — shared .view-flex-column flex wrapper vs per-view calc()" ;
    rlg:rationale "Per-view calc() (e.g., calc(100% - 90px)) is fragile — breaks when toolbar height changes. Flex column delegates height distribution to the browser. Shared class keeps CSS DRY for future views. Table/cards use natural scrolling and don't need the wrapper." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M031/S05/T04> ;
    rlg:governs <urn:repolens:sempkm:part/B> ;
    rlg:governs <urn:repolens:sempkm:part/V> .

<urn:repolens:sempkm:decision/D295>
    a rlg:Decision ;
    dcterms:identifier "D295" ;
    dcterms:title "Dashboard block layout storage — keep SQLite JSON, not RDF" ;
    rlg:rationale "Existing system has 968 lines across 4 backend modules, 1,076 lines of tests, proven GridStack serialization. Dashboard definitions are per-user config data, not knowledge graph entities. RDF migration would be significant effort with no clear benefit." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M032> ;
    rlg:governs <urn:repolens:sempkm:part/DB> ;
    rlg:governs <urn:repolens:sempkm:part/DS> .

<urn:repolens:sempkm:decision/D296>
    a rlg:Decision ;
    dcterms:identifier "D296" ;
    dcterms:title "Widget config schema — keep Python type hints, defer JSON Schema (BLK-06)" ;
    rlg:rationale "Python type hints are simpler, work for all planned block types (flat config dicts), and the validation code is already well-tested with 30+ registry tests. JSON Schema adds value only for external plugin systems — not needed now." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M032> ;
    rlg:governs <urn:repolens:sempkm:part/M> ;
    rlg:governs <urn:repolens:sempkm:part/Q> .

<urn:repolens:sempkm:decision/D297>
    a rlg:Decision ;
    dcterms:identifier "D297" ;
    dcterms:title "M033 slice ordering — all six slices are independent, no inter-slice dependencies" ;
    rlg:rationale "Deployment eliminates dangerous example.org default. Isometric graph is highest technical uncertainty (Cytoscape issue #1756). Calendar/map follow established view renderer pattern. Federation backend already exists — only console UI is new. App catalog is least coupled. Independence means slices can be reordered or dropped without affecting others." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/planning> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M033%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/F> .

<urn:repolens:sempkm:decision/D298>
    a rlg:Decision ;
    dcterms:identifier "D298" ;
    dcterms:title "M033 requirement ID prefixes" ;
    rlg:rationale "Follows established provider-specific prefix convention (D209, D214, etc.). Each feature area gets its own prefix for clear traceability." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M033%20planning> .

<urn:repolens:sempkm:decision/D299>
    a rlg:Decision ;
    dcterms:identifier "D299" ;
    dcterms:title "Research correction — SPARQL console has zero federation UI code" ;
    rlg:rationale "Grep confirmed zero matches for federation-related terms in frontend/static/js/sparql-console.js and all files under frontend/static/js/. This adjusts S05 scope upward from \"polish\" to \"build console integration\"." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M033%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/U> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/F> .

<urn:repolens:sempkm:decision/D300>
    a rlg:Decision ;
    dcterms:identifier "D300" ;
    dcterms:title "Isometric 2.5D approach — CSS 3D transform on Cytoscape container with inverse coordinate correction" ;
    rlg:rationale "Reuses all existing Cytoscape infrastructure (layouts, styling, popovers). Option B (z-position hack) isn't real isometric. Option C (custom renderer) is too much scope. The coordinate correction is well-documented in Cytoscape issue #1756 community workarounds. Ship as a layout option, not a separate renderer." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M033%20planning> .

<urn:repolens:sempkm:decision/D301>
    a rlg:Decision ;
    dcterms:identifier "D301" ;
    dcterms:title "Calendar view is read-only display — no inline drag-to-reschedule" ;
    rlg:rationale "Inline reschedule requires a write-back path for date property changes, which means a SPARQL UPDATE from the frontend or a new API endpoint. This exceeds v1 scope and adds complexity. Users can click through to the object editor to change dates." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M033%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D302>
    a rlg:Decision ;
    dcterms:identifier "D302" ;
    dcterms:title "Map view ships functional with empty-state UX — no geo property bootstrapping" ;
    rlg:rationale "The map view is a capability investment. Forcing geo properties into bpkm:Event (which has a string location field) would be artificial. Future models (Research Workflow, CRM with meeting locations) can add `wgs84:lat`/`wgs84:long` and the view works immediately." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M033%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/E> .

<urn:repolens:sempkm:decision/D303>
    a rlg:Decision ;
    dcterms:identifier "D303" ;
    dcterms:title "FullCalendar interaction approach — enable editable/selectable/droppable on existing CDN bundle" ;
    rlg:rationale "Research confirmed the standard FullCalendar CDN bundle includes `@fullcalendar/interaction`. M033 template already lazy-loads FullCalendar with CDN polling. Write-back uses existing `object.patch` command endpoint. D301 deferred inline reschedule — M034 delivers it." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M034%20planning> .

<urn:repolens:sempkm:decision/D304>
    a rlg:Decision ;
    dcterms:identifier "D304" ;
    dcterms:title "Frappe Gantt (MIT, zero deps, ~50KB SVG) for timeline/Gantt renderer" ;
    rlg:rationale "vis-timeline has heavier deps and more complex API. FullCalendar Premium timeline costs $480 and is not MIT. Frappe Gantt is purpose-built for task timelines, MIT licensed, zero runtime deps, and has the exact feature set needed (bars, arrows, drag, zoom). Custom SVG would duplicate what Frappe Gantt already provides." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M034%20planning> .

<urn:repolens:sempkm:decision/D305>
    a rlg:Decision ;
    dcterms:identifier "D305" ;
    dcterms:title "Task scheduling properties — bpkm:scheduledStart/scheduledEnd/estimatedDuration complementing ppv:doDate" ;
    rlg:rationale "dueDate = deadline, doDate = day-level intent, scheduledStart/End = hour-level time block. All three are useful at different granularities. Calendar needs dateTime precision for time-grid placement. Duration enables block sizing independent of explicit end time. Additive change only — no existing properties modified, basic-pkm version bumps to 2.2.0." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M034%20planning> .

<urn:repolens:sempkm:decision/D306>
    a rlg:Decision ;
    dcterms:identifier "D306" ;
    dcterms:title "python-dateutil for backend RRULE expansion" ;
    rlg:rationale "Event model already has `bpkm:recurrenceRule` (xsd:string, RFC 5545 RRULE format) from calendar sync apps. python-dateutil is the standard Python library for RRULE parsing. Virtual expansion at query time (not stored objects) follows the Google Calendar pattern and avoids phantom object pollution in the triplestore." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M034%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/E> ;
    rlg:governs <urn:repolens:sempkm:part/T> ;
    rlg:governs <urn:repolens:sempkm:part/P> .

<urn:repolens:sempkm:decision/D307>
    a rlg:Decision ;
    dcterms:identifier "D307" ;
    dcterms:title "Cross-panel drag protocol — text/x-sempkm-iri dataTransfer type with IRI + title + duration" ;
    rlg:rationale "Extends the proven kanban drag pattern (currently uses `text/plain` with bare IRI). JSON payload carries title and estimated duration for immediate calendar block rendering before the server roundtrip. FullCalendar's `externalDrop` event provides the date/time from the drop target. `stopPropagation()` prevents dockview interference (proven in kanban M031 and canvas M008)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M034%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/E> ;
    rlg:governs <urn:repolens:sempkm:part/CV> .

<urn:repolens:sempkm:decision/D308>
    a rlg:Decision ;
    dcterms:identifier "D308" ;
    dcterms:title "M034 requirement ID prefixes — PLAN-01..PLAN-10" ;
    rlg:rationale "New PLAN- prefix for the planning domain. Follows established prefix convention (D209, D285, D298)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M034%20planning> .

<urn:repolens:sempkm:decision/D309>
    a rlg:Decision ;
    dcterms:identifier "D309" ;
    dcterms:title "Frappe Gantt loaded from CDN, not vendored" ;
    rlg:rationale "The codebase consistently uses CDN loading for all external visualization libraries. Vendoring would diverge from the established pattern. Pinned to @1.2.2 for reproducibility." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/library> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M034/S02> .

<urn:repolens:sempkm:decision/D310>
    a rlg:Decision ;
    dcterms:identifier "D310" ;
    dcterms:title "RDF import: store imported triples directly with original IRIs, no IRI reminting" ;
    rlg:rationale "RDF import users expect their IRIs to be preserved. The object view queries `<iri> ?p ?o` and renders any IRI. Reminting would lose external linkability and violate user expectations for RDF data." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M039%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/E> .

<urn:repolens:sempkm:decision/D311>
    a rlg:Decision ;
    dcterms:identifier "D311" ;
    dcterms:title "RDF import: direct triple insertion without edge reification" ;
    rlg:rationale "Reification is lossy and complex — some URIRef objects are vocabulary terms, not importable subjects. Edge detection is ambiguous without a heuristic. Direct triples are valid RDF, queryable via SPARQL, and preserve data fidelity. Edge Inspector won't show these — acceptable for v1." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M039%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/N> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D312>
    a rlg:Decision ;
    dcterms:identifier "D312" ;
    dcterms:title "RDF import: one Operation per subject, commit_bulk for batches" ;
    rlg:rationale "Per-subject Operations provide fine-grained provenance. commit_bulk keeps event overhead low (~10 summary triples vs N*5). Direct Operation construction preserves original RDF data faithfully — imported data already has IRIs and typed literals." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M039%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/E> .

<urn:repolens:sempkm:decision/D313>
    a rlg:Decision ;
    dcterms:identifier "D313" ;
    dcterms:title "RDF import module: separate `/browser/rdf-import` router, not nested under Obsidian's `/browser/import`" ;
    rlg:rationale "The Obsidian router at `/browser/import` has `/{import_id}/...` path patterns. A nested `/browser/import/rdf` path could collide with import_id route matching. Separate prefix follows the Notion pattern (separate module at `/browser/notion`)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M039%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/B> ;
    rlg:governs <urn:repolens:sempkm:part/X> ;
    rlg:governs <urn:repolens:sempkm:part/Z> .

<urn:repolens:sempkm:decision/D314>
    a rlg:Decision ;
    dcterms:identifier "D314" ;
    dcterms:title "Where to place M034 feature documentation in the user guide" ;
    rlg:rationale "Calendar, Timeline, and Map are renderers — they belong in the renderers chapter (7) alongside Table, Cards, Graph, and Kanban. Task Templates and Review Workflows are planning tools built on the workflow system — they belong with existing workflow docs in chapter 28. Preserves existing chapter structure without creating thin standalone chapters. Alternative (dedicated \"Planning & Time-Blocking\" chapter) rejected because it would scatter renderer documentation across two chapters." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/documentation> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M040%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/J> .

<urn:repolens:sempkm:decision/D315>
    a rlg:Decision ;
    dcterms:identifier "D315" ;
    dcterms:title "Orphan chapter renumbering strategy — sequential from 39 onward" ;
    rlg:rationale "Avoids touching any existing chapter numbers, which would break cross-references. Orphans get the next available numbers. Mental Model Catalog (currently duplicating 29) moves to 39, preserving its content as-is. Sync apps cluster together (41–44, 47) for logical grouping." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/documentation> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M040%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/P> .

<urn:repolens:sempkm:decision/D316>
    a rlg:Decision ;
    dcterms:identifier "D316" ;
    dcterms:title "Model packaging for business planning frameworks" ;
    rlg:rationale "Single model is simpler to install and enables cross-framework SPARQL queries without cross-model graph concerns. PPV model (11 types, 2186 lines) provides precedent for large models. All frameworks share base types (QuadrantItem, FrameworkSection) in a single namespace." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M036%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/P> .

<urn:repolens:sempkm:decision/D317>
    a rlg:Decision ;
    dcterms:identifier "D317" ;
    dcterms:title "Custom renderer dispatch — extend elif pattern, don't refactor registry" ;
    rlg:rationale "The elif pattern is ugly but proven across 7 renderers, each with unique data fetching and template context needs. Refactoring to registry-based dispatch is a large tangent that doesn't deliver user value. The 4 new renderers can follow the exact same pattern. Wire the registry in a future cleanup milestone." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M036%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/M> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D318>
    a rlg:Decision ;
    dcterms:identifier "D318" ;
    dcterms:title "Generic quadrant renderer parameterized by axis labels" ;
    rlg:rationale "Building 6 separate renderers for the same 2×2 layout would be massive duplication. The only difference is axis labels and quadrant names. A single parameterized renderer with config from the ViewSpec keeps CSS/JS DRY. Each framework's ViewSpec declares `quadrant` renderer with framework-specific config." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M036%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/L> ;
    rlg:governs <urn:repolens:sempkm:part/P> ;
    rlg:governs <urn:repolens:sempkm:part/V> .

<urn:repolens:sempkm:decision/D319>
    a rlg:Decision ;
    dcterms:identifier "D319" ;
    dcterms:title "M036 requirement ID prefix — BIZ-01 through BIZ-10" ;
    rlg:rationale "New BIZ- prefix for the business planning domain. Follows established prefix convention (D209, D285, D298, D308)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M036%20planning> .

<urn:repolens:sempkm:decision/D320>
    a rlg:Decision ;
    dcterms:identifier "D320" ;
    dcterms:title "Computed fields (OKR progress, Decision Matrix scores) via server-side Python in data endpoints" ;
    rlg:rationale "SHACL-AF computation would make values SPARQL-queryable (ideal) but adds significant rule complexity and requires inference re-run on every edit. Client-side JS loses SPARQL queryability. Server-side computation is the pragmatic middle: computed values are available in the rendered view and can be cached or materialized later." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M036%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/I> .

<urn:repolens:sempkm:decision/D321>
    a rlg:Decision ;
    dcterms:identifier "D321" ;
    dcterms:title "New `POST /api/copilot/chat` endpoint with dual-auth, separate from settings LLM proxy" ;
    rlg:rationale "Copilot logic (schema injection, self-correction, conversation history) shouldn't pollute the generic LLM proxy. Separation of concerns." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M035%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/G> ;
    rlg:governs <urn:repolens:sempkm:part/AI> .

<urn:repolens:sempkm:decision/D322>
    a rlg:Decision ;
    dcterms:identifier "D322" ;
    dcterms:title "SQLite per-message rows for conversation persistence — `copilot_conversations` + `copilot_messages` tables via Alembic" ;
    rlg:rationale "SQLite is the right balance: persistent, queryable, schema-migrated. One row per message allows future conversation search and message-level linking." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M035%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/DB> ;
    rlg:governs <urn:repolens:sempkm:part/K> .

<urn:repolens:sempkm:decision/D323>
    a rlg:Decision ;
    dcterms:identifier "D323" ;
    dcterms:title "Separate `ai_personas` table from workspace `personas` — same CRUD pattern, different schema" ;
    rlg:rationale "Sharing a table would require nullable columns for both use cases and type discrimination. persona/ module is the pattern reference, not the storage target." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M035%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/U> .

<urn:repolens:sempkm:decision/D324>
    a rlg:Decision ;
    dcterms:identifier "D324" ;
    dcterms:title "SPARQL self-correction: max 2 retries (3 total), error message fed back to LLM" ;
    rlg:rationale "Well-documented pattern for LLM code generation. 3 attempts catches syntax and predicate errors. More indicates fundamental misunderstanding." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M035%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D325>
    a rlg:Decision ;
    dcterms:identifier "D325" ;
    dcterms:title "M035 requirement IDs: AI-01 through AI-10" ;
    rlg:rationale "New AI- prefix for the AI copilot domain. Follows established prefix convention (D209, D285, D298, D308, D319)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M035%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/AI> .

<urn:repolens:sempkm:decision/D326>
    a rlg:Decision ;
    dcterms:identifier "D326" ;
    dcterms:title "Character-based token estimation (~4 chars/token), no tiktoken dependency" ;
    rlg:rationale "Avoids heavy dependency for approximate arithmetic. Budget is a soft limit — precision not needed. Works across all LLM providers (OpenAI, Anthropic, Ollama/Llama)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M035%20planning> .

<urn:repolens:sempkm:decision/D327>
    a rlg:Decision ;
    dcterms:identifier "D327" ;
    dcterms:title "Copilot chat endpoint — new POST /api/copilot/chat SSE with dedicated CopilotService" ;
    rlg:rationale "Copilot needs schema context injection, SPARQL detection, and approval state — none supported by existing LLM proxies. Dedicated service class keeps copilot logic isolated from extension AI endpoints." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M035/S01%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/CX> ;
    rlg:governs <urn:repolens:sempkm:part/AI> .

<urn:repolens:sempkm:decision/D328>
    a rlg:Decision ;
    dcterms:identifier "D328" ;
    dcterms:title "SPARQL predicate validation — non-blocking warnings for unknown predicates, blocking rejection for mutation keywords" ;
    rlg:rationale "SHACL shape coverage is incomplete — rdf:type, rdfs:label, and other common predicates aren't declared in shapes. Blocking on unknowns would false-negative on legitimate queries. Mutation blocking is strict because the copilot should never modify the graph." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M035/S01> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/L> ;
    rlg:governs <urn:repolens:sempkm:part/H> ;
    rlg:governs <urn:repolens:sempkm:part/Q> ;
    rlg:governs <urn:repolens:sempkm:part/AI> .

<urn:repolens:sempkm:decision/D329>
    a rlg:Decision ;
    dcterms:identifier "D329" ;
    dcterms:title "SSE client uses ReadableStream reader instead of EventSource API" ;
    rlg:rationale "EventSource only supports GET requests. The copilot chat endpoint requires POST with a JSON body (messages array, model selection). ReadableStream gives full control over request method, headers, and body while parsing the same SSE wire format." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M035/S01> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/AI> .

<urn:repolens:sempkm:decision/D330>
    a rlg:Decision ;
    dcterms:identifier "D330" ;
    dcterms:title "CopilotService lives in `backend/app/copilot/` module, not `backend/app/services/`" ;
    rlg:rationale "The copilot module has its own Pydantic schemas, will gain conversation persistence and persona integration in S02/S03 — a package structure accommodates growth. Follows the same pattern as `backend/app/commands/`, `backend/app/sparql/`, `backend/app/auth/`." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M035/S01> ;
    rlg:governs <urn:repolens:sempkm:part/C> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/G> ;
    rlg:governs <urn:repolens:sempkm:part/AI> .

<urn:repolens:sempkm:decision/D331>
    a rlg:Decision ;
    dcterms:identifier "D331" ;
    dcterms:title "Graph context serialization: human-readable grouped text with labels, not raw RDF triples" ;
    rlg:rationale "LLMs process natural language far better than RDF syntax. Raw triples waste token budget on angle brackets and full IRIs. Matches the schema context pattern from S01's build_schema_context()." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M035/S02> ;
    rlg:governs <urn:repolens:sempkm:part/L> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D332>
    a rlg:Decision ;
    dcterms:identifier "D332" ;
    dcterms:title "Conversation persistence: per-message rows in copilot_messages table, not JSON blob" ;
    rlg:rationale "Per-message rows enable pagination, cross-conversation search, and per-message metadata (SPARQL query attachment, approval status). Matches the SparqlQueryHistory per-record pattern. JSON blob requires full deserialization for any operation." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/data-model> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M035/S02> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/K> .

<urn:repolens:sempkm:decision/D333>
    a rlg:Decision ;
    dcterms:identifier "D333" ;
    dcterms:title "Separate 2000-token budget for graph context, independent of 4000-token schema context budget" ;
    rlg:rationale "Schema context (type structure) and graph context (instance data) vary independently — installing more models shouldn't shrink instance context space. Combined total ~6000 tokens (24KB) stays well within LLM context limits." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M035/S02> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D334>
    a rlg:Decision ;
    dcterms:identifier "D334" ;
    dcterms:title "3-tier LLM test strategy: mock (CI), Ollama (local), cloud (budget-capped)" ;
    rlg:rationale "Mock gives deterministic assertions for CI. Ollama gives real inference without API costs. Cloud gives production-realistic testing with budget guardrails. Each tier has a dedicated compose file or configuration path." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M035/S04> ;
    rlg:governs <urn:repolens:sempkm:part/I> .

<urn:repolens:sempkm:decision/D335>
    a rlg:Decision ;
    dcterms:identifier "D335" ;
    dcterms:title "Mock LLM server pattern matching priority: claims first for backward compat" ;
    rlg:rationale "Adding copilot routes to the existing mock server must not break M028 claim detection tests. Priority ordering with keyword matching ensures backward compatibility while supporting the new copilot flows." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M035/S04> ;
    rlg:governs <urn:repolens:sempkm:part/AI> .

<urn:repolens:sempkm:decision/D336>
    a rlg:Decision ;
    dcterms:identifier "D336" ;
    dcterms:title "Context data in SQLite `user_context` table — single-row-per-user upsert, not RDF" ;
    rlg:rationale "Triplestore is for knowledge graph data. Context is transient device state that changes every few minutes. SQLite is the right home for ephemeral per-user state." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M037%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/T> ;
    rlg:governs <urn:repolens:sempkm:part/DB> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D337>
    a rlg:Decision ;
    dcterms:identifier "D337" ;
    dcterms:title "Expo managed workflow with development builds for mobile app" ;
    rlg:rationale "Flutter rejected (Dart, no ecosystem overlap). Bare React Native rejected (Expo wraps the hard native parts). Expo Go rejected (doesn't support native modules)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/tech> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M037%20planning> .

<urn:repolens:sempkm:decision/D338>
    a rlg:Decision ;
    dcterms:identifier "D338" ;
    dcterms:title "Direct FCM via `firebase-admin` Python SDK for push notifications" ;
    rlg:rationale "Aligns with self-hosted philosophy — no dependency on Expo's push servers. firebase-admin is Google's official SDK." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M037%20planning> .

<urn:repolens:sempkm:decision/D339>
    a rlg:Decision ;
    dcterms:identifier "D339" ;
    dcterms:title "`ContextBroadcast` SSE fan-out — same pattern as `LintBroadcast`" ;
    rlg:rationale "LintBroadcast is proven. No need for shared base class — the two broadcasts serve different event streams. Extract base if a third broadcast is needed." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M037%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/E> .

<urn:repolens:sempkm:decision/D340>
    a rlg:Decision ;
    dcterms:identifier "D340" ;
    dcterms:title "CTX-01 through CTX-19 requirement IDs for user context domain" ;
    rlg:rationale "New CTX- prefix follows established convention (D209, D285, D298, D308, D319, D325)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M037%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D341>
    a rlg:Decision ;
    dcterms:identifier "D341" ;
    dcterms:title "Rules evaluate on context update POST, not on a timer" ;
    rlg:rationale "Context updates are naturally event-driven (geofence transitions, calendar boundaries). Polling wastes CPU." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M037%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/E> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D342>
    a rlg:Decision ;
    dcterms:identifier "D342" ;
    dcterms:title "Manual persona switch suppresses auto-switching until next context change" ;
    rlg:rationale "Users expect manual choice to stick. \"Until next context change\" is a natural reset — the next geofence transition signals a meaningful state change." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M037%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D343>
    a rlg:Decision ;
    dcterms:identifier "D343" ;
    dcterms:title "Context rule conditions: JSON dict with AND semantics, first-match-wins by priority" ;
    rlg:rationale "Covers stated use case (location + time → persona) with minimal complexity. JSON conditions are schema-free and extensible. Priority ordering gives users predictable control. OR/complex expressions deferred." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M037/S02%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D344>
    a rlg:Decision ;
    dcterms:identifier "D344" ;
    dcterms:title "Rule evaluation runs synchronously in context update request handler, not as broadcast subscriber" ;
    rlg:rationale "Synchronous evaluation is simpler, avoids subscriber lifecycle management, and rule evaluation is fast (one DB query + in-memory matching). Decoupling adds complexity without benefit at this scale." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M037/S02%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D345>
    a rlg:Decision ;
    dcterms:identifier "D345" ;
    dcterms:title "Geofence sync failures in mobile app are non-blocking — zone CRUD succeeds even if registerGeofences() fails" ;
    rlg:rationale "Geofence registration is an OS-level operation that can fail for many reasons (permissions revoked, region limit exceeded, background restrictions). Blocking zone CRUD on geofence registration would make the UI feel broken when the backend is healthy. The zone data is the source of truth; geofences are re-registered on next app launch or zone mutation." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/UX> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M037/S04> .

<urn:repolens:sempkm:decision/D346>
    a rlg:Decision ;
    dcterms:identifier "D346" ;
    dcterms:title "Schedule rules in StateClient (JSON), media items + daily plans in RDF" ;
    rlg:rationale "Rules change frequently and don't benefit from graph querying. Media items are knowledge artifacts queryable by SPARQL (\"what did I listen to this week?\") and linkable to other objects. Consistent with M037 context rules pattern (SQLite config, not RDF)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M038%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/DB> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D347>
    a rlg:Decision ;
    dcterms:identifier "D347" ;
    dcterms:title "Podcast polling reuses feedparser + conditional GET from RSS Reader (M010), not a new dependency" ;
    rlg:rationale "feedparser is already a project dependency. The RSS Reader's feed_service.py is a proven pattern (subscribe, fetch, parse, dedup). Extracting a shared library adds coupling between two apps that should be independently deployable. Duplication is cheaper than abstraction at this point." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M038%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/P> .

<urn:repolens:sempkm:decision/D348>
    a rlg:Decision ;
    dcterms:identifier "D348" ;
    dcterms:title "External API clients use raw httpx (via SDK HttpClient), no Python SDK wrappers" ;
    rlg:rationale "Consistent with all existing sync apps (Linear, GitHub, Jira, Monday, Google Calendar) which use raw HTTP. Avoids new dependencies, keeps the API surface explicit, and the SDK's HttpClient enforces domain allowlists." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M038%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/P> .

<urn:repolens:sempkm:decision/D349>
    a rlg:Decision ;
    dcterms:identifier "D349" ;
    dcterms:title "Context-driven plan adaptation uses 2-minute debounce on context SSE events" ;
    rlg:rationale "Prevents thrashing from rapid activity detection changes (walking↔stationary during a meeting). Location zone changes are discrete events (geofence transitions) that warrant immediate response. Activity/calendar changes are noisy and benefit from settling time." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M038%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/E> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D350>
    a rlg:Decision ;
    dcterms:identifier "D350" ;
    dcterms:title "Media playback via deep links to native apps, not embedded players" ;
    rlg:rationale "Building a reliable audio/video player is out of scope. Users already have preferred apps for each media type. Deep links provide the best UX — one tap to start playing in the right app. Podcast audio player could be added later as a progressive enhancement." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/UX> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M038%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/P> .

<urn:repolens:sempkm:decision/D351>
    a rlg:Decision ;
    dcterms:identifier "D351" ;
    dcterms:title "Media scheduler ontology: flat enum (sh:in) for sourceType, not OWL subclasses" ;
    rlg:rationale "Flat enum simplifies SPARQL (single type, filter by sourceType) vs subclass hierarchy (PodcastSource, YouTubeSource, SpotifySource). Consistent with other model patterns in the codebase." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M038/S01%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/O> .

<urn:repolens:sempkm:decision/D352>
    a rlg:Decision ;
    dcterms:identifier "D352" ;
    dcterms:title "Media scheduler app owns its model (media-scheduler), does not extend rss-feeds" ;
    rlg:rationale "Independent evolution of both models. No confusing type overlap. Consistent with app-per-model separation." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M038/S01%20planning> .

<urn:repolens:sempkm:decision/D353>
    a rlg:Decision ;
    dcterms:identifier "D353" ;
    dcterms:title "Spotify OAuth requires HTTPS redirect URI — HTTP rejected" ;
    rlg:rationale "Discovered by user during Spotify portal configuration. Unlike some OAuth providers, Spotify does not allow HTTP even for localhost development." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/integration> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M038/S04%20%28early%29> .

<urn:repolens:sempkm:decision/D354>
    a rlg:Decision ;
    dcterms:identifier "D354" ;
    dcterms:title "Time range rule evaluation behavior when current_time is missing from context" ;
    rlg:rationale "A time-scoped rule matching when there's no time data could trigger media playback at inappropriate times. Fail-closed is the safe default for context-driven automation. Wildcard behavior is already available via null conditions for fields where \"match any\" is intentional." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M038/S02/T01> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D355>
    a rlg:Decision ;
    dcterms:identifier "D355" ;
    dcterms:title "How to handle old daily plan entries when regenerating a plan" ;
    rlg:rationale "object.delete is a separate permission the app may not have. Patching status preserves history (what was planned before regeneration) and is consistent with the event-sourced write model. The today view SPARQL excludes \"replaced\" entries." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/arch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M038/S02/T02> ;
    rlg:governs <urn:repolens:sempkm:part/E> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D356>
    a rlg:Decision ;
    dcterms:identifier "D356" ;
    dcterms:title "Object-level ownership model (F-002)" ;
    rlg:rationale "Single-user/small-team is the target. Federation provides cross-instance sharing. Per-object ownership would touch every CRUD endpoint for a use case that doesn't exist." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/security> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M042%20Security%20Audit%20findings> ;
    rlg:governs <urn:repolens:sempkm:part/F> .

<urn:repolens:sempkm:decision/D357>
    a rlg:Decision ;
    dcterms:identifier "D357" ;
    dcterms:title "Session management hardening (F-013)" ;
    rlg:rationale "revoke_all_sessions() already exists but is unwired. Session cap prevents unbounded accumulation. Daily cleanup replaces startup-only cleanup for long-running instances." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/security> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M042%20Security%20Audit%20findings> .

<urn:repolens:sempkm:decision/D358>
    a rlg:Decision ;
    dcterms:identifier "D358" ;
    dcterms:title "Demo mode safeguard (F-019)" ;
    rlg:rationale "Demo mode is intentional for the hosted demo. A warning surfaces misconfiguration without blocking legitimate use. Hard block adds override-flag complexity for an unlikely scenario." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/security> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M042%20Security%20Audit%20findings> .

<urn:repolens:sempkm:decision/D359>
    a rlg:Decision ;
    dcterms:identifier "D359" ;
    dcterms:title "Central SPARQL query builder approach for injection prevention" ;
    rlg:rationale "Research findings: (1) SPARQLWrapper has no parameterized query support (open issue since 2018). (2) Apache Jena's ParameterizedSparqlString is Java-only with known limitations. (3) rdflib's prepareQuery/initBindings doesn't work with remote SPARQLStore endpoints. (4) The pudo/sparqlquery project is abandoned. (5) rdflib's .n3() method IS the right primitive — URIRef.n3() rejects malicious IRIs with exceptions, Literal.n3() properly escapes all injection characters. Building on .n3() gives us type-safe serialization without a new dependency. The builder consolidates 9 scattered escape functions + _validate_iri into one authoritative module." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/security/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M043%20Security%20Hardening%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D360>
    a rlg:Decision ;
    dcterms:identifier "D360" ;
    dcterms:title "Whether to standardize htmx patterns: 14 trigger types, inconsistent debounce (200ms vs 300ms), revealed vs intersect, and undocumented conventions" ;
    rlg:rationale "htmx patterns are already 88% consistent — formalizing the de facto standard prevents drift. The 200ms vs 300ms debounce difference is likely accidental (same intent, different author). revealed is a legacy htmx trigger; intersect once is the documented modern equivalent." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/frontend%20/%20htmx%20conventions> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M041%20S02%20frontend%20audit> .

<urn:repolens:sempkm:decision/D361>
    a rlg:Decision ;
    dcterms:identifier "D361" ;
    dcterms:title "SPARQL injection defense strategy — validate early at HTTP boundary" ;
    rlg:rationale "If safe_iri() is only called deep in the service layer, ValueError propagates as 500 instead of 400. Early validation at the router gives clean error responses and security audit logging. The service-layer calls catch edge cases where system data becomes corrupted or an internal caller bypasses the router." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/security> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M043/S01/T04> ;
    rlg:governs <urn:repolens:sempkm:part/N> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/Q> .

<urn:repolens:sempkm:decision/D362>
    a rlg:Decision ;
    dcterms:identifier "D362" ;
    dcterms:title "CORS header ownership — single source of truth" ;
    rlg:rationale "Dual CORS headers (nginx + FastAPI) caused duplicate header issues and confusion about which layer controlled access. Single-sourcing in FastAPI makes CORS testable via unit tests and keeps proxy layers as pure pass-through. The well-known override uses BaseHTTPMiddleware with `del response.headers[key]` (not .pop() — Starlette MutableHeaders doesn't implement pop)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/security/infrastructure> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M043/S02/T02> ;
    rlg:governs <urn:repolens:sempkm:part/N> ;
    rlg:governs <urn:repolens:sempkm:part/A> .

<urn:repolens:sempkm:decision/D363>
    a rlg:Decision ;
    dcterms:identifier "D363" ;
    dcterms:title "HTTP security headers standard set for all proxy layers" ;
    rlg:rationale "F-021 finding. Headers applied at proxy layer (nginx/Caddy) so they cover all responses including static files, not just FastAPI routes. CSP allowlist matches the three CDNs used by FullCalendar, Leaflet, and Yasgui — would be removed when those are vendored (M029 pipeline). 'unsafe-inline' is required for existing htmx inline event handlers and inline styles." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/security/infrastructure> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M043/S02/T02> ;
    rlg:governs <urn:repolens:sempkm:part/U> ;
    rlg:governs <urn:repolens:sempkm:part/N> ;
    rlg:governs <urn:repolens:sempkm:part/A> ;
    rlg:governs <urn:repolens:sempkm:part/E> .

<urn:repolens:sempkm:decision/D364>
    a rlg:Decision ;
    dcterms:identifier "D364" ;
    dcterms:title "Obsidian vault upload size cap" ;
    rlg:rationale "F-027 finding — the Obsidian import endpoint had client_max_body_size 0 (unlimited), allowing unbounded uploads. 500MB accommodates large Obsidian vaults while preventing abuse. Other endpoints stay at nginx default 10m." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/security> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M043/S02/T02> ;
    rlg:governs <urn:repolens:sempkm:part/N> ;
    rlg:governs <urn:repolens:sempkm:part/X> .

<urn:repolens:sempkm:decision/D365>
    a rlg:Decision ;
    dcterms:identifier "D365" ;
    dcterms:title "M043/S03 — Single-use magic link enforcement location" ;
    rlg:rationale "Preserves clean separation between cryptographic verification (stateless, no DB) and stateful consumption tracking. The itsdangerous verify is fast and rejects most invalid tokens before hitting the DB." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/security/auth> ;
    rlg:governs <urn:repolens:sempkm:part/G> .

<urn:repolens:sempkm:decision/D366>
    a rlg:Decision ;
    dcterms:identifier "D366" ;
    dcterms:title "M043/S03 — API token scope enforcement surface" ;
    rlg:rationale "The practical external API surface is SPARQL + commands + copilot. Object mutations via external clients go through the commands router (already scoped). Admin endpoints are owner-gated browser-only. Adding scope checks to htmx endpoints would require changing their auth dependency chain for no security benefit — those endpoints don't accept Bearer tokens." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/security/auth> ;
    rlg:governs <urn:repolens:sempkm:part/C> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/B> ;
    rlg:governs <urn:repolens:sempkm:part/G> ;
    rlg:governs <urn:repolens:sempkm:part/AI> .

<urn:repolens:sempkm:decision/D367>
    a rlg:Decision ;
    dcterms:identifier "D367" ;
    dcterms:title "M043/S03 — Periodic session/token cleanup scheduling mechanism" ;
    rlg:rationale "Zero new dependencies. Proper cancellation via task.cancel() in lifespan shutdown. The cleanup is lightweight (two DELETE queries) and runs once daily — doesn't justify a scheduler library." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> .

<urn:repolens:sempkm:decision/D368>
    a rlg:Decision ;
    dcterms:identifier "D368" ;
    dcterms:title "Audit logging failure isolation policy" ;
    rlg:rationale "Security audit logging is observability infrastructure. If the audit log DB is temporarily unavailable, the login/token-creation/session-revocation operation must still succeed. The helper manages its own DB session and swallows exceptions with ERROR-level logging." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/security> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M043/S04/T02> .

<urn:repolens:sempkm:decision/D369>
    a rlg:Decision ;
    dcterms:identifier "D369" ;
    dcterms:title "Centralized fetch wrapper design: apiFetch() behavior and migration strategy" ;
    rlg:rationale "Every file already has its own error handling (inline UI messages, custom toasts, status elements). Double-toasting from apiFetch + caller would confuse users. Using {silent:true} universally means apiFetch provides the safety net (network errors, unexpected 5xx) while callers keep their specific UX. Auth.js /api/auth/me is exempt because apiFetch's 401 redirect loses the ?next= query parameter needed for return-URL preservation. Toast CSS must be in theme.css (not workspace.css) so it renders on auth pages that don't load the workspace stylesheet." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/frontend%20/%20fetch> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M044/S01> ;
    rlg:governs <urn:repolens:sempkm:part/U> ;
    rlg:governs <urn:repolens:sempkm:part/G> .

<urn:repolens:sempkm:decision/D370>
    a rlg:Decision ;
    dcterms:identifier "D370" ;
    dcterms:title "Window namespace consolidation strategy for cross-IIFE globals" ;
    rlg:rationale "Three-phase rollout with shims ensures zero breakage at any intermediate stage — templates and E2E tests work against both old and new names during migration. Keeping existing `SemPKM*` concatenated names avoids unnecessary churn for already-safe globals. Keeping `_sempkm` prefixes under the namespace object is mechanically safer than renaming (shim pattern works identically for all globals). Debug pages have their own local `switchTab`/`executeCommand` from `app.js` — migrating those would break them since `app.js` is not an IIFE and doesn't export to window.SemPKM." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/frontend%20/%20namespace> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M044/S03> ;
    rlg:governs <urn:repolens:sempkm:part/J> .

<urn:repolens:sempkm:decision/D371>
    a rlg:Decision ;
    dcterms:identifier "D371" ;
    dcterms:title "How to handle decorative per-section colors in BMC, quadrant, OKR, and decision-matrix CSS files" ;
    rlg:rationale "The research initially suggested leaving BMC/quadrant/OKR decorative colors as exemptions (counting toward ≤20 rgba). However, those files alone have 127 standalone rgba values — far exceeding the budget. Full conversion with primitive tokens adds ~15 lines to theme.css but enables proper dark-mode support (brighter section colors on dark backgrounds) and eliminates ~291 lines of dark-mode override blocks across these files. The quadrant colors already match existing primitives (--_color-green-500 etc.), reducing new tokens needed." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/frontend%20/%20CSS%20theme> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M044/S04> .

<urn:repolens:sempkm:decision/D372>
    a rlg:Decision ;
    dcterms:identifier "D372" ;
    dcterms:title "Federation SHA-256 hash verification backward compatibility strategy (F-036)" ;
    rlg:rationale "Breaking federation by rejecting hashless patches would require coordinated upgrades across all federation peers. Warning-only for missing hashes allows gradual rollout. Mandatory verification when present catches tampering from upgraded peers." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/security> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M045/S01> ;
    rlg:governs <urn:repolens:sempkm:part/F> .

<urn:repolens:sempkm:decision/D373>
    a rlg:Decision ;
    dcterms:identifier "D373" ;
    dcterms:title "Docker compose cloud overlay inherits security_opt/cap_drop from base" ;
    rlg:rationale "Adding security_opt/cap_drop to both base and cloud overlay causes docker compose config validation error (duplicate keys). The cloud overlay extends base, so security directives propagate automatically. Verified with docker compose -f docker-compose.yml -f docker-compose.cloud.yml config showing no-new-privileges on both services." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/infrastructure> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M045/S02/T01> ;
    rlg:governs <urn:repolens:sempkm:part/Q> .

<urn:repolens:sempkm:decision/D374>
    a rlg:Decision ;
    dcterms:identifier "D374" ;
    dcterms:title "Strategy for fixing M044 namespace migration leftovers in HTML template onclick handlers" ;
    rlg:rationale "The M044/S03 migration moved all window globals to window.SemPKM.* and removed backward-compat shims. Several templates (timeline_view.html, create_class_form.html) still use bare globals in onclick= handlers because the migration only updated JS files and missed HTML template inline handlers. Adding shims back would regress M044's cleanup; fixing the templates directly is the correct approach." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/E2E%20/%20templates> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M046/S06> ;
    rlg:governs <urn:repolens:sempkm:part/J> .

<urn:repolens:sempkm:decision/D375>
    a rlg:Decision ;
    dcterms:identifier "D375" ;
    dcterms:title "RBox ontology viewer data-testid mismatch: fix test selectors or template?" ;
    rlg:rationale "The template generates `data-testid=\"{{ testid }}-{{ source }}\"` (e.g., rbox-object-table-gist) which is more specific and useful for debugging. The E2E test expects `[data-testid=\"rbox-object-table\"]` without suffix. Changing to prefix-match in the test preserves the template's specificity while making the test work across any source value (gist, user, etc.)." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/E2E%20/%20templates> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M046/S06> ;
    rlg:governs <urn:repolens:sempkm:part/J> ;
    rlg:governs <urn:repolens:sempkm:part/O> .

<urn:repolens:sempkm:decision/D376>
    a rlg:Decision ;
    dcterms:identifier "D376" ;
    dcterms:title "Serialization format for TBox dashboards and workflows in model manifests" ;
    rlg:rationale "Dashboards and workflows are UI constructs stored in SQLite, not RDF knowledge-domain concepts. Using RDF would create an impedance mismatch (serialize to RDF in manifest → parse to JSON → store in SQLite). The JSON format maps directly to the existing service CRUD methods with zero translation layer." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M047%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/E> ;
    rlg:governs <urn:repolens:sempkm:part/DB> .

<urn:repolens:sempkm:decision/D377>
    a rlg:Decision ;
    dcterms:identifier "D377" ;
    dcterms:title "How to distinguish model-sourced vs user-created dashboards and workflows" ;
    rlg:rationale "Simple column addition enables clean install (INSERT with source_model), uninstall (DELETE WHERE source_model = ?), refresh (delete + recreate), and user customization (SET source_model = NULL to detach). SQLite ALTER TABLE ADD COLUMN is safe. No need for a separate junction table." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M047%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/DB> .

<urn:repolens:sempkm:decision/D378>
    a rlg:Decision ;
    dcterms:identifier "D378" ;
    dcterms:title "Manifest version detection strategy for backward compatibility" ;
    rlg:rationale "Minimum-change approach. Pydantic optional fields naturally handle v1 manifests that omit the new fields — they default to None and the loader skips them. No migration of existing manifests needed. All 6 v1 models continue working unchanged." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M047%20planning> .

<urn:repolens:sempkm:decision/D379>
    a rlg:Decision ;
    dcterms:identifier "D379" ;
    dcterms:title "Whether to build task template infrastructure in M047" ;
    rlg:rationale "No existing TemplateSpec model, service, or UI infrastructure exists. Building it from scratch adds significant scope with low marginal value — the core PPV value is in dashboards and workflows, not templates. A workflow create-form step achieves the same user experience." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/scope> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M047%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/J> .

<urn:repolens:sempkm:decision/D380>
    a rlg:Decision ;
    dcterms:identifier "D380" ;
    dcterms:title "Where TBox SQLite writes happen relative to RDF4J transaction in the install pipeline" ;
    rlg:rationale "The model installer already uses this pattern for seed data (step 10 in the 12-step pipeline). RDF4J transaction is the critical path. If SQLite creation fails after RDF commits, the model is installed but missing operational surfaces — a degraded but recoverable state. Full two-phase commit across RDF4J + SQLite would add complexity without proportional benefit." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M047%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/T> ;
    rlg:governs <urn:repolens:sempkm:part/DB> .

<urn:repolens:sempkm:decision/D381>
    a rlg:Decision ;
    dcterms:identifier "D381" ;
    dcterms:title "How user_id is threaded through ModelService for TBox dashboard/workflow creation" ;
    rlg:rationale "The model install endpoint already authenticates the user (require_role('owner')). Threading user_id through the service layer is the minimal change — no new dependency injection needed. Making dashboard/workflow services optional on the constructor preserves backward compatibility for existing tests that construct ModelService without them." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M047/S01> ;
    rlg:governs <urn:repolens:sempkm:part/DS> .

<urn:repolens:sempkm:decision/D382>
    a rlg:Decision ;
    dcterms:identifier "D382" ;
    dcterms:title "How TBox workflow steps reference TBox dashboards defined in the same model" ;
    rlg:rationale "TBox dashboard UUIDs are minted at install time — they can't be hardcoded in the model archive JSON. Name-based resolution at install time is simple (~15 lines), requires no schema changes, and uses the natural install sequence (dashboards are created before workflows already). The alternative (name-based lookup in the workflow router) would require router changes and wouldn't work for user-created workflows referencing user-created dashboards." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M047/S03> ;
    rlg:governs <urn:repolens:sempkm:part/DS> .

<urn:repolens:sempkm:decision/D383>
    a rlg:Decision ;
    dcterms:identifier "D383" ;
    dcterms:title "Jaeger version for distributed tracing" ;
    rlg:rationale "Jaeger v1 reached end-of-life December 31, 2025. Jaeger v2 is built on the OpenTelemetry Collector framework and natively ingests OTLP without additional configuration. The Docker image is jaegertracing/jaeger:latest." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M049/S02> ;
    rlg:governs <urn:repolens:sempkm:part/P> .

<urn:repolens:sempkm:decision/D384>
    a rlg:Decision ;
    dcterms:identifier "D384" ;
    dcterms:title "Whether object.delete should cascade to inbound edges (triples where the deleted object is the RDF object, not the subject)" ;
    rlg:rationale "Leaving dangling references causes silent data corruption — views, relations panels, and SPARQL queries would reference non-existent objects. The inbound edge triples are included in the delete event's data for audit purposes, so provenance is preserved." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M048/S03> ;
    rlg:governs <urn:repolens:sempkm:part/N> ;
    rlg:governs <urn:repolens:sempkm:part/E> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/V> .

<urn:repolens:sempkm:decision/D385>
    a rlg:Decision ;
    dcterms:identifier "D385" ;
    dcterms:title "How to handle LuceneSail index storage in Docker" ;
    rlg:rationale "Separate Docker named volumes are created with root ownership. The RDF4J triplestore runs as the tomcat user. On fresh-volume deploys, the lucene_index volume was root-owned and unwritable by tomcat, causing RepositoryLockedException on every access. Since /var/rdf4j/lucene is a child path of /var/rdf4j, housing it inside the parent rdf4j_data volume gives it tomcat ownership automatically." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/infrastructure> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M048/S04/T02> ;
    rlg:governs <urn:repolens:sempkm:part/T> .

<urn:repolens:sempkm:decision/D386>
    a rlg:Decision ;
    dcterms:identifier "D386" ;
    dcterms:title "RDF4J repository readiness after fresh creation" ;
    rlg:rationale "After PUT creates a new RDF4J repository, the LuceneSail + NativeStore needs initialization time. Immediate SPARQL operations can fail with 500. The /size endpoint returning 200 is a reliable readiness signal. Retry with backoff avoids race conditions on fresh-volume deploys." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/infrastructure> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M048/S04/T02> ;
    rlg:governs <urn:repolens:sempkm:part/T> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D387>
    a rlg:Decision ;
    dcterms:identifier "D387" ;
    dcterms:title "OTel tracing initialization ordering in FastAPI lifespan" ;
    rlg:rationale "HTTPXClientInstrumentor monkey-patches httpx.AsyncClient — if called after client creation, SPARQL HTTP spans are not captured. shutdown_tracing() before client.close() ensures BatchSpanProcessor can flush pending spans via the still-open HTTP connection to Jaeger." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture/observability> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M049/S02> ;
    rlg:governs <urn:repolens:sempkm:part/A> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D388>
    a rlg:Decision ;
    dcterms:identifier "D388" ;
    dcterms:title "Server-Timing header naming format for per-query SPARQL entries" ;
    rlg:rationale "Server-Timing spec requires unique metric names per header. Multiple SPARQL queries of the same type (e.g. two SELECT queries) within one request need distinct names. The 1-indexed suffix per entry provides uniqueness while preserving readability in DevTools." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/observability> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M049/S03/T01> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D389>
    a rlg:Decision ;
    dcterms:identifier "D389" ;
    dcterms:title "Whether to remove View Variants dropdown or rework it" ;
    rlg:rationale "View Variants is confusing UX — users don't understand \"variant\" vs \"renderer\". Saved views don't reference variant IDs. The dropdown only appears when a type is selected and shows model-declared ViewSpecs, which overlap with the generic renderers. Removing it simplifies the toolbar with zero data model impact. Model-declared ViewSpecs remain accessible through the explorer sidebar VIEWS section." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/frontend%20/%20UX> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M050%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/V> .

<urn:repolens:sempkm:decision/D390>
    a rlg:Decision ;
    dcterms:identifier "D390" ;
    dcterms:title "How to implement smart type filtering per renderer" ;
    rlg:rationale "The detection methods already exist and are proven (KNOWLEDGE patterns P5, P13, P14). Iterating all types is fast because `get_node_shapes()` is cached — each `get_form_for_type()` call filters from the cached list. A new endpoint `/views/compatible-types` also allows the frontend to lazy-load types if needed later. No new SPARQL queries needed — just reuse of existing SHACL introspection." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/frontend%20/%20views> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M050/S01> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/V> .

<urn:repolens:sempkm:decision/D391>
    a rlg:Decision ;
    dcterms:identifier "D391" ;
    dcterms:title "Where to strip ' Shape' suffix from type labels" ;
    rlg:rationale "The label comes from rdfs:label on SHACL NodeShape nodes (e.g. 'Project Shape'). Stripping in get_types() fixes all downstream consumers at once — explorer nav tree, type picker, command palette, view type dropdowns. The existing workspace.js client-side strip for command palette becomes redundant but harmless." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/UX> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M051> ;
    rlg:governs <urn:repolens:sempkm:part/U> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/L> .

<urn:repolens:sempkm:decision/D392>
    a rlg:Decision ;
    dcterms:identifier "D392" ;
    dcterms:title "M052 slice grouping strategy — how to partition 15+ polish items into demoable slices" ;
    rlg:rationale "Grouping by rendering surface minimizes cross-file conflicts between slices. The kanban slice is isolated first because it's the only backend SPARQL change. Property and navigation chrome slices are independent — they touch different CSS files and templates. The final slice collects low-risk remaining items and serves as integration verification." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M052%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/S> ;
    rlg:governs <urn:repolens:sempkm:part/J> .

<urn:repolens:sempkm:decision/D393>
    a rlg:Decision ;
    dcterms:identifier "D393" ;
    dcterms:title "M052 kanban column color mapping strategy" ;
    rlg:rationale "A keyword heuristic works across any Mental Model's status enum without requiring model authors to declare colors. It covers the most common status naming patterns. If a status value doesn't match any keyword, it gets a neutral border. This avoids adding a new manifest field for a purely cosmetic feature." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M052/S01%20planning> .

<urn:repolens:sempkm:decision/D394>
    a rlg:Decision ;
    dcterms:identifier "D394" ;
    dcterms:title "M052/S01 kanban enrichment field detection strategy — how to identify priority and due-date fields for card enrichment" ;
    rlg:rationale "Follows the established pattern from _detect_status_field() and _detect_date_fields() — scan SHACL PropertyShapes by path keyword and datatype. No manifest extension needed. OPTIONAL SPARQL clauses ensure zero breakage for types that lack enrichment fields. The priority keyword heuristic covers standard naming patterns (priority, taskPriority, issuePriority) across Mental Models." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M052/S01> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D395>
    a rlg:Decision ;
    dcterms:identifier "D395" ;
    dcterms:title "Model marketplace registry format and hosting" ;
    rlg:rationale "Model archives are tiny (40-264KB). A static registry.json index + .tar.gz archives in a GitHub repo can be served at zero cost with HTTPS, global CDN, and high availability. No backend server to maintain, no API keys to manage. Users can fork the registry for private/custom models." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M053> ;
    rlg:governs <urn:repolens:sempkm:part/U> ;
    rlg:governs <urn:repolens:sempkm:part/M> .

<urn:repolens:sempkm:decision/D396>
    a rlg:Decision ;
    dcterms:identifier "D396" ;
    dcterms:title "Downloaded marketplace model storage location" ;
    rlg:rationale "/app/models/ is read-only in the Docker container (mounted :ro). The writable sempkm_data volume at /app/data/ already persists across restarts. Adding /app/data/models/ as a secondary search path keeps bundled models separate from downloaded ones while reusing the existing persistent volume." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M053> ;
    rlg:governs <urn:repolens:sempkm:part/K> .

<urn:repolens:sempkm:decision/D397>
    a rlg:Decision ;
    dcterms:identifier "D397" ;
    dcterms:title "Model archive format for HTTP distribution" ;
    rlg:rationale "Model directories have a flat structure (manifest.yaml + subdirs) that tar.gz preserves exactly. Python tarfile is stdlib — no new dependencies. Security: extract to tempdir first, validate manifest + contents, then atomic move to install location. Tarfile bomb/traversal protection adapted from existing zip_validator.py pattern." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M053> ;
    rlg:governs <urn:repolens:sempkm:part/Q> .

<urn:repolens:sempkm:decision/D398>
    a rlg:Decision ;
    dcterms:identifier "D398" ;
    dcterms:title "Model archive trust model for M053" ;
    rlg:rationale "SHA-256 hash comparison provides integrity verification (tampered/corrupted archives rejected). Full cryptographic signing (GPG/Sigstore) adds significant complexity for marginal security gain when the registry is first-party and served over HTTPS. Models contain executable SHACL-AF rules, but the trust boundary is the registry source, not individual archives." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/security> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M053> ;
    rlg:governs <urn:repolens:sempkm:part/M> ;
    rlg:governs <urn:repolens:sempkm:part/CX> .

<urn:repolens:sempkm:decision/D399>
    a rlg:Decision ;
    dcterms:identifier "D399" ;
    dcterms:title "Model directory resolution approach for marketplace models" ;
    rlg:rationale "S02 scope requires only that marketplace-installed models work end-to-end (install → icons load → refresh artifacts → entailment defaults). The auto-discover scan in S01 correctly scans only bundled models — marketplace models appear in the \"Installed\" table, not the \"Available\" cards section. Minimum viable change is 3 call sites + IconService, not all 10+ references to /app/models/." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M053/S02%20planning> .

<urn:repolens:sempkm:decision/D400>
    a rlg:Decision ;
    dcterms:identifier "D400" ;
    dcterms:title "How to build composable SPARQL queries for filter/group/sort" ;
    rlg:rationale "strategies.py already solves multi-level grouping with chain narrowing filters. Reusing these proven SPARQL builders avoids duplicating complex query logic. The new explorer query builder wraps them with a config-driven dispatch layer." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M054> ;
    rlg:governs <urn:repolens:sempkm:part/S> .

<urn:repolens:sempkm:decision/D401>
    a rlg:Decision ;
    dcterms:identifier "D401" ;
    dcterms:title "How to structure the composable explorer backend for M054/S01" ;
    rlg:rationale "Follows D400's direction to reuse strategies.py query builders. Keeps the composition logic in a dedicated module rather than cluttering workspace.py further (already 1341 lines). The config-options API enables the frontend to dynamically populate dropdowns based on installed models' SHACL shapes. Templates follow the existing mount_tree.html pattern for folder/children lazy loading." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M054/S01> ;
    rlg:governs <urn:repolens:sempkm:part/U> ;
    rlg:governs <urn:repolens:sempkm:part/J> ;
    rlg:governs <urn:repolens:sempkm:part/H> .

<urn:repolens:sempkm:decision/D402>
    a rlg:Decision ;
    dcterms:identifier "D402" ;
    dcterms:title "Multi-panel DOM access strategy for duplicate OBJECTS sections" ;
    rlg:rationale "IDs must be unique per document, so duplicating a section with the same IDs breaks `getElementById()`. Class-based selectors scoped to a parent element are the standard pattern for repeated UI components. The refactor is contained within explorer-config.js and the config panel template — no other files reference these IDs." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/M054/S02> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M054/S02> .

<urn:repolens:sempkm:decision/D403>
    a rlg:Decision ;
    dcterms:identifier "D403" ;
    dcterms:title "Closed tab stack persistence" ;
    rlg:rationale "The stack is for undo-close during a single work session. Cross-session persistence adds complexity (stale IRIs, deleted objects) for minimal value. Browser convention (Ctrl+Shift+T) is also session-scoped in most browsers." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M055%20planning> ;
    rlg:governs <urn:repolens:sempkm:part/B> .

<urn:repolens:sempkm:decision/D404>
    a rlg:Decision ;
    dcterms:identifier "D404" ;
    dcterms:title "R016 — Bookmarkable URLs" ;
    rlg:rationale "E2E test 4 navigates to /browser/?tab=<iri> and asserts the correct object tab opens. Manually verified in browser during T02 — deep-link opens tab, refresh preserves it." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/requirement> ;
    rlg:governs <urn:repolens:sempkm:part/B> .

<urn:repolens:sempkm:decision/D405>
    a rlg:Decision ;
    dcterms:identifier "D405" ;
    dcterms:title "R017" ;
    rlg:rationale "Duplicate of R014. Same evidence: Ctrl+Shift+T and command palette \"Reopen Closed Tab\" both work. 8 E2E tests pass across Chromium and Firefox." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/requirement> .

<urn:repolens:sempkm:decision/D406>
    a rlg:Decision ;
    dcterms:identifier "D406" ;
    dcterms:title "TBox tab layout: graph vs tree as primary view" ;
    rlg:rationale "The graph is the milestone's core value proposition. The tree remains as secondary navigation for users who prefer text-based browsing. A toggle switch keeps both accessible without tabs-within-tabs complexity." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/architecture> ;
    rlg:decidedDuring <urn:repolens:sempkm:milestone/M056%20planning> .

<urn:repolens:sempkm:decision/D407>
    a rlg:Decision ;
    dcterms:identifier "D407" ;
    dcterms:title "R021 — Clicking graph node shows class detail in bottom panel" ;
    rlg:rationale "ontology-graph.js wires Cytoscape node tap event to existing loadClassDetail() function which loads class properties, relationships, and instance count in the bottom detail panel via the existing /browser/ontology/tbox/detail endpoint." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/requirement> ;
    rlg:governs <urn:repolens:sempkm:part/E> ;
    rlg:governs <urn:repolens:sempkm:part/B> ;
    rlg:governs <urn:repolens:sempkm:part/O> .

<urn:repolens:sempkm:decision/D408>
    a rlg:Decision ;
    dcterms:identifier "D408" ;
    dcterms:title "R022" ;
    rlg:rationale "T01 added cy.resize() call in switchOntologyTab() when tabId === 'tbox'. No cy.fit() added — verified by grep count (exactly 1 in file, existing in toggleTboxView). Zoom/pan state preserved on tab switch." ;
    rlg:sourceDocument ".gsd/DECISIONS.md" ;
    rlg:scope <urn:repolens:sempkm:scope/requirement> .


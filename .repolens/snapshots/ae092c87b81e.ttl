    a rl:Check ;
    dcterms:title "Most writes notify nobody" ;
    rl:checkKind "coverage" ;
    rl:passed false ;
    rl:expected "0 uncovered modules" ;
    rl:actual "9" ;
    rl:severity rl:high .

<urn:repolens:sempkm:check/validation-coverage>

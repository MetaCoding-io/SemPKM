<urn:repolens:sempkm:part/S>
    a rl:Part ;
    dcterms:title "SPARQL client" ;
    rl:shortName "SPARQL" ;
    rl:key "S" ;
    rl:partOf <urn:repolens:sempkm:repo> ;
    dcterms:description "Every read goes through here. Its most important job is scoping: rewriting queries so they can only see the current-state graph, which keeps raw event history from leaking into ordinary reads." ;
    skos:note "3,352 lines across 12 files: a passthrough router for the admin console, the scoping rewriter, and the query paths used by views and the browser. Also serves the federated mirror endpoint." ;

    rl:passed true ;
    rl:expected "empty output" ;
    rl:actual "exit 0" ;
    rl:severity rl:high .

<urn:repolens:sempkm:finding/f00>
    a rl:Finding ;
    dcterms:title "The documentation is five months behind the code" ;
    dcterms:description "CODEBASE.md is dated 12 March and describes 24 modules, 2 mental models and 82 specs in 28 directories. The tree holds 39 modules, 8 models and 126 specs in 55 directories. Federation, apps, copilot, context, ontology, notion, dashboard and persona do not appear in it at all, and it still describes browser/router.py as a 1,570-line monolith — that file is now a 38-line aggregator." ;
    rl:evidence "CODEBASE.md header 'Last updated: 2026-03-12'; ls backend/app → 39 dirs; ls models → 8; find e2e/tests -name '*.spec.ts' → 126; wc -l backend/app/browser/router.py → 38." ;
    rl:severity rl:medium ;
    rl:provenance rl:authored .

<urn:repolens:sempkm:finding/f01>
    a rl:Finding ;
    dcterms:title "Presentation modules hold the most write sites" ;
    dcterms:description "In a volatility-based reading, browser/ and vfs/ are client-tier: they render pages and serve files. Between them they hold 10 of the 28 commit sites, reaching past the managers tier straight into resource access. Nothing is broken by it, but the write surface is now spread across the layer that changes most often." ;
    rl:evidence "browser/{objects,comments,events}.py → 8 commit sites; vfs/write.py → 2. Both import from app.commands.handlers directly." ;
    rl:severity rl:medium ;
    rl:about <urn:repolens:sempkm:part/B> ;
    rl:provenance rl:authored .

<urn:repolens:sempkm:finding/f02>
    a rl:Finding ;
    dcterms:title "Two files carry outsized responsibility" ;
    dcterms:description "views/service.py is 3,859 lines — the largest file in the backend — inside a module of only four files totalling 5,923 lines. ontology/service.py is 2,277. Both are candidates for the split that browser/ already received, which turned a 1,570-line router into 17 focused files." ;
    rl:evidence "wc -l: views/service.py 3859, ontology/service.py 2277, views/router.py 1983, admin/router.py 1906." ;
    rl:severity rl:low ;
    rl:about <urn:repolens:sempkm:part/V> ;
    rl:provenance rl:authored .

<urn:repolens:sempkm:finding/f03>
    a rl:Finding ;
    dcterms:title "Named graphs grow without bound" ;
    dcterms:description "One immutable named graph per write, kept forever. That is the intended trade for a complete audit trail rather than a leak, but nothing in the tree prunes, compacts or archives them, so store size tracks total write count for the life of the instance." ;
    rl:evidence "events/store.py mints urn:sempkm:event:{uuid} per commit; no deletion path in the module." ;
    rl:severity rl:note ;
    rl:about <urn:repolens:sempkm:part/T> ;
    rl:provenance rl:authored .

<urn:repolens:sempkm:finding/f04>
    a rl:Finding ;
    dcterms:title "The validation queue is in-process" ;
    dcterms:description "An asyncio queue held in memory and started in the lifespan. A container restart drops whatever was pending; validation is re-triggered by the next write rather than resumed." ;
    rl:evidence "validation/queue.py — AsyncValidationQueue, started in main.py lifespan, no persistence." ;
    rl:severity rl:note ;
    rl:about <urn:repolens:sempkm:part/Q> ;
    rl:provenance rl:authored .

<urn:repolens:sempkm:finding/f05>
    a rl:Finding ;
    dcterms:title "Every previously recorded concern is fixed" ;
    dcterms:description "The February planning notes listed SMTP delivery as a stub, the session cookie as hardcoded insecure, the label cache as never invalidated and Alembic as wired up but unused. All four are resolved in the current tree — and the notes were never updated to say so." ;
    rl:evidence "services/email.py uses aiosmtplib; auth/router.py:54 reads settings.cookie_secure; label invalidate() called from 6 sites; 26 files in backend/migrations/versions/." ;
    rl:severity rl:good ;
    rl:about <urn:repolens:sempkm:part/G> ;
    rl:provenance rl:authored .

<urn:repolens:sempkm:finding/f06>
    a rl:Finding ;
    dcterms:title "No TODO, FIXME or HACK markers anywhere in the backend" ;
    dcterms:description "Zero occurrences across 169,932 lines of Python. Unusual at this size, and it means the findings above had to come from reading structure rather than from the trail of notes a codebase usually leaves about itself." ;
    rl:evidence "rg -c 'TODO|FIXME|HACK|XXX' backend/app → 0." ;
    rl:severity rl:good ;
    rl:provenance rl:authored .

<urn:repolens:sempkm:finding/webhook-coverage>
    a rl:Finding ;
    dcterms:title "Most writes notify nobody" ;
    dcterms:description "Webhook dispatch is wired at the router, not at the event store, so only 3 of 28 commit sites reach it. 9 of 11 modules that write never notify a subscriber: browser, federation, inference, notion, obsidian, rdf_import, services, task_templates, vfs." ;
    rl:evidence "modules with commits but no dispatch: browser, federation, inference, notion, obsidian, rdf_import, services, task_templates, vfs" ;
    rl:severity rl:high ;
    rl:about <urn:repolens:sempkm:part/W> ;
    rl:provenance rl:computed ;
    rl:producedBy <urn:repolens:sempkm:check/webhook-coverage> .

<urn:repolens:sempkm:finding/validation-coverage>
    a rl:Finding ;
    dcterms:title "Imported data is never SHACL-checked" ;
    dcterms:description "Validation is enqueued by the caller rather than by the store. 6 of 11 writing modules commit without enqueueing, so their data is not conformance-checked until something else touches it: federation, notion, obsidian, rdf_import, services, vfs." ;
    rl:evidence "modules with commits but no enqueue: federation, notion, obsidian, rdf_import, services, vfs" ;
    rl:severity rl:high ;
    rl:about <urn:repolens:sempkm:part/Q> ;
    rl:provenance rl:computed ;
    rl:producedBy <urn:repolens:sempkm:check/validation-coverage> .

<urn:repolens:sempkm:finding/single-write-door>
    a rl:Finding ;
    dcterms:title "The single-write-door convention is aspirational" ;
    dcterms:description "The documented convention is that every mutation goes through POST /api/commands. 11 different modules call EventStore.commit() directly. The deeper invariant still holds — nothing writes raw SPARQL UPDATE — but the endpoint framing does not." ;
    rl:evidence "modules calling event_store.commit: 11 (expected 1)" ;
    rl:severity rl:medium ;
    rl:about <urn:repolens:sempkm:part/C> ;
    rl:provenance rl:computed ;
    rl:producedBy <urn:repolens:sempkm:check/single-write-door> .

<urn:repolens:sempkm:finding/di-provider-skipped>
    a rl:Finding ;
    dcterms:title "A dependency provider exists and is skipped" ;
    dcterms:description "dependencies.py exposes get_event_store(), yet 5 sites construct EventStore(client) inline instead. Harmless while the store is stateless, and precisely the thing that stops being harmless when it is not." ;
    rl:evidence "ad-hoc EventStore(client) constructions: 5" ;
    rl:severity rl:medium ;
    rl:about <urn:repolens:sempkm:part/E> ;
    rl:provenance rl:computed ;
    rl:producedBy <urn:repolens:sempkm:check/di-provider-skipped> .

<urn:repolens:sempkm:finding/broad-except>
    a rl:Finding ;
    dcterms:title "Broad exception handlers" ;
    dcterms:description "except Exception or bare except appears 330 times. Some are deliberate; at this volume the deliberate ones are indistinguishable from the defensive ones." ;
    rl:evidence "broad handlers: 330 (threshold 100)" ;
    rl:severity rl:low ;
    rl:about <urn:repolens:sempkm:part/A> ;
    rl:provenance rl:computed ;
    rl:producedBy <urn:repolens:sempkm:check/broad-except> .


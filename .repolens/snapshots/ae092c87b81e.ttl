<urn:repolens:sempkm:part/P>
    a rl:Part ;
    dcterms:title "Apps framework" ;
    rl:shortName "APPS" ;
    rl:key "P" ;
    rl:partOf <urn:repolens:sempkm:repo> ;
    dcterms:description "Runs third-party integrations inside the instance. Apps declare scheduled tasks in a manifest; the scheduler ticks them, and whatever they produce is written back as commands." ;
    skos:note "manager, registry, manifest, scheduler, proxy and token modules — 2,557 lines. Twelve bundled apps (~29.8k lines) cover GitHub, Jira, Linear, Asana, Monday, Todoist, Google/Outlook/CalDAV calendars, RSS and media scheduling. The scheduler parses intervals, evaluates due tasks, applies backoff on failure and records every run." ;
    rl:memberGlob "backend/app/apps/**/*.py" ;
    rl:inGroup <urn:repolens:sempkm:group/feed> ;
    rl:inLayer <urn:repolens:sempkm:layer/manager> ;

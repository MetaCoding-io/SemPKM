<urn:repolens:sempkm:part/A>
    a rl:Part ;
    dcterms:title "FastAPI app" ;
    rl:shortName "FASTAPI" ;
    rl:key "A" ;
    rl:partOf <urn:repolens:sempkm:repo> ;
    dcterms:description "The application factory. On startup it builds every service singleton, hangs them on app.state, wires 48 routers and opens the triplestore connection. Everything downstream is reached through dependency injection from here." ;
    skos:note "main.py is 907 lines and registers 48 routers serving 219 endpoints. 40 service singletons live on app.state and are injected via Depends() from dependencies.py. Four middlewares wrap every request: rate limiting, PostHog error capture, conditional GET and timing." ;
    rl:memberGlob "backend/app/*.py" ;
    rl:inGroup <urn:repolens:sempkm:group/loop> ;
    rl:inLayer <urn:repolens:sempkm:layer/client> ;
    rl:inTier <urn:repolens:sempkm:tier/t2> ;

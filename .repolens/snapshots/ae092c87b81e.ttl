<urn:repolens:sempkm:part/N>
    a rl:Part ;
    dcterms:title "nginx edge" ;
    rl:shortName "NGINX" ;
    rl:key "N" ;
    rl:partOf <urn:repolens:sempkm:repo> ;
    dcterms:description "Serves the static front-end and forwards every /api and /browser request to the FastAPI container. The only door into the system from a browser." ;
    skos:note "nginx:stable-alpine with a single nginx.conf. The static directory is bind-mounted read-only, so CSS and JS edits appear on refresh with no rebuild — only nginx.conf changes need a container restart." ;
    rl:memberGlob "frontend/nginx.conf" ;

<urn:repolens:sempkm:part/T>
    a rl:Part ;
    dcterms:title "RDF4J triplestore" ;
    rl:shortName "RDF4J" ;
    rl:key "T" ;
    rl:partOf <urn:repolens:sempkm:repo> ;
    dcterms:description "Where the knowledge actually lives. Holds the current-state graph, every event graph ever written, the installed ontologies and shapes, and the inferred triples — each in its own named graph." ;
    skos:note "Reached over HTTP by an async client wrapping transactions, queries and updates. Named graphs partition everything: urn:sempkm:current for state, urn:sempkm:event:{uuid} per commit, urn:sempkm:model:{id}:{artifact} per installed model, urn:sempkm:inferred for entailments." ;
    rl:memberGlob "backend/app/triplestore/**/*.py" ;
    rl:inGroup <urn:repolens:sempkm:group/loop> ;
    rl:inLayer <urn:repolens:sempkm:layer/resource> ;

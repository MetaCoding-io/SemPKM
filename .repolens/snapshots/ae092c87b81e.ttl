<urn:repolens:sempkm:part/L>
    a rl:Part ;
    dcterms:title "Label cache" ;
    rl:shortName "LABELS" ;
    rl:key "L" ;
    rl:partOf <urn:repolens:sempkm:repo> ;
    dcterms:description "Decides what to call things. Given a batch of IRIs it returns display names using a fixed precedence, and caches the answers so a page full of relations does not become a page full of queries." ;
    skos:note "Precedence is dcterms:title, then rdfs:label, skos:prefLabel, schema:name, foaf:name, and finally the QName. resolve_batch() folds a whole page's IRIs into one query; a 300-second TTL cache fronts it." ;
    rl:memberGlob "backend/app/services/labels.py" ;
    rl:inGroup <urn:repolens:sempkm:group/loop> ;
    rl:inLayer <urn:repolens:sempkm:layer/access> ;

{
  "@context": {
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "gist": "https://w3id.org/semanticarts/ns/ontology/gist/",
    "rss": "urn:sempkm:model:rss-feeds:"
  },
  "@graph": [
    {
      "@id": "rss:ontology",
      "@type": "owl:Ontology",
      "rdfs:label": "RSS Feeds Ontology",
      "dcterms:description": "RSS/Atom feed articles and subscriptions. Defines Article and FeedSubscription types for feed reader applications."
    },

    {
      "@id": "rss:Article",
      "@type": "owl:Class",
      "rdfs:label": "Article",
      "rdfs:comment": "An article or entry from an RSS/Atom feed",
      "rdfs:subClassOf": { "@id": "gist:FormattedContent" }
    },
    {
      "@id": "rss:FeedSubscription",
      "@type": "owl:Class",
      "rdfs:label": "Feed Subscription",
      "rdfs:comment": "A subscription to an RSS or Atom feed"
    },

    {
      "@id": "rss:link",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Link",
      "rdfs:comment": "Original URL of the article",
      "rdfs:domain": { "@id": "rss:Article" },
      "rdfs:range": { "@id": "xsd:anyURI" }
    },
    {
      "@id": "rss:author",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Author",
      "rdfs:comment": "Author name of the article",
      "rdfs:domain": { "@id": "rss:Article" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "rss:feedSource",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Feed Source",
      "rdfs:comment": "The feed subscription this article came from",
      "rdfs:domain": { "@id": "rss:Article" },
      "rdfs:range": { "@id": "rss:FeedSubscription" }
    },
    {
      "@id": "rss:isRead",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Read",
      "rdfs:comment": "Whether the article has been read",
      "rdfs:domain": { "@id": "rss:Article" },
      "rdfs:range": { "@id": "xsd:boolean" }
    },
    {
      "@id": "rss:isStarred",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Starred",
      "rdfs:comment": "Whether the article has been starred/favorited",
      "rdfs:domain": { "@id": "rss:Article" },
      "rdfs:range": { "@id": "xsd:boolean" }
    },
    {
      "@id": "rss:articleId",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Article ID",
      "rdfs:comment": "Unique article identifier from the feed (entry ID or GUID)",
      "rdfs:domain": { "@id": "rss:Article" },
      "rdfs:range": { "@id": "xsd:string" }
    },

    {
      "@id": "rss:feedUrl",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Feed URL",
      "rdfs:comment": "URL of the RSS or Atom feed",
      "rdfs:domain": { "@id": "rss:FeedSubscription" },
      "rdfs:range": { "@id": "xsd:anyURI" }
    },
    {
      "@id": "rss:siteUrl",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Site URL",
      "rdfs:comment": "URL of the feed's website",
      "rdfs:domain": { "@id": "rss:FeedSubscription" },
      "rdfs:range": { "@id": "xsd:anyURI" }
    },
    {
      "@id": "rss:lastPolled",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Last Polled",
      "rdfs:comment": "Timestamp of the last poll attempt",
      "rdfs:domain": { "@id": "rss:FeedSubscription" },
      "rdfs:range": { "@id": "xsd:dateTime" }
    },
    {
      "@id": "rss:errorCount",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Error Count",
      "rdfs:comment": "Number of consecutive polling errors",
      "rdfs:domain": { "@id": "rss:FeedSubscription" },
      "rdfs:range": { "@id": "xsd:integer" }
    },
    {
      "@id": "rss:lastError",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Last Error",
      "rdfs:comment": "Description of the last polling error",
      "rdfs:domain": { "@id": "rss:FeedSubscription" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "rss:etag",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "ETag",
      "rdfs:comment": "HTTP ETag header for conditional GET requests",
      "rdfs:domain": { "@id": "rss:FeedSubscription" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "rss:lastModifiedHeader",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Last-Modified Header",
      "rdfs:comment": "HTTP Last-Modified header for conditional GET requests",
      "rdfs:domain": { "@id": "rss:FeedSubscription" },
      "rdfs:range": { "@id": "xsd:string" }
    }
  ]
}

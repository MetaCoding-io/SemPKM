{
  "@context": {
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "prov": "http://www.w3.org/ns/prov#",
    "doap": "http://usefulinc.com/ns/doap#",
    "gist": "https://w3id.org/semanticarts/ns/ontology/gist/",
    "rl": "urn:sempkm:model:repolens:"
  },
  "@graph": [
    {
      "@id": "rl:ontology",
      "@type": "owl:Ontology",
      "rdfs:label": "RepoLens Core Ontology",
      "dcterms:description": "A repository as a graph: its parts, files and symbols, the connections between them, what was measured about them, and what is asserted about them. Structure and measurement are separated from judgement on purpose — a finding is a determination about the code, not a property of it.",
      "rdfs:comment": "Alignment notes. Structural classes follow the same intent as CodeOntology's CodeElement hierarchy and SEON's code ontology, and findings follow SARIF's result/rule/level/location split. Neither is imported: their term IRIs could not be verified from this environment, so alignment is recorded as rdfs:seeAlso rather than asserted as equivalence. What is asserted is alignment to gist, which ships with SemPKM, and to PROV-O, which is a W3C Recommendation.",
      "rdfs:seeAlso": [
        { "@id": "http://se-on.org/" },
        { "@id": "http://codeontology.org/" },
        { "@id": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/sarif-v2.1.0.html" }
      ]
    },

    { "@id": "rl:Repository", "@type": "owl:Class", "rdfs:label": "Repository",
      "rdfs:comment": "One repository at one revision. Everything else in a RepoLens graph hangs off exactly one of these.",
      "rdfs:subClassOf": { "@id": "gist:System" } },

    { "@id": "rl:Part", "@type": "owl:Class", "rdfs:label": "Part",
      "rdfs:comment": "A named area of the repository — a module, a service, a bundle of files. Membership is declared by glob, not derived, because what counts as a part is an editorial decision.",
      "rdfs:subClassOf": { "@id": "gist:Component" } },

    { "@id": "rl:File", "@type": "owl:Class", "rdfs:label": "File",
      "rdfs:comment": "A source file, identified by its repository-relative path.",
      "rdfs:subClassOf": { "@id": "gist:Content" } },

    { "@id": "rl:Symbol", "@type": "owl:Class", "rdfs:label": "Symbol",
      "rdfs:comment": "A function, class or method defined in a file, with the line span it occupies.",
      "rdfs:subClassOf": { "@id": "gist:Content" } },

    { "@id": "rl:Connection", "@type": "owl:Class", "rdfs:label": "Connection",
      "rdfs:comment": "A connection between two nodes, as a resource rather than a bare triple, so it can carry a flow layer, an example payload and a provenance. Use the direct properties (rl:imports, rl:calls) when none of that is needed.",
      "rdfs:subClassOf": { "@id": "gist:NetworkLink" } },

    { "@id": "rl:Occurrence", "@type": "owl:Class", "rdfs:label": "Occurrence",
      "rdfs:comment": "One place in the tree where a declared query matched: a path, a line, and the matched text. Deliberately not aligned to a gist class — an occurrence is a location, not content or a component, and forcing it into either would be worse than leaving it standalone.",
      "skos:note": "SARIF calls this a result location." },

    { "@id": "rl:Measurement", "@type": "owl:Class", "rdfs:label": "Measurement",
      "rdfs:comment": "A number about something, with the aspect it measures and where the number came from. Counting lines is a measurement; so is an author's claim about a line count — they differ only in provenance.",
      "rdfs:subClassOf": { "@id": "gist:Magnitude" } },

    { "@id": "rl:Claim", "@type": "owl:Class", "rdfs:label": "Claim",
      "rdfs:comment": "A measurement a person asserted rather than the tool measuring it. Keeping claims in the same class as measurements is what makes them checkable: rl:verifies points a claim at the measurement that should agree with it.",
      "rdfs:subClassOf": { "@id": "rl:Measurement" } },

    { "@id": "rl:Check", "@type": "owl:Class", "rdfs:label": "Check",
      "rdfs:comment": "An assertion about the repository that can pass or fail — a threshold on a metric, a coverage relation between two queries, or a shell command expected to produce nothing.",
      "rdfs:subClassOf": { "@id": "gist:Specification" } },

    { "@id": "rl:Finding", "@type": "owl:Class", "rdfs:label": "Finding",
      "rdfs:comment": "Something concluded about the repository, ranked by severity. A finding is an outcome of assessment, which is why it is a gist:Determination and not a property of the thing it is about.",
      "rdfs:subClassOf": { "@id": "gist:Determination" } },

    { "@id": "rl:Scan", "@type": "owl:Class", "rdfs:label": "Scan",
      "rdfs:comment": "One run of the analyser over one revision. Everything measured points back at the scan that measured it, so a graph carrying two scans stays unambiguous.",
      "rdfs:subClassOf": { "@id": "prov:Activity" } },

    { "@id": "rl:Group", "@type": "owl:Class", "rdfs:label": "Group",
      "rdfs:comment": "An editorial grouping of parts, used for colour and for the index. Independent of tier and layer.",
      "rdfs:subClassOf": { "@id": "gist:Category" } },

    { "@id": "rl:Tier", "@type": "owl:Class", "rdfs:label": "Tier",
      "rdfs:comment": "A band in a stacked reading of the system, such as depth in the request lifecycle.",
      "rdfs:subClassOf": { "@id": "gist:Category" } },

    { "@id": "rl:Layer", "@type": "owl:Class", "rdfs:label": "Layer",
      "rdfs:comment": "A volatility layer in the Löwy sense: client, manager, engine, resource access, resource, utility.",
      "rdfs:subClassOf": { "@id": "gist:Category" } },

    { "@id": "rl:Flow", "@type": "owl:Class", "rdfs:label": "Flow",
      "rdfs:comment": "What a connection belongs to — a write path, a read path, an import graph. A connection has exactly one.",
      "rdfs:subClassOf": { "@id": "gist:Category" } },

    { "@id": "rl:Severity", "@type": "owl:Class", "rdfs:label": "Severity",
      "rdfs:subClassOf": { "@id": "gist:Category" } },

    { "@id": "rl:Provenance", "@type": "owl:Class", "rdfs:label": "Provenance",
      "rdfs:comment": "Where a statement came from. The whole tool rests on keeping these three apart.",
      "rdfs:subClassOf": { "@id": "gist:Category" } },

    { "@id": "rl:measured", "@type": "rl:Provenance", "rdfs:label": "measured",
      "skos:definition": "Read from the working tree by a declared query. Re-derived on every scan." },
    { "@id": "rl:authored", "@type": "rl:Provenance", "rdfs:label": "authored",
      "skos:definition": "A person put it there. Survives rebuilds; never overwritten by a scan." },
    { "@id": "rl:computed", "@type": "rl:Provenance", "rdfs:label": "computed",
      "skos:definition": "Re-derived by a check that failed, so its numbers are current rather than remembered." },

    { "@id": "rl:high",   "@type": "rl:Severity", "rdfs:label": "high",   "schema:position": 1 },
    { "@id": "rl:medium", "@type": "rl:Severity", "rdfs:label": "medium", "schema:position": 2 },
    { "@id": "rl:low",    "@type": "rl:Severity", "rdfs:label": "low",    "schema:position": 3 },
    { "@id": "rl:note",   "@type": "rl:Severity", "rdfs:label": "note",   "schema:position": 4 },
    { "@id": "rl:good",   "@type": "rl:Severity", "rdfs:label": "good",   "schema:position": 5,
      "rdfs:comment": "Not a problem. Recorded because a checker that only ever reports bad news is one nobody believes." },

    { "@id": "rl:hasPart", "@type": "owl:ObjectProperty", "rdfs:label": "has part",
      "rdfs:domain": { "@id": "rl:Repository" }, "rdfs:range": { "@id": "rl:Part" },
      "owl:inverseOf": { "@id": "rl:partOf" } },
    { "@id": "rl:partOf", "@type": "owl:ObjectProperty", "rdfs:label": "part of",
      "rdfs:domain": { "@id": "rl:Part" }, "rdfs:range": { "@id": "rl:Repository" } },

    { "@id": "rl:hasFile", "@type": "owl:ObjectProperty", "rdfs:label": "has file",
      "rdfs:domain": { "@id": "rl:Part" }, "rdfs:range": { "@id": "rl:File" },
      "owl:inverseOf": { "@id": "rl:fileOf" } },
    { "@id": "rl:fileOf", "@type": "owl:ObjectProperty", "rdfs:label": "file of",
      "rdfs:domain": { "@id": "rl:File" }, "rdfs:range": { "@id": "rl:Part" } },

    { "@id": "rl:definesSymbol", "@type": "owl:ObjectProperty", "rdfs:label": "defines symbol",
      "rdfs:domain": { "@id": "rl:File" }, "rdfs:range": { "@id": "rl:Symbol" },
      "owl:inverseOf": { "@id": "rl:definedIn" } },
    { "@id": "rl:definedIn", "@type": "owl:ObjectProperty", "rdfs:label": "defined in",
      "rdfs:domain": { "@id": "rl:Symbol" }, "rdfs:range": { "@id": "rl:File" } },

    { "@id": "rl:enclosedBy", "@type": "owl:ObjectProperty", "rdfs:label": "enclosed by",
      "rdfs:comment": "A method's class. Absent for a top-level function.",
      "rdfs:domain": { "@id": "rl:Symbol" }, "rdfs:range": { "@id": "rl:Symbol" } },

    { "@id": "rl:imports", "@type": "owl:ObjectProperty", "rdfs:label": "imports",
      "rdfs:comment": "Resolved statically. Holds between files and, rolled up, between parts.",
      "rdfs:seeAlso": { "@id": "rl:Connection" } },
    { "@id": "rl:calls", "@type": "owl:ObjectProperty", "rdfs:label": "calls",
      "rdfs:comment": "A call between two symbols in the same file. Calls that leave the file are not resolved.",
      "rdfs:domain": { "@id": "rl:Symbol" }, "rdfs:range": { "@id": "rl:Symbol" } },

    { "@id": "rl:source", "@type": "owl:ObjectProperty", "rdfs:label": "source",
      "rdfs:domain": { "@id": "rl:Connection" },
      "rdfs:subPropertyOf": { "@id": "gist:links" } },
    { "@id": "rl:target", "@type": "owl:ObjectProperty", "rdfs:label": "target",
      "rdfs:domain": { "@id": "rl:Connection" },
      "rdfs:subPropertyOf": { "@id": "gist:links" } },
    { "@id": "rl:flow", "@type": "owl:ObjectProperty", "rdfs:label": "flow",
      "rdfs:domain": { "@id": "rl:Connection" }, "rdfs:range": { "@id": "rl:Flow" } },

    { "@id": "rl:inGroup", "@type": "owl:ObjectProperty", "rdfs:label": "group",
      "rdfs:domain": { "@id": "rl:Part" }, "rdfs:range": { "@id": "rl:Group" } },
    { "@id": "rl:inTier", "@type": "owl:ObjectProperty", "rdfs:label": "tier",
      "rdfs:domain": { "@id": "rl:Part" }, "rdfs:range": { "@id": "rl:Tier" } },
    { "@id": "rl:inLayer", "@type": "owl:ObjectProperty", "rdfs:label": "layer",
      "rdfs:domain": { "@id": "rl:Part" }, "rdfs:range": { "@id": "rl:Layer" } },

    { "@id": "rl:about", "@type": "owl:ObjectProperty", "rdfs:label": "about",
      "rdfs:comment": "The thing an assessment concerns. Deliberately untyped in range so a finding, a decision or a rule can point at a part, a file or a symbol." },

    { "@id": "rl:measures", "@type": "owl:ObjectProperty", "rdfs:label": "measures",
      "rdfs:domain": { "@id": "rl:Measurement" } },
    { "@id": "rl:aspect", "@type": "owl:ObjectProperty", "rdfs:label": "aspect",
      "rdfs:comment": "What is being counted — lines, files, commit sites, out-degree.",
      "rdfs:domain": { "@id": "rl:Measurement" }, "rdfs:range": { "@id": "gist:Aspect" } },
    { "@id": "rl:verifies", "@type": "owl:ObjectProperty", "rdfs:label": "verifies",
      "rdfs:comment": "Points a claim at the measurement that should agree with it. Where they disagree, the tool reports drift rather than silently preferring one.",
      "rdfs:domain": { "@id": "rl:Claim" }, "rdfs:range": { "@id": "rl:Measurement" } },

    { "@id": "rl:producedBy", "@type": "owl:ObjectProperty", "rdfs:label": "produced by",
      "rdfs:domain": { "@id": "rl:Finding" }, "rdfs:range": { "@id": "rl:Check" } },
    { "@id": "rl:severity", "@type": "owl:ObjectProperty", "rdfs:label": "severity",
      "rdfs:domain": { "@id": "rl:Finding" }, "rdfs:range": { "@id": "rl:Severity" } },
    { "@id": "rl:occursIn", "@type": "owl:ObjectProperty", "rdfs:label": "occurs in",
      "rdfs:domain": { "@id": "rl:Occurrence" }, "rdfs:range": { "@id": "rl:File" } },
    { "@id": "rl:matches", "@type": "owl:ObjectProperty", "rdfs:label": "matches",
      "rdfs:comment": "The declared query this occurrence answers.",
      "rdfs:domain": { "@id": "rl:Occurrence" } },

    { "@id": "rl:provenance", "@type": "owl:ObjectProperty", "rdfs:label": "provenance",
      "rdfs:comment": "Applies to anything a person could disagree with: a measurement, a finding, a link.",
      "rdfs:range": { "@id": "rl:Provenance" } },
    { "@id": "rl:fromScan", "@type": "owl:ObjectProperty", "rdfs:label": "from scan",
      "rdfs:range": { "@id": "rl:Scan" },
      "rdfs:subPropertyOf": { "@id": "prov:wasGeneratedBy" } },

    { "@id": "rl:path", "@type": "owl:DatatypeProperty", "rdfs:label": "path",
      "rdfs:domain": { "@id": "rl:File" }, "rdfs:range": { "@id": "xsd:string" } },
    { "@id": "rl:memberGlob", "@type": "owl:DatatypeProperty", "rdfs:label": "member glob",
      "rdfs:domain": { "@id": "rl:Part" }, "rdfs:range": { "@id": "xsd:string" } },
    { "@id": "rl:key", "@type": "owl:DatatypeProperty", "rdfs:label": "key",
      "rdfs:comment": "The one- or two-letter key a part is drawn with.",
      "rdfs:domain": { "@id": "rl:Part" }, "rdfs:range": { "@id": "xsd:string" } },
    { "@id": "rl:shortName", "@type": "owl:DatatypeProperty", "rdfs:label": "short name",
      "rdfs:range": { "@id": "xsd:string" } },
    { "@id": "rl:language", "@type": "owl:DatatypeProperty", "rdfs:label": "language",
      "rdfs:subPropertyOf": { "@id": "schema:programmingLanguage" },
      "rdfs:range": { "@id": "xsd:string" } },
    { "@id": "rl:symbolKind", "@type": "owl:DatatypeProperty", "rdfs:label": "kind",
      "rdfs:comment": "function, class, method.",
      "rdfs:domain": { "@id": "rl:Symbol" }, "rdfs:range": { "@id": "xsd:string" } },
    { "@id": "rl:startLine", "@type": "owl:DatatypeProperty", "rdfs:label": "start line",
      "rdfs:range": { "@id": "xsd:integer" } },
    { "@id": "rl:endLine", "@type": "owl:DatatypeProperty", "rdfs:label": "end line",
      "rdfs:range": { "@id": "xsd:integer" } },
    { "@id": "rl:lineNumber", "@type": "owl:DatatypeProperty", "rdfs:label": "line",
      "rdfs:domain": { "@id": "rl:Occurrence" }, "rdfs:range": { "@id": "xsd:integer" } },
    { "@id": "rl:snippet", "@type": "owl:DatatypeProperty", "rdfs:label": "snippet",
      "rdfs:domain": { "@id": "rl:Occurrence" }, "rdfs:range": { "@id": "xsd:string" } },
    { "@id": "rl:approximate", "@type": "owl:DatatypeProperty", "rdfs:label": "approximate",
      "rdfs:comment": "True where the line span came from brace counting rather than a parser. Said on the record rather than implied by silence.",
      "rdfs:range": { "@id": "xsd:boolean" } },

    { "@id": "rl:value", "@type": "owl:DatatypeProperty", "rdfs:label": "value",
      "rdfs:domain": { "@id": "rl:Measurement" }, "rdfs:range": { "@id": "xsd:decimal" } },
    { "@id": "rl:expected", "@type": "owl:DatatypeProperty", "rdfs:label": "expected",
      "rdfs:domain": { "@id": "rl:Check" } },
    { "@id": "rl:actual", "@type": "owl:DatatypeProperty", "rdfs:label": "actual",
      "rdfs:domain": { "@id": "rl:Check" } },
    { "@id": "rl:passed", "@type": "owl:DatatypeProperty", "rdfs:label": "passed",
      "rdfs:domain": { "@id": "rl:Check" }, "rdfs:range": { "@id": "xsd:boolean" } },
    { "@id": "rl:checkKind", "@type": "owl:DatatypeProperty", "rdfs:label": "check kind",
      "rdfs:comment": "metric, coverage, shell.",
      "rdfs:domain": { "@id": "rl:Check" }, "rdfs:range": { "@id": "xsd:string" } },
    { "@id": "rl:evidence", "@type": "owl:DatatypeProperty", "rdfs:label": "evidence",
      "rdfs:comment": "The line a person can check by hand.",
      "rdfs:range": { "@id": "xsd:string" } },

    { "@id": "rl:payloadExample", "@type": "owl:DatatypeProperty", "rdfs:label": "payload example",
      "rdfs:comment": "A sample of what travels along a connection. Authored, and marked as such.",
      "rdfs:domain": { "@id": "rl:Connection" }, "rdfs:range": { "@id": "xsd:string" } },
    { "@id": "rl:revision", "@type": "owl:DatatypeProperty", "rdfs:label": "revision",
      "rdfs:domain": { "@id": "rl:Repository" }, "rdfs:range": { "@id": "xsd:string" } }
  ]
}

      "dcterms:title": "How to Take Smart Notes",
      "dcterms:creator": "Sönke Ahrens",
      "zk:sourceType": "book",
      "schema:datePublished": { "@value": "2017-02-21", "@type": "xsd:date" },
      "zk:notes": "Foundational text on the Zettelkasten method. Explains Luhmann's slip-box system and how writing is thinking.",
      "zk:rating": { "@value": "5", "@type": "xsd:integer" },
      "bpkm:tags": ["zettelkasten", "note-taking", "productivity", "writing"],

      "dcterms:creator": "Rolf Dobelli",
      "zk:sourceType": "book",
      "schema:datePublished": { "@value": "2013-05-14", "@type": "xsd:date" },
      "zk:notes": "Catalog of cognitive biases and logical fallacies. Useful for understanding reasoning pitfalls.",
      "zk:rating": { "@value": "4", "@type": "xsd:integer" },

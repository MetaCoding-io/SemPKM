      "@id": "bp:seed-lean-uvp",
      "@type": "bp:LeanCanvasSection",
      "dcterms:title": "Unique Value Proposition",
      "bp:leanSectionType": "Unique Value Proposition",
      "bp:leanSectionContent": "Think in frameworks, not folders. Your knowledge stays connected, structured, and queryable — not scattered across apps.",

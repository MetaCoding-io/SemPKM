      "@id": "bp:seed-alt-option-a",
      "@type": "bp:Alternative",
      "dcterms:title": "Option A — Rust Framework",
      "dcterms:description": "High-performance compiled solution with steep learning curve but excellent runtime characteristics.",
      "bp:belongsToDecisionMatrix": { "@id": "bp:seed-dm-tech-selection" },
      "dcterms:created": { "@value": "2026-03-20T10:05:00Z", "@type": "xsd:dateTime" }

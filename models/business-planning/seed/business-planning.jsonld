      "bp:xAxisLabel": "Urgency",
      "bp:yAxisLabel": "Importance",
      "dcterms:created": { "@value": "2026-03-01T09:00:00Z", "@type": "xsd:dateTime" }
    },

    {
      "@id": "bp:seed-item-quarterly-report",
      "@type": "bp:EisenhowerItem",
      "dcterms:title": "Finish quarterly report",

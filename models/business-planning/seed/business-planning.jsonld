      "dcterms:title": "Knowledge Graph App",
      "dcterms:description": "Lean Canvas for a personal knowledge graph application targeting researchers.",
      "dcterms:created": { "@value": "2026-03-22T19:00:00Z", "@type": "xsd:dateTime" }
    },
    {
      "@id": "bp:seed-lean-problem",
      "@type": "bp:LeanCanvasSection",
      "dcterms:title": "Problem",
      "bp:leanSectionType": "Problem",
      "bp:leanSectionContent": "Researchers lose context when switching between papers, notes, and reference managers. Existing tools don't preserve semantic relationships between concepts.",
      "bp:belongsToLeanCanvas": { "@id": "bp:seed-lean-app" },
      "dcterms:created": { "@value": "2026-03-22T19:01:00Z", "@type": "xsd:dateTime" }
    },
    {
      "@id": "bp:seed-lean-solution",
      "@type": "bp:LeanCanvasSection",
      "dcterms:title": "Solution",
      "bp:leanSectionType": "Solution",
      "bp:leanSectionContent": "A semantic workspace that auto-links concepts, papers, and notes using RDF knowledge graphs. Install domain-specific Mental Models for instant structure.",
      "bp:belongsToLeanCanvas": { "@id": "bp:seed-lean-app" },
      "dcterms:created": { "@value": "2026-03-22T19:02:00Z", "@type": "xsd:dateTime" }
    },

      "sempkm:rendererType": "table",
      "sempkm:sparqlQuery": "SELECT ?s ?title ?description ?created WHERE { ?s a <urn:sempkm:model:business-planning:DecisionMatrix> ; <http://purl.org/dc/terms/title> ?title . OPTIONAL { ?s <http://purl.org/dc/terms/description> ?description } . OPTIONAL { ?s <http://purl.org/dc/terms/created> ?created } }",
      "sempkm:columns": "title,description,created",
      "sempkm:sortDefault": "title"
    },
    {
      "@id": "bp:view-alternative-table",
      "@type": "sempkm:ViewSpec",
      "rdfs:label": "Alternatives Table",
      "sempkm:targetClass": { "@id": "bp:Alternative" },
      "sempkm:rendererType": "table",
      "sempkm:sparqlQuery": "SELECT ?s ?title ?description WHERE { ?s a <urn:sempkm:model:business-planning:Alternative> ; <http://purl.org/dc/terms/title> ?title . OPTIONAL { ?s <http://purl.org/dc/terms/description> ?description } }",
      "sempkm:columns": "title,description",
      "sempkm:sortDefault": "title"
    },
    {
      "@id": "bp:view-score-decisionmatrix",
      "@type": "sempkm:ViewSpec",
      "rdfs:label": "Decision Matrix Scoring",
      "sempkm:targetClass": { "@id": "bp:Score" },
      "sempkm:rendererType": "decision-matrix",
      "sempkm:sparqlQuery": "SELECT ?s ?value ?alternative ?alternativeTitle ?criterion ?criterionTitle ?weight ?matrix WHERE { ?s a <urn:sempkm:model:business-planning:Score> ; <urn:sempkm:model:business-planning:value> ?value ; <urn:sempkm:model:business-planning:scoreAlternative> ?alternative ; <urn:sempkm:model:business-planning:scoreCriterion> ?criterion . ?alternative <http://purl.org/dc/terms/title> ?alternativeTitle . ?criterion <http://purl.org/dc/terms/title> ?criterionTitle . OPTIONAL { ?criterion <urn:sempkm:model:business-planning:weight> ?weight } . OPTIONAL { ?criterion <urn:sempkm:model:business-planning:belongsToDecisionMatrix> ?matrix } }"
    },

    {
      "@id": "bp:view-swot-analysis-table",
      "@type": "sempkm:ViewSpec",
      "rdfs:label": "SWOT Analyses Table",
      "sempkm:targetClass": { "@id": "bp:SWOTAnalysis" },
      "sempkm:rendererType": "table",

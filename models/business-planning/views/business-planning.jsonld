{
  "@context": {
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "bp": "urn:sempkm:model:business-planning:",
    "sempkm": "urn:sempkm:vocab:",
    "dcterms": "http://purl.org/dc/terms/"
  },
  "@graph": [
    {
      "@id": "bp:view-eisenhower-matrix-table",
      "@type": "sempkm:ViewSpec",
      "rdfs:label": "Eisenhower Matrices Table",
      "sempkm:targetClass": { "@id": "bp:EisenhowerMatrix" },
      "sempkm:rendererType": "table",
      "sempkm:sparqlQuery": "SELECT ?s ?title ?description ?created WHERE { ?s a <urn:sempkm:model:business-planning:EisenhowerMatrix> ; <http://purl.org/dc/terms/title> ?title . OPTIONAL { ?s <http://purl.org/dc/terms/description> ?description } . OPTIONAL { ?s <http://purl.org/dc/terms/created> ?created } }",
      "sempkm:columns": "title,description,created",
      "sempkm:sortDefault": "title"
    },
    {
      "@id": "bp:view-eisenhower-item-table",
      "@type": "sempkm:ViewSpec",
      "rdfs:label": "Eisenhower Items Table",
      "sempkm:targetClass": { "@id": "bp:EisenhowerItem" },
      "sempkm:rendererType": "table",
      "sempkm:sparqlQuery": "SELECT ?s ?title ?urgency ?importance ?description WHERE { ?s a <urn:sempkm:model:business-planning:EisenhowerItem> ; <http://purl.org/dc/terms/title> ?title . OPTIONAL { ?s <urn:sempkm:model:business-planning:urgency> ?urgency } . OPTIONAL { ?s <urn:sempkm:model:business-planning:importance> ?importance } . OPTIONAL { ?s <http://purl.org/dc/terms/description> ?description } }",
      "sempkm:columns": "title,urgency,importance,description",
      "sempkm:sortDefault": "title"
    },
    {
      "@id": "bp:view-eisenhower-item-quadrant",
      "@type": "sempkm:ViewSpec",
      "rdfs:label": "Eisenhower Quadrant",
      "sempkm:targetClass": { "@id": "bp:EisenhowerItem" },
      "sempkm:rendererType": "quadrant",
      "sempkm:sparqlQuery": "SELECT ?s ?title ?urgency ?importance ?description WHERE { ?s a <urn:sempkm:model:business-planning:EisenhowerItem> ; <http://purl.org/dc/terms/title> ?title . OPTIONAL { ?s <urn:sempkm:model:business-planning:urgency> ?urgency } . OPTIONAL { ?s <urn:sempkm:model:business-planning:importance> ?importance } . OPTIONAL { ?s <http://purl.org/dc/terms/description> ?description } }"
    },

    {
      "@id": "bp:view-bmc-canvas-table",
      "@type": "sempkm:ViewSpec",
      "rdfs:label": "Business Model Canvases Table",
      "sempkm:targetClass": { "@id": "bp:BusinessModelCanvas" },
      "sempkm:rendererType": "table",
      "sempkm:sparqlQuery": "SELECT ?s ?title ?description ?created WHERE { ?s a <urn:sempkm:model:business-planning:BusinessModelCanvas> ; <http://purl.org/dc/terms/title> ?title . OPTIONAL { ?s <http://purl.org/dc/terms/description> ?description } . OPTIONAL { ?s <http://purl.org/dc/terms/created> ?created } }",
      "sempkm:columns": "title,description,created",
      "sempkm:sortDefault": "title"
    },
    {
      "@id": "bp:view-bmc-section-table",
      "@type": "sempkm:ViewSpec",
      "rdfs:label": "BMC Sections Table",
      "sempkm:targetClass": { "@id": "bp:BMCSection" },
      "sempkm:rendererType": "table",
      "sempkm:sparqlQuery": "SELECT ?s ?title ?sectionType ?sectionContent WHERE { ?s a <urn:sempkm:model:business-planning:BMCSection> ; <http://purl.org/dc/terms/title> ?title . OPTIONAL { ?s <urn:sempkm:model:business-planning:sectionType> ?sectionType } . OPTIONAL { ?s <urn:sempkm:model:business-planning:sectionContent> ?sectionContent } }",
      "sempkm:columns": "title,sectionType,sectionContent",
      "sempkm:sortDefault": "sectionType"
    },
    {
      "@id": "bp:view-bmc-section-bmc",
      "@type": "sempkm:ViewSpec",
      "rdfs:label": "Business Model Canvas",
      "sempkm:targetClass": { "@id": "bp:BMCSection" },
      "sempkm:rendererType": "bmc",
      "sempkm:sparqlQuery": "SELECT ?s ?title ?sectionType ?sectionContent ?canvas WHERE { ?s a <urn:sempkm:model:business-planning:BMCSection> ; <http://purl.org/dc/terms/title> ?title . OPTIONAL { ?s <urn:sempkm:model:business-planning:sectionType> ?sectionType } . OPTIONAL { ?s <urn:sempkm:model:business-planning:sectionContent> ?sectionContent } . OPTIONAL { ?s <urn:sempkm:model:business-planning:belongsToCanvas> ?canvas } }"
    },

    {
      "@id": "bp:view-objective-table",
      "@type": "sempkm:ViewSpec",
      "rdfs:label": "Objectives Table",
      "sempkm:targetClass": { "@id": "bp:Objective" },
      "sempkm:rendererType": "table",
      "sempkm:sparqlQuery": "SELECT ?s ?title ?description ?timeframe ?created WHERE { ?s a <urn:sempkm:model:business-planning:Objective> ; <http://purl.org/dc/terms/title> ?title . OPTIONAL { ?s <http://purl.org/dc/terms/description> ?description } . OPTIONAL { ?s <urn:sempkm:model:business-planning:timeframe> ?timeframe } . OPTIONAL { ?s <http://purl.org/dc/terms/created> ?created } }",
      "sempkm:columns": "title,description,timeframe,created",
      "sempkm:sortDefault": "title"
    },
    {
      "@id": "bp:view-keyresult-table",
      "@type": "sempkm:ViewSpec",
      "rdfs:label": "Key Results Table",
      "sempkm:targetClass": { "@id": "bp:KeyResult" },
      "sempkm:rendererType": "table",
      "sempkm:sparqlQuery": "SELECT ?s ?title ?currentValue ?targetValue ?unit WHERE { ?s a <urn:sempkm:model:business-planning:KeyResult> ; <http://purl.org/dc/terms/title> ?title . OPTIONAL { ?s <urn:sempkm:model:business-planning:currentValue> ?currentValue } . OPTIONAL { ?s <urn:sempkm:model:business-planning:targetValue> ?targetValue } . OPTIONAL { ?s <urn:sempkm:model:business-planning:unit> ?unit } }",
      "sempkm:columns": "title,currentValue,targetValue,unit",
      "sempkm:sortDefault": "title"
    },
    {
      "@id": "bp:view-keyresult-okr",
      "@type": "sempkm:ViewSpec",
      "rdfs:label": "OKR Progress",
      "sempkm:targetClass": { "@id": "bp:KeyResult" },
      "sempkm:rendererType": "okr",
      "sempkm:sparqlQuery": "SELECT ?s ?title ?currentValue ?targetValue ?unit ?objective ?objectiveTitle WHERE { ?s a <urn:sempkm:model:business-planning:KeyResult> ; <http://purl.org/dc/terms/title> ?title . OPTIONAL { ?s <urn:sempkm:model:business-planning:currentValue> ?currentValue } . OPTIONAL { ?s <urn:sempkm:model:business-planning:targetValue> ?targetValue } . OPTIONAL { ?s <urn:sempkm:model:business-planning:unit> ?unit } . OPTIONAL { ?s <urn:sempkm:model:business-planning:belongsToObjective> ?objective . ?objective <http://purl.org/dc/terms/title> ?objectiveTitle } }"
    },

    {
      "@id": "bp:view-decisionmatrix-table",
      "@type": "sempkm:ViewSpec",

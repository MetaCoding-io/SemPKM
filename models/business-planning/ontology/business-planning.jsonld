{
  "@context": {
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dcterms": "http://purl.org/dc/terms/",
    "bp": "urn:sempkm:model:business-planning:",
    "gist": "https://w3id.org/semanticarts/ns/ontology/gist/"
  },
  "@graph": [
    {
      "@id": "bp:ontology",
      "@type": "owl:Ontology",
      "rdfs:label": "Business Planning Ontology",
      "dcterms:description": "Business planning frameworks: Eisenhower Matrix for urgency×importance prioritization, Business Model Canvas for the nine building blocks of a business model, OKR (Objectives and Key Results) for goal tracking with measurable progress, Decision Matrix for weighted multi-criteria evaluation, SWOT Analysis for strengths/weaknesses/opportunities/threats, BCG Matrix for growth-share portfolio analysis, Ansoff Matrix for growth strategy selection, Stakeholder Map for power-interest mapping, and Risk Matrix for likelihood-impact assessment."
    },

    {
      "@id": "bp:FrameworkItem",
      "@type": "owl:Class",
      "rdfs:label": "Framework Item",
      "rdfs:comment": "Abstract base class for all business framework items",
      "rdfs:subClassOf": { "@id": "gist:Category" }
    },
    {
      "@id": "bp:QuadrantItem",
      "@type": "owl:Class",
      "rdfs:label": "Quadrant Item",
      "rdfs:comment": "Base class for items placed on a 2-axis grid (quadrant view)",
      "rdfs:subClassOf": { "@id": "bp:FrameworkItem" }
    },
    {
      "@id": "bp:EisenhowerMatrix",
      "@type": "owl:Class",
      "rdfs:label": "Eisenhower Matrix",
      "rdfs:comment": "A container for prioritized items organized by urgency and importance",
      "rdfs:subClassOf": { "@id": "gist:Collection" }
    },
    {
      "@id": "bp:EisenhowerItem",
      "@type": "owl:Class",
      "rdfs:label": "Eisenhower Item",
      "rdfs:comment": "An item in an Eisenhower Matrix, classified by urgency and importance",
      "rdfs:subClassOf": { "@id": "bp:QuadrantItem" }
    },

    {
      "@id": "bp:urgency",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Urgency",
      "rdfs:comment": "How urgent this item is (high or low)",
      "rdfs:domain": { "@id": "bp:QuadrantItem" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bp:importance",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Importance",
      "rdfs:comment": "How important this item is (high or low)",
      "rdfs:domain": { "@id": "bp:QuadrantItem" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bp:belongsToMatrix",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Belongs To Matrix",
      "rdfs:comment": "The Eisenhower Matrix this item belongs to",
      "rdfs:domain": { "@id": "bp:EisenhowerItem" },
      "rdfs:range": { "@id": "bp:EisenhowerMatrix" }
    },
    {
      "@id": "bp:matrixDescription",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Matrix Description",
      "rdfs:comment": "Longer description of the matrix purpose or context",
      "rdfs:domain": { "@id": "bp:EisenhowerMatrix" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bp:xAxisLabel",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "X-Axis Label",
      "rdfs:comment": "Label for the horizontal axis of the quadrant view",
      "rdfs:domain": { "@id": "bp:EisenhowerMatrix" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bp:yAxisLabel",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Y-Axis Label",
      "rdfs:comment": "Label for the vertical axis of the quadrant view",
      "rdfs:domain": { "@id": "bp:EisenhowerMatrix" },
      "rdfs:range": { "@id": "xsd:string" }
    },

    {
      "@id": "bp:BusinessModelCanvas",
      "@type": "owl:Class",
      "rdfs:label": "Business Model Canvas",
      "rdfs:comment": "A container for the nine building blocks of a business model (Osterwalder & Pigneur)",
      "rdfs:subClassOf": { "@id": "gist:Collection" }
    },
    {
      "@id": "bp:BMCSection",
      "@type": "owl:Class",
      "rdfs:label": "BMC Section",
      "rdfs:comment": "One of the nine sections in a Business Model Canvas — each section holds content for a specific building block",
      "rdfs:subClassOf": { "@id": "bp:FrameworkItem" }
    },

    {
      "@id": "bp:sectionType",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Section Type",
      "rdfs:comment": "Which of the nine BMC building blocks this section represents",
      "rdfs:domain": { "@id": "bp:BMCSection" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bp:sectionContent",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Section Content",
      "rdfs:comment": "Free-text content describing the business model aspect for this section",
      "rdfs:domain": { "@id": "bp:BMCSection" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bp:belongsToCanvas",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Belongs To Canvas",
      "rdfs:comment": "The Business Model Canvas this section belongs to",
      "rdfs:domain": { "@id": "bp:BMCSection" },
      "rdfs:range": { "@id": "bp:BusinessModelCanvas" }
    },

    {
      "@id": "bp:Objective",
      "@type": "owl:Class",
      "rdfs:label": "Objective",
      "rdfs:comment": "An OKR Objective — a qualitative goal that key results measure progress toward",
      "rdfs:subClassOf": { "@id": "bp:FrameworkItem" }
    },
    {
      "@id": "bp:KeyResult",
      "@type": "owl:Class",
      "rdfs:label": "Key Result",
      "rdfs:comment": "A measurable outcome that tracks progress toward an Objective, with current and target values",
      "rdfs:subClassOf": { "@id": "bp:FrameworkItem" }
    },

    {
      "@id": "bp:currentValue",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Current Value",
      "rdfs:comment": "The current measured value for this key result",
      "rdfs:domain": { "@id": "bp:KeyResult" },
      "rdfs:range": { "@id": "xsd:decimal" }
    },
    {
      "@id": "bp:targetValue",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Target Value",
      "rdfs:comment": "The target value that represents full completion of this key result",
      "rdfs:domain": { "@id": "bp:KeyResult" },
      "rdfs:range": { "@id": "xsd:decimal" }
    },
    {
      "@id": "bp:unit",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Unit",
      "rdfs:comment": "The unit of measurement for current and target values (e.g. %, points, count)",
      "rdfs:domain": { "@id": "bp:KeyResult" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bp:timeframe",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Timeframe",
      "rdfs:comment": "The time period for this objective or key result (e.g. Q2 2026, H1 2026)",
      "rdfs:domain": { "@id": "bp:Objective" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bp:belongsToObjective",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Belongs To Objective",
      "rdfs:comment": "The Objective this Key Result measures progress toward",
      "rdfs:domain": { "@id": "bp:KeyResult" },
      "rdfs:range": { "@id": "bp:Objective" }
    },

    {
      "@id": "bp:DecisionMatrix",
      "@type": "owl:Class",
      "rdfs:label": "Decision Matrix",
      "rdfs:comment": "A weighted scoring matrix for comparing alternatives against multiple criteria",
      "rdfs:subClassOf": { "@id": "gist:Collection" }
    },
    {
      "@id": "bp:Criterion",
      "@type": "owl:Class",
      "rdfs:label": "Criterion",
      "rdfs:comment": "A weighted evaluation dimension in a Decision Matrix",
      "rdfs:subClassOf": { "@id": "bp:FrameworkItem" }
    },
    {
      "@id": "bp:Alternative",
      "@type": "owl:Class",
      "rdfs:label": "Alternative",
      "rdfs:comment": "An option being evaluated in a Decision Matrix",
      "rdfs:subClassOf": { "@id": "bp:FrameworkItem" }
    },
    {
      "@id": "bp:Score",
      "@type": "owl:Class",
      "rdfs:label": "Score",
      "rdfs:comment": "A junction node linking an Alternative to a Criterion with a numeric score value",
      "rdfs:subClassOf": { "@id": "bp:FrameworkItem" }
    },

    {
      "@id": "bp:weight",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Weight",
      "rdfs:comment": "The relative weight of this criterion in the scoring calculation (higher = more important)",
      "rdfs:domain": { "@id": "bp:Criterion" },
      "rdfs:range": { "@id": "xsd:decimal" }
    },
    {
      "@id": "bp:value",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Value",
      "rdfs:comment": "The numeric score value for this alternative-criterion combination",
      "rdfs:domain": { "@id": "bp:Score" },
      "rdfs:range": { "@id": "xsd:decimal" }
    },
    {
      "@id": "bp:belongsToDecisionMatrix",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Belongs To Decision Matrix",
      "rdfs:comment": "The Decision Matrix this criterion or alternative belongs to",
      "rdfs:range": { "@id": "bp:DecisionMatrix" }
    },
    {
      "@id": "bp:scoreAlternative",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Score Alternative",
      "rdfs:comment": "The alternative being scored",
      "rdfs:domain": { "@id": "bp:Score" },
      "rdfs:range": { "@id": "bp:Alternative" }
    },
    {
      "@id": "bp:scoreCriterion",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Score Criterion",
      "rdfs:comment": "The criterion being scored against",
      "rdfs:domain": { "@id": "bp:Score" },
      "rdfs:range": { "@id": "bp:Criterion" }
    },

    {
      "@id": "bp:SWOTAnalysis",
      "@type": "owl:Class",
      "rdfs:label": "SWOT Analysis",
      "rdfs:comment": "A container for SWOT (Strengths, Weaknesses, Opportunities, Threats) analysis items",
      "rdfs:subClassOf": { "@id": "gist:Collection" }
    },
    {
      "@id": "bp:SWOTItem",
      "@type": "owl:Class",
      "rdfs:label": "SWOT Item",
      "rdfs:comment": "An item in a SWOT Analysis, classified by nature (internal/external) and valence (positive/negative)",
      "rdfs:subClassOf": { "@id": "bp:QuadrantItem" }
    },
    {
      "@id": "bp:swotNature",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Nature",
      "rdfs:comment": "Whether this factor is internal or external to the organization",
      "rdfs:domain": { "@id": "bp:SWOTItem" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bp:swotValence",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Valence",
      "rdfs:comment": "Whether this factor is positive (helpful) or negative (harmful)",
      "rdfs:domain": { "@id": "bp:SWOTItem" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bp:belongsToSWOT",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Belongs To SWOT",
      "rdfs:comment": "The SWOT Analysis this item belongs to",
      "rdfs:domain": { "@id": "bp:SWOTItem" },
      "rdfs:range": { "@id": "bp:SWOTAnalysis" }
    },

    {
      "@id": "bp:BCGMatrix",
      "@type": "owl:Class",
      "rdfs:label": "BCG Matrix",
      "rdfs:comment": "A container for BCG (Boston Consulting Group) growth-share matrix items",
      "rdfs:subClassOf": { "@id": "gist:Collection" }
    },
    {
      "@id": "bp:BCGItem",
      "@type": "owl:Class",
      "rdfs:label": "BCG Item",
      "rdfs:comment": "A business unit or product in a BCG Matrix, classified by market growth and market share",
      "rdfs:subClassOf": { "@id": "bp:QuadrantItem" }
    },
    {
      "@id": "bp:marketGrowth",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Market Growth",
      "rdfs:comment": "Whether the market is growing at a high or low rate",
      "rdfs:domain": { "@id": "bp:BCGItem" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bp:marketShare",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Market Share",
      "rdfs:comment": "Whether this unit has high or low relative market share",
      "rdfs:domain": { "@id": "bp:BCGItem" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bp:belongsToBCG",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Belongs To BCG",
      "rdfs:comment": "The BCG Matrix this item belongs to",
      "rdfs:domain": { "@id": "bp:BCGItem" },
      "rdfs:range": { "@id": "bp:BCGMatrix" }
    },

    {
      "@id": "bp:AnsoffMatrix",
      "@type": "owl:Class",
      "rdfs:label": "Ansoff Matrix",
      "rdfs:comment": "A container for Ansoff growth strategy matrix items",
      "rdfs:subClassOf": { "@id": "gist:Collection" }
    },
    {
      "@id": "bp:AnsoffItem",
      "@type": "owl:Class",
      "rdfs:label": "Ansoff Item",
      "rdfs:comment": "A growth strategy in an Ansoff Matrix, classified by market novelty and product novelty",
      "rdfs:subClassOf": { "@id": "bp:QuadrantItem" }
    },
    {
      "@id": "bp:marketNovelty",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Market Novelty",
      "rdfs:comment": "Whether the target market is existing or new",
      "rdfs:domain": { "@id": "bp:AnsoffItem" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bp:productNovelty",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Product Novelty",
      "rdfs:comment": "Whether the product or service is existing or new",
      "rdfs:domain": { "@id": "bp:AnsoffItem" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bp:belongsToAnsoff",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Belongs To Ansoff",
      "rdfs:comment": "The Ansoff Matrix this item belongs to",
      "rdfs:domain": { "@id": "bp:AnsoffItem" },
      "rdfs:range": { "@id": "bp:AnsoffMatrix" }
    },

    {
      "@id": "bp:StakeholderMap",
      "@type": "owl:Class",
      "rdfs:label": "Stakeholder Map",
      "rdfs:comment": "A container for stakeholder mapping items organized by power and interest",
      "rdfs:subClassOf": { "@id": "gist:Collection" }
    },
    {
      "@id": "bp:StakeholderItem",
      "@type": "owl:Class",
      "rdfs:label": "Stakeholder Item",
      "rdfs:comment": "A stakeholder in a Stakeholder Map, classified by power and interest level",
      "rdfs:subClassOf": { "@id": "bp:QuadrantItem" }
    },
    {
      "@id": "bp:stakeholderPower",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Stakeholder Power",
      "rdfs:comment": "The stakeholder's level of power or influence (high or low)",
      "rdfs:domain": { "@id": "bp:StakeholderItem" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bp:stakeholderInterest",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Stakeholder Interest",
      "rdfs:comment": "The stakeholder's level of interest in the project (high or low)",
      "rdfs:domain": { "@id": "bp:StakeholderItem" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bp:belongsToStakeholderMap",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Belongs To Stakeholder Map",
      "rdfs:comment": "The Stakeholder Map this item belongs to",
      "rdfs:domain": { "@id": "bp:StakeholderItem" },
      "rdfs:range": { "@id": "bp:StakeholderMap" }
    },

    {
      "@id": "bp:RiskMatrix",
      "@type": "owl:Class",
      "rdfs:label": "Risk Matrix",
      "rdfs:comment": "A container for risk assessment items organized by likelihood and impact",
      "rdfs:subClassOf": { "@id": "gist:Collection" }
    },
    {
      "@id": "bp:RiskItem",
      "@type": "owl:Class",
      "rdfs:label": "Risk Item",
      "rdfs:comment": "A risk in a Risk Matrix, classified by likelihood and impact level",
      "rdfs:subClassOf": { "@id": "bp:QuadrantItem" }
    },
    {
      "@id": "bp:riskLikelihood",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Risk Likelihood",
      "rdfs:comment": "How likely this risk is to occur (high or low)",
      "rdfs:domain": { "@id": "bp:RiskItem" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bp:riskImpact",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Risk Impact",
      "rdfs:comment": "How severe the impact would be if this risk occurs (high or low)",
      "rdfs:domain": { "@id": "bp:RiskItem" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bp:belongsToRiskMatrix",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Belongs To Risk Matrix",
      "rdfs:comment": "The Risk Matrix this item belongs to",
      "rdfs:domain": { "@id": "bp:RiskItem" },
      "rdfs:range": { "@id": "bp:RiskMatrix" }
    }
  ]
}

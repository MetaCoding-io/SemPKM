    {
      "@id": "bp:CriterionShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": { "@id": "bp:Criterion" },
      "rdfs:label": "Criterion Shape",
      "sempkm:editHelpText": "A weighted evaluation dimension in a Decision Matrix. Higher weights mean this criterion matters more in the final ranking.",
      "sh:property": [
        {
          "sh:path": { "@id": "dcterms:title" },
          "sh:name": "Title",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:order": 1,
          "sh:group": { "@id": "bp:CriterionBasicInfoGroup" },
          "sh:description": "The criterion name.",
          "sempkm:editHelpText": "Name this evaluation dimension — e.g. \"Performance\", \"Cost\", \"Ease of Use\"."
        },
        {
          "sh:path": { "@id": "dcterms:description" },
          "sh:name": "Description",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:maxCount": 1,
          "sh:order": 2,
          "sh:group": { "@id": "bp:CriterionBasicInfoGroup" },
          "sh:description": "What this criterion measures.",
          "sempkm:editHelpText": "Clarify how alternatives should be evaluated on this dimension."
        },
        {
          "sh:path": { "@id": "bp:weight" },
          "sh:name": "Weight",
          "sh:datatype": { "@id": "xsd:decimal" },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:order": 3,
          "sh:group": { "@id": "bp:CriterionScoringGroup" },
          "sh:description": "Relative weight (higher = more important).",
          "sempkm:editHelpText": "How important is this criterion relative to others? Use a scale like 1–10."
        },
        {
          "sh:path": { "@id": "bp:belongsToDecisionMatrix" },
          "sh:name": "Decision Matrix",
          "sh:class": { "@id": "bp:DecisionMatrix" },
          "sh:maxCount": 1,
          "sh:order": 4,
          "sh:group": { "@id": "bp:CriterionRelationshipsGroup" },
          "sh:description": "Which Decision Matrix this criterion belongs to.",
          "sempkm:editHelpText": "Link this criterion to a Decision Matrix."
        },
        {
          "sh:path": { "@id": "dcterms:created" },
          "sh:name": "Created",
          "sh:datatype": { "@id": "xsd:dateTime" },
          "sh:maxCount": 1,
          "sh:order": 5,
          "sh:group": { "@id": "bp:CriterionMetadataGroup" }
        },
        {
          "sh:path": { "@id": "dcterms:modified" },
          "sh:name": "Modified",
          "sh:datatype": { "@id": "xsd:dateTime" },
          "sh:maxCount": 1,
          "sh:order": 6,
          "sh:group": { "@id": "bp:CriterionMetadataGroup" }
        }
      ]
    },


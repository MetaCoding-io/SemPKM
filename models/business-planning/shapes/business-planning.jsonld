      "@type": "sh:NodeShape",
      "sh:targetClass": { "@id": "bp:Score" },
      "rdfs:label": "Score Shape",
      "sempkm:editHelpText": "A score entry linking an Alternative to a Criterion with a numeric value. Create one Score for each alternative-criterion combination in the matrix.",
      "sh:property": [
        {
          "sh:path": { "@id": "dcterms:title" },
          "sh:name": "Title",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:maxCount": 1,
          "sh:order": 1,
          "sh:group": { "@id": "bp:ScoreBasicInfoGroup" },
          "sh:description": "Optional label for this score entry.",
          "sempkm:editHelpText": "A label like \"Option A – Performance\" (auto-generated by the matrix view if left empty)."
        },
        {
          "sh:path": { "@id": "bp:value" },
          "sh:name": "Value",
          "sh:datatype": { "@id": "xsd:decimal" },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:order": 2,
          "sh:group": { "@id": "bp:ScoreBasicInfoGroup" },
          "sh:description": "Numeric score (e.g. 1–10).",
          "sempkm:editHelpText": "Rate this alternative on this criterion. Use the same scale across all scores (e.g. 1–10)."
        },
        {
          "sh:path": { "@id": "bp:scoreAlternative" },
          "sh:name": "Alternative",
          "sh:class": { "@id": "bp:Alternative" },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:order": 3,
          "sh:group": { "@id": "bp:ScoreRelationshipsGroup" },
          "sh:description": "The alternative being scored.",
          "sempkm:editHelpText": "Which option is being rated?"
        },
        {
          "sh:path": { "@id": "bp:scoreCriterion" },
          "sh:name": "Criterion",
          "sh:class": { "@id": "bp:Criterion" },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:order": 4,
          "sh:group": { "@id": "bp:ScoreRelationshipsGroup" },
          "sh:description": "The criterion being scored against.",
          "sempkm:editHelpText": "Which evaluation dimension is this score for?"
        },
        {
          "sh:path": { "@id": "dcterms:created" },
          "sh:name": "Created",
          "sh:datatype": { "@id": "xsd:dateTime" },
          "sh:maxCount": 1,
          "sh:order": 5,
          "sh:group": { "@id": "bp:ScoreMetadataGroup" }
        },
        {

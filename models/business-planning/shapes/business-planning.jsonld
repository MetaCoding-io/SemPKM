        },
        {
          "sh:path": { "@id": "dcterms:created" },
          "sh:name": "Created",
          "sh:datatype": { "@id": "xsd:dateTime" },
          "sh:maxCount": 1,
          "sh:order": 4,
          "sh:group": { "@id": "bp:AlternativeMetadataGroup" }
        },
        {

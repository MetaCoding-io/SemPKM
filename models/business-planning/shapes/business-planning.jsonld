          "sh:maxCount": 1,
          "sh:order": 1,
          "sh:group": { "@id": "bp:AlternativeBasicInfoGroup" },
          "sh:description": "The alternative name.",
          "sempkm:editHelpText": "Name this option — e.g. \"React Native\", \"Vendor A\", \"Build In-House\"."
        },
        {
          "sh:path": { "@id": "dcterms:description" },
          "sh:name": "Description",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:maxCount": 1,
          "sh:order": 2,
          "sh:group": { "@id": "bp:AlternativeBasicInfoGroup" },
          "sh:description": "Details about this alternative.",
          "sempkm:editHelpText": "Key facts about this option — capabilities, pricing, constraints."
        },
        {
          "sh:path": { "@id": "bp:belongsToDecisionMatrix" },
          "sh:name": "Decision Matrix",

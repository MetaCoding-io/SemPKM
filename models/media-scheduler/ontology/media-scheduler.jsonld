{
  "@context": {
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "gist": "https://w3id.org/semanticarts/ns/ontology/gist/",
    "ms": "urn:sempkm:model:media-scheduler:"
  },
  "@graph": [
    {
      "@id": "ms:ontology",
      "@type": "owl:Ontology",
      "rdfs:label": "Media Scheduler Ontology",
      "dcterms:description": "Media scheduling and consumption tracking. Defines MediaSource, MediaItem, and MediaCategory types for podcast, YouTube, and Spotify content management."
    },

    {
      "@id": "ms:MediaSource",
      "@type": "owl:Class",
      "rdfs:label": "Media Source",
      "rdfs:comment": "A content source such as a podcast feed, YouTube channel, or Spotify playlist"
    },
    {
      "@id": "ms:MediaItem",
      "@type": "owl:Class",
      "rdfs:label": "Media Item",
      "rdfs:comment": "An individual episode, video, or track discovered from a media source",
      "rdfs:subClassOf": { "@id": "gist:FormattedContent" }
    },
    {
      "@id": "ms:MediaCategory",
      "@type": "owl:Class",
      "rdfs:label": "Media Category",
      "rdfs:comment": "A user-defined grouping for media sources (e.g. news, podcasts, music, learning)"
    },

    {
      "@id": "ms:sourceType",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Source Type",
      "rdfs:comment": "Type of content source: podcast, youtube, or spotify",
      "rdfs:domain": { "@id": "ms:MediaSource" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "ms:feedUrl",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Feed URL",
      "rdfs:comment": "URL of the RSS/Atom feed or channel/playlist URL",
      "rdfs:domain": { "@id": "ms:MediaSource" },
      "rdfs:range": { "@id": "xsd:anyURI" }
    },
    {
      "@id": "ms:lastPolled",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Last Polled",
      "rdfs:comment": "Timestamp of the last poll attempt",
      "rdfs:domain": { "@id": "ms:MediaSource" },
      "rdfs:range": { "@id": "xsd:dateTime" }
    },
    {
      "@id": "ms:errorCount",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Error Count",
      "rdfs:comment": "Number of consecutive polling errors",
      "rdfs:domain": { "@id": "ms:MediaSource" },
      "rdfs:range": { "@id": "xsd:integer" }
    },
    {
      "@id": "ms:lastError",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Last Error",
      "rdfs:comment": "Description of the last polling error",
      "rdfs:domain": { "@id": "ms:MediaSource" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "ms:etag",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "ETag",
      "rdfs:comment": "HTTP ETag header for conditional GET requests",
      "rdfs:domain": { "@id": "ms:MediaSource" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "ms:lastModifiedHeader",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Last-Modified Header",
      "rdfs:comment": "HTTP Last-Modified header for conditional GET requests",
      "rdfs:domain": { "@id": "ms:MediaSource" },
      "rdfs:range": { "@id": "xsd:string" }
    },

    {
      "@id": "ms:enclosureUrl",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Enclosure URL",
      "rdfs:comment": "URL of the audio or video file",
      "rdfs:domain": { "@id": "ms:MediaItem" },
      "rdfs:range": { "@id": "xsd:anyURI" }
    },
    {
      "@id": "ms:duration",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Duration",
      "rdfs:comment": "Duration in seconds",
      "rdfs:domain": { "@id": "ms:MediaItem" },
      "rdfs:range": { "@id": "xsd:integer" }
    },
    {
      "@id": "ms:thumbnailUrl",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Thumbnail URL",
      "rdfs:comment": "URL of the episode or video thumbnail image",
      "rdfs:domain": { "@id": "ms:MediaItem" },
      "rdfs:range": { "@id": "xsd:anyURI" }
    },
    {
      "@id": "ms:externalId",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "External ID",
      "rdfs:comment": "Unique identifier from the source (episode GUID, video ID)",
      "rdfs:domain": { "@id": "ms:MediaItem" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "ms:status",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Status",
      "rdfs:comment": "Consumption status: queued, playing, completed, skipped, or saved",
      "rdfs:domain": { "@id": "ms:MediaItem" },
      "rdfs:range": { "@id": "xsd:string" }
    },

    {
      "@id": "ms:color",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Color",
      "rdfs:comment": "Display color for the category",
      "rdfs:domain": { "@id": "ms:MediaCategory" },
      "rdfs:range": { "@id": "xsd:string" }
    },

    {
      "@id": "ms:mediaSource",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Media Source",
      "rdfs:comment": "The content source this item was discovered from",
      "rdfs:domain": { "@id": "ms:MediaItem" },
      "rdfs:range": { "@id": "ms:MediaSource" }
    },
    {
      "@id": "ms:category",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Category",
      "rdfs:comment": "The category this source belongs to",
      "rdfs:domain": { "@id": "ms:MediaSource" },
      "rdfs:range": { "@id": "ms:MediaCategory" }
    }
  ]
}

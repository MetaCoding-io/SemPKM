{
  "workflows": [
    {
      "name": "Daily Check-in",
      "description": "Quick daily capture: create an action item and review active actions on the kanban board.",
      "steps": [
        {
          "type": "form",
          "label": "Create Action Item",
          "config": {
            "target_class": "urn:sempkm:model:ppv:ActionItem"
          }
        },
        {
          "type": "view",
          "label": "Action Kanban",
          "config": {
            "spec_iri": "urn:sempkm:model:ppv:view-action-kanban",
            "renderer_type": "kanban"
          }
        }
      ]
    },
    {
      "name": "Weekly Review",

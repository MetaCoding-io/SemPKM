@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix ppv:   <urn:sempkm:model:ppv:> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .

# Rule: Derive ppv:pillar on Projects from the GoalOutcome -> ValueGoal -> Pillar chain
# This populates the denormalized shortcut so dashboard queries can filter by pillar directly.

ppv:ProjectPillarDenormRule
    a sh:NodeShape ;
    sh:targetClass ppv:Project ;
    sh:rule [
        a sh:SPARQLRule ;
        sh:order 0 ;
        rdfs:label "Derive project pillar from goal chain" ;
        rdfs:comment "When a Project links to a GoalOutcome whose ValueGoal has a Pillar, copy the Pillar link to the Project" ;
        sh:prefixes ppv:PrefixDeclarations ;
        sh:construct """
            CONSTRUCT {
                $this ppv:pillar ?pillar .
            }
            WHERE {
                $this ppv:goalOutcome ?go .
                ?go ppv:valueGoal ?vg .
                ?vg ppv:pillar ?pillar .
                FILTER NOT EXISTS { $this ppv:pillar ?existingPillar }
            }
        """ ;
    ] .

# Rule: Derive ppv:pillar on ActionItems from the Project -> GoalOutcome -> ValueGoal -> Pillar chain

ppv:ActionItemPillarDenormRule
    a sh:NodeShape ;
    sh:targetClass ppv:ActionItem ;
    sh:rule [
        a sh:SPARQLRule ;
        sh:order 1 ;
        rdfs:label "Derive action item pillar from project chain" ;
        rdfs:comment "When an ActionItem links to a Project that has a Pillar (direct or derived), copy the Pillar link to the ActionItem" ;
        sh:prefixes ppv:PrefixDeclarations ;
        sh:construct """
            CONSTRUCT {
                $this ppv:pillar ?pillar .
            }
            WHERE {
                $this ppv:project ?proj .
                ?proj ppv:pillar ?pillar .
                FILTER NOT EXISTS { $this ppv:pillar ?existingPillar }
            }
        """ ;
    ] .

# Rule: Derive schema:startDate on PillarScore from the linked WeeklyReview's startDate
# This denormalizes the date so calendar/timeline views can render PillarScores directly.

ppv:PillarScoreDateDenormRule
    a sh:NodeShape ;
    sh:targetClass ppv:PillarScore ;
    sh:rule [
        a sh:SPARQLRule ;
        sh:order 2 ;
        rdfs:label "Derive pillar score date from weekly review" ;
        sh:prefixes ppv:PrefixDeclarations ;
        sh:construct """
            CONSTRUCT { $this schema:startDate ?startDate . }
            WHERE {
                $this ppv:weeklyReview ?wr .
                ?wr schema:startDate ?startDate .
                FILTER NOT EXISTS { $this schema:startDate ?existing }
            }
        """ ;
    ] .

# Prefix declarations for SPARQL rules
ppv:PrefixDeclarations
    a owl:Ontology ;
    sh:declare [
        sh:prefix "ppv" ;
        sh:namespace "urn:sempkm:model:ppv:"^^xsd:anyURI ;
    ] ;
    sh:declare [
        sh:prefix "dcterms" ;
        sh:namespace "http://purl.org/dc/terms/"^^xsd:anyURI ;
    ] ;
    sh:declare [
        sh:prefix "xsd" ;
        sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ;
    ] ;
    sh:declare [
        sh:prefix "schema" ;
        sh:namespace "https://schema.org/"^^xsd:anyURI ;
    ] .

# ============================================================
# Validation: Info when a Project has no modification date.
# Uses simple NOT EXISTS check to avoid K001 date arithmetic
# limitation. Projects without dcterms:modified may be stale.
# ============================================================

ppv:StaleProjectValidationShape
    a sh:NodeShape ;
    sh:targetClass ppv:Project ;
    sh:severity sh:Info ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Project has no modification date recorded. Consider reviewing its status." ;
        sh:prefixes ppv:PrefixDeclarations ;
        sh:select """
            SELECT $this
            WHERE {
                FILTER NOT EXISTS { $this dcterms:modified ?mod }
            }
        """ ;
    ] .

# ============================================================
# Validation: Warn when an ActionItem is not linked to a Project.
# Part of the PPV broken-chain checks — every action should
# trace up to a project in the pillar hierarchy.
# ============================================================

ppv:ActionItemNoProjectValidationShape
    a sh:NodeShape ;
    sh:targetClass ppv:ActionItem ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Action item is not linked to any project." ;
        sh:prefixes ppv:PrefixDeclarations ;
        sh:select """
            SELECT $this
            WHERE {
                FILTER NOT EXISTS { $this ppv:project ?proj }
            }
        """ ;
    ] .

# ============================================================
# Validation: Warn when a Project is not linked to a GoalOutcome.
# Part of the PPV broken-chain checks — every project should
# trace up to a goal outcome in the pillar hierarchy.
# ============================================================

ppv:ProjectNoGoalValidationShape
    a sh:NodeShape ;
    sh:targetClass ppv:Project ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Project is not linked to any goal outcome." ;
        sh:prefixes ppv:PrefixDeclarations ;
        sh:select """
            SELECT $this
            WHERE {
                FILTER NOT EXISTS { $this ppv:goalOutcome ?go }
            }
        """ ;
    ] .

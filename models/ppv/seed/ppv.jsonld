    {
      "@id": "ppv:seed-review-yearly-2026",
      "@type": "ppv:YearlyReview",
      "dcterms:title": "2026 Annual Review",
      "ppv:cycle": "yearly",
      "ppv:yearName": "2026",
      "ppv:intentionWord": "Momentum",
      "ppv:yearTheme": "Build the scaffolding for the life I want — health systems, career trajectory, relationship rituals — so that daily execution becomes automatic and energy goes to what matters.",
      "ppv:quarters": [
        { "@id": "ppv:seed-review-q1-2026" }
      ],
      "dcterms:created": { "@value": "2026-01-01T09:00:00Z", "@type": "xsd:dateTime" }
    },
    {
      "@id": "ppv:seed-review-q1-2026",
      "@type": "ppv:QuarterlyReview",
      "dcterms:title": "Q1 2026",
      "ppv:cycle": "quarterly",
      "ppv:quarterName": "Q1 2026",
      "ppv:yearLink": { "@id": "ppv:seed-review-yearly-2026" },
      "ppv:accomplishments": "Established consistent running habit (4x/week for 8 weeks). Launched meal prep system. Delivered well-received technical design doc at work.",
      "ppv:disappointments": "Conference abstract still not started. Missed two family dinners due to work travel. Didn't start the strength training progression.",
      "ppv:whatWorked": "Sunday planning sessions made weekday execution almost automatic. Stacking habits (morning run → cold shower → journaling) created reliable momentum.",
      "ppv:whatDidntWork": "Trying to do deep work in the open office. Relying on willpower for evening workouts instead of scheduling them. Not saying no to optional meetings.",
      "ppv:howToImprove": "Block two 90-minute deep work sessions per week in a private room. Move all workouts to morning. Set a hard cap of 4 meetings per day.",
      "ppv:annualVisionNotes": "On track for the health pillar. Career pillar needs a forcing function for the conference keynote — consider committing publicly. Relationship pillar is steady but could use more intentional 1:1 time.",
      "dcterms:created": { "@value": "2026-01-01T09:00:00Z", "@type": "xsd:dateTime" }
    },
    {
      "@id": "ppv:seed-review-march-2026",
      "@type": "ppv:MonthlyReview",
      "dcterms:title": "March 2026",
      "ppv:cycle": "monthly",
      "ppv:monthName": "March 2026",
      "ppv:year": "2026",
      "ppv:quarter": { "@id": "ppv:seed-review-q1-2026" },
      "ppv:gratitude": "Grateful for consistent running habit finally clicking after years of false starts.",
      "ppv:learnedThisMonth": "Learned that meal prepping on Sunday saves both time and decision fatigue during the week.",
      "ppv:biggestWins": "Completed all four weeks of half marathon training without missing a single run. Family dinner tradition hit 8 consecutive weeks.",
      "ppv:biggestChallenges": "Work travel disrupted two weeks of meal prep. Struggled to maintain evening focus after long days.",
      "ppv:focusAreas": "Lock in the 10K distance as comfortable. Start conference abstract draft. Add one new family recipe per week.",
      "ppv:habitsToAdjust": "Move meal prep to Saturday evening when Sunday mornings get crowded. Replace phone scrolling before bed with 10 minutes of reading.",
      "dcterms:created": { "@value": "2026-03-01T09:00:00Z", "@type": "xsd:dateTime" }
    },
    {
      "@id": "ppv:seed-review-week-mar3",
      "@type": "ppv:WeeklyReview",
      "dcterms:title": "Week of March 3, 2026",

    {
      "@id": "ppv:seed-guiding-principles",
      "@type": "ppv:GuidingPrinciples",
      "dcterms:title": "My Guiding Principles",
      "ppv:values": "Integrity, Growth, Impact, Connection, Excellence",
      "ppv:purpose": "To build systems and knowledge that empower people to live intentionally, making each day a deliberate step toward the life they envision.",
      "ppv:meaning": "A life well-lived means continuous growth across all pillars — not perfection, but consistent forward motion guided by clear values and honest self-assessment.",
      "ppv:manifestation": "I show up fully in every domain: disciplined in health, ambitious in career, present in relationships. I build before I consume. I reflect before I react.",
      "ppv:foundationalStatement": "Every system I build, every habit I cultivate, and every relationship I nurture is an expression of who I am becoming. Structure creates freedom.",
      "ppv:guidingWord": "Intentional",
      "dcterms:created": { "@value": "2026-01-01T09:00:00Z", "@type": "xsd:dateTime" }
    },

    {
      "@id": "ppv:seed-score-health-w1",
      "@type": "ppv:PillarScore",
      "dcterms:title": "Health & Fitness — Week of March 3",
      "ppv:score": { "@value": "8", "@type": "xsd:integer" },
      "ppv:wentWell": "Hit all four training runs this week including the tempo session. Sleep consistency improved — averaged 7.5 hours with consistent 10pm bedtime.",

    {
      "@id": "ppv:guiding-principles",
      "@type": "ppv:GuidingPrinciples",
      "dcterms:title": "My Guiding Principles",
      "ppv:values": "Family. Independence. Democratic economic planning.",
      "ppv:purpose": "To build a loving family, maintain a stable and independent financial life, and contribute to the world through politics.",
      "ppv:meaning": "Family is the core of who I am — it's identity, not aspiration. Economic planning has been the heart of what I've cared about in left politics for twenty years. These aren't items on a list. They're the things I'd fight for.",
      "ppv:manifestation": "I call my parents and sister. I show up for Jack every week. I ship real things outside my day job — newsletters, courses, tools. I read and engage with the democratic planning community, and I push myself to do more than passively consume.",
      "ppv:foundationalStatement": "Time is the thing I never have enough of.\nSo I spend it where it counts: on the people I love,\non work that builds independence, and on twenty years\nof conviction that the economy can serve everyone.\nI build. I show up. I don't wait for the perfect moment.",
      "ppv:guidingWord": "Build",
      "dcterms:created": {"@value": "2026-03-21T12:00:00Z", "@type": "xsd:dateTime"}
    },


    {"@id": "ppv:vg-build-life-with-partner", "@type": "ppv:ValueGoal", "dcterms:title": "Build a Life with My Partner", "dcterms:description": "Take the next major steps in our relationship — proposal, engagement, and building a shared future together.", "ppv:pillar": {"@id": "ppv:pillar-relationships"}, "ppv:status": "Underway", "ppv:priority": "1st Priority", "dcterms:created": {"@value": "2026-03-21T12:00:00Z", "@type": "xsd:dateTime"}},
    {"@id": "ppv:vg-strengthen-family", "@type": "ppv:ValueGoal", "dcterms:title": "Strengthen Family Bonds", "dcterms:description": "Invest real time and attention in family — call more often, reconnect with extended family, mentor nephew Jack, show up more for parents and sister.", "ppv:pillar": {"@id": "ppv:pillar-relationships"}, "ppv:status": "Underway", "ppv:priority": "2nd Priority", "dcterms:created": {"@value": "2026-03-21T12:00:00Z", "@type": "xsd:dateTime"}},
    {"@id": "ppv:vg-investment-income", "@type": "ppv:ValueGoal", "dcterms:title": "Build Investment Income Streams", "dcterms:description": "Develop knowledge and positions in options trading to create a recurring cashflow stream outside of salary.", "ppv:pillar": {"@id": "ppv:pillar-finances"}, "ppv:status": "Underway", "ppv:priority": "1st Priority", "dcterms:created": {"@value": "2026-03-21T12:00:00Z", "@type": "xsd:dateTime"}},
    {"@id": "ppv:vg-practical-life-skills", "@type": "ppv:ValueGoal", "dcterms:title": "Build Practical Life Skills", "dcterms:description": "Close the gaps on essential life skills that expand independence and capability.", "ppv:pillar": {"@id": "ppv:pillar-learning"}, "ppv:status": "Underway", "ppv:priority": "1st Priority", "dcterms:created": {"@value": "2026-03-21T12:00:00Z", "@type": "xsd:dateTime"}},
    {"@id": "ppv:vg-stay-active", "@type": "ppv:ValueGoal", "dcterms:title": "Stay Physically Active", "dcterms:description": "Maintain an active lifestyle through sports and regular physical activity.", "ppv:pillar": {"@id": "ppv:pillar-health"}, "ppv:status": "Underway", "ppv:priority": "1st Priority", "dcterms:created": {"@value": "2026-03-21T12:00:00Z", "@type": "xsd:dateTime"}},
    {"@id": "ppv:vg-play-music", "@type": "ppv:ValueGoal", "dcterms:title": "Play Music Again", "dcterms:description": "Get back into drumming — whether through lessons, practice at home, or both.", "ppv:pillar": {"@id": "ppv:pillar-fun"}, "ppv:status": "Underway", "ppv:priority": "1st Priority", "dcterms:created": {"@value": "2026-03-21T12:00:00Z", "@type": "xsd:dateTime"}},
    {"@id": "ppv:vg-tidy-life-admin", "@type": "ppv:ValueGoal", "dcterms:title": "Keep Life Admin Under Control", "dcterms:description": "Stay on top of paperwork, household admin, and the unglamorous stuff that piles up when ignored.", "ppv:pillar": {"@id": "ppv:pillar-home"}, "ppv:status": "Underway", "ppv:priority": "1st Priority", "dcterms:created": {"@value": "2026-03-21T12:00:00Z", "@type": "xsd:dateTime"}},

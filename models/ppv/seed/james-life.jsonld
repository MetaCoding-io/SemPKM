    {"@id": "ppv:action-proposal-brainstorm-locations", "@type": "ppv:ActionItem", "dcterms:title": "Brainstorm proposal locations", "dcterms:description": "List 3-5 places that are meaningful to your relationship. Think about where you first met, favorite date spots, or somewhere new that would feel special.", "ppv:project": {"@id": "ppv:proj-plan-proposal"}, "ppv:pillar": {"@id": "ppv:pillar-relationships"}, "ppv:status": "Active", "ppv:priority": "1st Priority", "ppv:done": false, "ppv:doDate": {"@value": "2026-03-23", "@type": "xsd:date"}, "ppv:context": "anywhere", "ppv:energy": "medium", "ppv:timeEstimate": {"@value": "30", "@type": "xsd:integer"}, "dcterms:created": {"@value": "2026-03-21T12:00:00Z", "@type": "xsd:dateTime"}},
    {"@id": "ppv:action-proposal-decide-accomplices", "@type": "ppv:ActionItem", "dcterms:title": "Decide if anyone else should be involved", "dcterms:description": "Photographer? Family hiding nearby? Or just the two of you? Decide the vibe.", "ppv:project": {"@id": "ppv:proj-plan-proposal"}, "ppv:pillar": {"@id": "ppv:pillar-relationships"}, "ppv:status": "Next Up", "ppv:priority": "2nd Priority", "ppv:done": false, "ppv:doDate": {"@value": "2026-03-25", "@type": "xsd:date"}, "ppv:context": "anywhere", "ppv:energy": "medium", "ppv:timeEstimate": {"@value": "20", "@type": "xsd:integer"}, "dcterms:created": {"@value": "2026-03-21T12:00:00Z", "@type": "xsd:dateTime"}},
    {"@id": "ppv:action-proposal-write-words", "@type": "ppv:ActionItem", "dcterms:title": "Draft what you want to say", "dcterms:description": "Doesn't need to be a speech — just the core of what you want her to hear. Write from the heart, edit later.", "ppv:project": {"@id": "ppv:proj-plan-proposal"}, "ppv:pillar": {"@id": "ppv:pillar-relationships"}, "ppv:status": "Next Up", "ppv:priority": "2nd Priority", "ppv:done": false, "ppv:doDate": {"@value": "2026-03-28", "@type": "xsd:date"}, "ppv:context": "home", "ppv:energy": "high", "ppv:timeEstimate": {"@value": "45", "@type": "xsd:integer"}, "dcterms:created": {"@value": "2026-03-21T12:00:00Z", "@type": "xsd:dateTime"}},

    {
      "@id": "ppv:review-yearly-2026",
      "@type": "ppv:YearlyReview",
      "dcterms:title": "2026 Annual Review",
      "ppv:cycle": "yearly",
      "ppv:yearName": "2026",
      "ppv:intentionWord": "Build",
      "ppv:yearTheme": "Stop consuming, start building — in career, in family, in the political work I've cared about for twenty years. Ship the newsletter, make the calls, show up.",
      "ppv:quarters": [{"@id": "ppv:review-q1-2026"}],
      "dcterms:created": {"@value": "2026-01-01T09:00:00Z", "@type": "xsd:dateTime"}

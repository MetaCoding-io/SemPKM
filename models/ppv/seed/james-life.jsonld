    {"@id": "ppv:action-armra-reup", "@type": "ppv:ActionItem", "dcterms:title": "Get ARMRA Colostrum re-up for Mom and Dad", "dcterms:description": "Reorder ARMRA colostrum for parents. Check if they need the same size/quantity as last time.", "ppv:pillar": {"@id": "ppv:pillar-relationships"}, "ppv:status": "Active", "ppv:priority": "Immediate", "ppv:done": false, "ppv:doDate": {"@value": "2026-04-07", "@type": "xsd:date"}, "ppv:context": "computer", "ppv:energy": "low", "ppv:timeEstimate": {"@value": "10", "@type": "xsd:integer"}, "dcterms:created": {"@value": "2026-04-05T12:00:00Z", "@type": "xsd:dateTime"}},
    {"@id": "ppv:action-write-joseph", "@type": "ppv:ActionItem", "dcterms:title": "Set aside time to write a thoughtful response to Joseph", "dcterms:description": "It's been a long time and you forgot to write back. Don't rush this — find a quiet 30-minute window, re-read his last message, and write something real. Acknowledge the gap without over-apologizing.", "ppv:project": {"@id": "ppv:proj-reconnect-joseph"}, "ppv:pillar": {"@id": "ppv:pillar-relationships"}, "ppv:status": "Active", "ppv:priority": "2nd Priority", "ppv:done": false, "ppv:doDate": {"@value": "2026-03-24", "@type": "xsd:date"}, "ppv:context": "home", "ppv:energy": "medium", "ppv:timeEstimate": {"@value": "30", "@type": "xsd:integer"}, "dcterms:created": {"@value": "2026-03-21T12:00:00Z", "@type": "xsd:dateTime"}},
    {"@id": "ppv:action-joseph-followup", "@type": "ppv:ActionItem", "dcterms:title": "Follow up with Joseph — suggest a call or hangout", "dcterms:description": "After the initial reply lands, propose something concrete: a call, a meal, a visit.", "ppv:project": {"@id": "ppv:proj-reconnect-joseph"}, "ppv:pillar": {"@id": "ppv:pillar-relationships"}, "ppv:status": "Future 1", "ppv:priority": "Scheduled", "ppv:done": false, "ppv:doDate": {"@value": "2026-03-29", "@type": "xsd:date"}, "ppv:context": "calls", "ppv:energy": "low", "ppv:timeEstimate": {"@value": "10", "@type": "xsd:integer"}, "dcterms:created": {"@value": "2026-03-21T12:00:00Z", "@type": "xsd:dateTime"}},
    {"@id": "ppv:action-write-adrianna", "@type": "ppv:ActionItem", "dcterms:title": "Set aside time to write a thoughtful response to Adrianna", "dcterms:description": "Same situation as Joseph — you owe her a real reply. Find a quiet window, re-read her message, write something genuine.", "ppv:project": {"@id": "ppv:proj-reconnect-adrianna"}, "ppv:pillar": {"@id": "ppv:pillar-relationships"}, "ppv:status": "Active", "ppv:priority": "2nd Priority", "ppv:done": false, "ppv:doDate": {"@value": "2026-03-25", "@type": "xsd:date"}, "ppv:context": "home", "ppv:energy": "medium", "ppv:timeEstimate": {"@value": "30", "@type": "xsd:integer"}, "dcterms:created": {"@value": "2026-03-21T12:00:00Z", "@type": "xsd:dateTime"}},
    {"@id": "ppv:action-adrianna-followup", "@type": "ppv:ActionItem", "dcterms:title": "Follow up with Adrianna — suggest catching up", "ppv:project": {"@id": "ppv:proj-reconnect-adrianna"}, "ppv:pillar": {"@id": "ppv:pillar-relationships"}, "ppv:status": "Future 1", "ppv:priority": "Scheduled", "ppv:done": false, "ppv:doDate": {"@value": "2026-03-29", "@type": "xsd:date"}, "ppv:context": "calls", "ppv:energy": "low", "ppv:timeEstimate": {"@value": "10", "@type": "xsd:integer"}, "dcterms:created": {"@value": "2026-03-21T12:00:00Z", "@type": "xsd:dateTime"}},
    {"@id": "ppv:action-jack-pick-first-language", "@type": "ppv:ActionItem", "dcterms:title": "Pick a first programming language/tool for Jack", "dcterms:description": "Consider his age and interests. Scratch? Python? JavaScript? Something he can see results from quickly. Maybe tie it to something he already cares about (games, math visualizations).", "ppv:project": {"@id": "ppv:proj-mentor-jack"}, "ppv:pillar": {"@id": "ppv:pillar-relationships"}, "ppv:status": "Active", "ppv:priority": "2nd Priority", "ppv:done": false, "ppv:doDate": {"@value": "2026-03-24", "@type": "xsd:date"}, "ppv:context": "anywhere", "ppv:energy": "medium", "ppv:timeEstimate": {"@value": "20", "@type": "xsd:integer"}, "dcterms:created": {"@value": "2026-03-21T12:00:00Z", "@type": "xsd:dateTime"}},
    {"@id": "ppv:action-jack-first-programming-session", "@type": "ppv:ActionItem", "dcterms:title": "Run first programming mini-lesson with Jack", "dcterms:description": "Introduce it during the next tutoring session — 15-20 min at the end. Keep it fun, low-pressure. Build something small together.", "ppv:project": {"@id": "ppv:proj-mentor-jack"}, "ppv:pillar": {"@id": "ppv:pillar-relationships"}, "ppv:status": "Next Up", "ppv:priority": "Scheduled", "ppv:done": false, "ppv:doDate": {"@value": "2026-03-25", "@type": "xsd:date"}, "ppv:context": "home", "ppv:energy": "medium", "ppv:timeEstimate": {"@value": "30", "@type": "xsd:integer"}, "dcterms:created": {"@value": "2026-03-21T12:00:00Z", "@type": "xsd:dateTime"}},

    {
      "@id": "ppv:review-q1-2026",
      "@type": "ppv:QuarterlyReview",
      "dcterms:title": "Q1 2026",
      "ppv:cycle": "quarterly",
      "ppv:quarterName": "Q1 2026",
      "ppv:yearLink": {"@id": "ppv:review-yearly-2026"},
      "ppv:accomplishments": "Got proposal planning off the ground — locations brainstormed, wedding bands 50% done. Jack tutoring going strong. Started Tailscale home lab setup. Soccer still happening weekly.",
      "ppv:disappointments": "Career pillar went nowhere. Zero progress on Zabbix, newsletter, or side income. Didn't write back to Joseph or Adrianna. Mental health habits (journaling, workout, reading) all at zero.",
      "ppv:whatWorked": "Sunday planning sessions. Having concrete next-actions on the proposal kept momentum. Soccer as a weekly anchor for physical activity.",
      "ppv:whatDidntWork": "Relying on free time appearing for career and mental health work. If it's not scheduled, it doesn't happen. Passive consumption of political content instead of active participation.",
      "ppv:howToImprove": "Block dedicated time for Zabbix and newsletter work during the week. Pick ONE mental health habit to start (journaling seems lowest friction). Schedule the family calls instead of 'meaning to call soon'.",
      "ppv:annualVisionNotes": "Relationships pillar is the strongest. Career and Mental Health are the weakest. Q2 needs to be about building foundations in the neglected pillars — even small ones.",
      "dcterms:created": {"@value": "2026-01-01T09:00:00Z", "@type": "xsd:dateTime"}
    },
    {
      "@id": "ppv:review-march-2026",

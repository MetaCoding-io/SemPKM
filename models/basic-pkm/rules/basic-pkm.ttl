@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix bpkm:  <urn:sempkm:model:basic-pkm:> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .

# Rule: Derive bpkm:hasRelatedNote on Projects from Notes' bpkm:relatedProject
# This is NOT handled by OWL inverseOf -- no inverse declaration exists for relatedProject.
# Demonstrates SHACL-AF value: arbitrary SPARQL-based derivation beyond OWL 2 RL axioms.

bpkm:ProjectRelatedNoteRule
    a sh:NodeShape ;
    sh:targetClass bpkm:Note ;
    sh:rule [
        a sh:SPARQLRule ;
        sh:order 0 ;
        rdfs:label "Derive hasRelatedNote inverse" ;
        rdfs:comment "When a Note has relatedProject, the Project gains hasRelatedNote back-link" ;
        sh:prefixes bpkm:PrefixDeclarations ;
        sh:construct """
            CONSTRUCT {
                ?project bpkm:hasRelatedNote $this .
            }
            WHERE {
                $this bpkm:relatedProject ?project .
            }
        """ ;
    ] .

# Rule: Derive bpkm:taskProject on a Task from its Milestone's project.
# When a Task links to a Milestone via bpkm:milestone, and that Milestone links
# to a Project via bpkm:milestoneProject, this rule infers the transitive
# bpkm:taskProject link — but only if the Task doesn't already have one.
# The inverse (bpkm:hasProjectTasks) is handled by owl:inverseOf entailment.

bpkm:TaskProjectDenormRule
    a sh:NodeShape ;
    sh:targetClass bpkm:Task ;
    sh:rule [
        a sh:SPARQLRule ;
        sh:order 1 ;
        rdfs:label "Derive task project from milestone" ;
        sh:prefixes bpkm:PrefixDeclarations ;
        sh:construct """
            CONSTRUCT { $this bpkm:taskProject ?project . }
            WHERE {
                $this bpkm:milestone ?ms .
                ?ms bpkm:milestoneProject ?project .
                FILTER NOT EXISTS { $this bpkm:taskProject ?existingProject }
            }
        """ ;
    ] .

# Validation: Warn when a Task is overdue (due date in the past, status not done/cancelled).
# This is a SEPARATE NodeShape from inference rules per D153 — validation shapes
# carry sh:severity on the NodeShape, not on the SPARQLConstraint.
# Date comparison uses STRDT(SUBSTR(STR(NOW()),1,10), xsd:date) because rdflib
# does not support xsd:date(NOW()) cast.

bpkm:OverdueTaskValidationShape
    a sh:NodeShape ;
    sh:targetClass bpkm:Task ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Task is overdue: due date has passed but task is not done or cancelled." ;
        sh:prefixes bpkm:PrefixDeclarations ;
        sh:select """
            SELECT $this ?dueDate ?status
            WHERE {
                $this bpkm:dueDate ?dueDate .
                $this bpkm:taskStatus ?status .
                FILTER (?status IN ("todo", "in-progress", "blocked"))
                BIND(STRDT(SUBSTR(STR(NOW()), 1, 10), xsd:date) AS ?today)
                FILTER (?dueDate < ?today)
            }
        """ ;
    ] .

# ============================================================
# Validation: Warn when a tag value contains a comma.
# Users sometimes enter "tag1, tag2" as a single tag value
# instead of creating separate tag triples.
# ============================================================

bpkm:CommaInTagsValidationShape
    a sh:NodeShape ;
    sh:targetSubjectsOf bpkm:tags ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Tag value contains a comma — split into individual tags." ;
        sh:prefixes bpkm:PrefixDeclarations ;
        sh:select """
            SELECT $this ?tagVal
            WHERE {
                $this bpkm:tags ?tagVal .
                FILTER(CONTAINS(STR(?tagVal), ","))
            }
        """ ;
    ] .

# ============================================================
# Validation: Info when a Note or Concept has no body content.
# Uses sh:targetSubjectsOf rdf:type with SPARQL filter since
# sh:targetClass cannot target two classes on one shape.
# Body predicate uses full IRI — sempkm vocab not in prefixes.
# ============================================================

bpkm:EmptyBodyValidationShape
    a sh:NodeShape ;
    sh:targetSubjectsOf rdf:type ;
    sh:severity sh:Info ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Object has no body content. Consider adding a description or notes." ;
        sh:prefixes bpkm:PrefixDeclarations ;
        sh:select """
            SELECT $this
            WHERE {
                { $this a bpkm:Note }
                UNION
                { $this a bpkm:Concept }
                FILTER NOT EXISTS { $this <urn:sempkm:vocab:body> ?body }
            }
        """ ;
    ] .

# ============================================================
# Validation: Info when a Concept has no skos:definition.
# Concepts benefit from formal definitions to distinguish
# them from vague tags.
# ============================================================

bpkm:ConceptNoDefinitionValidationShape
    a sh:NodeShape ;
    sh:targetClass bpkm:Concept ;
    sh:severity sh:Info ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Concept has no definition. Consider adding a skos:definition." ;
        sh:prefixes bpkm:PrefixDeclarations ;
        sh:select """
            SELECT $this
            WHERE {
                FILTER NOT EXISTS { $this skos:definition ?def }
            }
        """ ;
    ] .

# ============================================================
# Validation: Warn when a basic-pkm typed object has no title.
# Checks dcterms:title, rdfs:label, skos:prefLabel, foaf:name.
# Scoped to basic-pkm types only to avoid false positives on
# objects with model-specific name properties (e.g. CRM).
# ============================================================

bpkm:TitlelessObjectValidationShape
    a sh:NodeShape ;
    sh:targetSubjectsOf rdf:type ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Object has no title (dcterms:title, rdfs:label, skos:prefLabel, or foaf:name)." ;
        sh:prefixes bpkm:PrefixDeclarations ;
        sh:select """
            SELECT $this
            WHERE {
                $this a ?type .
                FILTER(STRSTARTS(STR(?type), "urn:sempkm:model:basic-pkm:"))
                FILTER NOT EXISTS { $this dcterms:title ?t1 }
                FILTER NOT EXISTS { $this rdfs:label ?t2 }
                FILTER NOT EXISTS { $this skos:prefLabel ?t3 }
                FILTER NOT EXISTS { $this foaf:name ?t4 }
            }
        """ ;
    ] .

# ============================================================
# Validation: Info when a basic-pkm typed object is orphaned.
# An orphan has no edges to/from other typed resources
# (excluding rdf:type itself). Scoped to basic-pkm types
# to avoid firing on every typed resource in the graph (D282).
# ============================================================

bpkm:OrphanObjectValidationShape
    a sh:NodeShape ;
    sh:targetSubjectsOf rdf:type ;
    sh:severity sh:Info ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Object has no connections to other objects. Consider linking it." ;
        sh:prefixes bpkm:PrefixDeclarations ;
        sh:select """
            SELECT $this
            WHERE {
                $this a ?type .
                FILTER(STRSTARTS(STR(?type), "urn:sempkm:model:basic-pkm:"))
                FILTER NOT EXISTS {
                    $this ?p ?other .
                    ?other a ?anyType .
                    FILTER(?p != rdf:type)
                }
                FILTER NOT EXISTS {
                    ?other2 ?p2 $this .
                    ?other2 a ?anyType2 .
                }
            }
        """ ;
    ] .

# ============================================================
# Validation: Info when two objects of the same type share a URL.
# Detects potential duplicates based on schema:url.
# ============================================================

bpkm:DuplicateUrlValidationShape
    a sh:NodeShape ;
    sh:targetSubjectsOf <http://schema.org/url> ;
    sh:severity sh:Info ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Another object of the same type shares this URL: {?url}." ;
        sh:prefixes bpkm:PrefixDeclarations ;
        sh:select """
            SELECT $this ?url
            WHERE {
                $this <http://schema.org/url> ?url .
                $this a ?type .
                ?other a ?type .
                ?other <http://schema.org/url> ?url .
                FILTER(?other != $this)
            }
        """ ;
    ] .

# Prefix declarations for SPARQL rules and constraints.
# Shared by all sh:SPARQLRule and sh:SPARQLConstraint instances via sh:prefixes.
bpkm:PrefixDeclarations
    a owl:Ontology ;
    sh:declare [
        sh:prefix "bpkm" ;
        sh:namespace "urn:sempkm:model:basic-pkm:"^^xsd:anyURI ;
    ] ,
    [
        sh:prefix "xsd" ;
        sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ;
    ] ,
    [
        sh:prefix "dcterms" ;
        sh:namespace "http://purl.org/dc/terms/"^^xsd:anyURI ;
    ] ,
    [
        sh:prefix "rdf" ;
        sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ;
    ] ,
    [
        sh:prefix "rdfs" ;
        sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ;
    ] ,
    [
        sh:prefix "skos" ;
        sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ;
    ] ,
    [
        sh:prefix "foaf" ;
        sh:namespace "http://xmlns.com/foaf/0.1/"^^xsd:anyURI ;
    ] ,
    [
        sh:prefix "schema" ;
        sh:namespace "http://schema.org/"^^xsd:anyURI ;
    ] .

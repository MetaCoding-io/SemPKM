{
  "@context": {
    "sh": "http://www.w3.org/ns/shacl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dcterms": "http://purl.org/dc/terms/",
    "schema": "https://schema.org/",
    "foaf": "http://xmlns.com/foaf/0.1/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "bpkm": "urn:sempkm:model:basic-pkm:",
    "sempkm": "urn:sempkm:"
  },
  "@graph": [
    {
      "@id": "bpkm:ProjectBasicInfoGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Basic Info",
      "sh:order": 1
    },
    {
      "@id": "bpkm:ProjectDatesGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Dates",
      "sh:order": 2
    },
    {
      "@id": "bpkm:ProjectRelationshipsGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Relationships",
      "sh:order": 3
    },
    {
      "@id": "bpkm:ProjectMetadataGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Metadata",
      "sh:order": 4
    },
    {
      "@id": "bpkm:ProjectShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": {
        "@id": "bpkm:Project"
      },
      "rdfs:label": "Project Shape",
      "sempkm:editHelpText": "Projects organize related notes, people, and concepts around a goal or initiative. Use projects to track ongoing work, research themes, or collaborative efforts.",
      "sh:property": [
        {
          "sh:path": {
            "@id": "dcterms:title"
          },
          "sh:name": "Title",
          "sh:datatype": {
            "@id": "xsd:string"
          },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:order": 1,
          "sh:group": {
            "@id": "bpkm:ProjectBasicInfoGroup"
          },
          "sh:description": "The display name for this project.",
          "sempkm:editHelpText": "A clear project name that distinguishes it from others. Include enough context to recognize it at a glance -- e.g. \"Q2 Website Redesign\" rather than just \"Redesign\"."
        },
        {
          "sh:path": {
            "@id": "dcterms:description"
          },
          "sh:name": "Description",
          "sh:datatype": {
            "@id": "xsd:string"
          },
          "sh:maxCount": 1,
          "sh:order": 2,
          "sh:group": {
            "@id": "bpkm:ProjectBasicInfoGroup"
          },
          "sh:description": "A brief summary of what this project is about.",
          "sempkm:editHelpText": "Summarize the project's purpose and scope. What problem does it solve? What does \"done\" look like? A few sentences is enough."
        },
        {
          "sh:path": {
            "@id": "bpkm:status"
          },
          "sh:name": "Status",
          "sh:datatype": {
            "@id": "xsd:string"
          },
          "sh:in": {
            "@list": [
              "active",
              "completed",
              "on-hold",
              "cancelled"
            ]
          },
          "sh:defaultValue": "active",
          "sh:maxCount": 1,
          "sh:order": 3,
          "sh:group": {
            "@id": "bpkm:ProjectBasicInfoGroup"
          },
          "sh:description": "Track where this project stands right now.",
          "sempkm:editHelpText": "Where the project stands right now. Update this as the project progresses -- it helps you quickly scan which projects need attention."
        },
        {
          "sh:path": {
            "@id": "bpkm:priority"
          },
          "sh:name": "Priority",
          "sh:datatype": {
            "@id": "xsd:string"
          },
          "sh:in": {
            "@list": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "sh:defaultValue": "medium",
          "sh:maxCount": 1,
          "sh:order": 4,
          "sh:group": {
            "@id": "bpkm:ProjectBasicInfoGroup"
          },
          "sh:description": "How urgent or important this project is.",
          "sempkm:editHelpText": "Relative importance compared to your other projects. Use this to decide what to work on when time is limited."
        },
        {
          "sh:path": {
            "@id": "schema:startDate"
          },
          "sh:name": "Start Date",
          "sh:datatype": {
            "@id": "xsd:date"
          },
          "sh:maxCount": 1,
          "sh:order": 5,
          "sh:group": {
            "@id": "bpkm:ProjectDatesGroup"
          },
          "sh:description": "When this project began or is planned to begin.",
          "sempkm:editHelpText": "When this project kicked off or is planned to begin. Useful for tracking timelines and reviewing past work."
        },
        {
          "sh:path": {
            "@id": "schema:endDate"
          },
          "sh:name": "End Date",
          "sh:datatype": {
            "@id": "xsd:date"
          },
          "sh:maxCount": 1,
          "sh:order": 6,
          "sh:group": {
            "@id": "bpkm:ProjectDatesGroup"
          },
          "sh:description": "When this project finished or is expected to finish.",
          "sempkm:editHelpText": "When this project wrapped up or is expected to finish. Leave blank for ongoing projects."
        },
        {
          "sh:path": {
            "@id": "bpkm:tags"
          },
          "sh:name": "Tags",
          "sh:datatype": {
            "@id": "xsd:string"
          },
          "sh:order": 7,
          "sh:group": {
            "@id": "bpkm:ProjectMetadataGroup"
          },
          "sh:description": "Free-form labels to help organize and find this project.",
          "sempkm:editHelpText": "Free-form tags for quick filtering. Use lowercase, hyphen-separated terms (e.g. `work`, `side-project`, `writing`). Tags help when you have many projects."
        },
        {
          "sh:path": {
            "@id": "bpkm:hasParticipant"
          },
          "sh:name": "Participants",
          "sh:class": {
            "@id": "bpkm:Person"
          },
          "sh:order": 8,
          "sh:group": {
            "@id": "bpkm:ProjectRelationshipsGroup"
          },
          "sh:description": "People involved in this project.",
          "sempkm:editHelpText": "People involved in this project. Linking participants lets you see all of someone's projects from their profile."
        },
        {
          "sh:path": {
            "@id": "bpkm:hasNote"
          },
          "sh:name": "Notes",
          "sh:class": {
            "@id": "bpkm:Note"
          },
          "sh:order": 9,
          "sh:group": {
            "@id": "bpkm:ProjectRelationshipsGroup"
          },
          "sh:description": "Notes related to this project.",
          "sempkm:editHelpText": "Notes related to this project. Linking notes here keeps project context together and makes research easier to find."
        },
        {
          "sh:path": {
            "@id": "dcterms:created"
          },
          "sh:name": "Created",
          "sh:datatype": {
            "@id": "xsd:dateTime"
          },
          "sh:maxCount": 1,
          "sh:order": 10,
          "sh:group": {
            "@id": "bpkm:ProjectMetadataGroup"
          }
        },
        {
          "sh:path": {
            "@id": "dcterms:modified"
          },
          "sh:name": "Modified",
          "sh:datatype": {
            "@id": "xsd:dateTime"
          },
          "sh:maxCount": 1,
          "sh:order": 11,
          "sh:group": {
            "@id": "bpkm:ProjectMetadataGroup"
          }
        }
      ]
    },
    {
      "@id": "bpkm:PersonBasicInfoGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Basic Info",
      "sh:order": 1
    },
    {
      "@id": "bpkm:PersonContactGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Contact",
      "sh:order": 2
    },
    {
      "@id": "bpkm:PersonRelationshipsGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Relationships",
      "sh:order": 3
    },
    {
      "@id": "bpkm:PersonMetadataGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Metadata",
      "sh:order": 4
    },
    {
      "@id": "bpkm:PersonShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": {
        "@id": "bpkm:Person"
      },
      "rdfs:label": "Person Shape",
      "sempkm:editHelpText": "People represent contacts, collaborators, or authors you interact with. Link them to projects and notes to build a network of who contributed what.",
      "sh:property": [
        {
          "sh:path": {
            "@id": "foaf:name"
          },
          "sh:name": "Name",
          "sh:datatype": {
            "@id": "xsd:string"
          },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:order": 1,
          "sh:group": {
            "@id": "bpkm:PersonBasicInfoGroup"
          },
          "sh:description": "Full name of this person.",
          "sempkm:editHelpText": "Full name as you'd recognize them. Use whatever form is most natural -- \"Jane Smith\" or \"Dr. Jane Smith\" are both fine."
        },
        {
          "sh:path": {
            "@id": "foaf:mbox"
          },
          "sh:name": "Email",
          "sh:datatype": {
            "@id": "xsd:string"
          },
          "sh:maxCount": 1,
          "sh:order": 2,
          "sh:group": {
            "@id": "bpkm:PersonContactGroup"
          },
          "sh:description": "Primary email address.",
          "sempkm:editHelpText": "Primary email address. Useful for quick reference -- you won't need to dig through other apps to find it."
        },
        {
          "sh:path": {
            "@id": "schema:jobTitle"
          },
          "sh:name": "Job Title",
          "sh:datatype": {
            "@id": "xsd:string"
          },
          "sh:maxCount": 1,
          "sh:order": 3,
          "sh:group": {
            "@id": "bpkm:PersonBasicInfoGroup"
          },
          "sh:description": "Their role or position.",
          "sempkm:editHelpText": "Their current role or position. Helps you remember context when you revisit this person later."
        },
        {
          "sh:path": {
            "@id": "schema:worksFor"
          },
          "sh:name": "Organization",
          "sh:datatype": {
            "@id": "xsd:string"
          },
          "sh:maxCount": 1,
          "sh:order": 4,
          "sh:group": {
            "@id": "bpkm:PersonBasicInfoGroup"
          },
          "sh:description": "Company or institution they belong to.",
          "sempkm:editHelpText": "Company, institution, or group they belong to. Helpful for remembering where you know someone from."
        },
        {
          "sh:path": {
            "@id": "foaf:phone"
          },
          "sh:name": "Phone",
          "sh:datatype": {
            "@id": "xsd:string"
          },
          "sh:maxCount": 1,
          "sh:order": 5,
          "sh:group": {
            "@id": "bpkm:PersonContactGroup"
          },
          "sh:description": "Phone number.",
          "sempkm:editHelpText": "Phone number in any format. Include country code for international contacts."
        },
        {
          "sh:path": {
            "@id": "schema:url"
          },
          "sh:name": "URL",
          "sh:datatype": {
            "@id": "xsd:anyURI"
          },
          "sh:maxCount": 1,
          "sh:order": 6,
          "sh:group": {
            "@id": "bpkm:PersonContactGroup"
          },
          "sh:description": "Website or profile link.",
          "sempkm:editHelpText": "Personal website, LinkedIn profile, or other relevant link. One URL that best represents this person."
        },
        {
          "sh:path": {
            "@id": "dcterms:description"
          },
          "sh:name": "Notes",
          "sh:datatype": {
            "@id": "xsd:string"
          },
          "sh:maxCount": 1,
          "sh:order": 7,
          "sh:group": {
            "@id": "bpkm:PersonBasicInfoGroup"
          },
          "sh:description": "Anything else worth remembering about this person.",
          "sempkm:editHelpText": "Anything worth remembering about this person -- how you met, shared interests, conversation notes. Free-form text."
        },
        {
          "sh:path": {
            "@id": "bpkm:tags"
          },
          "sh:name": "Tags",
          "sh:datatype": {
            "@id": "xsd:string"
          },
          "sh:order": 8,
          "sh:group": {
            "@id": "bpkm:PersonMetadataGroup"
          },
          "sh:description": "Labels to categorize this person (e.g. colleague, mentor).",
          "sempkm:editHelpText": "Free-form tags for categorization. Use terms like `colleague`, `mentor`, `client`, `conference-contact` to group people."
        },
        {
          "sh:path": {
            "@id": "bpkm:participatesIn"
          },
          "sh:name": "Projects",
          "sh:class": {
            "@id": "bpkm:Project"
          },
          "sh:order": 9,
          "sh:group": {
            "@id": "bpkm:PersonRelationshipsGroup"
          },
          "sh:description": "Projects this person is involved in.",
          "sempkm:editHelpText": "Projects this person is involved in. Linking here creates a two-way connection visible from both sides."
        },
        {
          "sh:path": {
            "@id": "dcterms:created"
          },
          "sh:name": "Created",
          "sh:datatype": {
            "@id": "xsd:dateTime"
          },
          "sh:maxCount": 1,
          "sh:order": 10,
          "sh:group": {
            "@id": "bpkm:PersonMetadataGroup"
          }
        },
        {
          "sh:path": {
            "@id": "dcterms:modified"
          },
          "sh:name": "Modified",
          "sh:datatype": {
            "@id": "xsd:dateTime"
          },
          "sh:maxCount": 1,
          "sh:order": 11,
          "sh:group": {
            "@id": "bpkm:PersonMetadataGroup"
          }
        }
      ]
    },
    {
      "@id": "bpkm:NoteContentGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Content",
      "sh:order": 1
    },
    {
      "@id": "bpkm:NoteRelationshipsGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Relationships",
      "sh:order": 2
    },
    {
      "@id": "bpkm:NoteMetadataGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Metadata",
      "sh:order": 3
    },
    {
      "@id": "bpkm:NoteShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": {
        "@id": "bpkm:Note"
      },
      "rdfs:label": "Note Shape",
      "sempkm:editHelpText": "Notes capture individual ideas, observations, or references. Each note should focus on a single thought -- you can always link related notes together via concepts and projects. Prefer creating many small notes over one large one.",
      "sh:property": [
        {
          "sh:path": {
            "@id": "dcterms:title"
          },
          "sh:name": "Title",
          "sh:datatype": {
            "@id": "xsd:string"
          },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:order": 1,
          "sh:group": {
            "@id": "bpkm:NoteContentGroup"
          },
          "sempkm:editHelpText": "A concise, descriptive title that captures the core idea. Good titles help you find notes later -- prefer specifics over generic labels.",
          "sh:description": "A concise title that captures the core idea."
        },
        {
          "sh:path": {
            "@id": "bpkm:body"
          },
          "sh:name": "Body",
          "sh:datatype": {
            "@id": "xsd:string"
          },
          "sh:maxCount": 1,
          "sh:order": 2,
          "sh:group": {
            "@id": "bpkm:NoteContentGroup"
          },
          "sempkm:editHelpText": "The main content of your note. Write in your own words -- paraphrasing helps retention. Markdown formatting is supported.",
          "sh:description": "The main content of your note. Markdown supported."
        },
        {
          "sh:path": {
            "@id": "bpkm:noteType"
          },
          "sh:name": "Type",
          "sh:datatype": {
            "@id": "xsd:string"
          },
          "sh:in": {
            "@list": [
              "observation",
              "idea",
              "reference",
              "meeting-note",
              "journal"
            ]
          },
          "sh:defaultValue": "observation",
          "sh:maxCount": 1,
          "sh:order": 3,
          "sh:group": {
            "@id": "bpkm:NoteContentGroup"
          },
          "sempkm:editHelpText": "Categorize this note: **observation** for things you noticed, **idea** for new thoughts, **reference** for external sources, **meeting-note** for discussions, **journal** for reflections.",
          "sh:description": "What kind of note this is (observation, idea, reference, etc.)."
        },
        {
          "sh:path": {
            "@id": "bpkm:isAbout"
          },
          "sh:name": "About Concepts",
          "sh:class": {
            "@id": "bpkm:Concept"
          },
          "sh:order": 4,
          "sh:group": {
            "@id": "bpkm:NoteRelationshipsGroup"
          },
          "sempkm:editHelpText": "Link to the concepts this note discusses. Concept links build your knowledge graph and help surface related notes automatically.",
          "sh:description": "Concepts this note discusses or relates to."
        },
        {
          "sh:path": {
            "@id": "bpkm:relatedProject"
          },
          "sh:name": "Related Project",
          "sh:class": {
            "@id": "bpkm:Project"
          },
          "sh:maxCount": 1,
          "sh:order": 5,
          "sh:group": {
            "@id": "bpkm:NoteRelationshipsGroup"
          },
          "sempkm:editHelpText": "Optionally associate this note with a project. The note will appear in the project's context, making it easier to find later.",
          "sh:description": "The project this note belongs to, if any."
        },
        {
          "sh:path": {
            "@id": "dcterms:source"
          },
          "sh:name": "Source URL",
          "sh:datatype": {
            "@id": "xsd:anyURI"
          },
          "sh:maxCount": 1,
          "sh:order": 6,
          "sh:group": {
            "@id": "bpkm:NoteContentGroup"
          },
          "sempkm:editHelpText": "If this note references an external source (article, paper, website), paste the URL here for attribution and easy revisiting.",
          "sh:description": "Link to the original source (article, paper, website)."
        },
        {
          "sh:path": {
            "@id": "bpkm:tags"
          },
          "sh:name": "Tags",
          "sh:datatype": {
            "@id": "xsd:string"
          },
          "sh:order": 7,
          "sh:group": {
            "@id": "bpkm:NoteMetadataGroup"
          },
          "sempkm:editHelpText": "Free-form tags for quick filtering. Use lowercase, hyphen-separated terms (e.g. `machine-learning`, `team-standup`). Tags complement concept links for lightweight categorization.",
          "sh:description": "Free-form labels for quick filtering."
        },
        {
          "sh:path": {
            "@id": "dcterms:created"
          },
          "sh:name": "Created",
          "sh:datatype": {
            "@id": "xsd:dateTime"
          },
          "sh:maxCount": 1,
          "sh:order": 8,
          "sh:group": {
            "@id": "bpkm:NoteMetadataGroup"
          }
        },
        {
          "sh:path": {
            "@id": "dcterms:modified"
          },
          "sh:name": "Modified",
          "sh:datatype": {
            "@id": "xsd:dateTime"
          },
          "sh:maxCount": 1,
          "sh:order": 9,
          "sh:group": {
            "@id": "bpkm:NoteMetadataGroup"
          }
        }
      ]
    },
    {
      "@id": "bpkm:ConceptDefinitionGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Definition",
      "sh:order": 1
    },
    {
      "@id": "bpkm:ConceptHierarchyGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Hierarchy",
      "sh:order": 2
    },
    {
      "@id": "bpkm:ConceptMetadataGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Metadata",
      "sh:order": 3
    },
    {
      "@id": "bpkm:ConceptShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": {
        "@id": "bpkm:Concept"
      },
      "rdfs:label": "Concept Shape",
      "sempkm:editHelpText": "Concepts are the vocabulary of your knowledge base. They represent topics, themes, or domains that notes can be *about*. Build a concept hierarchy with broader/narrower links to organize your thinking.",
      "sh:property": [
        {
          "sh:path": {
            "@id": "skos:prefLabel"
          },
          "sh:name": "Label",
          "sh:datatype": {
            "@id": "xsd:string"
          },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:order": 1,
          "sh:group": {
            "@id": "bpkm:ConceptDefinitionGroup"
          },
          "sh:description": "The primary name for this concept.",
          "sempkm:editHelpText": "The primary name for this concept -- the term you'd naturally use when thinking or writing about it."
        },
        {
          "sh:path": {
            "@id": "skos:altLabel"
          },
          "sh:name": "Alternative Labels",
          "sh:datatype": {
            "@id": "xsd:string"
          },
          "sh:order": 2,
          "sh:group": {
            "@id": "bpkm:ConceptDefinitionGroup"
          },
          "sh:description": "Synonyms or other names for this concept.",
          "sempkm:editHelpText": "Synonyms, abbreviations, or alternate spellings. Helps you find this concept even when using different terminology."
        },
        {
          "sh:path": {
            "@id": "skos:definition"
          },
          "sh:name": "Definition",
          "sh:datatype": {
            "@id": "xsd:string"
          },
          "sh:maxCount": 1,
          "sh:order": 3,
          "sh:group": {
            "@id": "bpkm:ConceptDefinitionGroup"
          },
          "sh:description": "What this concept means in your own words.",
          "sempkm:editHelpText": "What this concept means in your own words. Writing a definition deepens understanding -- even a rough one is valuable."
        },
        {
          "sh:path": {
            "@id": "skos:broader"
          },
          "sh:name": "Broader Concepts",
          "sh:class": {
            "@id": "bpkm:Concept"
          },
          "sh:order": 4,
          "sh:group": {
            "@id": "bpkm:ConceptHierarchyGroup"
          },
          "sh:description": "Parent concepts that this one falls under.",
          "sempkm:editHelpText": "Parent concepts that this one falls under. For example, \"Machine Learning\" is broader than \"Neural Networks\". Builds a concept hierarchy."
        },
        {
          "sh:path": {
            "@id": "skos:narrower"
          },
          "sh:name": "Narrower Concepts",
          "sh:class": {
            "@id": "bpkm:Concept"
          },
          "sh:order": 5,
          "sh:group": {
            "@id": "bpkm:ConceptHierarchyGroup"
          },
          "sh:description": "More specific concepts within this one.",
          "sempkm:editHelpText": "More specific concepts within this one. The inverse of \"broader\" -- helps you navigate from general to specific."
        },
        {
          "sh:path": {
            "@id": "skos:related"
          },
          "sh:name": "Related Concepts",
          "sh:class": {
            "@id": "bpkm:Concept"
          },
          "sh:order": 6,
          "sh:group": {
            "@id": "bpkm:ConceptHierarchyGroup"
          },
          "sh:description": "Concepts that are related but not hierarchically.",
          "sempkm:editHelpText": "Concepts that are connected but not hierarchically. Use for lateral associations -- e.g. \"Design Thinking\" related to \"User Research\"."
        },
        {
          "sh:path": {
            "@id": "schema:url"
          },
          "sh:name": "Reference URL",
          "sh:datatype": {
            "@id": "xsd:anyURI"
          },
          "sh:maxCount": 1,
          "sh:order": 7,
          "sh:group": {
            "@id": "bpkm:ConceptMetadataGroup"
          },
          "sh:description": "Link to an authoritative source for this concept.",
          "sempkm:editHelpText": "Link to an authoritative or useful source -- a Wikipedia article, textbook chapter, or key paper. For quick reference."
        },
        {
          "sh:path": {
            "@id": "bpkm:tags"
          },
          "sh:name": "Tags",
          "sh:datatype": {
            "@id": "xsd:string"
          },
          "sh:order": 8,
          "sh:group": {
            "@id": "bpkm:ConceptMetadataGroup"
          },
          "sh:description": "Free-form labels for categorization.",
          "sempkm:editHelpText": "Free-form tags for lightweight categorization. Use alongside the concept hierarchy for cross-cutting concerns like `needs-review` or `core-concept`."
        },
        {
          "sh:path": {
            "@id": "dcterms:created"
          },
          "sh:name": "Created",
          "sh:datatype": {
            "@id": "xsd:dateTime"
          },
          "sh:maxCount": 1,
          "sh:order": 9,
          "sh:group": {
            "@id": "bpkm:ConceptMetadataGroup"
          }
        },
        {
          "sh:path": {
            "@id": "dcterms:modified"
          },
          "sh:name": "Modified",
          "sh:datatype": {
            "@id": "xsd:dateTime"
          },
          "sh:maxCount": 1,
          "sh:order": 10,
          "sh:group": {
            "@id": "bpkm:ConceptMetadataGroup"
          }
        }
      ]
    },

    {
      "@id": "bpkm:TaskBasicInfoGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Basic Info",
      "sh:order": 1
    },
    {
      "@id": "bpkm:TaskDatesGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Dates",
      "sh:order": 2
    },
    {
      "@id": "bpkm:TaskRelationshipsGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Relationships",
      "sh:order": 3
    },
    {
      "@id": "bpkm:TaskMetadataGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Metadata",
      "sh:order": 4
    },
    {
      "@id": "bpkm:TaskShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": {
        "@id": "bpkm:Task"
      },
      "rdfs:label": "Task Shape",
      "sempkm:editHelpText": "Tasks are actionable units of work. Create them manually or let integration apps sync them from external providers like Linear, Jira, GitHub Issues, Asana, or Todoist. Tasks can link to projects, milestones, notes, concepts, and people.",
      "sh:property": [
        {
          "sh:path": { "@id": "dcterms:title" },
          "sh:name": "Title",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:order": 1,
          "sh:group": { "@id": "bpkm:TaskBasicInfoGroup" },
          "sh:description": "What needs to be done.",
          "sempkm:editHelpText": "A clear, actionable description of what needs to be done. Start with a verb -- e.g. \"Write user guide for graph view\" rather than just \"User guide\"."
        },
        {
          "sh:path": { "@id": "dcterms:description" },
          "sh:name": "Description",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:maxCount": 1,
          "sh:order": 2,
          "sh:group": { "@id": "bpkm:TaskBasicInfoGroup" },
          "sh:description": "Additional details, acceptance criteria, or context.",
          "sempkm:editHelpText": "Expand on the task with details, acceptance criteria, or context. What does \"done\" look like? Markdown supported."
        },
        {
          "sh:path": { "@id": "bpkm:taskStatus" },
          "sh:name": "Status",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:in": { "@list": ["todo", "in-progress", "done", "blocked", "cancelled"] },
          "sh:defaultValue": "todo",
          "sh:maxCount": 1,
          "sh:order": 3,
          "sh:group": { "@id": "bpkm:TaskBasicInfoGroup" },
          "sh:description": "Current state of the task.",
          "sempkm:editHelpText": "Current state. For synced tasks, this updates automatically from the external provider."
        },
        {
          "sh:path": { "@id": "bpkm:priority" },
          "sh:name": "Priority",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:in": { "@list": ["low", "medium", "high", "critical"] },
          "sh:defaultValue": "medium",
          "sh:maxCount": 1,
          "sh:order": 4,
          "sh:group": { "@id": "bpkm:TaskBasicInfoGroup" },
          "sh:description": "How urgent or important this task is.",
          "sempkm:editHelpText": "Relative importance. Use this to decide what to work on when time is limited."
        },
        {
          "sh:path": { "@id": "bpkm:effort" },
          "sh:name": "Effort",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:in": { "@list": ["trivial", "small", "medium", "large", "epic"] },
          "sh:maxCount": 1,
          "sh:order": 5,
          "sh:group": { "@id": "bpkm:TaskBasicInfoGroup" },
          "sh:description": "Rough size estimate for planning.",
          "sempkm:editHelpText": "T-shirt sizing for effort. Useful for planning how much you can take on in a sprint or week."
        },
        {
          "sh:path": { "@id": "bpkm:startDate" },
          "sh:name": "Start Date",
          "sh:datatype": { "@id": "xsd:date" },
          "sh:maxCount": 1,
          "sh:order": 6,
          "sh:group": { "@id": "bpkm:TaskDatesGroup" },
          "sh:description": "When work on this task begins.",
          "sempkm:editHelpText": "The planned start date. Maps to Asana start_on, Monday timeline start, Linear cycle start."
        },
        {
          "sh:path": { "@id": "bpkm:dueDate" },
          "sh:name": "Due Date",
          "sh:datatype": { "@id": "xsd:date" },
          "sh:maxCount": 1,
          "sh:order": 7,
          "sh:group": { "@id": "bpkm:TaskDatesGroup" },
          "sh:description": "When this task is due.",
          "sempkm:editHelpText": "The deadline. Leave blank for tasks without a hard due date."
        },
        {
          "sh:path": { "@id": "bpkm:completedDate" },
          "sh:name": "Completed",
          "sh:datatype": { "@id": "xsd:date" },
          "sh:maxCount": 1,
          "sh:order": 8,
          "sh:group": { "@id": "bpkm:TaskDatesGroup" },
          "sh:description": "When this task was completed.",
          "sempkm:editHelpText": "Set when the task is done. For synced tasks, this is populated automatically."
        },
        {
          "sh:path": { "@id": "bpkm:assignedTo" },
          "sh:name": "Assigned To",
          "sh:class": { "@id": "bpkm:Person" },
          "sh:order": 9,
          "sh:group": { "@id": "bpkm:TaskRelationshipsGroup" },
          "sh:description": "Who is responsible for this task.",
          "sempkm:editHelpText": "The person or people working on this. For synced tasks, mapped from the provider's assignee field."
        },
        {
          "sh:path": { "@id": "bpkm:followers" },
          "sh:name": "Followers",
          "sh:class": { "@id": "bpkm:Person" },
          "sh:order": 10,
          "sh:group": { "@id": "bpkm:TaskRelationshipsGroup" },
          "sh:description": "People watching this task for updates.",
          "sempkm:editHelpText": "People following this task. Maps to Asana followers, Monday subscribers, Jira watchers."
        },
        {
          "sh:path": { "@id": "bpkm:parentTask" },
          "sh:name": "Parent Task",
          "sh:class": { "@id": "bpkm:Task" },
          "sh:maxCount": 1,
          "sh:order": 11,
          "sh:group": { "@id": "bpkm:TaskRelationshipsGroup" },
          "sh:description": "The parent task if this is a subtask.",
          "sempkm:editHelpText": "Set when this is a subtask. Supports deep nesting (up to 5 levels in Asana/Monday)."
        },
        {
          "sh:path": { "@id": "bpkm:taskProject" },
          "sh:name": "Projects",
          "sh:class": { "@id": "bpkm:Project" },
          "sh:order": 12,
          "sh:group": { "@id": "bpkm:TaskRelationshipsGroup" },
          "sh:description": "Projects this task belongs to.",
          "sempkm:editHelpText": "Which project(s) this task is part of. Asana tasks can belong to multiple projects; Monday items can be linked across boards."
        },
        {
          "sh:path": { "@id": "bpkm:milestone" },
          "sh:name": "Milestone",
          "sh:class": { "@id": "bpkm:Milestone" },
          "sh:maxCount": 1,
          "sh:order": 13,
          "sh:group": { "@id": "bpkm:TaskRelationshipsGroup" },
          "sh:description": "The milestone this task contributes to.",
          "sempkm:editHelpText": "Which milestone this task is part of. Milestones group tasks toward a specific deliverable or deadline."
        },
        {
          "sh:path": { "@id": "bpkm:dependsOn" },
          "sh:name": "Depends On",
          "sh:class": { "@id": "bpkm:Task" },
          "sh:order": 14,
          "sh:group": { "@id": "bpkm:TaskRelationshipsGroup" },
          "sh:description": "Tasks that must be completed before this one.",
          "sempkm:editHelpText": "Blocking dependencies. These tasks must be done before this one can start. Shows in the task dependency graph."
        },
        {
          "sh:path": { "@id": "bpkm:isAbout" },
          "sh:name": "Related Concepts",
          "sh:class": { "@id": "bpkm:Concept" },
          "sh:order": 15,
          "sh:group": { "@id": "bpkm:TaskRelationshipsGroup" },
          "sh:description": "Concepts this task relates to.",
          "sempkm:editHelpText": "Link to concepts this task involves. Builds connections between your work and your knowledge graph."
        },
        {
          "sh:path": { "@id": "bpkm:storyPoints" },
          "sh:name": "Story Points",
          "sh:datatype": { "@id": "xsd:decimal" },
          "sh:maxCount": 1,
          "sh:order": 16,
          "sh:group": { "@id": "bpkm:TaskBasicInfoGroup" },
          "sh:description": "Numeric complexity/effort estimate.",
          "sempkm:editHelpText": "Numeric estimate (e.g., fibonacci story points). Maps to Linear estimate, Jira story points, Monday numbers column. Use alongside or instead of t-shirt sizing."
        },
        {
          "sh:path": { "@id": "bpkm:taskGroup" },
          "sh:name": "Group / Section",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:maxCount": 1,
          "sh:order": 17,
          "sh:group": { "@id": "bpkm:TaskMetadataGroup" },
          "sh:description": "Section or group name from the external provider.",
          "sempkm:editHelpText": "Preserves the provider's grouping: Asana section, Monday group, Jira sprint name, Linear cycle. Set automatically during sync."
        },
        {
          "sh:path": { "@id": "bpkm:tags" },
          "sh:name": "Tags",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:order": 18,
          "sh:group": { "@id": "bpkm:TaskMetadataGroup" },
          "sh:description": "Free-form labels for filtering and organization.",
          "sempkm:editHelpText": "Free-form tags. Use for cross-cutting concerns like `bug`, `feature`, `docs`, `urgent`."
        },
        {
          "sh:path": { "@id": "bpkm:externalProvider" },
          "sh:name": "Provider",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:in": { "@list": ["manual", "asana", "linear", "jira", "github", "todoist", "trello", "monday"] },
          "sh:maxCount": 1,
          "sh:order": 19,
          "sh:group": { "@id": "bpkm:TaskMetadataGroup" },
          "sh:description": "Which service this task was imported from.",
          "sempkm:editHelpText": "Set automatically when a task is synced from an external provider. Manual tasks default to 'manual'."
        },
        {
          "sh:path": { "@id": "bpkm:externalId" },
          "sh:name": "External ID",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:maxCount": 1,
          "sh:order": 20,
          "sh:group": { "@id": "bpkm:TaskMetadataGroup" },
          "sh:description": "The task's identifier in the external system.",
          "sempkm:editHelpText": "The task ID from the external provider (e.g., LIN-123, PROJ-42, #7). Set automatically during sync."
        },
        {
          "sh:path": { "@id": "bpkm:externalUrl" },
          "sh:name": "External Link",
          "sh:datatype": { "@id": "xsd:anyURI" },
          "sh:maxCount": 1,
          "sh:order": 21,
          "sh:group": { "@id": "bpkm:TaskMetadataGroup" },
          "sh:description": "Direct link to this task in the external provider.",
          "sempkm:editHelpText": "Click to open this task in its original provider (Linear, Jira, GitHub, etc.)."
        },
        {
          "sh:path": { "@id": "bpkm:externalStatus" },
          "sh:name": "External Status",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:maxCount": 1,
          "sh:order": 22,
          "sh:group": { "@id": "bpkm:TaskMetadataGroup" },
          "sh:description": "Raw status label from the provider before normalization.",
          "sempkm:editHelpText": "The original status label (e.g., 'Working on it', 'In Review', 'Backlog'). Preserved for round-trip sync fidelity."
        },
        {
          "sh:path": { "@id": "bpkm:syncDirection" },
          "sh:name": "Sync Direction",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:in": { "@list": ["pull", "push", "bidirectional"] },
          "sh:maxCount": 1,
          "sh:order": 23,
          "sh:group": { "@id": "bpkm:TaskMetadataGroup" },
          "sh:description": "How this task syncs with the external provider.",
          "sempkm:editHelpText": "Pull: read-only from provider. Push: changes flow to provider. Bidirectional: both directions with conflict resolution."
        },
        {
          "sh:path": { "@id": "bpkm:lastSyncedAt" },
          "sh:name": "Last Synced",
          "sh:datatype": { "@id": "xsd:dateTime" },
          "sh:maxCount": 1,
          "sh:order": 24,
          "sh:group": { "@id": "bpkm:TaskMetadataGroup" },
          "sh:description": "When this task was last synced with the external provider."
        },
        {
          "sh:path": { "@id": "dcterms:created" },
          "sh:name": "Created",
          "sh:datatype": { "@id": "xsd:dateTime" },
          "sh:maxCount": 1,
          "sh:order": 25,
          "sh:group": { "@id": "bpkm:TaskMetadataGroup" }
        },
        {
          "sh:path": { "@id": "dcterms:modified" },
          "sh:name": "Modified",
          "sh:datatype": { "@id": "xsd:dateTime" },
          "sh:maxCount": 1,
          "sh:order": 26,
          "sh:group": { "@id": "bpkm:TaskMetadataGroup" }
        }
      ]
    },

    {
      "@id": "bpkm:MilestoneBasicInfoGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Basic Info",
      "sh:order": 1
    },
    {
      "@id": "bpkm:MilestoneDatesGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Dates",
      "sh:order": 2
    },
    {
      "@id": "bpkm:MilestoneRelationshipsGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Relationships",
      "sh:order": 3
    },
    {
      "@id": "bpkm:MilestoneShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": { "@id": "bpkm:Milestone" },
      "rdfs:label": "Milestone Shape",
      "sempkm:editHelpText": "Milestones group tasks toward a specific deliverable or deadline. They sit between projects and tasks -- a project can have multiple milestones, each with its own set of tasks.",
      "sh:property": [
        {
          "sh:path": { "@id": "dcterms:title" },
          "sh:name": "Title",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:order": 1,
          "sh:group": { "@id": "bpkm:MilestoneBasicInfoGroup" },
          "sh:description": "Name of this milestone.",
          "sempkm:editHelpText": "A clear milestone name describing the deliverable -- e.g. \"v1.0 Launch\" or \"User Research Complete\"."
        },
        {
          "sh:path": { "@id": "dcterms:description" },
          "sh:name": "Description",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:maxCount": 1,
          "sh:order": 2,
          "sh:group": { "@id": "bpkm:MilestoneBasicInfoGroup" },
          "sh:description": "What this milestone delivers.",
          "sempkm:editHelpText": "Describe what completing this milestone means. What's the deliverable? What does success look like?"
        },
        {
          "sh:path": { "@id": "bpkm:milestoneStatus" },
          "sh:name": "Status",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:in": { "@list": ["planned", "active", "completed", "cancelled"] },
          "sh:defaultValue": "planned",
          "sh:maxCount": 1,
          "sh:order": 3,
          "sh:group": { "@id": "bpkm:MilestoneBasicInfoGroup" },
          "sh:description": "Current state of this milestone.",
          "sempkm:editHelpText": "Where this milestone stands. Update as work progresses."
        },
        {
          "sh:path": { "@id": "bpkm:targetDate" },
          "sh:name": "Target Date",
          "sh:datatype": { "@id": "xsd:date" },
          "sh:maxCount": 1,
          "sh:order": 4,
          "sh:group": { "@id": "bpkm:MilestoneDatesGroup" },
          "sh:description": "When this milestone should be completed.",
          "sempkm:editHelpText": "The deadline for this milestone. Tasks within the milestone should be completed before this date."
        },
        {
          "sh:path": { "@id": "bpkm:completedDate" },
          "sh:name": "Completed",
          "sh:datatype": { "@id": "xsd:date" },
          "sh:maxCount": 1,
          "sh:order": 5,
          "sh:group": { "@id": "bpkm:MilestoneDatesGroup" },
          "sh:description": "When this milestone was actually completed."
        },
        {
          "sh:path": { "@id": "bpkm:milestoneProject" },
          "sh:name": "Project",
          "sh:class": { "@id": "bpkm:Project" },
          "sh:maxCount": 1,
          "sh:order": 6,
          "sh:group": { "@id": "bpkm:MilestoneRelationshipsGroup" },
          "sh:description": "The project this milestone belongs to.",
          "sempkm:editHelpText": "Which project this milestone is part of. A project can have multiple milestones."
        },
        {
          "sh:path": { "@id": "dcterms:created" },
          "sh:name": "Created",
          "sh:datatype": { "@id": "xsd:dateTime" },
          "sh:maxCount": 1,
          "sh:order": 7,
          "sh:group": { "@id": "bpkm:MilestoneBasicInfoGroup" }
        },
        {
          "sh:path": { "@id": "dcterms:modified" },
          "sh:name": "Modified",
          "sh:datatype": { "@id": "xsd:dateTime" },
          "sh:maxCount": 1,
          "sh:order": 8,
          "sh:group": { "@id": "bpkm:MilestoneBasicInfoGroup" }
        }
      ]
    },

    {
      "@id": "bpkm:EventBasicInfoGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Basic Info",
      "sh:order": 1
    },
    {
      "@id": "bpkm:EventScheduleGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Schedule",
      "sh:order": 2
    },
    {
      "@id": "bpkm:EventRelationshipsGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Relationships",
      "sh:order": 3
    },
    {
      "@id": "bpkm:EventMetadataGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Metadata",
      "sh:order": 4
    },
    {
      "@id": "bpkm:EventShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": { "@id": "bpkm:Event" },
      "rdfs:label": "Event Shape",
      "sempkm:editHelpText": "Events represent calendar entries — meetings, appointments, deadlines, or time blocks. Create them manually or let integration apps sync them from Google Calendar, Outlook, or CalDAV. Link events to projects, people, notes, and tasks.",
      "sh:property": [
        {
          "sh:path": { "@id": "dcterms:title" },
          "sh:name": "Title",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:order": 1,
          "sh:group": { "@id": "bpkm:EventBasicInfoGroup" },
          "sh:description": "Event title.",
          "sempkm:editHelpText": "The event name as it appears on your calendar."
        },
        {
          "sh:path": { "@id": "bpkm:eventType" },
          "sh:name": "Type",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:in": { "@list": ["meeting", "appointment", "deadline", "reminder", "focus-block", "social", "travel", "other"] },
          "sh:defaultValue": "meeting",
          "sh:maxCount": 1,
          "sh:order": 2,
          "sh:group": { "@id": "bpkm:EventBasicInfoGroup" },
          "sh:description": "What kind of event this is.",
          "sempkm:editHelpText": "Categorize: **meeting** for group discussions, **focus-block** for deep work time, **deadline** for due dates, etc."
        },
        {
          "sh:path": { "@id": "bpkm:eventStatus" },
          "sh:name": "Status",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:in": { "@list": ["confirmed", "tentative", "cancelled"] },
          "sh:defaultValue": "confirmed",
          "sh:maxCount": 1,
          "sh:order": 3,
          "sh:group": { "@id": "bpkm:EventBasicInfoGroup" },
          "sh:description": "Whether this event is confirmed."
        },
        {
          "sh:path": { "@id": "dcterms:description" },
          "sh:name": "Description",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:maxCount": 1,
          "sh:order": 4,
          "sh:group": { "@id": "bpkm:EventBasicInfoGroup" },
          "sh:description": "Event description or agenda.",
          "sempkm:editHelpText": "Agenda, talking points, or context for the event. Markdown supported."
        },
        {
          "sh:path": { "@id": "schema:startDate" },
          "sh:name": "Start",
          "sh:datatype": { "@id": "xsd:dateTime" },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:order": 5,
          "sh:group": { "@id": "bpkm:EventScheduleGroup" },
          "sh:description": "When this event starts.",
          "sempkm:editHelpText": "Start date and time. For all-day events, just the date portion matters."
        },
        {
          "sh:path": { "@id": "schema:endDate" },
          "sh:name": "End",
          "sh:datatype": { "@id": "xsd:dateTime" },
          "sh:maxCount": 1,
          "sh:order": 6,
          "sh:group": { "@id": "bpkm:EventScheduleGroup" },
          "sh:description": "When this event ends.",
          "sempkm:editHelpText": "End date and time. Leave blank for point-in-time events like deadlines or reminders."
        },
        {
          "sh:path": { "@id": "bpkm:allDay" },
          "sh:name": "All Day",
          "sh:datatype": { "@id": "xsd:boolean" },
          "sh:maxCount": 1,
          "sh:order": 7,
          "sh:group": { "@id": "bpkm:EventScheduleGroup" },
          "sh:description": "Whether this is an all-day event."
        },
        {
          "sh:path": { "@id": "bpkm:timeZone" },
          "sh:name": "Time Zone",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:maxCount": 1,
          "sh:order": 8,
          "sh:group": { "@id": "bpkm:EventScheduleGroup" },
          "sh:description": "IANA time zone (e.g., America/New_York).",
          "sempkm:editHelpText": "The time zone for this event. For synced events, pulled from the calendar provider. Uses IANA identifiers like America/New_York, Europe/London."
        },
        {
          "sh:path": { "@id": "bpkm:location" },
          "sh:name": "Location",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:maxCount": 1,
          "sh:order": 9,
          "sh:group": { "@id": "bpkm:EventScheduleGroup" },
          "sh:description": "Physical location or address.",
          "sempkm:editHelpText": "Where this event takes place. A physical address, room name, or building."
        },
        {
          "sh:path": { "@id": "bpkm:conferenceUrl" },
          "sh:name": "Conference URL",
          "sh:datatype": { "@id": "xsd:anyURI" },
          "sh:maxCount": 1,
          "sh:order": 10,
          "sh:group": { "@id": "bpkm:EventScheduleGroup" },
          "sh:description": "Video meeting join link.",
          "sempkm:editHelpText": "Join URL for Google Meet, Zoom, Microsoft Teams, etc. Synced automatically from calendar providers that support conference data."
        },
        {
          "sh:path": { "@id": "bpkm:recurrenceRule" },
          "sh:name": "Recurrence",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:maxCount": 1,
          "sh:order": 11,
          "sh:group": { "@id": "bpkm:EventScheduleGroup" },
          "sh:description": "RFC 5545 recurrence rule (e.g., FREQ=WEEKLY;BYDAY=MO).",
          "sempkm:editHelpText": "Recurrence pattern in RRULE format. For synced events, this is pulled automatically. Manual events can use standard RRULE syntax."
        },
        {
          "sh:path": { "@id": "bpkm:recurringEventId" },
          "sh:name": "Series Master",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:maxCount": 1,
          "sh:order": 12,
          "sh:group": { "@id": "bpkm:EventScheduleGroup" },
          "sh:description": "External ID of the recurring series this occurrence belongs to."
        },
        {
          "sh:path": { "@id": "bpkm:reminderMinutes" },
          "sh:name": "Reminder",
          "sh:datatype": { "@id": "xsd:integer" },
          "sh:maxCount": 1,
          "sh:order": 13,
          "sh:group": { "@id": "bpkm:EventScheduleGroup" },
          "sh:description": "Minutes before event to send reminder.",
          "sempkm:editHelpText": "How many minutes before the event to trigger a notification. Common values: 10, 15, 30, 60."
        },
        {
          "sh:path": { "@id": "bpkm:visibility" },
          "sh:name": "Visibility",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:in": { "@list": ["public", "private", "confidential"] },
          "sh:maxCount": 1,
          "sh:order": 14,
          "sh:group": { "@id": "bpkm:EventBasicInfoGroup" },
          "sh:description": "Who can see event details.",
          "sempkm:editHelpText": "**public**: anyone can see details. **private**: only attendees see details, others see busy/free. **confidential**: only organizer sees details."
        },
        {
          "sh:path": { "@id": "bpkm:showAs" },
          "sh:name": "Show As",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:in": { "@list": ["busy", "free", "tentative", "out-of-office", "working-elsewhere"] },
          "sh:defaultValue": "busy",
          "sh:maxCount": 1,
          "sh:order": 15,
          "sh:group": { "@id": "bpkm:EventBasicInfoGroup" },
          "sh:description": "How this event affects availability.",
          "sempkm:editHelpText": "How your calendar shows availability during this event. **busy** blocks the time, **free** keeps it open, **out-of-office** shows you away."
        },
        {
          "sh:path": { "@id": "bpkm:responseStatus" },
          "sh:name": "My Response",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:in": { "@list": ["accepted", "declined", "tentative", "needs-action"] },
          "sh:maxCount": 1,
          "sh:order": 16,
          "sh:group": { "@id": "bpkm:EventBasicInfoGroup" },
          "sh:description": "Your RSVP response to this event.",
          "sempkm:editHelpText": "Your attendance response. Synced from calendar providers — changing this here will update your RSVP in the provider."
        },
        {
          "sh:path": { "@id": "bpkm:organizer" },
          "sh:name": "Organizer",
          "sh:class": { "@id": "bpkm:Person" },
          "sh:maxCount": 1,
          "sh:order": 17,
          "sh:group": { "@id": "bpkm:EventRelationshipsGroup" },
          "sh:description": "Who organized this event.",
          "sempkm:editHelpText": "The event creator/organizer. Distinct from attendees. For synced events, matched to a Person by email."
        },
        {
          "sh:path": { "@id": "bpkm:attendee" },
          "sh:name": "Attendees",
          "sh:class": { "@id": "bpkm:Person" },
          "sh:order": 18,
          "sh:group": { "@id": "bpkm:EventRelationshipsGroup" },
          "sh:description": "People attending this event.",
          "sempkm:editHelpText": "Who's attending. For synced events, attendees are auto-matched to existing Person objects by email."
        },
        {
          "sh:path": { "@id": "bpkm:eventProject" },
          "sh:name": "Project",
          "sh:class": { "@id": "bpkm:Project" },
          "sh:maxCount": 1,
          "sh:order": 19,
          "sh:group": { "@id": "bpkm:EventRelationshipsGroup" },
          "sh:description": "The project this event relates to.",
          "sempkm:editHelpText": "Link to the relevant project. Helps keep project context together across meetings and work sessions."
        },
        {
          "sh:path": { "@id": "bpkm:generatedTask" },
          "sh:name": "Action Items",
          "sh:class": { "@id": "bpkm:Task" },
          "sh:order": 20,
          "sh:group": { "@id": "bpkm:EventRelationshipsGroup" },
          "sh:description": "Tasks created as a result of this event.",
          "sempkm:editHelpText": "Action items that came out of this meeting. Link existing tasks or create new ones."
        },
        {
          "sh:path": { "@id": "bpkm:eventNote" },
          "sh:name": "Notes",
          "sh:class": { "@id": "bpkm:Note" },
          "sh:order": 21,
          "sh:group": { "@id": "bpkm:EventRelationshipsGroup" },
          "sh:description": "Notes linked to this event.",
          "sempkm:editHelpText": "Meeting notes, discussion summaries, or reference material related to this event."
        },
        {
          "sh:path": { "@id": "bpkm:meetingNotes" },
          "sh:name": "Meeting Notes",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:maxCount": 1,
          "sh:order": 22,
          "sh:group": { "@id": "bpkm:EventMetadataGroup" },
          "sh:description": "Quick notes captured after the meeting.",
          "sempkm:editHelpText": "Post-meeting capture: decisions made, key takeaways, follow-ups needed. For detailed notes, create a linked Note object instead. Markdown supported."
        },
        {
          "sh:path": { "@id": "bpkm:tags" },
          "sh:name": "Tags",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:order": 23,
          "sh:group": { "@id": "bpkm:EventMetadataGroup" },
          "sh:description": "Free-form labels for categorization.",
          "sempkm:editHelpText": "Tags for filtering. Use terms like `recurring`, `1-on-1`, `standup`, `external`."
        },
        {
          "sh:path": { "@id": "bpkm:externalProvider" },
          "sh:name": "Provider",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:in": { "@list": ["manual", "google-calendar", "outlook", "apple-calendar", "caldav"] },
          "sh:maxCount": 1,
          "sh:order": 24,
          "sh:group": { "@id": "bpkm:EventMetadataGroup" },
          "sh:description": "Which calendar service this was synced from."
        },
        {
          "sh:path": { "@id": "bpkm:calendarName" },
          "sh:name": "Calendar",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:maxCount": 1,
          "sh:order": 25,
          "sh:group": { "@id": "bpkm:EventMetadataGroup" },
          "sh:description": "Which calendar within the provider (e.g., Work, Personal)."
        },
        {
          "sh:path": { "@id": "bpkm:externalId" },
          "sh:name": "External ID",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:maxCount": 1,
          "sh:order": 26,
          "sh:group": { "@id": "bpkm:EventMetadataGroup" },
          "sh:description": "Unique identifier in the calendar provider."
        },
        {
          "sh:path": { "@id": "bpkm:externalUrl" },
          "sh:name": "External Link",
          "sh:datatype": { "@id": "xsd:anyURI" },
          "sh:maxCount": 1,
          "sh:order": 27,
          "sh:group": { "@id": "bpkm:EventMetadataGroup" },
          "sh:description": "Link to this event in the calendar provider."
        },
        {
          "sh:path": { "@id": "bpkm:externalStatus" },
          "sh:name": "External Status",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:maxCount": 1,
          "sh:order": 28,
          "sh:group": { "@id": "bpkm:EventMetadataGroup" },
          "sh:description": "Raw status from the calendar provider before normalization."
        },
        {
          "sh:path": { "@id": "bpkm:syncDirection" },
          "sh:name": "Sync Direction",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:in": { "@list": ["pull", "push", "bidirectional"] },
          "sh:maxCount": 1,
          "sh:order": 29,
          "sh:group": { "@id": "bpkm:EventMetadataGroup" },
          "sh:description": "How this event syncs with the calendar provider."
        },
        {
          "sh:path": { "@id": "bpkm:lastSyncedAt" },
          "sh:name": "Last Synced",
          "sh:datatype": { "@id": "xsd:dateTime" },
          "sh:maxCount": 1,
          "sh:order": 30,
          "sh:group": { "@id": "bpkm:EventMetadataGroup" }
        },
        {
          "sh:path": { "@id": "dcterms:created" },
          "sh:name": "Created",
          "sh:datatype": { "@id": "xsd:dateTime" },
          "sh:maxCount": 1,
          "sh:order": 31,
          "sh:group": { "@id": "bpkm:EventMetadataGroup" }
        },
        {
          "sh:path": { "@id": "dcterms:modified" },
          "sh:name": "Modified",
          "sh:datatype": { "@id": "xsd:dateTime" },
          "sh:maxCount": 1,
          "sh:order": 32,
          "sh:group": { "@id": "bpkm:EventMetadataGroup" }
        }
      ]
    }
  ]
}

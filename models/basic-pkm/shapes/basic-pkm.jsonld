{
  "@context": {
    "sh": "http://www.w3.org/ns/shacl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dcterms": "http://purl.org/dc/terms/",
    "schema": "https://schema.org/",
    "foaf": "http://xmlns.com/foaf/0.1/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "bpkm": "urn:sempkm:model:basic-pkm:",
    "sempkm": "urn:sempkm:"
  },
  "@graph": [
    {
      "@id": "bpkm:ProjectBasicInfoGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Basic Info",
      "sh:order": 1
    },
    {
      "@id": "bpkm:ProjectDatesGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Dates",
      "sh:order": 2
    },
    {
      "@id": "bpkm:ProjectRelationshipsGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Relationships",
      "sh:order": 3
    },
    {
      "@id": "bpkm:ProjectMetadataGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Metadata",
      "sh:order": 4
    },
    {
      "@id": "bpkm:ProjectShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": {
        "@id": "bpkm:Project"
      },
      "rdfs:label": "Project Shape",
      "sempkm:editHelpText": "Projects organize related notes, people, and concepts around a goal or initiative. Use projects to track ongoing work, research themes, or collaborative efforts.",
      "sh:property": [
        {
          "sh:path": { "@id": "dcterms:title" },
          "sh:name": "Title",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:order": 1,
          "sh:group": { "@id": "bpkm:ProjectBasicInfoGroup" },
          "sh:description": "The display name for this project.",
          "sempkm:editHelpText": "A clear project name that distinguishes it from others. Include enough context to recognize it at a glance -- e.g. \"Q2 Website Redesign\" rather than just \"Redesign\"."
        },
        {
          "sh:path": { "@id": "dcterms:description" },
          "sh:name": "Description",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:maxCount": 1,
          "sh:order": 2,
          "sh:group": { "@id": "bpkm:ProjectBasicInfoGroup" },
          "sh:description": "A brief summary of what this project is about.",
          "sempkm:editHelpText": "Summarize the project's purpose and scope. What problem does it solve? What does \"done\" look like? A few sentences is enough."
        },
        {
          "sh:path": { "@id": "bpkm:status" },
          "sh:name": "Status",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:in": { "@list": ["active", "completed", "on-hold", "cancelled"] },
          "sh:defaultValue": "active",
          "sh:maxCount": 1,
          "sh:order": 3,
          "sh:group": { "@id": "bpkm:ProjectBasicInfoGroup" },
          "sh:description": "Track where this project stands right now.",
          "sempkm:editHelpText": "Where the project stands right now. Update this as the project progresses -- it helps you quickly scan which projects need attention."
        },
        {
          "sh:path": { "@id": "bpkm:priority" },
          "sh:name": "Priority",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:in": { "@list": ["low", "medium", "high", "critical"] },
          "sh:defaultValue": "medium",
          "sh:maxCount": 1,
          "sh:order": 4,
          "sh:group": { "@id": "bpkm:ProjectBasicInfoGroup" },
          "sh:description": "How urgent or important this project is.",
          "sempkm:editHelpText": "Relative importance compared to your other projects. Use this to decide what to work on when time is limited."
        },
        {
          "sh:path": { "@id": "schema:startDate" },
          "sh:name": "Start Date",
          "sh:datatype": { "@id": "xsd:date" },
          "sh:maxCount": 1,
          "sh:order": 5,
          "sh:group": { "@id": "bpkm:ProjectDatesGroup" },
          "sh:description": "When this project began or is planned to begin.",
          "sempkm:editHelpText": "When this project kicked off or is planned to begin. Useful for tracking timelines and reviewing past work."
        },
        {
          "sh:path": { "@id": "schema:endDate" },
          "sh:name": "End Date",
          "sh:datatype": { "@id": "xsd:date" },
          "sh:maxCount": 1,
          "sh:order": 6,
          "sh:group": { "@id": "bpkm:ProjectDatesGroup" },
          "sh:description": "When this project finished or is expected to finish.",
          "sempkm:editHelpText": "When this project wrapped up or is expected to finish. Leave blank for ongoing projects."
        },
        {
          "sh:path": { "@id": "bpkm:hasParticipant" },
          "sh:name": "Participants",
          "sh:class": { "@id": "bpkm:Person" },
          "sh:order": 7,
          "sh:group": { "@id": "bpkm:ProjectRelationshipsGroup" },
          "sh:description": "People involved in this project.",
          "sempkm:editHelpText": "People involved in this project. Linking participants lets you see all of someone's projects from their profile."
        },
        {
          "sh:path": { "@id": "bpkm:hasNote" },
          "sh:name": "Notes",
          "sh:class": { "@id": "bpkm:Note" },
          "sh:order": 8,
          "sh:group": { "@id": "bpkm:ProjectRelationshipsGroup" },
          "sh:description": "Notes related to this project.",
          "sempkm:editHelpText": "Notes related to this project. Linking notes here keeps project context together and makes research easier to find."
        },
        {
          "sh:path": { "@id": "bpkm:hasProjectTasks" },
          "sh:name": "Tasks",
          "sh:class": { "@id": "bpkm:Task" },
          "sh:order": 9,
          "sh:group": { "@id": "bpkm:ProjectRelationshipsGroup" },
          "sh:description": "Tasks belonging to this project.",
          "sempkm:editHelpText": "Tasks belonging to this project. Populated automatically when tasks reference this project -- you can also link tasks directly here."
        },
        {
          "sh:path": { "@id": "bpkm:hasMilestones" },
          "sh:name": "Milestones",
          "sh:class": { "@id": "bpkm:Milestone" },
          "sh:order": 10,
          "sh:group": { "@id": "bpkm:ProjectRelationshipsGroup" },
          "sh:description": "Milestones for this project.",
          "sempkm:editHelpText": "Milestones for this project. Each milestone groups related tasks toward a deliverable or deadline."
        },
        {
          "sh:path": { "@id": "bpkm:tags" },
          "sh:name": "Tags",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:order": 11,
          "sh:group": { "@id": "bpkm:ProjectMetadataGroup" },
          "sh:description": "Free-form labels to help organize and find this project.",
          "sempkm:editHelpText": "Free-form tags for quick filtering. Use lowercase, hyphen-separated terms (e.g. `work`, `side-project`, `writing`). Tags help when you have many projects."
        },
        {
          "sh:path": { "@id": "dcterms:created" },
          "sh:name": "Created",
          "sh:datatype": { "@id": "xsd:dateTime" },
          "sh:maxCount": 1,
          "sh:order": 12,
          "sh:group": { "@id": "bpkm:ProjectMetadataGroup" }
        },
        {
          "sh:path": { "@id": "dcterms:modified" },
          "sh:name": "Modified",
          "sh:datatype": { "@id": "xsd:dateTime" },
          "sh:maxCount": 1,
          "sh:order": 13,
          "sh:group": { "@id": "bpkm:ProjectMetadataGroup" }
        }
      ]
    },

    {
      "@id": "bpkm:PersonBasicInfoGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Basic Info",
      "sh:order": 1
    },
    {
      "@id": "bpkm:PersonContactGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Contact",
      "sh:order": 2
    },
    {
      "@id": "bpkm:PersonRelationshipsGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Relationships",
      "sh:order": 3
    },
    {
      "@id": "bpkm:PersonMetadataGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Metadata",
      "sh:order": 4
    },
    {
      "@id": "bpkm:PersonShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": { "@id": "bpkm:Person" },
      "rdfs:label": "Person Shape",
      "sempkm:editHelpText": "People represent contacts, collaborators, or authors you interact with. Link them to projects and notes to build a network of who contributed what.",
      "sh:property": [
        {
          "sh:path": { "@id": "foaf:name" },
          "sh:name": "Name",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:order": 1,
          "sh:group": { "@id": "bpkm:PersonBasicInfoGroup" },
          "sh:description": "Full name of this person.",
          "sempkm:editHelpText": "Full name as you'd recognize them. Use whatever form is most natural -- \"Jane Smith\" or \"Dr. Jane Smith\" are both fine."
        },
        {
          "sh:path": { "@id": "foaf:mbox" },
          "sh:name": "Email",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:maxCount": 1,
          "sh:order": 2,
          "sh:group": { "@id": "bpkm:PersonContactGroup" },
          "sh:description": "Primary email address.",
          "sempkm:editHelpText": "Primary email address. Useful for quick reference -- you won't need to dig through other apps to find it."
        },
        {
          "sh:path": { "@id": "schema:jobTitle" },
          "sh:name": "Job Title",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:maxCount": 1,
          "sh:order": 3,
          "sh:group": { "@id": "bpkm:PersonBasicInfoGroup" },
          "sh:description": "Their role or position.",
          "sempkm:editHelpText": "Their current role or position. Helps you remember context when you revisit this person later."
        },
        {
          "sh:path": { "@id": "schema:worksFor" },
          "sh:name": "Organization",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:maxCount": 1,
          "sh:order": 4,
          "sh:group": { "@id": "bpkm:PersonBasicInfoGroup" },
          "sh:description": "Company or institution they belong to.",
          "sempkm:editHelpText": "Company, institution, or group they belong to. Helpful for remembering where you know someone from."
        },
        {
          "sh:path": { "@id": "foaf:phone" },
          "sh:name": "Phone",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:maxCount": 1,
          "sh:order": 5,
          "sh:group": { "@id": "bpkm:PersonContactGroup" },
          "sh:description": "Phone number.",
          "sempkm:editHelpText": "Phone number in any format. Include country code for international contacts."
        },
        {
          "sh:path": { "@id": "schema:url" },
          "sh:name": "URL",
          "sh:datatype": { "@id": "xsd:anyURI" },
          "sh:maxCount": 1,
          "sh:order": 6,
          "sh:group": { "@id": "bpkm:PersonContactGroup" },
          "sh:description": "Website or profile link.",
          "sempkm:editHelpText": "Personal website, LinkedIn profile, or other relevant link. One URL that best represents this person."
        },
        {
          "sh:path": { "@id": "dcterms:description" },
          "sh:name": "Notes",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:maxCount": 1,
          "sh:order": 7,
          "sh:group": { "@id": "bpkm:PersonBasicInfoGroup" },
          "sh:description": "Anything else worth remembering about this person.",
          "sempkm:editHelpText": "Anything worth remembering about this person -- how you met, shared interests, conversation notes. Free-form text."
        },
        {
          "sh:path": { "@id": "bpkm:tags" },
          "sh:name": "Tags",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:order": 8,
          "sh:group": { "@id": "bpkm:PersonMetadataGroup" },
          "sh:description": "Labels to categorize this person (e.g. colleague, mentor).",
          "sempkm:editHelpText": "Free-form tags for categorization. Use terms like `colleague`, `mentor`, `client`, `conference-contact` to group people."
        },
        {
          "sh:path": { "@id": "bpkm:participatesIn" },
          "sh:name": "Projects",
          "sh:class": { "@id": "bpkm:Project" },
          "sh:order": 9,
          "sh:group": { "@id": "bpkm:PersonRelationshipsGroup" },
          "sh:description": "Projects this person is involved in.",
          "sempkm:editHelpText": "Projects this person is involved in. Linking here creates a two-way connection visible from both sides."
        },
        {
          "sh:path": { "@id": "bpkm:hasAssignedTask" },
          "sh:name": "Assigned Tasks",
          "sh:class": { "@id": "bpkm:Task" },
          "sh:order": 10,
          "sh:group": { "@id": "bpkm:PersonRelationshipsGroup" },
          "sh:description": "Tasks assigned to this person.",
          "sempkm:editHelpText": "Tasks assigned to this person. Populated automatically when tasks reference this person as assignee."
        },
        {
          "sh:path": { "@id": "dcterms:created" },
          "sh:name": "Created",
          "sh:datatype": { "@id": "xsd:dateTime" },
          "sh:maxCount": 1,
          "sh:order": 11,
          "sh:group": { "@id": "bpkm:PersonMetadataGroup" }
        },
        {
          "sh:path": { "@id": "dcterms:modified" },
          "sh:name": "Modified",
          "sh:datatype": { "@id": "xsd:dateTime" },
          "sh:maxCount": 1,
          "sh:order": 12,
          "sh:group": { "@id": "bpkm:PersonMetadataGroup" }
        }
      ]
    },

    {
      "@id": "bpkm:NoteContentGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Content",
      "sh:order": 1
    },
    {
      "@id": "bpkm:NoteRelationshipsGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Relationships",
      "sh:order": 2
    },
    {
      "@id": "bpkm:NoteMetadataGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Metadata",
      "sh:order": 3
    },
    {
      "@id": "bpkm:NoteShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": { "@id": "bpkm:Note" },
      "rdfs:label": "Note Shape",
      "sempkm:editHelpText": "Notes capture individual ideas, observations, or references. Each note should focus on a single thought -- you can always link related notes together via concepts and projects. Prefer creating many small notes over one large one.",
      "sh:property": [
        {
          "sh:path": { "@id": "dcterms:title" },
          "sh:name": "Title",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:order": 1,
          "sh:group": { "@id": "bpkm:NoteContentGroup" },
          "sempkm:editHelpText": "A concise, descriptive title that captures the core idea. Good titles help you find notes later -- prefer specifics over generic labels.",
          "sh:description": "A concise title that captures the core idea."
        },
        {
          "sh:path": { "@id": "bpkm:body" },
          "sh:name": "Body",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:maxCount": 1,
          "sh:order": 2,
          "sh:group": { "@id": "bpkm:NoteContentGroup" },
          "sempkm:editHelpText": "The main content of your note. Write in your own words -- paraphrasing helps retention. Markdown formatting is supported.",
          "sh:description": "The main content of your note. Markdown supported."
        },
        {
          "sh:path": { "@id": "bpkm:noteType" },
          "sh:name": "Type",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:in": { "@list": ["observation", "idea", "reference", "meeting-note", "journal"] },
          "sh:defaultValue": "observation",
          "sh:maxCount": 1,
          "sh:order": 3,
          "sh:group": { "@id": "bpkm:NoteContentGroup" },
          "sempkm:editHelpText": "Categorize this note: **observation** for things you noticed, **idea** for new thoughts, **reference** for external sources, **meeting-note** for discussions, **journal** for reflections.",
          "sh:description": "What kind of note this is (observation, idea, reference, etc.)."
        },
        {
          "sh:path": { "@id": "bpkm:isAbout" },
          "sh:name": "About Concepts",
          "sh:class": { "@id": "bpkm:Concept" },
          "sh:order": 4,
          "sh:group": { "@id": "bpkm:NoteRelationshipsGroup" },
          "sempkm:editHelpText": "Link to the concepts this note discusses. Concept links build your knowledge graph and help surface related notes automatically.",
          "sh:description": "Concepts this note discusses or relates to."
        },
        {
          "sh:path": { "@id": "bpkm:relatedProject" },
          "sh:name": "Related Project",
          "sh:class": { "@id": "bpkm:Project" },
          "sh:maxCount": 1,
          "sh:order": 5,
          "sh:group": { "@id": "bpkm:NoteRelationshipsGroup" },
          "sempkm:editHelpText": "Optionally associate this note with a project. The note will appear in the project's context, making it easier to find later.",
          "sh:description": "The project this note belongs to, if any."
        },
        {
          "sh:path": { "@id": "dcterms:source" },
          "sh:name": "Source URL",
          "sh:datatype": { "@id": "xsd:anyURI" },
          "sh:maxCount": 1,
          "sh:order": 6,
          "sh:group": { "@id": "bpkm:NoteContentGroup" },
          "sempkm:editHelpText": "If this note references an external source (article, paper, website), paste the URL here for attribution and easy revisiting.",
          "sh:description": "Link to the original source (article, paper, website)."
        },
        {
          "sh:path": { "@id": "bpkm:tags" },
          "sh:name": "Tags",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:order": 7,
          "sh:group": { "@id": "bpkm:NoteMetadataGroup" },
          "sempkm:editHelpText": "Free-form tags for quick filtering. Use lowercase, hyphen-separated terms (e.g. `machine-learning`, `team-standup`). Tags complement concept links for lightweight categorization.",
          "sh:description": "Free-form labels for quick filtering."
        },
        {
          "sh:path": { "@id": "dcterms:created" },
          "sh:name": "Created",
          "sh:datatype": { "@id": "xsd:dateTime" },
          "sh:maxCount": 1,
          "sh:order": 8,
          "sh:group": { "@id": "bpkm:NoteMetadataGroup" }
        },
        {
          "sh:path": { "@id": "dcterms:modified" },
          "sh:name": "Modified",
          "sh:datatype": { "@id": "xsd:dateTime" },
          "sh:maxCount": 1,
          "sh:order": 9,
          "sh:group": { "@id": "bpkm:NoteMetadataGroup" }
        }
      ]
    },

    {
      "@id": "bpkm:ConceptDefinitionGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Definition",
      "sh:order": 1
    },
    {
      "@id": "bpkm:ConceptHierarchyGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Hierarchy",
      "sh:order": 2
    },
    {
      "@id": "bpkm:ConceptMetadataGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Metadata",
      "sh:order": 3
    },
    {
      "@id": "bpkm:ConceptShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": { "@id": "bpkm:Concept" },
      "rdfs:label": "Concept Shape",
      "sempkm:editHelpText": "Concepts are the vocabulary of your knowledge base. They represent topics, themes, or domains that notes can be *about*. Build a concept hierarchy with broader/narrower links to organize your thinking.",
      "sh:property": [
        {
          "sh:path": { "@id": "skos:prefLabel" },
          "sh:name": "Label",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:order": 1,
          "sh:group": { "@id": "bpkm:ConceptDefinitionGroup" },
          "sh:description": "The primary name for this concept.",
          "sempkm:editHelpText": "The primary name for this concept -- the term you'd naturally use when thinking or writing about it."
        },
        {
          "sh:path": { "@id": "skos:altLabel" },
          "sh:name": "Alternative Labels",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:order": 2,
          "sh:group": { "@id": "bpkm:ConceptDefinitionGroup" },
          "sh:description": "Synonyms or other names for this concept.",
          "sempkm:editHelpText": "Synonyms, abbreviations, or alternate spellings. Helps you find this concept even when using different terminology."
        },
        {
          "sh:path": { "@id": "skos:definition" },
          "sh:name": "Definition",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:maxCount": 1,
          "sh:order": 3,
          "sh:group": { "@id": "bpkm:ConceptDefinitionGroup" },
          "sh:description": "What this concept means in your own words.",
          "sempkm:editHelpText": "What this concept means in your own words. Writing a definition deepens understanding -- even a rough one is valuable."
        },
        {
          "sh:path": { "@id": "skos:broader" },
          "sh:name": "Broader Concepts",
          "sh:class": { "@id": "bpkm:Concept" },
          "sh:order": 4,
          "sh:group": { "@id": "bpkm:ConceptHierarchyGroup" },
          "sh:description": "Parent concepts that this one falls under.",
          "sempkm:editHelpText": "Parent concepts that this one falls under. For example, \"Machine Learning\" is broader than \"Neural Networks\". Builds a concept hierarchy."
        },
        {
          "sh:path": { "@id": "skos:narrower" },
          "sh:name": "Narrower Concepts",
          "sh:class": { "@id": "bpkm:Concept" },
          "sh:order": 5,
          "sh:group": { "@id": "bpkm:ConceptHierarchyGroup" },
          "sh:description": "More specific concepts within this one.",
          "sempkm:editHelpText": "More specific concepts within this one. The inverse of \"broader\" -- helps you navigate from general to specific."
        },
        {
          "sh:path": { "@id": "skos:related" },
          "sh:name": "Related Concepts",
          "sh:class": { "@id": "bpkm:Concept" },
          "sh:order": 6,
          "sh:group": { "@id": "bpkm:ConceptHierarchyGroup" },
          "sh:description": "Concepts that are related but not hierarchically.",
          "sempkm:editHelpText": "Concepts that are connected but not hierarchically. Use for lateral associations -- e.g. \"Design Thinking\" related to \"User Research\"."
        },
        {
          "sh:path": { "@id": "schema:url" },
          "sh:name": "Reference URL",
          "sh:datatype": { "@id": "xsd:anyURI" },
          "sh:maxCount": 1,
          "sh:order": 7,
          "sh:group": { "@id": "bpkm:ConceptMetadataGroup" },
          "sh:description": "Link to an authoritative source for this concept.",
          "sempkm:editHelpText": "Link to an authoritative or useful source -- a Wikipedia article, textbook chapter, or key paper. For quick reference."
        },
        {
          "sh:path": { "@id": "bpkm:tags" },
          "sh:name": "Tags",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:order": 8,
          "sh:group": { "@id": "bpkm:ConceptMetadataGroup" },
          "sh:description": "Free-form labels for categorization.",
          "sempkm:editHelpText": "Free-form tags for lightweight categorization. Use alongside the concept hierarchy for cross-cutting concerns like `needs-review` or `core-concept`."
        },
        {
          "sh:path": { "@id": "dcterms:created" },
          "sh:name": "Created",
          "sh:datatype": { "@id": "xsd:dateTime" },
          "sh:maxCount": 1,
          "sh:order": 9,
          "sh:group": { "@id": "bpkm:ConceptMetadataGroup" }
        },
        {
          "sh:path": { "@id": "dcterms:modified" },
          "sh:name": "Modified",
          "sh:datatype": { "@id": "xsd:dateTime" },
          "sh:maxCount": 1,
          "sh:order": 10,
          "sh:group": { "@id": "bpkm:ConceptMetadataGroup" }
        }
      ]
    },

    {
      "@id": "bpkm:TaskBasicInfoGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Basic Info",
      "sh:order": 1
    },
    {
      "@id": "bpkm:TaskDatesGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Dates",
      "sh:order": 2
    },
    {
      "@id": "bpkm:TaskRelationshipsGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Relationships",
      "sh:order": 3
    },
    {
      "@id": "bpkm:TaskMetadataGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Metadata",
      "sh:order": 4
    },
    {
      "@id": "bpkm:TaskShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": { "@id": "bpkm:Task" },
      "rdfs:label": "Task Shape",
      "sempkm:editHelpText": "Tasks represent individual units of work. They can be native SemPKM tasks or synced from external providers like Linear, Jira, or GitHub. Link tasks to projects, milestones, and people to build a complete work graph.",
      "sh:property": [
        {
          "sh:path": { "@id": "dcterms:title" },
          "sh:name": "Title",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:order": 1,
          "sh:group": { "@id": "bpkm:TaskBasicInfoGroup" },
          "sh:description": "The task title.",
          "sempkm:editHelpText": "A clear, actionable task title. Start with a verb when possible -- e.g. \"Implement login page\" rather than \"Login page\"."
        },
        {
          "sh:path": { "@id": "dcterms:description" },
          "sh:name": "Description",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:maxCount": 1,
          "sh:order": 2,
          "sh:group": { "@id": "bpkm:TaskBasicInfoGroup" },
          "sh:description": "Longer description or acceptance criteria.",
          "sempkm:editHelpText": "Detailed description or acceptance criteria. What does \"done\" look like? Include enough context so anyone could pick this up."
        },
        {
          "sh:path": { "@id": "bpkm:taskStatus" },
          "sh:name": "Status",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:in": { "@list": ["todo", "in-progress", "done", "blocked", "cancelled"] },
          "sh:defaultValue": "todo",
          "sh:maxCount": 1,
          "sh:order": 3,
          "sh:group": { "@id": "bpkm:TaskBasicInfoGroup" },
          "sh:description": "Current state of the task.",
          "sempkm:editHelpText": "Current state of the task. Synced tasks update this automatically. Use \"blocked\" when waiting on dependencies or external input."
        },
        {
          "sh:path": { "@id": "bpkm:priority" },
          "sh:name": "Priority",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:in": { "@list": ["low", "medium", "high", "critical"] },
          "sh:defaultValue": "medium",
          "sh:maxCount": 1,
          "sh:order": 4,
          "sh:group": { "@id": "bpkm:TaskBasicInfoGroup" },
          "sh:description": "How urgent or important this task is.",
          "sempkm:editHelpText": "Relative importance. Use \"critical\" sparingly -- if everything is critical, nothing is. Consider both urgency and impact."
        },
        {
          "sh:path": { "@id": "bpkm:effort" },
          "sh:name": "Effort",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:in": { "@list": ["trivial", "small", "medium", "large", "epic"] },
          "sh:maxCount": 1,
          "sh:order": 5,
          "sh:group": { "@id": "bpkm:TaskBasicInfoGroup" },
          "sh:description": "Rough size estimate for planning.",
          "sempkm:editHelpText": "Rough size estimate. Useful for planning capacity across projects. Trivial = minutes, small = hours, medium = a day, large = days, epic = a week+."
        },
        {
          "sh:path": { "@id": "bpkm:dueDate" },
          "sh:name": "Due Date",
          "sh:datatype": { "@id": "xsd:date" },
          "sh:maxCount": 1,
          "sh:order": 6,
          "sh:group": { "@id": "bpkm:TaskDatesGroup" },
          "sh:description": "When this task is due.",
          "sempkm:editHelpText": "When this task needs to be finished. Tasks past their due date with status todo or in-progress will trigger overdue warnings."
        },
        {
          "sh:path": { "@id": "bpkm:completedDate" },
          "sh:name": "Completed Date",
          "sh:datatype": { "@id": "xsd:date" },
          "sh:maxCount": 1,
          "sh:order": 7,
          "sh:group": { "@id": "bpkm:TaskDatesGroup" },
          "sh:description": "When this task was finished.",
          "sempkm:editHelpText": "When this task was actually completed. Set automatically for synced tasks. Useful for tracking velocity over time."
        },
        {
          "sh:path": { "@id": "bpkm:assignedTo" },
          "sh:name": "Assigned To",
          "sh:class": { "@id": "bpkm:Person" },
          "sh:order": 8,
          "sh:group": { "@id": "bpkm:TaskRelationshipsGroup" },
          "sh:description": "Person responsible for this task.",
          "sempkm:editHelpText": "Who's responsible for completing this task. Links back to the person's profile where all their assigned tasks are visible."
        },
        {
          "sh:path": { "@id": "bpkm:taskProject" },
          "sh:name": "Project",
          "sh:class": { "@id": "bpkm:Project" },
          "sh:maxCount": 1,
          "sh:order": 9,
          "sh:group": { "@id": "bpkm:TaskRelationshipsGroup" },
          "sh:description": "The project this task belongs to.",
          "sempkm:editHelpText": "Parent project for this task. If the task belongs to a milestone, the project can be inferred automatically from the milestone's project."
        },
        {
          "sh:path": { "@id": "bpkm:milestone" },
          "sh:name": "Milestone",
          "sh:class": { "@id": "bpkm:Milestone" },
          "sh:maxCount": 1,
          "sh:order": 10,
          "sh:group": { "@id": "bpkm:TaskRelationshipsGroup" },
          "sh:description": "Which milestone this task belongs to.",
          "sempkm:editHelpText": "The milestone this task contributes to. Milestones group related tasks toward a deliverable or deadline within a project."
        },
        {
          "sh:path": { "@id": "bpkm:dependsOn" },
          "sh:name": "Depends On",
          "sh:class": { "@id": "bpkm:Task" },
          "sh:order": 11,
          "sh:group": { "@id": "bpkm:TaskRelationshipsGroup" },
          "sh:description": "Tasks that must be completed before this one.",
          "sempkm:editHelpText": "Tasks that must be completed before this one can start. Helps identify bottlenecks and plan work order."
        },
        {
          "sh:path": { "@id": "bpkm:relatedNote" },
          "sh:name": "Related Notes",
          "sh:class": { "@id": "bpkm:Note" },
          "sh:order": 12,
          "sh:group": { "@id": "bpkm:TaskRelationshipsGroup" },
          "sh:description": "Notes providing context for this task.",
          "sempkm:editHelpText": "Notes that provide context, research, or discussion relevant to this task. Link meeting notes, design docs, or reference material."
        },
        {
          "sh:path": { "@id": "bpkm:relatedConcept" },
          "sh:name": "Related Concepts",
          "sh:class": { "@id": "bpkm:Concept" },
          "sh:order": 13,
          "sh:group": { "@id": "bpkm:TaskRelationshipsGroup" },
          "sh:description": "Concepts related to this task.",
          "sempkm:editHelpText": "Concepts this task relates to. Useful for finding all tasks about a particular topic or domain."
        },
        {
          "sh:path": { "@id": "bpkm:tags" },
          "sh:name": "Tags",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:order": 14,
          "sh:group": { "@id": "bpkm:TaskMetadataGroup" },
          "sh:description": "Free-form labels for categorization.",
          "sempkm:editHelpText": "Free-form tags for quick filtering. Use terms like `bug`, `feature`, `documentation`, `tech-debt` to categorize work."
        },
        {
          "sh:path": { "@id": "bpkm:body" },
          "sh:name": "Body",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:maxCount": 1,
          "sh:order": 15,
          "sh:group": { "@id": "bpkm:TaskMetadataGroup" },
          "sh:description": "Markdown notes on the task.",
          "sempkm:editHelpText": "Extended notes, implementation details, or working notes for this task. Markdown formatting is supported."
        },
        {
          "sh:path": { "@id": "bpkm:externalProvider" },
          "sh:name": "External Provider",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:in": { "@list": ["asana", "linear", "jira", "github", "todoist", "trello", "manual"] },
          "sh:maxCount": 1,
          "sh:order": 16,
          "sh:group": { "@id": "bpkm:TaskMetadataGroup" },
          "sh:description": "Which service this task was imported from.",
          "sempkm:editHelpText": "Which service this task was imported from. Set automatically during sync. Manual tasks don't need this field."
        },
        {
          "sh:path": { "@id": "bpkm:externalId" },
          "sh:name": "External ID",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:maxCount": 1,
          "sh:order": 17,
          "sh:group": { "@id": "bpkm:TaskMetadataGroup" },
          "sh:description": "Provider's task identifier (e.g., PROJ-123).",
          "sempkm:editHelpText": "The task's identifier in the external system (e.g., LIN-42, PROJ-123, #42). Set automatically during sync."
        },
        {
          "sh:path": { "@id": "bpkm:externalUrl" },
          "sh:name": "External URL",
          "sh:datatype": { "@id": "xsd:anyURI" },
          "sh:maxCount": 1,
          "sh:order": 18,
          "sh:group": { "@id": "bpkm:TaskMetadataGroup" },
          "sh:description": "Direct link to the task in the external provider.",
          "sempkm:editHelpText": "Direct link to this task in the external provider. Click to open the task in its original context."
        },
        {
          "sh:path": { "@id": "bpkm:lastSyncedAt" },
          "sh:name": "Last Synced",
          "sh:datatype": { "@id": "xsd:dateTime" },
          "sh:maxCount": 1,
          "sh:order": 19,
          "sh:group": { "@id": "bpkm:TaskMetadataGroup" },
          "sh:description": "Timestamp of last successful sync.",
          "sempkm:editHelpText": "When this task was last synchronized with its external provider. Updated automatically during sync cycles."
        },
        {
          "sh:path": { "@id": "dcterms:created" },
          "sh:name": "Created",
          "sh:datatype": { "@id": "xsd:dateTime" },
          "sh:maxCount": 1,
          "sh:order": 20,
          "sh:group": { "@id": "bpkm:TaskMetadataGroup" }
        },
        {
          "sh:path": { "@id": "dcterms:modified" },
          "sh:name": "Modified",
          "sh:datatype": { "@id": "xsd:dateTime" },
          "sh:maxCount": 1,
          "sh:order": 21,
          "sh:group": { "@id": "bpkm:TaskMetadataGroup" }
        }
      ]
    },

    {
      "@id": "bpkm:MilestoneBasicInfoGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Basic Info",
      "sh:order": 1
    },
    {
      "@id": "bpkm:MilestoneDatesGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Dates",
      "sh:order": 2
    },
    {
      "@id": "bpkm:MilestoneRelationshipsGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Relationships",
      "sh:order": 3
    },
    {
      "@id": "bpkm:MilestoneMetadataGroup",
      "@type": "sh:PropertyGroup",
      "rdfs:label": "Metadata",
      "sh:order": 4
    },
    {
      "@id": "bpkm:MilestoneShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": { "@id": "bpkm:Milestone" },
      "rdfs:label": "Milestone Shape",
      "sempkm:editHelpText": "Milestones group related tasks toward a specific deliverable or deadline within a project. Use milestones to break large projects into manageable phases with clear targets.",
      "sh:property": [
        {
          "sh:path": { "@id": "dcterms:title" },
          "sh:name": "Title",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:order": 1,
          "sh:group": { "@id": "bpkm:MilestoneBasicInfoGroup" },
          "sh:description": "The milestone name.",
          "sempkm:editHelpText": "A clear milestone name that describes the deliverable or target. E.g. \"Beta Launch\" or \"Q2 Feature Freeze\" rather than just \"Phase 1\"."
        },
        {
          "sh:path": { "@id": "dcterms:description" },
          "sh:name": "Description",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:maxCount": 1,
          "sh:order": 2,
          "sh:group": { "@id": "bpkm:MilestoneBasicInfoGroup" },
          "sh:description": "What this milestone delivers.",
          "sempkm:editHelpText": "What this milestone delivers or represents. Define the exit criteria -- what must be true for this milestone to be considered complete?"
        },
        {
          "sh:path": { "@id": "bpkm:milestoneStatus" },
          "sh:name": "Status",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:in": { "@list": ["planned", "active", "completed", "cancelled"] },
          "sh:defaultValue": "planned",
          "sh:maxCount": 1,
          "sh:order": 3,
          "sh:group": { "@id": "bpkm:MilestoneBasicInfoGroup" },
          "sh:description": "Current state of the milestone.",
          "sempkm:editHelpText": "Where the milestone stands. Move to \"active\" when work begins, \"completed\" when all tasks are done, or \"cancelled\" if plans change."
        },
        {
          "sh:path": { "@id": "bpkm:targetDate" },
          "sh:name": "Target Date",
          "sh:datatype": { "@id": "xsd:date" },
          "sh:maxCount": 1,
          "sh:order": 4,
          "sh:group": { "@id": "bpkm:MilestoneDatesGroup" },
          "sh:description": "Deadline for this milestone.",
          "sempkm:editHelpText": "When this milestone should be completed. Helps prioritize tasks within the milestone and track project timeline."
        },
        {
          "sh:path": { "@id": "bpkm:completedDate" },
          "sh:name": "Completed Date",
          "sh:datatype": { "@id": "xsd:date" },
          "sh:maxCount": 1,
          "sh:order": 5,
          "sh:group": { "@id": "bpkm:MilestoneDatesGroup" },
          "sh:description": "When this milestone was finished.",
          "sempkm:editHelpText": "When this milestone was actually completed. Compare with target date to track estimation accuracy over time."
        },
        {
          "sh:path": { "@id": "bpkm:milestoneProject" },
          "sh:name": "Project",
          "sh:class": { "@id": "bpkm:Project" },
          "sh:maxCount": 1,
          "sh:order": 6,
          "sh:group": { "@id": "bpkm:MilestoneRelationshipsGroup" },
          "sh:description": "The project this milestone belongs to.",
          "sempkm:editHelpText": "Parent project for this milestone. Every milestone should belong to exactly one project."
        },
        {
          "sh:path": { "@id": "bpkm:hasTasks" },
          "sh:name": "Tasks",
          "sh:class": { "@id": "bpkm:Task" },
          "sh:order": 7,
          "sh:group": { "@id": "bpkm:MilestoneRelationshipsGroup" },
          "sh:description": "Tasks belonging to this milestone.",
          "sempkm:editHelpText": "Tasks contributing to this milestone. Populated automatically when tasks reference this milestone -- you can also link tasks directly here."
        },
        {
          "sh:path": { "@id": "bpkm:tags" },
          "sh:name": "Tags",
          "sh:datatype": { "@id": "xsd:string" },
          "sh:order": 8,
          "sh:group": { "@id": "bpkm:MilestoneMetadataGroup" },
          "sh:description": "Free-form labels for categorization.",
          "sempkm:editHelpText": "Free-form tags for categorization. Use terms like `release`, `review`, `planning` to group milestones across projects."
        },
        {
          "sh:path": { "@id": "dcterms:created" },
          "sh:name": "Created",
          "sh:datatype": { "@id": "xsd:dateTime" },
          "sh:maxCount": 1,
          "sh:order": 9,
          "sh:group": { "@id": "bpkm:MilestoneMetadataGroup" }
        },
        {
          "sh:path": { "@id": "dcterms:modified" },
          "sh:name": "Modified",
          "sh:datatype": { "@id": "xsd:dateTime" },
          "sh:maxCount": 1,
          "sh:order": 10,
          "sh:group": { "@id": "bpkm:MilestoneMetadataGroup" }
        }
      ]
    }
  ]
}

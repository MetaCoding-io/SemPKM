{
  "@context": {
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "foaf": "http://xmlns.com/foaf/0.1/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "bpkm": "urn:sempkm:model:basic-pkm:",
    "gist": "https://w3id.org/semanticarts/ns/ontology/gist/"
  },
  "@graph": [
    {
      "@id": "bpkm:ontology",
      "@type": "owl:Ontology",
      "rdfs:label": "Basic PKM Ontology",
      "dcterms:description": "Core types for personal knowledge management: Projects, People, Notes, Concepts, Tasks, and Milestones with rich inter-type relationships."
    },

    {
      "@id": "bpkm:Project",
      "@type": "owl:Class",
      "rdfs:label": "Project",
      "rdfs:comment": "A project or initiative being tracked",
      "rdfs:subClassOf": { "@id": "gist:Project" }
    },
    {
      "@id": "bpkm:Person",
      "@type": "owl:Class",
      "rdfs:label": "Person",
      "rdfs:comment": "A person known to the user",
      "rdfs:subClassOf": { "@id": "gist:Person" }
    },
    {
      "@id": "bpkm:Note",
      "@type": "owl:Class",
      "rdfs:label": "Note",
      "rdfs:comment": "A note, observation, or piece of knowledge",
      "rdfs:subClassOf": { "@id": "gist:FormattedContent" }
    },
    {
      "@id": "bpkm:Concept",
      "@type": "owl:Class",
      "rdfs:label": "Concept",
      "rdfs:comment": "An abstract concept, topic, or domain area",
      "rdfs:subClassOf": { "@id": "gist:KnowledgeConcept" }
    },
    {
      "@id": "bpkm:Task",
      "@type": "owl:Class",
      "rdfs:label": "Task",
      "rdfs:comment": "An atomic unit of work, optionally synced from an external provider",
      "rdfs:subClassOf": { "@id": "gist:Task" }
    },
    {
      "@id": "bpkm:Milestone",
      "@type": "owl:Class",
      "rdfs:label": "Milestone",
      "rdfs:comment": "A grouping of tasks toward a specific deliverable or deadline within a project",
      "rdfs:subClassOf": { "@id": "gist:Event" }
    },

    {
      "@id": "bpkm:status",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Status",
      "rdfs:comment": "Status of a project (active, completed, on-hold, cancelled)",
      "rdfs:domain": { "@id": "bpkm:Project" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:priority",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Priority",
      "rdfs:comment": "Priority level (low, medium, high, critical)",
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:tags",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Tags",
      "rdfs:comment": "Tags for categorization (individual values)",
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:body",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Body",
      "rdfs:comment": "Markdown body content",
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:noteType",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Note Type",
      "rdfs:comment": "Type of note (observation, idea, reference, meeting-note, journal)",
      "rdfs:domain": { "@id": "bpkm:Note" },
      "rdfs:range": { "@id": "xsd:string" }
    },

    {
      "@id": "bpkm:taskStatus",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Task Status",
      "rdfs:comment": "Current state of a task (todo, in-progress, done, blocked, cancelled)",
      "rdfs:domain": { "@id": "bpkm:Task" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:dueDate",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Due Date",
      "rdfs:comment": "When the task is due",
      "rdfs:domain": { "@id": "bpkm:Task" },
      "rdfs:range": { "@id": "xsd:date" }
    },
    {
      "@id": "bpkm:scheduledStart",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Scheduled Start",
      "rdfs:comment": "When the task is scheduled to begin (calendar time-blocking)",
      "rdfs:domain": { "@id": "bpkm:Task" },
      "rdfs:range": { "@id": "xsd:dateTime" }
    },
    {
      "@id": "bpkm:scheduledEnd",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Scheduled End",
      "rdfs:comment": "When the task is scheduled to end (calendar time-blocking)",
      "rdfs:domain": { "@id": "bpkm:Task" },
      "rdfs:range": { "@id": "xsd:dateTime" }
    },
    {
      "@id": "bpkm:estimatedDuration",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Estimated Duration",
      "rdfs:comment": "Expected duration in ISO 8601 format (e.g. PT1H30M)",
      "rdfs:domain": { "@id": "bpkm:Task" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:completedDate",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Completed Date",
      "rdfs:comment": "When the task or milestone was finished",
      "rdfs:range": { "@id": "xsd:date" }
    },
    {
      "@id": "bpkm:effort",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Effort",
      "rdfs:comment": "T-shirt size estimate (trivial, small, medium, large, epic)",
      "rdfs:domain": { "@id": "bpkm:Task" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:externalId",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "External ID",
      "rdfs:comment": "Provider's task identifier (e.g., PROJ-123)",
      "rdfs:domain": { "@id": "bpkm:Task" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:externalUrl",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "External URL",
      "rdfs:comment": "Direct link to the task in the external provider",
      "rdfs:domain": { "@id": "bpkm:Task" },
      "rdfs:range": { "@id": "xsd:anyURI" }
    },
    {
      "@id": "bpkm:externalProvider",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "External Provider",
      "rdfs:comment": "Which service this task was imported from (asana, linear, jira, github, todoist, trello, manual)",
      "rdfs:domain": { "@id": "bpkm:Task" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:lastSyncedAt",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Last Synced At",
      "rdfs:comment": "Timestamp of last successful sync with external provider",
      "rdfs:domain": { "@id": "bpkm:Task" },
      "rdfs:range": { "@id": "xsd:dateTime" }
    },
    {
      "@id": "bpkm:syncDirection",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Sync Direction",
      "rdfs:comment": "How this task syncs with its external provider (pull, push, bidirectional)",
      "rdfs:domain": { "@id": "bpkm:Task" },
      "rdfs:range": { "@id": "xsd:string" }
    },

    {
      "@id": "bpkm:milestoneStatus",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Milestone Status",
      "rdfs:comment": "Current state of a milestone (planned, active, completed, cancelled)",
      "rdfs:domain": { "@id": "bpkm:Milestone" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:targetDate",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Target Date",
      "rdfs:comment": "Deadline for a milestone",
      "rdfs:domain": { "@id": "bpkm:Milestone" },
      "rdfs:range": { "@id": "xsd:date" }
    },

    {
      "@id": "bpkm:hasParticipant",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Has Participant",
      "rdfs:comment": "People involved in a project",
      "rdfs:domain": { "@id": "bpkm:Project" },
      "rdfs:range": { "@id": "bpkm:Person" }
    },
    {
      "@id": "bpkm:hasNote",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Has Note",
      "rdfs:comment": "Notes related to a project",
      "rdfs:domain": { "@id": "bpkm:Project" },
      "rdfs:range": { "@id": "bpkm:Note" }
    },
    {
      "@id": "bpkm:participatesIn",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Participates In",
      "rdfs:comment": "Projects a person is involved in",
      "rdfs:domain": { "@id": "bpkm:Person" },
      "rdfs:range": { "@id": "bpkm:Project" },
      "owl:inverseOf": { "@id": "bpkm:hasParticipant" }
    },
    {
      "@id": "bpkm:isAbout",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Is About",
      "rdfs:comment": "Concepts that a note relates to",
      "rdfs:domain": { "@id": "bpkm:Note" },
      "rdfs:range": { "@id": "bpkm:Concept" }
    },
    {
      "@id": "bpkm:relatedProject",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Related Project",
      "rdfs:comment": "Project context for a note",
      "rdfs:domain": { "@id": "bpkm:Note" },
      "rdfs:range": { "@id": "bpkm:Project" }
    },
    {
      "@id": "bpkm:hasRelatedNote",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Has Related Note",
      "rdfs:comment": "Notes related to this project (derived by SHACL-AF rule from relatedProject)",
      "rdfs:domain": { "@id": "bpkm:Project" },
      "rdfs:range": { "@id": "bpkm:Note" }
    },

    {
      "@id": "bpkm:assignedTo",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Assigned To",
      "rdfs:comment": "Person responsible for this task",
      "rdfs:domain": { "@id": "bpkm:Task" },
      "rdfs:range": { "@id": "bpkm:Person" },
      "owl:inverseOf": { "@id": "bpkm:hasAssignedTask" }
    },
    {
      "@id": "bpkm:hasAssignedTask",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Assigned Tasks",
      "rdfs:comment": "Tasks assigned to this person",
      "rdfs:domain": { "@id": "bpkm:Person" },
      "rdfs:range": { "@id": "bpkm:Task" },
      "owl:inverseOf": { "@id": "bpkm:assignedTo" }
    },
    {
      "@id": "bpkm:taskProject",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Project",
      "rdfs:comment": "The project this task belongs to",
      "rdfs:domain": { "@id": "bpkm:Task" },
      "rdfs:range": { "@id": "bpkm:Project" },
      "owl:inverseOf": { "@id": "bpkm:hasProjectTasks" }
    },
    {
      "@id": "bpkm:hasProjectTasks",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Tasks",
      "rdfs:comment": "Tasks belonging to this project",
      "rdfs:domain": { "@id": "bpkm:Project" },
      "rdfs:range": { "@id": "bpkm:Task" },
      "owl:inverseOf": { "@id": "bpkm:taskProject" }
    },
    {
      "@id": "bpkm:milestone",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Milestone",
      "rdfs:comment": "The milestone this task is part of",
      "rdfs:domain": { "@id": "bpkm:Task" },
      "rdfs:range": { "@id": "bpkm:Milestone" },
      "owl:inverseOf": { "@id": "bpkm:hasTasks" }
    },
    {
      "@id": "bpkm:hasTasks",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Tasks",
      "rdfs:comment": "Tasks belonging to this milestone",
      "rdfs:domain": { "@id": "bpkm:Milestone" },
      "rdfs:range": { "@id": "bpkm:Task" },
      "owl:inverseOf": { "@id": "bpkm:milestone" }
    },
    {
      "@id": "bpkm:milestoneProject",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Project",
      "rdfs:comment": "The project this milestone belongs to",
      "rdfs:domain": { "@id": "bpkm:Milestone" },
      "rdfs:range": { "@id": "bpkm:Project" },
      "owl:inverseOf": { "@id": "bpkm:hasMilestones" }
    },
    {
      "@id": "bpkm:hasMilestones",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Milestones",
      "rdfs:comment": "Milestones belonging to this project",
      "rdfs:domain": { "@id": "bpkm:Project" },
      "rdfs:range": { "@id": "bpkm:Milestone" },
      "owl:inverseOf": { "@id": "bpkm:milestoneProject" }
    },
    {
      "@id": "bpkm:dependsOn",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Depends On",
      "rdfs:comment": "Tasks that must be completed before this one can start",
      "rdfs:domain": { "@id": "bpkm:Task" },
      "rdfs:range": { "@id": "bpkm:Task" }
    },
    {
      "@id": "bpkm:relatedNote",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Related Note",
      "rdfs:comment": "Notes providing context for this task",
      "rdfs:domain": { "@id": "bpkm:Task" },
      "rdfs:range": { "@id": "bpkm:Note" }
    },
    {
      "@id": "bpkm:relatedConcept",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Related Concept",
      "rdfs:comment": "Concepts related to this task",
      "rdfs:domain": { "@id": "bpkm:Task" },
      "rdfs:range": { "@id": "bpkm:Concept" }
    },

    {
      "@id": "bpkm:Event",
      "@type": "owl:Class",
      "rdfs:label": "Event",
      "rdfs:comment": "A calendar event, optionally synced from an external calendar provider",
      "rdfs:subClassOf": { "@id": "gist:Event" }
    },

    {
      "@id": "bpkm:eventStatus",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Event Status",
      "rdfs:comment": "Confirmation status of the event (confirmed, tentative, cancelled)",
      "rdfs:domain": { "@id": "bpkm:Event" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:location",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Location",
      "rdfs:comment": "Physical or virtual location of the event",
      "rdfs:domain": { "@id": "bpkm:Event" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:timeZone",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Time Zone",
      "rdfs:comment": "IANA time zone identifier (e.g. America/New_York)",
      "rdfs:domain": { "@id": "bpkm:Event" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:allDay",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "All Day",
      "rdfs:comment": "Whether this is an all-day event",
      "rdfs:domain": { "@id": "bpkm:Event" },
      "rdfs:range": { "@id": "xsd:boolean" }
    },
    {
      "@id": "bpkm:visibility",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Visibility",
      "rdfs:comment": "Calendar visibility (public, private, confidential)",
      "rdfs:domain": { "@id": "bpkm:Event" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:showAs",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Show As",
      "rdfs:comment": "Free/busy status shown on calendar (free, tentative, busy, out-of-office, working-elsewhere)",
      "rdfs:domain": { "@id": "bpkm:Event" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:conferenceUrl",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Conference URL",
      "rdfs:comment": "Video conference or meeting link",
      "rdfs:domain": { "@id": "bpkm:Event" },
      "rdfs:range": { "@id": "xsd:anyURI" }
    },
    {
      "@id": "bpkm:recurrenceRule",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Recurrence Rule",
      "rdfs:comment": "RFC 5545 RRULE string defining the recurrence pattern",
      "rdfs:domain": { "@id": "bpkm:Event" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:recurringEventId",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Recurring Event ID",
      "rdfs:comment": "Identifier of the master recurring event this instance belongs to",
      "rdfs:domain": { "@id": "bpkm:Event" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:responseStatus",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Response Status",
      "rdfs:comment": "The user's RSVP response (needs-action, accepted, declined, tentative)",
      "rdfs:domain": { "@id": "bpkm:Event" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:reminderMinutes",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Reminder Minutes",
      "rdfs:comment": "Minutes before the event to trigger a reminder",
      "rdfs:domain": { "@id": "bpkm:Event" },
      "rdfs:range": { "@id": "xsd:integer" }
    },
    {
      "@id": "bpkm:calendarName",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Calendar Name",
      "rdfs:comment": "Name of the source calendar (e.g. Work, Personal)",
      "rdfs:domain": { "@id": "bpkm:Event" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:meetingNotes",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Meeting Notes",
      "rdfs:comment": "SemPKM-only field for capturing notes during or after the event",
      "rdfs:domain": { "@id": "bpkm:Event" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:attendee",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Attendee",
      "rdfs:comment": "People attending this event",
      "rdfs:domain": { "@id": "bpkm:Event" },
      "rdfs:range": { "@id": "bpkm:Person" }
    },
    {
      "@id": "bpkm:organizer",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Organizer",
      "rdfs:comment": "Person who organized this event",
      "rdfs:domain": { "@id": "bpkm:Event" },
      "rdfs:range": { "@id": "bpkm:Person" }
    },
    {
      "@id": "bpkm:eventProject",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Project",
      "rdfs:comment": "The project this event relates to",
      "rdfs:domain": { "@id": "bpkm:Event" },
      "rdfs:range": { "@id": "bpkm:Project" },
      "owl:inverseOf": { "@id": "bpkm:hasEvents" }
    },
    {
      "@id": "bpkm:hasEvents",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Events",
      "rdfs:comment": "Events related to this project",
      "rdfs:domain": { "@id": "bpkm:Project" },
      "rdfs:range": { "@id": "bpkm:Event" },
      "owl:inverseOf": { "@id": "bpkm:eventProject" }
    },
    {
      "@id": "bpkm:generatedTask",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Generated Task",
      "rdfs:comment": "Task created from or linked to this event",
      "rdfs:domain": { "@id": "bpkm:Event" },
      "rdfs:range": { "@id": "bpkm:Task" }
    },
    {
      "@id": "bpkm:eventNote",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Event Note",
      "rdfs:comment": "Note associated with this event",
      "rdfs:domain": { "@id": "bpkm:Event" },
      "rdfs:range": { "@id": "bpkm:Note" }
    }
  ]
}

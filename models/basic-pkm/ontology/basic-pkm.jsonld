{
  "@context": {
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "foaf": "http://xmlns.com/foaf/0.1/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "bpkm": "urn:sempkm:model:basic-pkm:",
    "gist": "https://w3id.org/semanticarts/ns/ontology/gist/"
  },
  "@graph": [
    {
      "@id": "bpkm:ontology",
      "@type": "owl:Ontology",
      "rdfs:label": "Basic PKM Ontology",
      "dcterms:description": "Core types for personal knowledge management: Projects, People, Notes, Concepts, Tasks, Milestones, and Events with rich inter-type relationships. Tasks and Events serve as semantic hubs for third-party provider integrations."
    },

    {
      "@id": "bpkm:Project",
      "@type": "owl:Class",
      "rdfs:label": "Project",
      "rdfs:comment": "A project or initiative being tracked",
      "rdfs:subClassOf": { "@id": "gist:Project" }
    },
    {
      "@id": "bpkm:Person",
      "@type": "owl:Class",
      "rdfs:label": "Person",
      "rdfs:comment": "A person known to the user",
      "rdfs:subClassOf": { "@id": "gist:Person" }
    },
    {
      "@id": "bpkm:Note",
      "@type": "owl:Class",
      "rdfs:label": "Note",
      "rdfs:comment": "A note, observation, or piece of knowledge",
      "rdfs:subClassOf": { "@id": "gist:FormattedContent" }
    },
    {
      "@id": "bpkm:Concept",
      "@type": "owl:Class",
      "rdfs:label": "Concept",
      "rdfs:comment": "An abstract concept, topic, or domain area",
      "rdfs:subClassOf": { "@id": "gist:KnowledgeConcept" }
    },

    {
      "@id": "bpkm:status",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Status",
      "rdfs:comment": "Status of a project (active, completed, on-hold, cancelled)",
      "rdfs:domain": { "@id": "bpkm:Project" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:priority",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Priority",
      "rdfs:comment": "Priority level (low, medium, high, critical)",
      "rdfs:domain": { "@id": "bpkm:Project" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:tags",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Tags",
      "rdfs:comment": "Tags for categorization (individual values)",
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:hasParticipant",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Has Participant",
      "rdfs:comment": "People involved in a project",
      "rdfs:domain": { "@id": "bpkm:Project" },
      "rdfs:range": { "@id": "bpkm:Person" }
    },
    {
      "@id": "bpkm:hasNote",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Has Note",
      "rdfs:comment": "Notes related to a project",
      "rdfs:domain": { "@id": "bpkm:Project" },
      "rdfs:range": { "@id": "bpkm:Note" }
    },
    {
      "@id": "bpkm:participatesIn",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Participates In",
      "rdfs:comment": "Projects a person is involved in",
      "rdfs:domain": { "@id": "bpkm:Person" },
      "rdfs:range": { "@id": "bpkm:Project" },
      "owl:inverseOf": { "@id": "bpkm:hasParticipant" }
    },
    {
      "@id": "bpkm:body",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Body",
      "rdfs:comment": "Markdown body content of a note",
      "rdfs:domain": { "@id": "bpkm:Note" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:noteType",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Note Type",
      "rdfs:comment": "Type of note (observation, idea, reference, meeting-note, journal)",
      "rdfs:domain": { "@id": "bpkm:Note" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:isAbout",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Is About",
      "rdfs:comment": "Concepts that a note relates to",
      "rdfs:domain": { "@id": "bpkm:Note" },
      "rdfs:range": { "@id": "bpkm:Concept" }
    },
    {
      "@id": "bpkm:relatedProject",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Related Project",
      "rdfs:comment": "Project context for a note",
      "rdfs:domain": { "@id": "bpkm:Note" },
      "rdfs:range": { "@id": "bpkm:Project" }
    },
    {
      "@id": "bpkm:hasRelatedNote",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Has Related Note",
      "rdfs:comment": "Notes related to this project (derived by SHACL-AF rule from relatedProject)",
      "rdfs:domain": { "@id": "bpkm:Project" },
      "rdfs:range": { "@id": "bpkm:Note" }
    },

    {
      "@id": "bpkm:Task",
      "@type": "owl:Class",
      "rdfs:label": "Task",
      "rdfs:comment": "An actionable unit of work. Can be created manually or synced from external providers (Asana, Linear, Jira, GitHub Issues, Todoist, etc.).",
      "rdfs:subClassOf": { "@id": "gist:Task" }
    },
    {
      "@id": "bpkm:Milestone",
      "@type": "owl:Class",
      "rdfs:label": "Milestone",
      "rdfs:comment": "A grouping of tasks toward a specific deliverable or deadline within a project",
      "rdfs:subClassOf": { "@id": "gist:Event" }
    },
    {
      "@id": "bpkm:Event",
      "@type": "owl:Class",
      "rdfs:label": "Event",
      "rdfs:comment": "A calendar event — meeting, appointment, deadline, or time block. Can be synced from external calendar providers (Google Calendar, Outlook, CalDAV, etc.).",
      "rdfs:subClassOf": { "@id": "gist:Event" }
    },

    {
      "@id": "bpkm:taskStatus",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Task Status",
      "rdfs:comment": "Normalized status of a task (todo, in-progress, done, blocked, cancelled)",
      "rdfs:domain": { "@id": "bpkm:Task" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:startDate",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Start Date",
      "rdfs:comment": "When work on this task begins. Maps to Asana start_on, Monday timeline start, Linear/Jira sprint start.",
      "rdfs:domain": { "@id": "bpkm:Task" },
      "rdfs:range": { "@id": "xsd:date" }
    },
    {
      "@id": "bpkm:dueDate",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Due Date",
      "rdfs:comment": "When the task is due",
      "rdfs:domain": { "@id": "bpkm:Task" },
      "rdfs:range": { "@id": "xsd:date" }
    },
    {
      "@id": "bpkm:completedDate",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Completed Date",
      "rdfs:comment": "When the task or milestone was completed",
      "rdfs:range": { "@id": "xsd:date" }
    },
    {
      "@id": "bpkm:effort",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Effort",
      "rdfs:comment": "T-shirt size estimate (trivial, small, medium, large, epic)",
      "rdfs:domain": { "@id": "bpkm:Task" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:externalId",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "External ID",
      "rdfs:comment": "Identifier from the external provider (e.g., PROJ-123, #42)",
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:externalUrl",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "External URL",
      "rdfs:comment": "Direct link to the item in the external provider's UI",
      "rdfs:range": { "@id": "xsd:anyURI" }
    },
    {
      "@id": "bpkm:externalProvider",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "External Provider",
      "rdfs:comment": "Which service this was imported from (asana, linear, jira, github, todoist, google-calendar, outlook, caldav, manual)",
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:lastSyncedAt",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Last Synced",
      "rdfs:comment": "Timestamp of the last successful sync with the external provider",
      "rdfs:range": { "@id": "xsd:dateTime" }
    },
    {
      "@id": "bpkm:storyPoints",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Story Points",
      "rdfs:comment": "Numeric complexity/effort estimate. Maps to Linear estimate, Jira story points, Monday numbers column.",
      "rdfs:domain": { "@id": "bpkm:Task" },
      "rdfs:range": { "@id": "xsd:decimal" }
    },
    {
      "@id": "bpkm:taskGroup",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Group",
      "rdfs:comment": "Section or group name from the external provider (Asana section, Monday group, Jira sprint, Linear cycle). Preserves provider-side organization.",
      "rdfs:domain": { "@id": "bpkm:Task" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:syncDirection",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Sync Direction",
      "rdfs:comment": "How this task syncs with the external provider (pull, push, bidirectional)",
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:externalStatus",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "External Status",
      "rdfs:comment": "The raw status label from the external provider before normalization. Preserved for round-trip fidelity (e.g., Asana section name, Monday status label, Jira workflow state).",
      "rdfs:range": { "@id": "xsd:string" }
    },

    {
      "@id": "bpkm:assignedTo",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Assigned To",
      "rdfs:comment": "Person(s) responsible for this task",
      "rdfs:domain": { "@id": "bpkm:Task" },
      "rdfs:range": { "@id": "bpkm:Person" }
    },
    {
      "@id": "bpkm:followers",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Followers",
      "rdfs:comment": "People following/watching this task for updates. Maps to Asana followers, Monday subscribers.",
      "rdfs:domain": { "@id": "bpkm:Task" },
      "rdfs:range": { "@id": "bpkm:Person" }
    },
    {
      "@id": "bpkm:parentTask",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Parent Task",
      "rdfs:comment": "The parent task if this is a subtask. Supports arbitrary depth (Asana: 5 levels, Monday: 5 levels).",
      "rdfs:domain": { "@id": "bpkm:Task" },
      "rdfs:range": { "@id": "bpkm:Task" }
    },
    {
      "@id": "bpkm:hasSubtasks",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Subtasks",
      "rdfs:comment": "Child tasks nested under this task",
      "rdfs:domain": { "@id": "bpkm:Task" },
      "rdfs:range": { "@id": "bpkm:Task" },
      "owl:inverseOf": { "@id": "bpkm:parentTask" }
    },
    {
      "@id": "bpkm:taskProject",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Project",
      "rdfs:comment": "Projects this task belongs to. Multi-value to match Asana (tasks can be in multiple projects) and Monday (items can be linked across boards).",
      "rdfs:domain": { "@id": "bpkm:Task" },
      "rdfs:range": { "@id": "bpkm:Project" }
    },
    {
      "@id": "bpkm:hasTasks",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Tasks",
      "rdfs:comment": "Tasks belonging to this project",
      "rdfs:domain": { "@id": "bpkm:Project" },
      "rdfs:range": { "@id": "bpkm:Task" },
      "owl:inverseOf": { "@id": "bpkm:taskProject" }
    },
    {
      "@id": "bpkm:milestone",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Milestone",
      "rdfs:comment": "The milestone this task belongs to",
      "rdfs:domain": { "@id": "bpkm:Task" },
      "rdfs:range": { "@id": "bpkm:Milestone" }
    },
    {
      "@id": "bpkm:hasMilestones",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Milestones",
      "rdfs:comment": "Milestones belonging to this project",
      "rdfs:domain": { "@id": "bpkm:Project" },
      "rdfs:range": { "@id": "bpkm:Milestone" },
      "owl:inverseOf": { "@id": "bpkm:milestoneProject" }
    },
    {
      "@id": "bpkm:milestoneProject",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Project",
      "rdfs:comment": "The project this milestone belongs to",
      "rdfs:domain": { "@id": "bpkm:Milestone" },
      "rdfs:range": { "@id": "bpkm:Project" }
    },
    {
      "@id": "bpkm:dependsOn",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Depends On",
      "rdfs:comment": "Tasks that must be completed before this one can start",
      "rdfs:domain": { "@id": "bpkm:Task" },
      "rdfs:range": { "@id": "bpkm:Task" }
    },
    {
      "@id": "bpkm:milestoneStatus",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Milestone Status",
      "rdfs:comment": "Status of a milestone (planned, active, completed, cancelled)",
      "rdfs:domain": { "@id": "bpkm:Milestone" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:targetDate",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Target Date",
      "rdfs:comment": "Target completion date for a milestone",
      "rdfs:domain": { "@id": "bpkm:Milestone" },
      "rdfs:range": { "@id": "xsd:date" }
    },

    {
      "@id": "bpkm:eventType",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Event Type",
      "rdfs:comment": "What kind of event (meeting, appointment, deadline, reminder, focus-block, social, travel, other)",
      "rdfs:domain": { "@id": "bpkm:Event" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:eventStatus",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Event Status",
      "rdfs:comment": "Status of a calendar event (confirmed, tentative, cancelled)",
      "rdfs:domain": { "@id": "bpkm:Event" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:allDay",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "All Day",
      "rdfs:comment": "Whether this is an all-day event",
      "rdfs:domain": { "@id": "bpkm:Event" },
      "rdfs:range": { "@id": "xsd:boolean" }
    },
    {
      "@id": "bpkm:location",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Location",
      "rdfs:comment": "Physical location or video meeting link",
      "rdfs:domain": { "@id": "bpkm:Event" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:calendarName",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Calendar",
      "rdfs:comment": "Name of the calendar within the provider (e.g., Work, Personal)",
      "rdfs:domain": { "@id": "bpkm:Event" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:meetingNotes",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Meeting Notes",
      "rdfs:comment": "Post-meeting notes and outcomes. Markdown supported.",
      "rdfs:domain": { "@id": "bpkm:Event" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "bpkm:attendee",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Attendee",
      "rdfs:comment": "People attending this event",
      "rdfs:domain": { "@id": "bpkm:Event" },
      "rdfs:range": { "@id": "bpkm:Person" }
    },
    {
      "@id": "bpkm:eventProject",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Project",
      "rdfs:comment": "The project this event relates to",
      "rdfs:domain": { "@id": "bpkm:Event" },
      "rdfs:range": { "@id": "bpkm:Project" }
    },
    {
      "@id": "bpkm:generatedTask",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Generated Task",
      "rdfs:comment": "Action items created from this event",
      "rdfs:domain": { "@id": "bpkm:Event" },
      "rdfs:range": { "@id": "bpkm:Task" }
    },
    {
      "@id": "bpkm:eventNote",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Event Note",
      "rdfs:comment": "Notes linked to this event",
      "rdfs:domain": { "@id": "bpkm:Event" },
      "rdfs:range": { "@id": "bpkm:Note" }
    }
  ]
}
